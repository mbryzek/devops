#!/usr/bin/env bash
# dev-script: targets=local
# Reclaim /tmp: idle Claude session scratchpads plus your own aged-out stray files. Dry run by default.
#
# Two things pile up in /tmp and nothing ever removes them:
#
#   1. /tmp/claude-501/<project>/<session-uuid>/  — one scratchpad per Claude Code
#      session, kept forever. This is the bulk of it (1.3 GB of ~1.5 GB on
#      2026-07-30). Pruned at the SESSION level, so a project keeps its recent
#      sessions and loses only the finished ones.
#   2. Loose files and dirs you dropped at the top level (test logs, one-off
#      scripts, scratch JSON). Only entries owned by you are considered.
#
# Age is the only signal, which is what makes this safe to run any time: an
# active session's scratchpad is being written to, so it is never idle long
# enough to qualify. Anything the OS or another user owns is skipped entirely --
# /tmp holds live sockets and Apple's own state, and deleting those breaks
# running software.
#
# Usage:
#   dev scripts run cleanup-tmp                 # dry run, 7-day cutoff
#   dev scripts run cleanup-tmp --days 3
#   dev scripts run cleanup-tmp --apply         # actually delete
#
# Dry run prints every candidate with its size and the total it would reclaim.

set -euo pipefail

DAYS=7
APPLY=0
# Resolved to its PHYSICAL path (/private/tmp on macOS): /tmp is a symlink, and
# `find /tmp -maxdepth 1` refuses to descend a symlink argument, so scanning the
# logical path silently reports nothing at the top level.
TMP_ROOT="$(cd -P /tmp && pwd)"
# Claude Code scratchpad root, one dir per uid.
CLAUDE_ROOT="$TMP_ROOT/claude-$(id -u)"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --days)
      shift
      [[ $# -gt 0 ]] || { echo "--days requires a value" >&2; exit 1; }
      DAYS="$1"
      ;;
    --apply) APPLY=1 ;;
    -h|--help) sed -n '3,32p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 1 ;;
  esac
  shift
done

[[ "$DAYS" =~ ^[0-9]+$ ]] || { echo "--days must be a non-negative integer" >&2; exit 1; }

ME=$(id -u)

# Top-level /tmp names that must never be touched, whoever appears to own them:
# live OS state and mount points, not scratch. Matched against the basename.
SKIP_PATTERNS=(
  'com.apple.*'
  '.*'
  'tmp-mount*'
  'powerlog*'
  'KSOutOfProcessFetcher*'
  # A stale-looking lock may still be held by a running app (Firefox's updater
  # keeps one for the life of the process); removing it invites a double-run.
  '*Lock-*'
  '*.lock'
)

skip_name() {
  local name="$1" pat
  for pat in "${SKIP_PATTERNS[@]}"; do
    # shellcheck disable=SC2053  # intentional glob match
    [[ "$name" == $pat ]] && return 0
  done
  return 1
}

# Candidates, one absolute path per line.
collect() {
  # Session scratchpads: /tmp/claude-<uid>/<project>/<session>, idle past cutoff.
  if [[ -d "$CLAUDE_ROOT" ]]; then
    find "$CLAUDE_ROOT" -mindepth 2 -maxdepth 2 -type d -mtime "+$DAYS" -user "$ME" -print 2>/dev/null || true
  fi

  # Your own loose top-level entries. Sockets/fifos/devices are excluded by
  # asking only for files and dirs -- a live socket is something's IPC endpoint.
  find "$TMP_ROOT" -mindepth 1 -maxdepth 1 \( -type f -o -type d \) \
    -mtime "+$DAYS" -user "$ME" -print 2>/dev/null |
    while IFS= read -r path; do
      name="${path##*/}"
      [[ "$path" == "$CLAUDE_ROOT" ]] && continue
      skip_name "$name" && continue
      printf '%s\n' "$path"
    done
}

# Built by hand rather than with mapfile: macOS ships bash 3.2, which has neither
# mapfile nor readarray.
CANDIDATES=()
while IFS= read -r line; do
  [[ -n "$line" ]] && CANDIDATES+=("$line")
done < <(collect | sort)

if [[ ${#CANDIDATES[@]} -eq 0 ]]; then
  echo "Nothing in $TMP_ROOT idle more than $DAYS day(s). Nothing to do."
  exit 0
fi

# KB -> the largest unit that keeps the number readable, so a 2 MB total doesn't
# print as "0.00 GB".
human_kb() {
  awk -v kb="$1" 'BEGIN {
    if (kb >= 1048576) printf "%.2f GB", kb/1048576
    else if (kb >= 1024) printf "%.1f MB", kb/1024
    else printf "%d KB", kb
  }'
}

echo "Candidates in $TMP_ROOT idle more than $DAYS day(s):"
total_kb=0
for path in "${CANDIDATES[@]}"; do
  kb=$(du -sk "$path" 2>/dev/null | cut -f1)
  kb=${kb:-0}
  total_kb=$((total_kb + kb))
  printf '  %10s  %s\n' "$(human_kb "$kb")" "$path"
done

printf '\n%d entr(ies), %s total.\n' "${#CANDIDATES[@]}" "$(human_kb "$total_kb")"

if [[ $APPLY -eq 0 ]]; then
  echo ""
  echo "(dry run -- pass --apply to delete these)"
  exit 0
fi

echo ""
removed=0
for path in "${CANDIDATES[@]}"; do
  # Re-check the mtime immediately before removing: a session can wake up and
  # write to its scratchpad between the scan and here.
  if [[ -z "$(find "$path" -maxdepth 0 -mtime "+$DAYS" -user "$ME" 2>/dev/null)" ]]; then
    echo "  skipped (active again): $path"
    continue
  fi
  rm -rf "$path"
  removed=$((removed + 1))
done

echo ""
echo "Removed $removed entr(ies)."
# Prune project dirs left empty by removing all of their sessions. Age-gated the
# same way: a project dir can be momentarily empty while a session starts up.
if [[ -d "$CLAUDE_ROOT" ]]; then
  find "$CLAUDE_ROOT" -mindepth 1 -maxdepth 1 -type d -empty -mtime "+$DAYS" -delete 2>/dev/null || true
fi
