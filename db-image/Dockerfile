ARG PG_MAJOR=18
FROM postgres:${PG_MAJOR}

# Allow passwordless connections — safe for local test containers only.
ENV POSTGRES_HOST_AUTH_METHOD=trust

# Which database this image carries, and the role that owns it. Both come from
# the devops config for the app (scala.development.database), passed through by
# bin/db-image — nothing about a specific app is baked into this file.
ARG DB_NAME
ARG DB_ROLE=api
ENV DB_NAME=${DB_NAME}
ENV DB_ROLE=${DB_ROLE}

# The build context is assembled by bin/db-image: the generic recipe from
# devops/db-image plus the schema repo's artifacts, all at fixed names. That
# indirection exists because COPY cannot reach outside the context, and the
# recipe and the artifacts live in different repositories.
#
# journal-settings.sql is always present but is EMPTY for an app with no
# journal schema — optionality is a zero-byte file rather than a conditional,
# so there is one code path here and in the init script.
# --chmod is required, not cosmetic: COPY otherwise preserves the mode the file
# happened to have in the build context, and these artifacts are generated by
# bin/db-image on the build host. A host with a restrictive umask (077) emits
# them 0600 — root-only — but everything below runs as the unprivileged postgres
# user, so the init script fails with "Permission denied" reading /schema/*.sql.
# Pinning the mode here makes the image independent of the build host's umask.
COPY --chmod=644 schema.sql              /schema/schema.sql
COPY --chmod=644 seed.sql                /schema/seed.sql
COPY --chmod=644 sem-tracking.sql        /schema/sem-tracking.sql
COPY --chmod=644 journal-settings.sql    /schema/journal-settings.sql
COPY --chmod=644 transfer-ownership.sql  /schema/transfer-ownership.sql

# Init script runs once on first container start, before connections open.
# 0755, not `chmod +x`: `+x` is relative to the existing mode, so a 0600 source
# becomes 0711 — executable but unreadable, and the kernel must READ a script to
# honor its shebang. That failed as "/bin/bash: 10-schema.sh: Permission denied".
COPY --chmod=755 initdb/10-schema.sh /docker-entrypoint-initdb.d/10-schema.sh
