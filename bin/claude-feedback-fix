#!/usr/bin/env bash
# claude-feedback-fix — hourly graph-feedback fix job.
#
# Claims unactioned graph-feedback comments (playbook-feedback API) and hands them
# to a local headless Claude session that fixes them and opens PRs. The claim
# endpoint is atomic server-side (SELECT ... FOR UPDATE), so concurrent runs
# serialize and this script exits quietly when there is nothing to do.
#
# Auth: mints a session via the tenant login endpoint using an admin's credentials.
#   CLUBAID_FEEDBACK_EMAIL     admin email (from ~/code/env)
#   CLUBAID_FEEDBACK_PASSWORD  admin password (from ~/code/env)
#   CLUBAID_API_BASE           optional; defaults to the production API
#
# Install the hourly schedule: see devops/claude-feedback/README.md.
set -euo pipefail

API_BASE="${CLUBAID_API_BASE:-https://idempotent.io}"
TENANT="clubaid"
# Headless-specific wrapper (env inputs + status curl) followed by the durable
# orientation shared with `dev feedback` (graph-feedback-body.md) — one copy.
PROMPT_DIR="$(cd "$(dirname "$0")/.." && pwd)/claude-feedback"
PROMPT_FILE="$PROMPT_DIR/prompt.md"
BODY_FILE="$PROMPT_DIR/graph-feedback-body.md"
LOG_DIR="${HOME}/code/claude/logs"
WORK_DIR="$(mktemp -d /tmp/claude-feedback-fix.XXXXXX)"

mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/claude-feedback-fix.log"
log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"; }

if [[ -z "${CLUBAID_FEEDBACK_EMAIL:-}" || -z "${CLUBAID_FEEDBACK_PASSWORD:-}" ]]; then
  log "ERROR missing CLUBAID_FEEDBACK_EMAIL / CLUBAID_FEEDBACK_PASSWORD"
  exit 1
fi

SESSION_ID="$(
  curl -sf -X POST "$API_BASE/tenant/$TENANT/session/logins" \
    -H 'Content-Type: application/json' \
    -d "{\"email\": \"$CLUBAID_FEEDBACK_EMAIL\", \"password\": \"$CLUBAID_FEEDBACK_PASSWORD\"}" \
  | jq -r '.session.id'
)"
if [[ -z "$SESSION_ID" || "$SESSION_ID" == "null" ]]; then
  log "ERROR login failed"
  exit 1
fi

CLAIMED_FILE="$WORK_DIR/claimed.json"
curl -sf -X POST "$API_BASE/playbook/feedback/comments/claims" \
  -H "session_id: $SESSION_ID" > "$CLAIMED_FILE"

COUNT="$(jq 'length' "$CLAIMED_FILE")"
if [[ "$COUNT" -eq 0 ]]; then
  rm -rf "$WORK_DIR"
  exit 0
fi

log "claimed $COUNT feedback item(s); starting fix session (work dir $WORK_DIR)"

# The fix session updates each item's status itself via these env vars.
export CLAUDE_FEEDBACK_API_BASE="$API_BASE"
export CLAUDE_FEEDBACK_SESSION_ID="$SESSION_ID"
export CLAUDE_FEEDBACK_CLAIMED_FILE="$CLAIMED_FILE"

claude --print "$(cat "$PROMPT_FILE" "$BODY_FILE")" >> "$LOG_FILE" 2>&1 || log "ERROR claude session exited non-zero"

log "fix session finished for $COUNT item(s)"
