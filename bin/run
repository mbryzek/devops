#!/bin/sh

# Shared sbt run/test wrapper for the scala projects (platform, acumen, ...).
# Each project root keeps a thin ./run.sh that execs this script, so the logic
# lives in one place. The project name (used for log file naming) is derived
# from the directory ./run.sh was invoked in.
#
# Usage (from a project root):
#   ./run.sh run
#   ./run.sh test
#   ./run.sh test --fix     # on failures/errors, launch claude to investigate
#                           # (without --fix, you're prompted before exiting)
#   ./run.sh test --make-faster
#                           # on a GREEN run, launch claude to speed the suite up
#   ./run.sh test --no-reset-db
#                           # keep the session database as the last run left it
#
# Every test run starts by RESETTING the session database (bin/reset-session-db),
# because the suite is not idempotent against its own: repeated runs against one
# database get slower and redder until the failures stop being about the code at
# all (ISS-801). --no-reset-db opts out; the test summary says which happened.
#
# Every `test` run prints a timing summary (see bin/test-timings) and appends a
# row to ~/.cache/devops-test-timings/<project>.tsv, so a slowdown shows up as a
# trend rather than a hunch. When the summary finds something worth speeding up
# it says so and points at --make-faster.

PROJECT=$(basename "$PWD")

# Never let a Claude session run sbt against the shared :5432 dev database — see
# lib/session_db.rb. It runs first, before the log file and before sbt, so the
# refusal costs nothing and the session can fix it in the same turn. Interactive
# runs are not gated at all (the check keys on CLAUDECODE), and a task that opens
# no database (compile, scalafmt, a bare `set ...`) is let through either way.
#
# Resolved via this script's own path so a checkout under ~/code/ai/<feature>/devops
# exercises its own copy, the same way $TIMINGS does below.
#
# It is given the arguments with --no-reset-db already removed, so what it sees is
# exactly the list sbt will see.
assert_session_db() {
  "$(dirname "$0")/assert-session-db" "$PROJECT" "$@" || exit 1
}

# --no-reset-db: keep the session database as the last run left it. Stripped here,
# ahead of everything, because the reset below happens before BOTH branches —
# `./run.sh test` and `./run.sh core/testOnly ...` are the same hazard and only
# the first goes through the test branch's own flag parsing.
NO_RESET_DB=0
argc=$#
while [ "$argc" -gt 0 ]; do
  arg="$1"
  shift
  if [ "$arg" = "--no-reset-db" ]; then
    NO_RESET_DB=1
  else
    set -- "$@" "$arg"
  fi
  argc=$((argc - 1))
done

assert_session_db "$@"

# A test run starts from a database in a known state, or it is not measuring the
# code. The platform suite leaves its rows behind: eight consecutive runs on one
# session database, on unmodified main, went 6m26s -> 3h35m and 3 -> 23 failures,
# with 131,632 rows in `tasks` (ISS-801). Nothing noticed, and the failures read
# as flaky tests.
#
# Only test tasks, only session databases, never :5432 — see bin/reset-session-db
# for what it refuses to touch and why.
DB_RESET="not reset"
if [ "$NO_RESET_DB" -eq 1 ]; then
  DB_RESET="not reset (--no-reset-db)"
else
  # Output is NOT captured: a refusal has to reach the terminal as it happens,
  # and the exit status — not a string in the output — is what says which of the
  # three outcomes this was. See bin/reset-session-db's header.
  "$(dirname "$0")/reset-session-db" "$PROJECT" "$@"
  case $? in
    0) ;;                                  # nothing to reset, or nothing could be
    9) DB_RESET="reset from template" ;;
    *)
      echo ""
      echo "ERROR: the session database could not be reset, so this run would start from"
      echo "whatever the last one left behind. Fix the above, or re-run with --no-reset-db"
      echo "if you accept results measured against a dirty database."
      exit 1
      ;;
  esac
fi

# Larger of two integers.
max() {
  if [ "$1" -ge "$2" ]; then echo "$1"; else echo "$2"; fi
}

# Launch a claude session (--dangerously-skip-permissions) to investigate and
# fix the failures/errors captured in the test log.
launch_fix() {
  echo "Launching claude to investigate and fix..."
  claude --dangerously-skip-permissions "The $PROJECT test suite was just run: sbt exited $SBT_STATUS, with $FAILURES test failure(s), $CANCELED canceled test(s), and $COMPILE_ERRORS compile error(s)$REPORTER_NOTE. The full sbt/ScalaTest output is in $LOG.

Investigate and fix the errors:
- Read $LOG and identify each distinct failure/error and its root cause (grep for '[error]', 'TESTS FAILED', 'Tests:', and stack traces).
- Trust sbt's exit code and the '[error] Failed tests:' list over ScalaTest's 'Tests: succeeded N, failed N' summary lines. If the ScalaTest reporter died mid-run ('Reporter completed abruptly'), those summary lines UNDERCOUNT and can read 'failed 0' on a run that failed.
- Fix the underlying cause, not the symptom. Read the relevant ~/code/claude/rules/*.mdc files before writing code.
- Do NOT change production behavior unless you first prove it is in fact a production bug. Starting assumption is the tests need to be updated.
- Check CONF_DB_DEV_URL is set to this session's DB first (the port is per container — use the URL 'claude-db start' handed you, shown again by 'claude-db status'). A suite that silently ran against the :5432 dev DB produces mass stale-data failures that are environmental, not code bugs.
- The session database for this run was: $DB_RESET. If it was NOT reset, the failures may be residue rather than code: the suite leaves its rows behind, and a database carrying earlier runs' rows produces failures in the task/queue specs and a suite that gets progressively slower (ISS-801). Re-run without --no-reset-db and see whether the failures survive a clean database before reading the diff.
- After fixing, re-run './run.sh test' (or a targeted 'testOnly') and confirm the suite is green before declaring done.
- Work on a feature branch and directory per CLAUDE.md; do not commit to main."
}

# Launch a claude session to make the suite faster. Only ever called on a GREEN
# run: speeding up a suite while it is red means optimizing against unknown
# behavior, and the timing numbers from a failed run are not trustworthy anyway.
launch_make_faster() {
  echo "Launching claude to make the test suite faster..."
  claude --dangerously-skip-permissions "The $PROJECT test suite was just run and passed, in ${WALL_SECONDS:-unknown} seconds of wall clock. The full sbt/ScalaTest output is in $LOG. Make the suite faster without weakening it.

Start by reading the timing summary, which is printed at the end of $LOG and can be regenerated at any time:
  ~/code/devops/bin/test-timings $LOG --project $PROJECT --top 30 --no-history
Run history (one row per run: timestamp, wall ms, test-body ms, tests, suites) is at ~/.cache/devops-test-timings/$PROJECT.tsv — check whether this is a recent regression before assuming it was always slow.

How to read the numbers:
- 'time in test bodies' is the sum of ScalaTest's per-test durations (the '-oD' flag, already set via testOptions in build.sbt). It counts ONLY the test body.
- It excludes suite construction, beforeAll/afterAll, Play application and HTTP server boot, and compile. So if body time is a small share of wall clock, the cost is fixtures/boot and making individual tests do less work is the WRONG lever.
- If summed body time is close to the 'longest test run' critical path, the suites are barely overlapping and parallelism is the lever.

The per-test durations do NOT attribute fixture/boot cost to a specific suite. To get true per-SUITE wall time (which DOES include beforeAll/afterAll and suite construction), re-run one subproject with ScalaTest's JUnit XML reporter. It must be scoped to a specific PROJECT — a ThisBuild-scoped or 'every'-scoped setting does NOT work here, because each subproject sets its own 'testOptions += Tests.Argument(\"-oDF\")' which shadows ThisBuild, and 'set every' fails outright with 'Reference to undefined setting':
  ./run.sh 'set <subproject> / Test / testOptions += Tests.Argument(TestFrameworks.ScalaTest, \"-u\", \"/tmp/$PROJECT-test-reports\")' <subproject>/test
Then compare each <testsuite time=...> against the sum of its <testcase time=...> values; the gap is that suite's fixture and boot overhead.

Things worth checking in this codebase specifically:
- Specs extending DefaultServerSpec use GuiceOneServerPerSuite, which boots a full Play app AND binds an HTTP server per suite. Specs extending DefaultAppSpec share one application per JVM via core/test/core/helpers/SharedPlayApp.scala. A spec that does not actually exercise HTTP should be on DefaultAppSpec — check before moving one, and move it only if it genuinely makes no HTTP calls.
- Class-level vals in a spec run at suite construction and are invisible to per-test durations. Creating orgs/users/clubs there is a common hidden cost.
- Test / parallelExecution and Test / fork are set per subproject in build.sbt.
- DB-heavy DAO specs often do redundant per-test setup that could be built once per suite.

Rules:
- Do NOT delete tests, weaken assertions, add Thread.sleep, or mark tests ignored/pending to make numbers go down. Coverage must not regress.
- Do NOT change production behavior to speed up a test.
- Measure before and after with the same command and report the real delta; do not claim an improvement you have not measured.
- Read the relevant ~/code/claude/rules/*.mdc files before writing code.
- Confirm the suite is still green before declaring done.
- Work on a feature branch and directory per CLAUDE.md; do not commit to main."
}

if [ "$1" = "test" ]; then
  # Tidy up old logs, but NEVER touch one a concurrent run is still writing.
  #
  # This used to be `rm -f "/tmp/$PROJECT-test-"*.log`, which deleted the log of every other run in
  # flight. Two overlapping `./run.sh test` invocations is not a hypothetical - it is what happens
  # the moment you get impatient with a slow run and start a second one in another terminal. The
  # second run's rm unlinked the first run's log out from under its `tee`, so when the first run
  # finished, every grep below read a file that no longer existed: zero failures, zero canceled,
  # zero compile errors, and a nonzero sbt status. That combination reports "sbt exited 1, with
  # test failure(s)" against an empty log, and with --fix it launches a claude session to fix
  # failures that do not exist (2026-07-30, acumen).
  #
  # Age-based deletion keeps the directory from growing without bound and cannot race: a log older
  # than a day is not being written by anything.
  #
  # The trailing slash on /tmp/ is required, not stylistic: on macOS /tmp is a symlink to
  # private/tmp, and `find /tmp` stats the symlink and never descends, so the same command without
  # it silently matches nothing.
  find /tmp/ -maxdepth 1 -name "$PROJECT-test-*.log" -type f -mtime +0 -delete 2>/dev/null

  # --fix: after the run, parse the log and, if there are any failures/errors,
  # launch a claude session (ccd == claude --dangerously-skip-permissions) to
  # investigate and fix them. The flag is stripped before passing args to sbt.
  #
  # --make-faster: on a green run, launch claude to speed the suite up instead.
  # Both flags are stripped before the remaining args are passed to sbt.
  AUTOFIX=0
  MAKE_FASTER=0
  argc=$#
  while [ "$argc" -gt 0 ]; do
    arg="$1"
    shift
    if [ "$arg" = "--fix" ]; then
      AUTOFIX=1
    elif [ "$arg" = "--make-faster" ]; then
      MAKE_FASTER=1
    else
      set -- "$@" "$arg"
    fi
    argc=$((argc - 1))
  done

  LOG="/tmp/$PROJECT-test-$(date +%Y%m%d-%H%M%S).log"
  echo "Logging to $LOG"

  # sbt's exit code is the authoritative pass/fail signal, but it is lost through
  # the `| tee` pipe ($? would be tee's). Stash it in a temp file instead — sh has
  # no PIPESTATUS. Everything below only ever ADDS problems on top of this.
  STATUS_FILE=$(mktemp "${TMPDIR:-/tmp}/run-status.XXXXXX")
  {
    eval "$(~/code/devops/bin/app-env --env development --format sh) sbt -no-share \"\$@\""
    echo $? > "$STATUS_FILE"
  } 2>&1 | tee "$LOG"
  SBT_STATUS=$(cat "$STATUS_FILE" 2>/dev/null)
  rm -f "$STATUS_FILE"
  # No status written => sbt died without the group completing; treat as failure.
  [ -n "$SBT_STATUS" ] || SBT_STATUS=1

  # Every count below is grepped out of $LOG, and grep against a file that is not there writes
  # nothing to stdout, so the counts come back as empty strings rather than zeros. That produced a
  # report of "sbt exited 1, with  test failure(s),  canceled test(s), and  compile error(s)" and,
  # with --fix, a claude session sent to fix nothing. If the log is gone, say so and stop guessing.
  if [ ! -f "$LOG" ]; then
    echo ""
    echo "ERROR: the log $LOG disappeared while the run was in progress."
    echo "Nothing can be reported about this run. If another './run.sh test' was running at the"
    echo "same time, re-run this one on its own."
    exit 1
  fi

  # Summarize results from the log.
  #
  # ScalaTest's per-subproject "Tests: succeeded N, failed N" summary is written by
  # the reporter, so when the reporter itself dies mid-run ("Reporter completed
  # abruptly") it reads "failed 0" on a run that failed — that is how a 26-failure
  # platform run was reported as green on 2026-07-17. Count the per-test
  # "*** FAILED ***" / "!!! CANCELED !!!" markers too (they are printed as each test
  # finishes, so they survive a dead reporter) and take whichever is larger.
  #
  # Match the summary line as a WHOLE line before extracting the counts. Bare
  # 'failed N' / 'canceled N' also occur in application log output captured in the
  # same file, and counting those invents failures on a green run — a WARN reading
  # "a members window failed 3 times" reported a clean platform run as 3 failures
  # on 2026-07-20.
  SUMMARY_LINES=$(grep -hE '^\[info\] Tests: succeeded [0-9]+, failed [0-9]+, canceled [0-9]+' "$LOG")
  FAILURES_SUMMARY=$(echo "$SUMMARY_LINES" | grep -Eo 'failed [0-9]+'   | grep -Eo '[0-9]+' | awk '{s+=$1} END {print s+0}')
  CANCELED_SUMMARY=$(echo "$SUMMARY_LINES" | grep -Eo 'canceled [0-9]+' | grep -Eo '[0-9]+' | awk '{s+=$1} END {print s+0}')
  # "*** N TESTS FAILED ***" is a suite total, not a per-test marker: it does not
  # contain the literal "*** FAILED ***", so it is not double counted here.
  FAILURES_MARKERS=$(grep -cF '*** FAILED ***' "$LOG")
  CANCELED_MARKERS=$(grep -cF '!!! CANCELED !!!' "$LOG")
  FAILURES=$(max "$FAILURES_SUMMARY" "$FAILURES_MARKERS")
  CANCELED=$(max "$CANCELED_SUMMARY" "$CANCELED_MARKERS")
  # Compile errors: [error] lines pointing at a source location (skips sbt's generic noise).
  COMPILE_ERRORS=$(grep -cE '^\[error\] .*\.(scala|java):[0-9]+' "$LOG")
  REPORTER_CRASHES=$(grep -cF 'Reporter completed abruptly' "$LOG")

  PROBLEMS=$((FAILURES + CANCELED + COMPILE_ERRORS))
  # A nonzero sbt exit means the run failed even if every count above came back 0
  # (aborted suite, dead reporter, sbt-level error). Never report green over it.
  if [ "$SBT_STATUS" -ne 0 ] && [ "$PROBLEMS" -eq 0 ]; then
    PROBLEMS=1
  fi

  REPORTER_NOTE=""
  if [ "$REPORTER_CRASHES" -gt 0 ]; then
    REPORTER_NOTE=" — NOTE: the ScalaTest reporter crashed mid-run, so these counts may undercount the real number of failures"
  fi

  echo ""
  echo "================ test summary ================"
  echo "  project:        $PROJECT"
  # In the summary because this is the block a person reads when a run goes red,
  # and "the database was not reset" is the single cheapest explanation for a red
  # that has nothing to do with the diff (ISS-801). A run that did reset says so
  # too — a fact stated only on the bad path is a fact nobody learns to trust.
  echo "  session db:     $DB_RESET"
  echo "  sbt exit:       $SBT_STATUS"
  echo "  failed:         $FAILURES"
  echo "  canceled:       $CANCELED"
  echo "  compile errors: $COMPILE_ERRORS"
  if [ "$REPORTER_CRASHES" -gt 0 ]; then
    echo "  reporter:       CRASHED ($REPORTER_CRASHES time(s)) — counts may undercount"
  fi
  echo "============================================="

  # Timing summary. Always runs, so every green run leaves a trend datapoint.
  # Guarded: this is reporting only, and must never turn a green run red or
  # mask the pass/fail result decided above.
  WALL_SECONDS=$(grep -oE '^\[success\] Total time: [0-9]+ s' "$LOG" | tail -1 | grep -oE '[0-9]+')
  # Resolve the sibling script via this script's own path, so a checkout under
  # ~/code/ai/<feature>/devops exercises its own copy rather than the one in
  # ~/code/devops.
  TIMINGS="$(dirname "$0")/test-timings"
  if [ -x "$TIMINGS" ]; then
    # Only a green run goes into the trend: a run that aborted on failures has
    # a wall clock that is not comparable to a full one.
    HISTORY_FLAG=""
    [ "$PROBLEMS" -gt 0 ] && HISTORY_FLAG="--no-history"
    # shellcheck disable=SC2086
    "$TIMINGS" "$LOG" --project "$PROJECT" $HISTORY_FLAG 2>&1 | tee -a "$LOG" || true
  fi

  if [ "$SBT_STATUS" -ne 0 ]; then
    # The list sbt prints is reliable even when the ScalaTest summary is not.
    echo "sbt reported failure. Failed suites:"
    sed -n '/^\[error\] Failed tests:/,/^\[error\] ([^)]*)/p' "$LOG" | grep -E '^\[error\]\s+\S+$' | sort -u
    echo ""
  fi

  if [ "$PROBLEMS" -gt 0 ]; then
    if [ "$MAKE_FASTER" -eq 1 ]; then
      # Perf work on a red suite optimizes against unknown behavior. Get it
      # green first; --fix (if also given) still runs below.
      echo "Skipping --make-faster: the suite is not green. Fix the failures first."
    fi
    if [ "$AUTOFIX" -eq 1 ]; then
      echo "Found $PROBLEMS problem(s)."
      launch_fix
    elif [ -t 0 ] && [ -e /dev/tty ]; then
      # Interactive: ask before exiting so the user can fix without re-running.
      printf "Found %s problem(s). Launch claude to investigate and fix? [y/N] " "$PROBLEMS"
      read -r reply < /dev/tty
      case "$reply" in
        [yY]|[yY][eE][sS]) launch_fix ;;
        *) echo "Skipping. Re-run with '--fix' to auto-launch claude next time." ;;
      esac
    else
      # Non-interactive (CI, pipe): don't block; just report.
      echo "Found $PROBLEMS problem(s). Re-run with '--fix' to auto-launch claude to investigate."
    fi
    # Exit nonzero so callers (CI, scripts, `&&` chains) can detect the failure
    # rather than inferring it from stdout.
    exit 1
  else
    echo "All green — no failures or errors."
    if [ "$MAKE_FASTER" -eq 1 ]; then
      launch_make_faster
    fi
  fi
  exit 0
else
  eval "$(~/code/devops/bin/app-env --env development --format sh) sbt -no-share \"\$@\""
fi
