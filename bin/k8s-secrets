#!/usr/bin/env ruby

# k8s-secrets: Sync environment secrets from git-crypt to Kubernetes
#
# Usage:
#   k8s-secrets [--app APP] [--env ENV] [--dry-run]
#
# Examples:
#   k8s-secrets                                    # Preview secrets for current app (dry-run)
#   k8s-secrets --app platform                     # Apply secrets to cluster
#   k8s-secrets --app platform --env development   # Use development environment
#   k8s-secrets --app platform --dry-run           # Preview without applying
#
# Prerequisites:
#   - kubectl configured with cluster access
#   - git-crypt unlocked in env/ repository

load File.join(File.dirname(__FILE__), '../lib/common.rb')

require 'yaml'

args = Args.parse(ARGV, ["app"])

# Pin kubectl to the app's DO account (digital-ocean-accounts.pkl); the default namespace
# is account-scoped.
account = DigitalOceanAccounts.activate_for_app!(Config.load(args.app))

# Kubernetes namespace
K8S_NAMESPACE = args.namespace || account['namespace']

# Load environment variables using the existing EnvironmentVariables class
Util.detail("Loading environment variables for #{args.app} (#{args.env})...")
vars_obj = EnvironmentVariables.load(args.app, args.env)

# Convert to hash by parsing the JSON serialization
vars = JSON.parse(vars_obj.serialize("json"))

if vars.empty?
  Util.exit_with_error("No environment variables found")
end

Util.detail("Found #{vars.size} environment variables")
Util.detail("")

# An app deployed with the New Relic agent attached but no license key does not
# fail. It starts, the agent cannot authenticate, and the app reports nothing —
# for as long as it runs, with no error anywhere the deploy can see. The result
# is an app that is absent from New Relic, and absent looks exactly like healthy:
# an NRQL query naming it returns an empty result set rather than an error
# (ISS-635), so "no errors" and "not instrumented" are the same output.
#
# That is not a hypothetical pairing of two bugs, it is what acumen was for
# eighteen months (ISS-1070), and the next app to hit it is already written down
# — k8s/apps/playbook-api.pkl carries a "no javaAgent yet" note pending a New
# Relic account decision, and whoever resolves that will set javaAgent in one
# repo and need a key in another.
#
# So the two halves are checked together, once, at the only moment both are
# visible: refuse to sync secrets for an app whose deploy config attaches the
# agent when the key that agent needs is not among them.
k8s_config = K8sAppConfig.load(args.app)
if K8sAppConfig.java_agent?(k8s_config) && vars[K8sAppConfig::LICENSE_KEY].to_s.strip.empty?
  Util.exit_with_error(<<~MSG.strip)
    #{args.app} is configured for New Relic APM (javaAgent in #{K8sAppConfig.path(args.app)})
    but #{K8sAppConfig::LICENSE_KEY} is not set for it in the env repo.

    Deploying this way is worse than not instrumenting at all: the agent attaches,
    fails to authenticate, and the app silently reports nothing — which is
    indistinguishable in New Relic from an app with no errors.

    Fix either half:
      - add #{K8sAppConfig::LICENSE_KEY} to apps/#{args.app}/env/#{args.env}.env in the env
        repo (it is the account's ingest key — the same value platform already uses), or
      - remove `javaAgent` from #{K8sAppConfig.path(args.app)} if this app is
        deliberately not instrumented.
  MSG
end

# Generate Kubernetes Secret manifest
secret_name = "#{args.app}-secrets"
config_name = "#{args.app}-config"

# Separate sensitive vs non-sensitive config
# Convention: Variables starting with CONF_ are config, others are secrets
config_vars = vars.select { |k, _| k.start_with?('CONF_') }
secret_vars = vars.reject { |k, _| k.start_with?('CONF_') }

# Also add database credentials secret if database config exists
db_vars = {}
%w[DB_HOST DB_PORT DB_NAME DB_USER DB_PASSWORD DATABASE_URL].each do |key|
  db_vars[key] = vars[key] if vars[key]
end

# Generate Secret YAML
secret_manifest = {
  'apiVersion' => 'v1',
  'kind' => 'Secret',
  'metadata' => {
    'name' => secret_name,
    'namespace' => K8S_NAMESPACE,
    'labels' => {
      'app' => args.app,
      'app.kubernetes.io/name' => args.app
    }
  },
  'type' => 'Opaque',
  'stringData' => secret_vars
}

# Generate ConfigMap YAML
configmap_manifest = {
  'apiVersion' => 'v1',
  'kind' => 'ConfigMap',
  'metadata' => {
    'name' => config_name,
    'namespace' => K8S_NAMESPACE,
    'labels' => {
      'app' => args.app,
      'app.kubernetes.io/name' => args.app
    }
  },
  'data' => config_vars
}

# Generate DB credentials Secret if we have database vars
db_secret_manifest = nil
unless db_vars.empty?
  db_secret_manifest = {
    'apiVersion' => 'v1',
    'kind' => 'Secret',
    'metadata' => {
      'name' => "#{args.app}-db-credentials",
      'namespace' => K8S_NAMESPACE,
      'labels' => {
        'app' => args.app,
        'app.kubernetes.io/name' => args.app
      }
    },
    'type' => 'Opaque',
    'stringData' => db_vars
  }
end

# Output summary
Util.detail("=" * 60)
Util.detail("Kubernetes Secrets Summary")
Util.detail("=" * 60)
Util.detail("  Namespace:    #{K8S_NAMESPACE}")
Util.detail("  Secret:       #{secret_name} (#{secret_vars.size} vars)")
Util.detail("  ConfigMap:    #{config_name} (#{config_vars.size} vars)")
Util.detail("  DB Secret:    #{args.app}-db-credentials (#{db_vars.size} vars)") if db_secret_manifest
Util.detail("=" * 60)
Util.detail("")

# Show variable names (not values!)
Util.detail("Secret variables (#{secret_name}):")
secret_vars.keys.sort.each { |k| Util.detail("  - #{k}") }
Util.detail("")

Util.detail("ConfigMap variables (#{config_name}):")
config_vars.keys.sort.each { |k| Util.detail("  - #{k}") }
Util.detail("")

if db_secret_manifest
  Util.detail("DB Credentials (#{args.app}-db-credentials):")
  db_vars.keys.sort.each { |k| Util.detail("  - #{k}") }
  Util.detail("")
end

if args.dry_run
  puts "DRY RUN - Use without --dry-run to apply secrets to cluster"
  puts ""
  puts "Preview (Secret):"
  puts secret_manifest.to_yaml
else
  Util.detail("Applying to Kubernetes cluster...")

  # Write manifests to temp files
  tmp_dir = "/tmp/k8s-secrets-#{args.app}"
  FileUtils.mkdir_p(tmp_dir)

  secret_file = File.join(tmp_dir, "secret.yaml")
  configmap_file = File.join(tmp_dir, "configmap.yaml")

  File.write(secret_file, secret_manifest.to_yaml)
  File.write(configmap_file, configmap_manifest.to_yaml)

  # Apply Secret, then prune any live key not in the source (see
  # Util.sync_k8s_resource for why `apply` alone can't do this).
  Util.detail("  Applying #{secret_name}...")
  Util.sync_k8s_resource("secret", secret_name, secret_file, secret_vars.keys, namespace: K8S_NAMESPACE)

  # Apply ConfigMap, same pruning.
  Util.detail("  Applying #{config_name}...")
  Util.sync_k8s_resource("configmap", config_name, configmap_file, config_vars.keys, namespace: K8S_NAMESPACE)

  # Apply DB credentials if present, same pruning.
  if db_secret_manifest
    db_name = "#{args.app}-db-credentials"
    db_file = File.join(tmp_dir, "db-secret.yaml")
    File.write(db_file, db_secret_manifest.to_yaml)
    Util.detail("  Applying #{db_name}...")
    Util.sync_k8s_resource("secret", db_name, db_file, db_vars.keys, namespace: K8S_NAMESPACE)
  end

  # Clean up
  FileUtils.rm_rf(tmp_dir)

  Util.detail("")
  Util.detail("Secrets applied successfully!")
end
