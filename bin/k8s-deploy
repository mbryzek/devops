#!/usr/bin/env ruby

# k8s-deploy: Deploy application to Kubernetes with rolling updates
#
# Usage:
#   k8s-deploy [--app APP] [--tag TAG] [--dry-run]
#
# Examples:
#   k8s-deploy                                 # Deploy current app (inferred from directory)
#   k8s-deploy --app platform                  # Deploy latest tag
#   k8s-deploy --app platform --tag v1.2.3    # Deploy specific tag
#
# Prerequisites:
#   - kubectl configured with cluster access
#   - Docker image built and pushed (via k8s-build)
#   - Secrets configured (via k8s-secrets)

load File.join(File.dirname(__FILE__), '../lib/common.rb')

args = Args.parse(ARGV, ["app"])

SCRIPT_DIR = File.dirname(__FILE__)
K8S_DIR = File.join(SCRIPT_DIR, '../k8s')

# Pin doctl + kubectl to the app's DO account (digital-ocean-accounts.pkl); registry and
# default namespace are account-scoped.
account = DigitalOceanAccounts.activate_for_app!(Config.load(args.app))

# Kubernetes namespace
K8S_NAMESPACE = args.namespace || account['namespace']

# Tag - fetch latest tag if not specified
tag = args.tag
if tag.nil? || tag.empty?
  tag = AppConfig.latest_tag(args.app)
  puts "Using latest tag: #{tag}"
end

# Timeout defaults to 360 seconds (6 minutes)
# JVM apps with NewRelic agent + 45s liveness initialDelay regularly exceed 180s
# when combined with a ~13s image pull on a cold node.
timeout = args.timeout || 360

Util.detail("")
Util.detail("=" * 60)
Util.detail("Deploying to Kubernetes")
Util.detail("=" * 60)
Util.detail("  App:       #{args.app}")
Util.detail("  Tag:       #{tag}")
Util.detail("  Namespace: #{K8S_NAMESPACE}")
Util.detail("  Dry Run:   #{args.dry_run ? 'Yes' : 'No'}")
Util.detail("=" * 60)
Util.detail("")

# Generate manifests
manifest_file = "/tmp/#{args.app}-deploy-#{tag}.yaml"
manifest = Util.step("Generating Kubernetes manifests") do
  app_config_file = File.join(K8S_DIR, 'apps', "#{args.app}.pkl")
  template_file = File.join(K8S_DIR, 'templates', 'scala-play-app.pkl')

  unless File.exist?(app_config_file)
    Util.exit_with_error("App config not found: #{app_config_file}")
  end

  unless File.exist?(template_file)
    Util.exit_with_error("Template not found: #{template_file}")
  end

  # Read app config to get port
  config_output = `cd #{K8S_DIR} && pkl eval -f json apps/#{args.app}.pkl 2>/dev/null`
  config = JSON.parse(config_output) rescue {}
  app_port = config["appPort"] || 9000

  # Build env vars for template (NodePort is auto-assigned by K8s)
  env_vars = "APP=#{args.app} PORT=#{app_port} VERSION=#{tag}"
  env_vars += " K8S_NAMESPACE=#{K8S_NAMESPACE} REGISTRY=#{account['registry']}"
  env_vars += " WEB_MEMORY=#{config['webMemory']}" if config['webMemory']
  env_vars += " JOB_MEMORY=#{config['jobMemory']}" if config['jobMemory']
  env_vars += " JAVA_AGENT=#{config['javaAgent']}" if config['javaAgent']

  cmd = "cd #{K8S_DIR} && #{env_vars} pkl eval templates/scala-play-app.pkl"
  generated = `#{cmd} 2>&1`

  unless $?.success?
    Util.exit_with_error("Error generating manifest:\n#{generated}")
  end

  File.write(manifest_file, generated)
  Util.detail("Manifest written to: #{manifest_file}")
  generated
end

if args.dry_run
  puts "DRY RUN - Manifest contents:"
  puts "-" * 60
  puts manifest
  puts "-" * 60
  FileUtils.rm_f(manifest_file)
  exit 0
end

# Check if namespace exists
namespace_exists = system("kubectl get namespace #{K8S_NAMESPACE} > /dev/null 2>&1")
unless namespace_exists
  puts "Creating namespace: #{K8S_NAMESPACE}"
  Util.run("kubectl create namespace #{K8S_NAMESPACE}")
end

deployment_name = "#{args.app}-web"
statefulset_name = "#{args.app}-job"

# Diagnostic helper to log cluster state
def log_cluster_state(app, namespace, label = nil)
  timestamp = Time.now.strftime("%H:%M:%S.%L")
  Util.detail("    [#{timestamp}] #{label}") if label

  # Get endpoints
  endpoints = `kubectl get endpoints #{app}-web -n #{namespace} -o jsonpath='{range .subsets[*].addresses[*]}{.targetRef.name}{" "}{end}' 2>/dev/null`.strip
  Util.detail("    [#{timestamp}] Endpoints: #{endpoints.empty? ? '(none)' : endpoints}")

  # Get pod status
  pods = `kubectl get pods -n #{namespace} -l app=#{app} -o wide --no-headers 2>/dev/null`.strip
  pods.each_line { |line| Util.detail("    [#{timestamp}] Pod: #{line.strip}") }

  # Check if healthcheck works via NodePort on each node
  nodeport = `kubectl get svc #{app}-web -n #{namespace} -o jsonpath='{.spec.ports[0].nodePort}' 2>/dev/null`.strip
  nodes = `kubectl get nodes -o wide --no-headers 2>/dev/null | awk '{print $7}'`.strip.split

  nodes.first(2).each do |node_ip|
    next if node_ip.empty? || node_ip == "<none>"
    result = `curl -s -o /dev/null -w "%{http_code}" --connect-timeout 2 http://#{node_ip}:#{nodeport}/_internal_/healthcheck 2>/dev/null`
    Util.detail("    [#{timestamp}] NodePort #{node_ip}:#{nodeport} -> #{result}")
  end
end

# Deploy in two stages:
# 1. Services and PDBs (non-disruptive)
# 2. Deployment (web) and StatefulSet (job) applied together, both rollouts
#    awaited in parallel
#
# Web zero-downtime comes from the Deployment's own RollingUpdate strategy
# (the web Service selects tier=web only, so job pods never back web
# traffic). The job tier accepts a brief outage: the StatefulSet update
# shuts down the old job pod, then starts the new one, so old and new job
# servers never run concurrently.
Util.detail("Deploying web and job in parallel (job tier tolerates a brief outage)...")
Util.detail("")

# Step 1: Apply Services and PodDisruptionBudget only (non-disruptive)
Util.step("Applying Services and PodDisruptionBudget") do
  log_cluster_state(args.app, K8S_NAMESPACE, "BEFORE deploy")

  # Extract only Service and PodDisruptionBudget resources from manifest
  svc_pdb_file = "/tmp/#{args.app}-svc-pdb.yaml"
  docs = File.read(manifest_file).split(/^---\s*$/)
  svc_pdb_docs = docs.select { |doc| doc =~ /kind:\s*(Service|PodDisruptionBudget)/ }
  File.write(svc_pdb_file, svc_pdb_docs.join("---\n"))
  Util.run("kubectl apply -f #{svc_pdb_file}")
  FileUtils.rm_f(svc_pdb_file)
end

# Runs concurrently for web and job. Both tiers roll out inside ONE stage (see
# below), so per-tier timing is detail for the log rather than its own line —
# two stages cannot be in flight at once in the parent's phase display, and the
# pair finishes together anyway.
def wait_for_rollout(label, rollout_cmd)
  started = Time.now
  if Util.quiet?
    Util.log("==> #{rollout_cmd}")
    rollout_cmd = "(#{rollout_cmd}) >> '#{Util.log_file}' 2>&1"
  end
  success = system(rollout_cmd)
  Util.detail("  #{label} #{success ? 'done' : 'FAILED'} (#{(Time.now - started).round}s)")
  success
end

# podManagementPolicy is immutable. Once the template changed it to Parallel,
# `kubectl apply` against a StatefulSet still carrying the OrderedReady default
# is rejected outright:
#
#   Forbidden: updates to statefulset spec for fields other than 'replicas',
#   'ordinals', 'template', 'updateStrategy', ... are forbidden
#
# which would fail every deploy of every scala-play app until someone migrated
# by hand. The migration is to delete the StatefulSet object while ORPHANING its
# pods (--cascade=orphan): the running pod is untouched, and the recreated
# StatefulSet adopts it by label selector. No downtime, and the pod is then
# rolled normally by the deploy that follows.
#
# Idempotent by construction — it only fires while the live object disagrees
# with the manifest, so it is a no-op on every subsequent deploy.
def adopt_statefulset_for_immutable_change(namespace, name, manifest_file)
  live = `kubectl get statefulset/#{name} -n #{namespace} -o jsonpath='{.spec.podManagementPolicy}' 2>/dev/null`.strip
  return if live.empty? # not created yet; the apply below creates it correctly

  desired = File.read(manifest_file)[/podManagementPolicy:\s*(\w+)/, 1] || "OrderedReady"
  return if live == desired

  Util.detail("  Migrating #{name}: podManagementPolicy #{live} -> #{desired} (immutable field)")
  Util.detail("  Deleting the StatefulSet with --cascade=orphan; pods keep running and are re-adopted.")
  Util.run("kubectl delete statefulset/#{name} -n #{namespace} --cascade=orphan")
end

# Step 2: Apply web Deployment + job StatefulSet, wait for both in parallel
Util.detail("")
Util.detail("  [2/2] Applying Deployment #{deployment_name} and StatefulSet #{statefulset_name}...")
Util.run("kubectl apply -f #{manifest_file} -l tier=web")
adopt_statefulset_for_immutable_change(K8S_NAMESPACE, statefulset_name, manifest_file)
Util.run("kubectl apply -f #{manifest_file} -l tier=job")

deployment_success = false
statefulset_success = false

# Raised only to make Util.step close its line as "failed (Ns)" — the step
# tracks success by whether its block returns normally, so a rollout that timed
# out has to leave the block by raising or it would render as done. Caught
# immediately: the pod/event/log diagnostics below are the real output, and
# they must run before the script exits.
class RolloutIncomplete < StandardError; end

begin
  Util.step("Rolling out #{deployment_name} + #{statefulset_name}") do
    # Monitor state during rollout
    monitor_thread = Thread.new do
      10.times do
        sleep 2
        log_cluster_state(args.app, K8S_NAMESPACE, "DURING rollout")
      end
    end

    deployment_thread = Thread.new do
      wait_for_rollout(deployment_name,
        "kubectl rollout status deployment/#{deployment_name} -n #{K8S_NAMESPACE} --timeout=#{timeout}s")
    end
    statefulset_thread = Thread.new do
      wait_for_rollout(statefulset_name,
        "kubectl rollout status statefulset/#{statefulset_name} -n #{K8S_NAMESPACE} --timeout=#{timeout}s")
    end

    deployment_success = deployment_thread.value
    statefulset_success = statefulset_thread.value
    monitor_thread.kill rescue nil

    raise RolloutIncomplete unless deployment_success && statefulset_success
  end
rescue RolloutIncomplete
  nil
end

log_cluster_state(args.app, K8S_NAMESPACE, "AFTER rollout")
if deployment_success
  Util.detail("  ✓ Deployment #{deployment_name} ready")
else
  puts "  ✗ Deployment #{deployment_name} failed"
end
if statefulset_success
  Util.detail("  ✓ StatefulSet #{statefulset_name} ready")
else
  puts "  ✗ StatefulSet #{statefulset_name} failed"
end

if deployment_success && statefulset_success
  Util.detail("")
  Util.detail("=" * 60)
  Util.detail("Deployment completed successfully!")
  Util.detail("=" * 60)
else
  puts ""
  puts "=" * 60
  puts "WARNING: Rollout did not complete within timeout"
  puts "=" * 60
  puts "Full log: #{Util.log_file}" if Util.quiet?
  puts ""

  # Show pod status
  puts "Pod Status:"
  puts "-" * 60
  system("kubectl get pods -n #{K8S_NAMESPACE} -l app=#{args.app} -o wide")
  puts ""

  # Show recent events
  puts "Recent Events:"
  puts "-" * 60
  system("kubectl get events -n #{K8S_NAMESPACE} --sort-by='.lastTimestamp' --field-selector involvedObject.name=#{deployment_name} 2>/dev/null | tail -10")
  puts ""

  # Show pod logs for any failing pods
  puts "Checking for failing pods..."
  failing_pods = `kubectl get pods -n #{K8S_NAMESPACE} -l app=#{args.app} -o jsonpath='{range .items[?(@.status.phase!="Running")]}{.metadata.name}{"\\n"}{end}' 2>/dev/null`.strip.split("\n").reject(&:empty?)

  failing_pods.each do |pod|
    puts ""
    puts "Logs from #{pod}:"
    puts "-" * 40
    system("kubectl logs -n #{K8S_NAMESPACE} #{pod} --tail=20 2>/dev/null || echo '  (no logs available)'")
  end

  puts ""
  puts "Debug commands:"
  puts "  kubectl describe pods -n #{K8S_NAMESPACE} -l app=#{args.app}"
  puts "  kubectl logs -n #{K8S_NAMESPACE} -l app=#{args.app} --tail=50"
  puts "  kubectl get events -n #{K8S_NAMESPACE} --sort-by='.lastTimestamp'"
  puts "=" * 60
  exit 1
end

# Show deployment status (verbose only; the release log has full history)
unless Util.quiet?
  puts ""
  puts "Deployment Status:"
  puts "-" * 60
  system("kubectl get deployment #{args.app}-web -n #{K8S_NAMESPACE}")
  system("kubectl get statefulset #{args.app}-job -n #{K8S_NAMESPACE}")
  puts ""
  puts "Pods:"
  system("kubectl get pods -n #{K8S_NAMESPACE} -l app=#{args.app}")
end

# Clean up manifest file
FileUtils.rm_f(manifest_file)

unless Util.quiet?
  puts ""
  puts "=" * 60
  puts "Deployment Summary"
  puts "=" * 60
  puts "  App:    #{args.app}"
  puts "  Tag:    #{tag}"
  puts "  Status: Deployed"
  puts ""
  puts "Useful commands:"
  puts "  kubectl logs -n #{K8S_NAMESPACE} -l app=#{args.app},tier=web -f"
  puts "  kubectl logs -n #{K8S_NAMESPACE} -l app=#{args.app},tier=job -f"
  puts "  kubectl get pods -n #{K8S_NAMESPACE} -l app=#{args.app} -w"
  puts "=" * 60
end
