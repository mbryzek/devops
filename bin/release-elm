#!/usr/bin/env ruby

require 'time'

# Run this script from the project root directory

LOG = "/tmp/release-elm.log"

dir = File.dirname(__FILE__)
load File.join(dir, "../lib/common.rb")

# Parse args BEFORE anything touches Config: ReleaseHelper's constructor loads the
# app config, which rebuilds dist/ unless --skip-generate-json has already been seen.
args = Args.parse(ARGV)

helper = ReleaseHelper.new("elm")

# Concise by default, like release-scala and release-sveltekit: one
# "label... done (12s)" line per stage, full command output in the log. `dev deploy`
# parses that stream to show this app's phases live. --verbose keeps the old
# fully-streaming output. The log name carries no version — Tag.ask does not run
# until after the compile.
Util.quiet!("/tmp/devops-release/#{helper.app}.log") unless args.verbose

puts ""
puts Util.underline("Releasing #{helper.app}")
puts "Full log: #{Util.log_file}" if Util.quiet?
puts ""

# Turn elm.js -> elm.min.js
def add_suffix(filename, suffix)
  File.basename(filename, ".*") + ".#{suffix}" + File.extname(filename)
end

def ensure_elm_review
  if !File.exist?("review.sh")
    Util.exit_with_error("No review.sh script found")
  end

  Util.step("Running elm-review") do
    # Quiet mode routes the output to the log and, on failure, prints its tail
    # plus the log path — which is the same "here is what to fix" the verbose
    # branch spells out by hand.
    next Util.run("./review.sh") if Util.quiet?

    if !system("./review.sh")
      puts ""
      puts ""
      puts "Fix Elm Review Suggestions then release again"
      puts ""
      exit(1)
    end
  end
end

def rewrite_constants(file, rewrites)
  contents = IO.read(file)
  rewrites.each do |r|
    contents.gsub!(r.from, r.to)
  end
  file = add_suffix(file, "constants")
  File.open(file, "w") do |out|
    out << contents
  end
  file
end

def rewrite_version(file, version)
  Util.detail("rewrite_version #{file} #{version}")
  tmp = []
  version_found = false
  # Append `?v=<version>` to /elm.js and /style.css refs at release time.
  # Source stays clean so elm-live serves them correctly in dev — a `?v=...`
  # query string trips elm-live's pushstate fallback in v4.x.
  cache_bust_re = %r{(<(?:script|link)\b[^>]*?\b(?:src|href)\s*=\s*["'])(/(?:elm\.js|style\.css))(?:\?[^"']*)?(["'])}
  IO.readlines(file).each do |l|
    line = l.gsub(cache_bust_re) { "#{$1}#{$2}?v=#{version}#{$3}" }
    if !version_found && md = line.strip.match(/^version\s*:\s*"([^"]+)"/)
      tmp << line.sub(md[1], version)
      version_found = true
    else
      tmp << line
    end
  end
  if !version_found
    raise "Failed to find version in #{file}"
  end
  File.open(file, "w") do |out|
    out << tmp.join("")
  end
  file
end

def minify(helper, js, uglifyjs)
  file = add_suffix(js, "min")
  helper.run "#{uglifyjs} #{js} --compress 'pure_funcs=[F2,F3,F4,F5,F6,F7,F8,F9,A2,A3,A4,A5,A6,A7,A8,A9],pure_getters,keep_fargs=false,unsafe_comps,unsafe' | #{uglifyjs} --mangle --output #{file}"
  file
end

def extract_file(l, tag)
  if md = l.match(/#{tag}\s*=\s*\"([^\"]+)/)
    url = md[1]
    if url.match(/^\//)
      # Strip any query string (e.g. `?v={{VERSION}}` cache-bust suffix) — the
      # underlying file on disk is the bare path.
      f = url[1..-1].sub(/\?.*\z/, "")
      if !File.exist?(f)
        raise "Failed to find file '#{f} from the following line in index.html:\n#{l}"
      end
      f
    else
      nil
    end
  else
    nil
  end
end

# The tools this release shells out to, installed and resolved BEFORE anything
# else runs.
#
# Up front for two reasons. minify() used to assert its tool on the far side of
# both the elm build and Tag.ask's prompt, so a machine without uglifyjs answered
# a version prompt and compiled for a minute before being told to go install
# something. And the install has to precede ./review.sh rather than lean on it:
# review.sh installs only when elm-review itself is missing, so a node_modules
# that predates a newly declared tool satisfies it and leaves the tool absent.
#
# See NodeBin for why repo-local wins over a global.
if !NodeBin.missing(["elm", "uglifyjs"]).empty?
  Util.step("Installing node dependencies") { helper.run "npm install" }
end
elm = NodeBin.resolve("elm", url: "https://guide.elm-lang.org/install/elm.html")
uglifyjs = NodeBin.resolve("uglifyjs", package: "uglify-js", url: "https://github.com/mishoo/UglifyJS")

ensure_elm_review
a = "elm.js"
Util.step("Compiling") { helper.run "#{elm} make src/Main.elm --optimize --output=#{a}" }

# Tag.ask prompts (unless RELEASE_AUTO_TAG), so it stays outside any Util.step: a
# stage owns its single line of stdout for the length of its block, and a prompt
# printed into the middle of it mangles both the prompt and the stage the parent reads.
tag = Tag.ask

Util.step("Minifying") do
  b = rewrite_constants(a, helper.app_config.rewrites)
  c = minify(helper, b, uglifyjs)
  helper.run "rm -f #{b}"
  helper.run "mv #{c} elm.js"
end

files = ["index.html"]
File.readlines("index.html").each do |l|
  if f = extract_file(l, "href")
    files << f
  end
  if f = extract_file(l, "src")
    files << f
  end
end

# Publishing IS the deploy for an elm app: Cloudflare Pages builds whatever lands on
# the release repo's main. There is no wrangler upload to narrate after this.
Util.step("Publishing to #{File.basename(helper.release_dir)}") do
  Dir.chdir(helper.release_dir) do |dir|
    helper.run "rm -rf *"
    helper.run "git reset --hard"
    helper.run "git clean -fdx"
    helper.write_to_file("version.txt", tag)
    files.each do |f|
      helper.run "cp #{File.join(helper.pwd, f)} ."
    end
    ni = rewrite_constants("index.html", helper.app_config.rewrites)
    ni2 = rewrite_version(ni, File.read("version.txt").strip)
    helper.run "rm -f index.html"
    helper.run "mv #{ni2} index.html"

    # Write _internal_/version (extensionless, JSON content) so the deployed
    # static site serves it at /_internal_/version — same path as the Scala /
    # SvelteKit dynamic endpoints. Content-Type may be octet-stream but the
    # work-versions client parses the body as JSON regardless.
    require "json"
    require "fileutils"
    FileUtils.mkdir_p("_internal_")
    File.write(File.join("_internal_", "version"),
               JSON.generate({ "version" => tag, "released_at" => Time.now.utc.iso8601 }))

    helper.run "git add #{files.join(" ")} version.txt _internal_/version"

    helper.maybe_tag_and_push(tag)
  end
end

# `dev deploy` reads this line to learn the version actually released — it knows the
# tag that existed BEFORE the release, which is the wrong one whenever the release
# minted a new one. Same contract as release-scala / release-docker-k8s.
puts "Full log: #{Util.log_file}" if Util.quiet?
puts ""
puts "Release complete: #{helper.app} #{tag}"
puts ""
