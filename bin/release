#!/usr/bin/env ruby

# Run this file from the project root directory

dir = File.dirname(__FILE__)
load File.join(dir, "../lib/common.rb")

# A stale local main would silently release old code — fast-forward it first,
# and only stop if the checkout can't be brought current.
ReleaseFreshness.ensure!

# Publish this checkout's apibuilder specs to the registry, when it owns any.
# The release IS the publish point: dev `api` runs are hermetic and never write
# the registry, so `latest` means "what is released" — the specs of the API
# actually running in prod. ReleaseFreshness.ensure! above already guarantees
# the clean, current main checkout that `api publish` requires.
#
# Deliberately NOT best-effort: a deployed API whose specs failed to publish is
# exactly the drift the hermetic design exists to prevent, so a publish failure
# fails the release (Util.run exits). Recover by fixing the cause and running
# `api publish` standalone — the deploy itself has already happened.
def publish_specs_if_owned(dir)
  config_path = File.join(Dir.pwd, ".api", "config.pkl")
  return unless File.exist?(config_path)
  config = ApiConfig.new(config_path)
  owns_specs = config.blocks.any? { |b| b.applications.any? { |a| File.exist?(File.join(Dir.pwd, a.file_path)) } }
  return unless owns_specs
  Util.run File.join(dir, "api") + " publish", quiet: true
end

pwd = `pwd`.strip
if pwd.end_with?("-postgresql")
  # This branch runs BEFORE Args.parse below, so --verbose is read straight off
  # ARGV. passthrough: release-db manages its own quiet-mode output (and
  # prompts for the tag and the apply gate), so its stream must never be
  # redirected into a parent's log.
  cmd = File.join(dir, "release-db")
  cmd += " --verbose" if ARGV.include?("--verbose")
  Util.run cmd, passthrough: true
  return
end

# Libraries (lib-util, lib-query, lib-cipher, lib-ai) have no app in the devops
# config — the `lib-` directory prefix is the tell, same one release-lib itself
# uses. Without this, `release` from a library checkout died in generate-json
# with "Missing required argument(s): app".
#
# passthrough: release-lib prompts for confirmation and shells out to GPG, so it
# must keep the terminal even if a parent enabled quiet mode.
if File.basename(pwd).start_with?("lib-")
  Util.run File.join(dir, "release-lib"), passthrough: true
  # lib-ai owns apibuilder specs; the other libs have no .api config and skip.
  publish_specs_if_owned(dir)
  return
end

args = Args.parse(ARGV, ["app"])
config = Config.load(args.app)

if args.cloudflare_account && !config.sveltekit
  Util.exit_with_error("--cloudflare-account only applies to sveltekit apps (#{args.app} is not one)")
end

files = if config.scala
    ["release-scala"]
  elsif config.elm
    if args.app == "acumen-ui"
      ["release-elm", "record-ui-version"]
    else
      ["release-elm"]
    end
  elsif config.sveltekit
    ["release-sveltekit"]
  elsif config.docker_k8s
    ["release-docker-k8s"]
  else
    Util.exit_with_error("Do not know how to release app that is not scala, elm, sveltekit, or docker_k8s")
  end

files.each do |file|
  # Config.load above already rebuilt dist/ — children reuse it rather than each
  # re-running generate-json.
  cmd = File.join(dir, file) + " --app #{args.app} #{Config::SKIP_REGENERATE_FLAG}"
  cmd += " --verbose" if args.verbose
  # Only release-sveltekit understands per-account target selection.
  if file == "release-sveltekit" && args.cloudflare_account
    cmd += " --cloudflare-account #{args.cloudflare_account}"
  end
  Util.run cmd, quiet: true
end

# Hard-failing (see publish_specs_if_owned) and therefore ahead of the
# best-effort hooks below. No-op for repos without local spec files (frontends'
# .api configs reference registry apps only).
publish_specs_if_owned(dir)

# Post-release hook: record this app's changelog in platform now that the tag exists.
# Runs the whole pipeline (capture then build), not just capture: the notes are served
# from the API, so nothing is baked into a build and there is no longer any reason to
# defer the model step to a manual run. Only the tracked playbook* apps feed it.
#
# Best-effort via system() (never raises/exits) so a changelog hiccup can never block or
# fail a release that has already succeeded.
CHANGELOG_TRACKED = %w[playbook-admin playbook-app playbook-www].freeze
if CHANGELOG_TRACKED.include?(args.app)
  system(File.join(dir, "dev"), "changelog", "--app", args.app, Config::SKIP_REGENERATE_FLAG) ||
    warn("changelog failed (ignored) — run `dev changelog --app #{args.app}` later")
end

# Post-release hook: run the two reconcilers that gate on "what is production
# running". A release is the only event that can change either answer, and the
# deploy steps above already waited for the rollout, so the new version is live by
# the time we reach here. Between releases both have nothing to do -- which is why
# they hang off this rather than a cron nobody would remember to install.
#
# Deliberately NOT scoped to the app just released. A feature removal (or a fixed
# issue) usually waits on more than one app, so releasing platform can be what
# clears one that was also waiting on playbook-app. Both commands evaluate
# everything outstanding, so one call per release covers all of it.
#
# Best-effort via system() for the same reason as the changelog hook above: a
# reconcile hiccup must never fail a release that has already succeeded. Both are
# fail-closed, so skipping a run only defers work -- nothing is deleted or
# transitioned on a failure, and feature_removals_must_be_processed_within_a_week
# catches a reconcile that has stopped running entirely.
RECONCILERS = [
  ["features", "feature-flag cleanup"],
  ["issues", "fixed -> deployed transitions"],
].freeze
RECONCILERS.each do |command, description|
  system(File.join(dir, "dev"), command, "reconcile", "--apply", Config::SKIP_REGENERATE_FLAG) ||
    warn("dev #{command} reconcile --apply failed (ignored, #{description}) — run it later")
end
