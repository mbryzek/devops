#!/usr/bin/env ruby

# Run this file from the project root directory

dir = File.dirname(__FILE__)
load File.join(dir, "../lib/common.rb")

# A stale local main would silently release old code — fast-forward it first,
# and only stop if the checkout can't be brought current.
ReleaseFreshness.ensure!

pwd = `pwd`.strip
if pwd.end_with?("-postgresql")
  # This branch runs BEFORE Args.parse below, so --verbose is read straight off
  # ARGV. passthrough: release-db manages its own quiet-mode output (and
  # prompts for the tag and the apply gate), so its stream must never be
  # redirected into a parent's log.
  cmd = File.join(dir, "release-db")
  cmd += " --verbose" if ARGV.include?("--verbose")
  Util.run cmd, passthrough: true
  return
end

# Libraries (lib-util, lib-query, lib-cipher, lib-ai) have no app in the devops
# config — the `lib-` directory prefix is the tell, same one release-lib itself
# uses. Without this, `release` from a library checkout died in generate-json
# with "Missing required argument(s): app".
#
# passthrough: release-lib prompts for confirmation and shells out to GPG, so it
# must keep the terminal even if a parent enabled quiet mode.
if File.basename(pwd).start_with?("lib-")
  Util.run File.join(dir, "release-lib"), passthrough: true
  # lib-ai owns apibuilder specs; the other libs have no .api config and skip.
  # ReleaseFreshness.ensure! above already guarantees the clean main checkout
  # that `api publish` requires; running after the release means origin/main may
  # have moved on by now — `api publish` only requires HEAD to be merged into it,
  # not to be its tip.
  PostRelease.publish_specs_if_owned(dir)
  return
end

args = Args.parse(ARGV, ["app"])
config = Config.load(args.app)

if args.cloudflare_account && !config.sveltekit
  Util.exit_with_error("--cloudflare-account only applies to sveltekit apps (#{args.app} is not one)")
end

files = if config.scala
    ["release-scala"]
  elsif config.elm
    if args.app == "acumen-ui"
      ["release-elm", "record-ui-version"]
    else
      ["release-elm"]
    end
  elsif config.sveltekit
    ["release-sveltekit"]
  elsif config.docker_k8s
    ["release-docker-k8s"]
  else
    Util.exit_with_error("Do not know how to release app that is not scala, elm, sveltekit, or docker_k8s")
  end

files.each do |file|
  # Config.load above already rebuilt dist/ — children reuse it rather than each
  # re-running generate-json.
  cmd = File.join(dir, file) + " --app #{args.app} #{Config::SKIP_REGENERATE_FLAG}"
  cmd += " --verbose" if args.verbose
  # Only release-sveltekit understands per-account target selection.
  if file == "release-sveltekit" && args.cloudflare_account
    cmd += " --cloudflare-account #{args.cloudflare_account}"
  end
  Util.run cmd, quiet: true
end

# Everything from here down runs AFTER the rollout the release script waited
# for. It used to be the post-deploy work itself — the spec publish, the
# changelog and the two global reconcilers, a minute or more of bookkeeping on
# the clock of whoever was watching. That work is filed for the fleet now
# (PostDeployWork, ISS-814); what is left is one narrated stage, in the same
# "label... done (12s)" protocol the live phase display parses
# (lib/deploy_progress.rb).
#
# Quiet mode can only be turned on HERE, not at the top of the script: while the
# release-* child above was running it had to keep the terminal (it manages its
# own quiet mode and Tag.ask prompts), and a parent in quiet mode would have
# redirected that child's stage lines into a log file, blanking the display for
# the whole release. --verbose keeps the old streaming output.
Util.quiet!("/tmp/devops-release/#{args.app}-post-release.log") unless args.verbose
puts "Post-release log: #{Util.log_file}" if Util.quiet?

PostRelease.new(app: args.app).run
