#!/usr/bin/env ruby

# Run this file from the project root directory

dir = File.dirname(__FILE__)
load File.join(dir, "../lib/common.rb")

# A stale local main would silently release old code — fast-forward it first,
# and only stop if the checkout can't be brought current.
ReleaseFreshness.ensure!

pwd = `pwd`.strip
if pwd.end_with?("-postgresql")
  Util.run File.join(dir, "release-db")
  return
end

args = Args.parse(ARGV, ["app"])
config = Config.load(args.app)

if args.cloudflare_account && !config.sveltekit
  Util.exit_with_error("--cloudflare-account only applies to sveltekit apps (#{args.app} is not one)")
end

files = if config.scala
    ["release-scala"]
  elsif config.elm
    if args.app == "acumen-ui"
      ["release-elm", "record-ui-version"]
    else
      ["release-elm"]
    end
  elsif config.sveltekit
    ["release-sveltekit"]
  elsif config.docker_k8s
    ["release-docker-k8s"]
  else
    Util.exit_with_error("Do not know how to release app that is not scala, elm, sveltekit, or docker_k8s")
  end

files.each do |file|
  # Config.load above already rebuilt dist/ — children reuse it rather than each
  # re-running generate-json.
  cmd = File.join(dir, file) + " --app #{args.app} #{Config::SKIP_REGENERATE_FLAG}"
  cmd += " --verbose" if args.verbose
  # Only release-sveltekit understands per-account target selection.
  if file == "release-sveltekit" && args.cloudflare_account
    cmd += " --cloudflare-account #{args.cloudflare_account}"
  end
  Util.run cmd, quiet: true
end

# Pre-release hook: record this app's changelog into the `changelog` data repo now
# that the tag exists. Best-effort via system() (never raises/exits) so a changelog
# hiccup can never block or fail a release. Only the tracked playbook* apps feed it.
CHANGELOG_TRACKED = %w[playbook-admin playbook-app playbook-www].freeze
if CHANGELOG_TRACKED.include?(args.app)
  system(File.join(dir, "dev"), "changelog", "capture", "--app", args.app, Config::SKIP_REGENERATE_FLAG) ||
    warn("changelog capture failed (ignored) — run `dev changelog capture --app #{args.app}` later")
end

# Post-release hook: run the two reconcilers that gate on "what is production
# running". A release is the only event that can change either answer, and the
# deploy steps above already waited for the rollout, so the new version is live by
# the time we reach here. Between releases both have nothing to do -- which is why
# they hang off this rather than a cron nobody would remember to install.
#
# Deliberately NOT scoped to the app just released. A feature removal (or a fixed
# issue) usually waits on more than one app, so releasing platform can be what
# clears one that was also waiting on playbook-app. Both commands evaluate
# everything outstanding, so one call per release covers all of it.
#
# Best-effort via system() for the same reason as the changelog hook above: a
# reconcile hiccup must never fail a release that has already succeeded. Both are
# fail-closed, so skipping a run only defers work -- nothing is deleted or
# transitioned on a failure, and feature_removals_must_be_processed_within_a_week
# catches a reconcile that has stopped running entirely.
RECONCILERS = [
  ["features", "feature-flag cleanup"],
  ["issues", "fixed -> deployed transitions"],
].freeze
RECONCILERS.each do |command, description|
  system(File.join(dir, "dev"), command, "reconcile", "--apply", Config::SKIP_REGENERATE_FLAG) ||
    warn("dev #{command} reconcile --apply failed (ignored, #{description}) — run it later")
end
