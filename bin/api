#!/usr/bin/env ruby

# Unified CLI for API Builder batch operations.
#
# Usage:
#   api                             # hermetic codegen from local specs (nothing published)
#   api --profile localhost         # same, with profile
#   api publish                     # upload + codegen, from a clean merged main checkout only
#
# Dev runs are HERMETIC: local spec files (plus sibling repos' specs when running
# under a ~/code/ai/<feature>/ working dir) ride along with the codegen batch as
# payloads; the server validates and generates from exactly that set and nothing
# is written to the registry. The registry's `latest` only moves via `api publish`,
# which is guarded to a clean main checkout whose HEAD is merged into origin/main —
# so `latest` always means "code that is merged on main" and concurrent sessions
# cannot clobber each other.

load File.join(File.dirname(__FILE__), '../lib/common.rb')

VALID_LANGUAGES = %w[typescript scala].freeze

USAGE = <<~TEXT
  Usage: api [--profile PROFILE] [--app APP ...] [--group GROUP]
         api [--profile PROFILE] [--app APP ...] [--group GROUP] publish
         api [--profile PROFILE] init [--language typescript] [--language scala]
         api [--profile PROFILE] validate <file>
         api [--profile PROFILE] [--app APP ...] [--group GROUP] lint [<file>]
         api [--profile PROFILE] result [--dry-run]

  Commands:
    (none)            Hermetic codegen: local spec files (and sibling repos' specs when
                      running under ~/code/ai/<feature>/) are sent with the batch as
                      payloads; the server validates the whole set together and
                      generates from exactly those specs. Nothing is published.
    publish           Upload specs to the registry AND generate code. Guarded: requires
                      a clean checkout of main matching origin/main. This is the ONLY
                      way the registry's `latest` moves — run after a merge (or let CI).
    init [options]    Create an anonymous org and token, write to ~/.apibuilder/config.
                      Use --language to also create a local .api/config.pkl with default
                      code generators. Can be repeated for multiple languages.
    validate <file>   Validate an api.json spec file via server-side validation
                      (hermetic — nothing is published).
    lint [<file>]     Remove imports that are declared but never referenced, rewriting
                      the spec files in place. With no <file>, lints every spec in
                      .api/config.pkl; scope it with --app/--group (same as codegen).
                      Exits non-zero if it removed anything or a spec failed to
                      parse — review and commit the changes (git diff to inspect/revert).
    result            Generate a repo-wide ApiResult.scala from the union of all
                      specs whose blocks bind the play_controller generator in
                      .api/config.pkl. Hermetic like codegen: local/sibling spec
                      payloads ride along. Use --dry-run to print the request body
                      and exit before HTTP.

  Options:
    --profile PROFILE  Use a named profile from ~/.apibuilder/config
    --app APP          Process only the specified application(s). Can be repeated.
    --group GROUP      Process only blocks with the specified group.

  Examples:
    api                                              # hermetic codegen
    api --app platform                                # one app only
    api --group dao                                   # dao specs only
    api publish                                       # publish from a clean main checkout
    api validate spec/myapp.json                      # validate a spec file
    api lint                                          # clean unused imports from every spec
    api result                                        # generate ApiResult.scala
    api result --dry-run                              # print request body, skip HTTP
TEXT

# --- Project prefix injection ---
#
# Scala-emitting generators (play_controller / play_api_result) derive the
# class names of repo-wide controller infrastructure from a project prefix
# (e.g. `core.controllers.AcumenControllerHelpers`). We read that prefix
# from the repo's top-level `build.sbt` `name := "..."` declaration and
# inject it as `service.attributes.project.name` on every spec we upload.
# Spec JSON files stay clean — the attribute exists only on the uploaded
# service.

def read_project_from_build_sbt(project_root = Dir.pwd)
  path = File.join(project_root, "build.sbt")
  return nil unless File.exist?(path)
  IO.foreach(path) do |line|
    if line =~ /^name\s*:=\s*"([^"]+)"/
      name = $1.strip
      return name if !name.empty?
    end
  end
  nil
end

def inject_project_attribute!(spec, project_name)
  return if project_name.nil? || project_name.empty?
  spec["attributes"] ||= {}
  # Don't overwrite an explicitly authored project attribute
  return if spec["attributes"].is_a?(Hash) && spec["attributes"]["project"].is_a?(Hash) && spec["attributes"]["project"]["name"]
  spec["attributes"]["project"] = { "name" => project_name }
end

# --- Argument Parsing ---

def parse_option_value(args, flag)
  value = args.shift
  Util.exit_with_error("#{flag} requires a value") if value.nil?
  value
end

def parse_global_args(argv)
  profile = nil
  remaining = []
  args = argv.dup

  while arg = args.shift
    case arg
    when "--profile"
      profile = parse_option_value(args, "--profile")
    when "-h", "--help"
      puts USAGE
      exit 0
    else
      remaining << arg
    end
  end

  { profile: profile, remaining: remaining }
end

def parse_batch_args(remaining)
  apps = []
  group = nil

  args = remaining.dup
  while arg = args.shift
    case arg
    when "--app"
      app = parse_option_value(args, "--app")
      apps << app unless apps.include?(app)
    when "--group"
      group = parse_option_value(args, "--group")
    when "publish"
      # The command keyword itself, when --app/--group precede it (e.g. `api --app X publish`).
      next
    when "upload", "codegen"
      Util.exit_with_error(
        "The '#{arg}' operation is gone: plain `api` now runs hermetic codegen (your local " \
        "specs ride along with the batch; nothing is published), and `api publish` uploads " \
        "from a clean main checkout. See `api --help`."
      )
    else
      Util.exit_with_error("Unknown argument: #{arg}\n\n#{USAGE}")
    end
  end

  { apps: apps.empty? ? nil : apps, group: group }
end

def parse_init_args(remaining)
  languages = []
  args = remaining.dup

  while arg = args.shift
    case arg
    when "--language"
      lang = parse_option_value(args, "--language").downcase
      if !VALID_LANGUAGES.include?(lang)
        Util.exit_with_error("Unknown language: #{lang}\nValid languages: #{VALID_LANGUAGES.join(', ')}")
      end
      languages << lang unless languages.include?(lang)
    else
      Util.exit_with_error("Unknown argument: #{arg}\nUsage: api init [--profile PROFILE] [--language typescript] [--language scala]")
    end
  end

  languages
end

# --- Init Command ---

# Per-language starter Pkl applications block. First provided language wins.
LANGUAGE_STARTERS = {
  "typescript" => <<~PKL,
    applications = new Listing<AppGroup> {
      new {
        names { "my-api" }
        generators = module.singleGenerator("typescript", "./src/generated")
      }
    }
  PKL
  "scala" => <<~PKL,
    applications = new Listing<AppGroup> {
      new {
        names { "my-api" }
        generators = module.full("conf")
      }
    }
  PKL
}.freeze

def run_init(profile, languages)
  api_uri = ApibuilderClient.read_config_value(profile, "api_uri") || ApibuilderClient::DEFAULT_API_URI

  client = ApibuilderClient.new(profile, allow_no_token: true)
  result = client.anonymous_init
  org_key = result["organization_key"] or Util.exit_with_error("Server response missing organization_key")
  token = result["token"] or Util.exit_with_error("Server response missing token")

  entries = profile ? { "api_uri" => api_uri, "token" => token } : { "token" => token }
  if !ApibuilderClient.write_config_section(profile, entries)
    exit 0
  end

  profile_name = profile || "default"
  puts "==> Anonymous org created: #{org_key}"
  puts "==> Token written to #{ApibuilderClient::CONFIG_PATH} [#{profile_name}]"

  write_local_config(org_key, languages) if languages.any?
end

# Writes a starter `.api/config.pkl` for the first provided language.
# Multi-language starters aren't supported — the user picks one to begin and
# edits the file afterward if they need more.
def write_local_config(org_key, languages)
  local_config_dir = File.join(Dir.pwd, ".api")
  local_config_path = File.join(local_config_dir, "config.pkl")

  if File.exist?(local_config_path)
    Util.exit_with_error(".api/config.pkl already exists. Delete it first to reinitialize.")
  end

  language = languages.first
  starter = LANGUAGE_STARTERS.fetch(language) do
    Util.exit_with_error("Unknown language for init: #{language}")
  end

  devops_path = File.expand_path(File.join(File.dirname(__FILE__), "..", "api", "ApiConfig.pkl"))
  relative_path = Pathname.new(devops_path).relative_path_from(Pathname.new(local_config_dir)).to_s

  content = <<~PKL
    amends "#{relative_path}"

    org = "#{org_key}"

    #{starter.strip}
  PKL

  FileUtils.mkdir_p(local_config_dir)
  tmp_path = "#{local_config_path}.tmp"
  IO.write(tmp_path, content)
  File.rename(tmp_path, local_config_path)
  puts "==> .api/config.pkl created for #{language}"

  if languages.size > 1
    puts "NOTE: Only the #{language} starter was written. Edit the file to add additional generators."
  end
end

# --- Result Command ---

RESULT_GENERATOR_KEY = "play_api_result"

def parse_result_args(remaining)
  dry_run = false
  args = remaining.dup
  while arg = args.shift
    case arg
    when "--dry-run"
      dry_run = true
    else
      Util.exit_with_error("Unknown argument: #{arg}\nUsage: api [--profile PROFILE] result [--dry-run]")
    end
  end
  { dry_run: dry_run }
end

# Collects every (org, app_key) pair from blocks that bind `play_controller`.
# Only those specs participate in ApiResult derivation — third-party clients
# (clientOnly), model-only specs, and DAO spec_glob blocks are excluded.
# Hermetic: each ref carries its working-tree spec as `original` when the file
# exists here (or in a sibling repo), so ApiResult derivation sees the same specs
# the codegen batch does — not the registry's copy.
def collect_result_applications(config, project_root, sibling_specs)
  apps = []
  seen = {}
  config.blocks.each do |block|
    next unless block.generators.any? { |g| g.key == "play_controller" }
    block.applications.each do |app|
      key = [block.org, app.key]
      next if seen[key]
      seen[key] = true
      entry = { "organization_key" => block.org, "application_key" => app.key }
      file_path = File.join(project_root, app.file_path)
      if File.exist?(file_path)
        entry["original"] = read_payload({ path: file_path, root: project_root })
      elsif source = sibling_specs[key]
        entry["original"] = read_payload(source)
      end
      apps << entry
    end
  end
  apps
end

# Stub-friendly wrapper: posts to the multi-spec invocation endpoint.
# Returns the parsed JSON body on success. On 422 prints validation errors and
# exits non-zero. On other errors prints the response body and exits non-zero.
def post_multi_spec_invocation(client, generator_key, body)
  path = "/apibuilder/generators/#{generator_key}/multi-spec-invocations"
  response = client.raw_request(:post, path, body)
  code = response.code.to_i
  case code
  when 200, 201
    JSON.parse(response.body)
  when 422
    errors = begin
               JSON.parse(response.body)
             rescue JSON::ParserError
               [{ "message" => response.body }]
             end
    $stderr.puts "==> Validation errors:"
    errors.each do |e|
      code = e["code"]
      msg = e["message"] || e.to_s
      $stderr.puts(code ? "  - [#{code}] #{msg}" : "  - #{msg}")
    end
    exit 1
  else
    $stderr.puts "==> POST #{path} failed with HTTP #{code}"
    $stderr.puts response.body
    exit 1
  end
end

def write_result_files(files, project_root, default_target)
  written = 0
  (files || []).each do |file|
    name = file["name"] or Util.exit_with_error("Server response file missing 'name'")
    contents = file["contents"] || ""
    dir = file["dir"]
    dir = default_target if dir.nil? || dir.empty?
    dir ||= ""
    dest_dir = File.join(project_root, dir)
    FileUtils.mkdir_p(dest_dir)
    dest_path = File.join(dest_dir, name)
    canonical_root = File.realpath(project_root)
    canonical_dest = File.expand_path(dest_path)
    unless canonical_dest.start_with?(canonical_root + File::SEPARATOR) || canonical_dest == canonical_root
      Util.exit_with_error("Refusing to write outside project root: #{dest_path}")
    end
    IO.write(dest_path, contents)
    puts "  wrote #{dest_path}"
    written += 1
  end
  puts ""
  puts "  #{written} file(s) written"
end

# Picks the canonical "generated Scala source" target for this repo by inspecting
# the targets bound to bryzek_play_model / bryzek_play_client / their mocks across
# every block in .api/config.pkl. Returns the most common target, or nil if no
# such generators are bound. ApiResult.scala lands in the same place as the rest
# of the generated apibuilder Scala output.
SCALA_SOURCE_GENERATORS = %w[
  bryzek_play_model
  bryzek_play_client
  bryzek_play_mock_model
  bryzek_play_mock_client
].freeze

def default_scala_source_target(config)
  counts = Hash.new(0)
  config.blocks.each do |block|
    block.generators.each do |g|
      next unless SCALA_SOURCE_GENERATORS.include?(g.key)
      next if g.target.nil? || g.target.empty?
      counts[g.target] += 1
    end
  end
  return nil if counts.empty?
  counts.max_by { |_target, n| n }.first
end

def run_result(profile, dry_run)
  config_path = File.join(Dir.pwd, ".api", "config.pkl")
  Util.exit_with_error("Config file not found: #{config_path}") unless File.exist?(config_path)
  config = ApiConfig.new(config_path)

  sibling_specs = sibling_spec_paths(Dir.pwd)
  applications = collect_result_applications(config, Dir.pwd, sibling_specs)
  if applications.empty?
    Util.exit_with_error("No applications in #{config_path} bind the play_controller generator")
  end

  default_target = default_scala_source_target(config)

  # Imports of the payload specs that this session may also have edited ride along as
  # context: they participate in import resolution but are not passed to the generator.
  available = sibling_specs.merge(local_spec_paths(config, Dir.pwd))
  context = payload_context_entries(applications, available)

  body = { "applications" => applications }
  body["context"] = context if context.any?

  if dry_run
    puts "==> DRY RUN — POST /apibuilder/generators/#{RESULT_GENERATOR_KEY}/multi-spec-invocations"
    puts JSON.pretty_generate(body)
    puts "==> #{applications.size} application(s)"
    puts "==> default target: #{default_target || '(none — file will land at server-specified dir or repo root)'}"
    return
  end

  client = ApibuilderClient.new(profile)
  puts "==> Submitting #{applications.size} application(s) to #{RESULT_GENERATOR_KEY}"
  result = post_multi_spec_invocation(client, RESULT_GENERATOR_KEY, body)
  write_result_files(result["files"], Dir.pwd, default_target)
end

# --- Publish Command ---

# The ONLY path that writes the registry. Guarded so `latest` always comes from
# merged main: a clean checkout of main whose HEAD is contained in origin/main
# (fetched fresh). Dev work never needs this — plain `api` is hermetic — so the
# guard has no escape hatch; if you hit it, merge first or fix your checkout.
#
# Containment, not equality: `release` publishes at the END of the deploy, so the
# commit it released is routinely several minutes behind origin/main by then —
# any PR merged during the deploy moves the tip. Demanding HEAD == origin/main
# failed those releases (platform 0.18.74) for a race that has nothing to do with
# what was deployed. Publishing the released commit's specs is the correct
# outcome: `latest` means "the specs of the API running in prod", and the PR that
# merged mid-deploy publishes its own specs when IT releases.
def ensure_publishable!(root)
  branch, status = Open3.capture2("git", "-C", root, "rev-parse", "--abbrev-ref", "HEAD")
  Util.exit_with_error("api publish: not a git repository: #{root}") unless status.success?
  branch = branch.strip
  if branch != "main"
    Util.exit_with_error(
      "api publish must run from main (current branch: #{branch}).\n" \
      "Dev codegen never publishes — plain `api` sends your working-tree specs with the batch."
    )
  end

  dirty, _ = Open3.capture2("git", "-C", root, "status", "--porcelain")
  if !dirty.strip.empty?
    Util.exit_with_error("api publish requires a clean working tree:\n#{dirty}")
  end

  _, fetch_status = Open3.capture2("git", "-C", root, "fetch", "origin", "main")
  Util.exit_with_error("api publish: git fetch origin main failed") unless fetch_status.success?

  local, _ = Open3.capture2("git", "-C", root, "rev-parse", "HEAD")
  remote, _ = Open3.capture2("git", "-C", root, "rev-parse", "origin/main")
  _, merged_status = Open3.capture2("git", "-C", root, "merge-base", "--is-ancestor", local.strip, remote.strip)
  if !merged_status.success?
    Util.exit_with_error(
      "api publish requires HEAD to be merged into origin/main " \
      "(local #{local.strip[0, 8]}, origin #{remote.strip[0, 8]}).\n" \
      "Push (or merge) main first so the registry only ever reflects merged code."
    )
  end
end

def run_publish(profile, app_filter, group_filter)
  ensure_publishable!(Dir.pwd)
  run_batch(profile, ["upload", "codegen"], app_filter, group_filter)
end

# --- Validate Command ---

def run_validate(profile, file_path)
  Util.exit_with_error("Usage: api validate <file>") if file_path.nil?
  Util.exit_with_error("File not found: #{file_path}") unless File.exist?(file_path)

  spec = begin
           JSON.parse(IO.read(file_path))
         rescue JSON::ParserError => e
           Util.exit_with_error("Invalid JSON in #{file_path}: #{e.message}")
         end

  inject_project_attribute!(spec, read_project_from_build_sbt)

  client = ApibuilderClient.new(profile)
  batch_client = ApiBatchClient.new(client)

  org = spec["organization"]&.[]("key") || "tmp"
  app = spec["application"]&.[]("key") || File.basename(file_path, ".json")

  # A codegen batch with a payload and no generators is pure hermetic validation:
  # the server parses and validates the spec (imports resolve from the registry),
  # generates nothing, and persists nothing. The old form here was an `upload`
  # batch, which published a version — and moved `latest` — just to validate.
  form = {
    "operations" => ["codegen"],
    "applications" => [
      {
        "organization_key" => org,
        "application_key"  => app,
        "original"         => spec,
      }
    ],
  }

  begin
    batch = batch_client.create_batch(org, form)
    result = batch_client.poll_until_complete(org, batch["id"])

    case result["status"]
    when "done"
      puts "==> #{file_path}: valid"
      exit 0
    when "error"
      errors = result["errors"] || []
      $stderr.puts "==> #{file_path}: validation failed"
      errors.each { |e| $stderr.puts "  - #{e["message"]}" }
      exit 1
    else
      Util.exit_with_error("Unexpected batch status '#{result["status"]}' for #{file_path}")
    end
  rescue ApibuilderClient::Error => e
    $stderr.puts "==> #{file_path}: validation failed"
    $stderr.puts "  #{e.message}"
    exit 1
  end
end

# --- Lint Command ---

def parse_lint_args(remaining)
  file_path = nil
  apps = []
  group = nil
  args = remaining.dup
  while arg = args.shift
    case arg
    when "lint"
      # The command keyword itself, when --app/--group precede it (e.g. `api --app X lint`).
      next
    when "--app"
      apps << (args.shift || Util.exit_with_error("--app requires a value"))
    when "--group"
      group = args.shift || Util.exit_with_error("--group requires a value")
    else
      if arg.start_with?("--")
        Util.exit_with_error("Unknown argument: #{arg}\nUsage: api lint [<file>] [--app APP ...] [--group GROUP]")
      elsif file_path
        Util.exit_with_error("api lint accepts at most one <file> (omit it to lint every spec)")
      else
        file_path = arg
      end
    end
  end
  { file_path: file_path, apps: apps, group: group }
end

# Lints every spec referenced in .api/config.pkl (or just <file>) by submitting a
# `lint` batch per organization and reading back batch.lint_results, then rewrites each
# spec in place with its unused imports removed. Exits non-zero if anything was removed
# or a spec failed to parse.
def run_lint(profile, file_path, apps_filter:, group_filter:)
  config_path = File.join(Dir.pwd, ".api", "config.pkl")
  Util.exit_with_error("No .api/config.pkl found in #{Dir.pwd}") unless File.exist?(config_path)
  if file_path
    Util.exit_with_error("File not found: #{file_path}") unless File.exist?(file_path)
  end
  config = ApiConfig.new(config_path)
  validate_filters(config, apps_filter.empty? ? nil : apps_filter, group_filter)

  client = ApibuilderClient.new(profile)
  batch_client = ApiBatchClient.new(client)

  removed_any = false
  had_error = false
  linted = 0

  config.orgs.each do |org|
    blocks = config.blocks_for_org(org)
    blocks = blocks.select { |b| b.group == group_filter } if group_filter
    apps = blocks.flat_map(&:applications).select { |a| File.exist?(a.file_path) }
    apps = apps.select { |a| apps_filter.include?(a.key) } unless apps_filter.empty?
    apps = apps.select { |a| File.expand_path(a.file_path) == File.expand_path(file_path) } if file_path
    apps = apps.uniq(&:file_path)
    next if apps.empty?

    path_by_app = apps.map { |a| [a.key, a.file_path] }.to_h
    applications = apps.map do |a|
      { "organization_key" => org, "application_key" => a.key, "original" => JSON.parse(IO.read(a.file_path)) }
    end

    batch = batch_client.create_batch(org, { "operations" => ["lint"], "applications" => applications })
    result = batch_client.poll_until_complete(org, batch["id"])
    linted += apps.size

    case result["status"]
    when "done"
      (result["lint_results"] || []).each do |r|
        path = path_by_app[r["application_key"]] || r["application_key"]
        unused = r["unused_imports"] || []
        if unused.empty?
          puts "==> #{lint_rel(path)}: clean"
        else
          removed_any = true
          lint_remove_unused_imports(path, unused)
          puts "==> #{lint_rel(path)}: removed #{unused.size} unused import#{'s' unless unused.size == 1}"
          unused.each { |u| puts "      #{u["namespace"]} (#{u["application"]})" }
        end
      end
    when "error"
      had_error = true
      (result["errors"] || []).each do |e|
        label = e["application_key"] || org
        $stderr.puts "==> #{label}: #{e["message"]}"
      end
    else
      Util.exit_with_error("Unexpected batch status '#{result["status"]}' for org #{org}")
    end
  end

  Util.exit_with_error("No spec files found to lint") if linted.zero?

  puts "==> removed unused imports — review and commit the changes (git diff)" if removed_any
  # Non-zero when anything was removed (so CI gates / the change gets committed) or a spec failed to parse.
  exit(had_error || removed_any ? 1 : 0)
end

def lint_rel(path)
  prefix = "#{Dir.pwd}/"
  path.start_with?(prefix) ? path[prefix.length..] : path
end

# Removes the given unused imports (matched by the app segment of each import URI)
# from a spec file in place. Drops the "imports" key entirely if it becomes empty.
def lint_remove_unused_imports(path, unused)
  spec = JSON.parse(IO.read(path))
  return unless spec["imports"].is_a?(Array)

  unused_apps = unused.map { |u| u["application"] }
  kept = spec["imports"].reject do |imp|
    uri = imp["uri"]
    next false unless uri.is_a?(String)
    md = uri.match(%r{/([^/]+)/([^/]+)/([^/]+)/service\.json\z})
    md && unused_apps.include?(md[2])
  end

  if kept.empty?
    spec.delete("imports")
  else
    spec["imports"] = kept
  end
  File.write(path, JSON.pretty_generate(spec) + "\n")
end

# --- Hermetic payload gathering ---
#
# Dev codegen is hermetic: every spec the session has locally rides along with the
# batch as an `original` payload, and the server validates + generates from exactly
# that set (imports resolve payload-first, registry fallback). Three payload sources,
# in precedence order:
#   1. this repo's own spec files (from .api/config.pkl)
#   2. sibling repos in the same ~/code/ai/<feature>/ working dir (their .api configs)
#   3. the registry — which, since only `api publish` writes it, means "merged main"

IMPORT_URI_RE = %r{/([^/]+)/([^/]+)/[^/]+/service\.json\z}

def parse_import_key(uri)
  md = uri.to_s.match(IMPORT_URI_RE)
  md ? [md[1], md[2]] : nil
end

# Scans sibling repos in the same ~/code/ai/<feature>/ dir for spec files. Returns
# {[org, app_key] => { path:, root: }}. Empty outside a feature dir (e.g. running
# directly in ~/code/<repo>), where the registry fallback — merged main — is correct.
# A sibling whose config fails to evaluate is skipped with a warning rather than
# failing the run: its specs simply fall back to the registry.
def sibling_spec_paths(project_root)
  root = File.realpath(project_root)
  feature_dir = File.dirname(root)
  return {} unless File.basename(File.dirname(feature_dir)) == "ai"

  paths = {}
  Dir.glob(File.join(feature_dir, "*", ".api", "config.pkl")).sort.each do |cfg_path|
    repo_dir = File.dirname(File.dirname(cfg_path))
    next if File.realpath(repo_dir) == root
    begin
      config = ApiConfig.new(cfg_path, base_dir: repo_dir)
      config.blocks.each do |block|
        block.applications.each do |app|
          fp = File.join(repo_dir, app.file_path)
          paths[[block.org, app.key]] ||= { path: fp, root: repo_dir } if File.exist?(fp)
        end
      end
    rescue SystemExit, StandardError => e
      Util.warning("Skipping sibling #{repo_dir}: #{e.message}")
    end
  end
  paths
end

def read_payload(source)
  original = JSON.parse(IO.read(source[:path]))
  # Prefer the producing repo's build.sbt for the project attribute; fall back to the
  # invoking repo's (the pre-hermetic behavior for nested roots without their own).
  project = read_project_from_build_sbt(source[:root]) || read_project_from_build_sbt
  inject_project_attribute!(original, project)
  original
end

# Payload sources for THIS repo's own specs (all apps in the config, ignoring
# --app/--group filters: a filtered-out app can still be needed as import context).
def local_spec_paths(config, project_root)
  paths = {}
  config.blocks.each do |block|
    block.applications.each do |app|
      fp = File.join(project_root, app.file_path)
      paths[[block.org, app.key]] ||= { path: fp, root: project_root } if File.exist?(fp)
    end
  end
  paths
end

# Closes the payload set under imports: for every import of every payload already in
# `applications`, if the imported spec is available locally or in a sibling and not
# already present, returns a payload-only entry (original, no generators) so the
# server can resolve the import from the session's working tree instead of the
# registry. Transitive. Specs with no local payload fall back to the registry (main).
def payload_context_entries(applications, available)
  present = {}
  applications.each { |a| present[[a["organization_key"], a["application_key"]]] = true }

  extras = []
  queue = applications.filter_map { |a| a["original"] }
  until queue.empty?
    spec = queue.shift
    (spec["imports"] || []).each do |imp|
      key = parse_import_key(imp["uri"]) or next
      next if present[key]
      present[key] = true
      source = available[key] or next
      original = read_payload(source)
      extras << { "organization_key" => key[0], "application_key" => key[1], "original" => original }
      queue << original
    end
  end
  extras
end

# --- Batch Operations ---

def build_batch_form(config, org, operations, app_filter, group_filter, project_root, sibling_specs)
  blocks = config.blocks_for_org(org)
  blocks = blocks.select { |b| b.group == group_filter } if group_filter

  app_data = {}  # application_key => { file_path:, generators: [] }

  blocks.each do |block|
    block.applications.each do |app|
      next if app_filter && !app_filter.include?(app.key)

      app_data[app.key] ||= { file_path: app.file_path, generators: [] }

      block.generators.each do |gen|
        batch_gen = { "generator_key" => gen.key }
        batch_gen["attributes"] = block.attributes if !block.attributes.empty?
        app_data[app.key][:generators] << batch_gen
      end
    end
  end

  applications = app_data.map do |app_key, data|
    entry = { "organization_key" => org, "application_key" => app_key }

    if operations.include?("upload")
      # Publish: the spec file must exist here. Relative to the config's own root,
      # which is the repo root for the repo's own config and the nested directory
      # for a nested one.
      file_path = File.join(project_root, data[:file_path])
      if !File.exist?(file_path)
        Util.exit_with_error("Application file not found: #{file_path} (for #{app_key})")
      end
      original = JSON.parse(IO.read(file_path))
      inject_project_attribute!(original, read_project_from_build_sbt)
      entry["original"] = original
    else
      # Hermetic codegen: attach the working-tree spec when we have it (this repo
      # first, then siblings). Absent both, the app resolves from the registry —
      # merged main — which is the right baseline for specs this session left alone.
      file_path = File.join(project_root, data[:file_path])
      if File.exist?(file_path)
        entry["original"] = read_payload({ path: file_path, root: project_root })
      elsif source = sibling_specs[[org, app_key]]
        entry["original"] = read_payload(source)
      end
    end

    if operations.include?("codegen")
      entry["generators"] = data[:generators]
    end

    entry
  end

  if !operations.include?("upload")
    available = sibling_specs.merge(local_spec_paths(config, project_root))
    applications += payload_context_entries(applications, available)
  end

  {
    "operations" => operations,
    "applications" => applications,
  }
end

def extract_zip(zip_data, config, project_root)
  require 'tmpdir'

  written = 0
  unchanged = 0

  Dir.mktmpdir("api-batch") do |tmp_dir|
    zip_path = File.join(tmp_dir, "batch.zip")
    IO.binwrite(zip_path, zip_data)

    extract_dir = File.join(tmp_dir, "extracted")
    system("unzip", "-q", zip_path, "-d", extract_dir) || Util.exit_with_error("Failed to unzip #{zip_path}")

    Dir.glob("#{extract_dir}/**/*").each do |full_path|
      next if File.directory?(full_path)

      relative = full_path.sub("#{extract_dir}/", "")
      parts = relative.split("/")
      # Structure: <org_key>/<application_key>/<generator_key>/<files...>
      if parts.length < 4
        Util.warning("Unexpected zip entry: #{relative}")
        next
      end

      _org_key = parts[0]
      application_key = parts[1]
      generator_key = parts[2]
      relative_file = parts[3..].join("/")

      target = config.find_target(application_key, generator_key)
      if target.nil?
        Util.warning("No target found for #{application_key}/#{generator_key}, skipping #{relative}")
        next
      end

      dest_path = File.join(project_root, target, relative_file)
      new_content = IO.read(full_path)

      if File.exist?(dest_path) && !meaningful_change?(new_content, IO.read(dest_path))
        unchanged += 1
      else
        FileUtils.mkdir_p(File.dirname(dest_path))
        IO.binwrite(dest_path, new_content)
        puts "  wrote #{dest_path}"
        written += 1
      end
    end
  end

  puts ""
  puts "  #{written} written, #{unchanged} unchanged"
end

IGNORE_PATTERNS = [
  /^\s*[\*#]\s*Service version:/,
  /^\s*[\*#]\s*User agent:/,
  /^\s*[\*#]\s*apibuilder app/,
].freeze

def meaningful_change?(new_content, existing_content)
  strip_metadata(new_content) != strip_metadata(existing_content)
end

def strip_metadata(content)
  content.each_line.reject { |line| IGNORE_PATTERNS.any? { |p| p.match?(line) } }.join.rstrip
end

# Validates --app/--group against the union of every root, so `--app <key>` that
# lives only in a nested root is accepted; a root the filter matches nothing in
# simply contributes no applications and is skipped.
def validate_filters(configs, app_filter, group_filter)
  all_blocks = Array(configs).flat_map(&:blocks)
  if group_filter
    all_groups = all_blocks.map(&:group).compact.uniq
    if !all_groups.include?(group_filter)
      Util.exit_with_error("Unknown group: #{group_filter}\n  Available: #{all_groups.sort.join(', ')}")
    end
  end

  if app_filter
    filtered_blocks = group_filter ? all_blocks.select { |b| b.group == group_filter } : all_blocks
    all_app_keys = filtered_blocks.flat_map { |b| b.applications.map(&:key) }.uniq
    missing = app_filter.select { |a| !all_app_keys.include?(a) }
    if missing.any?
      Util.exit_with_error("Unknown app(s): #{missing.join(', ')}\n  Available: #{all_app_keys.sort.join(', ')}")
    end
  end
end

# Every codegen root this invocation owns: the repo's own `.api/config.pkl`,
# then each directory its `nestedConfigs` lists. A nested root is processed with
# ITS config and ITS directory as the output root, exactly as running `api` there
# would - which is the point: one command at the repo root leaves no root behind.
# Not recursive, so the repo root remains the single place that names the roots.
def resolve_config_roots(root_dir)
  root_config = ApiConfig.new(File.join(root_dir, ".api", "config.pkl"), base_dir: root_dir)
  roots = [[root_config, root_dir]]

  root_config.nested_configs.each do |rel|
    dir = File.expand_path(rel, root_dir)
    path = File.join(dir, ".api", "config.pkl")
    if !File.exist?(path)
      Util.exit_with_error("nestedConfigs lists '#{rel}' but #{path} does not exist")
    end
    roots << [ApiConfig.new(path, base_dir: dir), dir]
  end

  roots
end

def run_batch(profile, operations, app_filter, group_filter)
  roots = resolve_config_roots(Dir.pwd)
  if roots.size > 1
    puts "==> #{roots.size} codegen roots: #{roots.map { |_, dir| dir == Dir.pwd ? "." : Pathname.new(dir).relative_path_from(Pathname.new(Dir.pwd)).to_s }.join(', ')}"
  end

  validate_filters(roots.map { |config, _| config }, app_filter, group_filter)

  sibling_specs = operations.include?("upload") ? {} : sibling_spec_paths(Dir.pwd)
  roots.each do |config, project_root|
    run_batch_for_config(profile, operations.dup, app_filter, group_filter, config, project_root, sibling_specs)
  end
end

def run_batch_for_config(profile, operations, app_filter, group_filter, config, project_root, sibling_specs)
  if operations.empty?
    operations = ["codegen"]
    puts "==> Hermetic codegen (working-tree specs ride along; nothing is published)"
  end

  client = ApibuilderClient.new(profile)
  batch_client = ApiBatchClient.new(client)

  num_orgs = config.orgs.size
  puts "==> Processing #{num_orgs} #{num_orgs == 1 ? 'organization' : 'organizations'}"

  config.orgs.each do |org|
    puts "==> Building batch for #{org}"
    form = build_batch_form(config, org, operations, app_filter, group_filter, project_root, sibling_specs)
    next if form["applications"].empty?

    num_apps = form["applications"].size
    puts "==> Submitting batch to #{org} (#{num_apps} #{num_apps == 1 ? 'application' : 'applications'}, operations: #{operations.join(', ')})"
    batch = batch_client.create_batch(org, form)
    batch_id = batch["id"]
    puts "==> Batch #{batch_id} created, polling for processing to begin..."

    result = batch_client.poll_until_complete(org, batch_id)

    case result["status"]
    when "error"
      $stderr.puts ""
      $stderr.puts "=" * 60
      errors = result["errors"] || []
      $stderr.puts "Batch failed with #{errors.size} error(s):"
      errors.each do |err|
        parts = [err["application_key"], err["generator_key"]].compact.join("/")
        $stderr.puts "  - #{parts}: #{err["message"]}"
      end
      $stderr.puts "=" * 60
      exit 1
    when "done"
      puts "==> Batch #{batch_id} completed"

      if operations.include?("codegen") && result["zip_file"].nil?
        $stderr.puts "WARNING: Batch completed but no zip_file in response. Full result: #{JSON.generate(result.reject { |k,_| k == "applications" })}"
      end

      if operations.include?("codegen") && result["zip_file"]
        zip_url = result["zip_file"]["url"]
        puts "==> Downloading generated code..."
        zip_data = batch_client.download_zip(zip_url)
        if zip_data.nil?
          Util.exit_with_error("Batch completed but zip has expired. Please re-run.")
        end
        puts "==> Extracting files..."
        extract_zip(zip_data, config, project_root)
      end
    end
  end
end

# --- Main ---

if __FILE__ == $PROGRAM_NAME
  start_time = Process.clock_gettime(Process::CLOCK_MONOTONIC)

  global = parse_global_args(ARGV)
  profile = global[:profile]
  remaining = global[:remaining]

  # `lint` and `publish` accept --app/--group, which may precede the command keyword
  # (e.g. `api --app db-playbook lint`), so route on their presence anywhere.
  if remaining.include?("lint")
    parsed = parse_lint_args(remaining)
    run_lint(profile, parsed[:file_path], apps_filter: parsed[:apps], group_filter: parsed[:group])
  elsif remaining.include?("publish")
    parsed = parse_batch_args(remaining)
    run_publish(profile, parsed[:apps], parsed[:group])
  else
    case remaining.first
    when "init"
      languages = parse_init_args(remaining[1..])
      run_init(profile, languages)
    when "validate"
      run_validate(profile, remaining[1])
    when "result"
      parsed = parse_result_args(remaining[1..])
      run_result(profile, parsed[:dry_run])
    else
      parsed = parse_batch_args(remaining)
      run_batch(profile, [], parsed[:apps], parsed[:group])
    end
  end

  elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - start_time
  puts "==> Done (#{format('%.1f', elapsed)} seconds)"
end
