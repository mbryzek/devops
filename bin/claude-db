#!/usr/bin/env ruby
# claude-db — per-Claude-session isolated Postgres database lifecycle manager
#
# Each Claude Code session gets its own database, cloned from an app's
# <database>_template, so parallel sessions can develop against the same schema
# without interfering with each other. Every Scala project with a schema repo
# works the same way — `--app platform`, `--app acumen`, ...
#
# ONE CONTAINER PER APP PER SCHEMA TAG, ONE PORT PER CONTAINER. The container is
# <database>-claude-<schema-tag> and its host port is allocated from the history
# file at ~/code/ai/.claude-db-ports.json — there is no fixed :5433 any more.
# Never hardcode a port: use the CONF_DB_DEV_URL `start` handed you.
#
# `start` NEVER removes a container it did not just decide to create. Adopting a
# new schema tag creates a NEW container beside the existing ones. The old
# behaviour — one shared container, torn down and recreated whenever the image
# moved — destroyed every other session's database, not just the caller's (one
# `claude-db start` was measured wiping four other sessions' databases).
#
# Usage:
#   claude-db next-port    Print a free host port to pass to `start`.
#
#   claude-db start --app APP [--port N]
#                      Boot the container for that app's current schema tag if
#                      needed and create this session's DB. --port is REQUIRED
#                      only when that container does not exist yet; when it does,
#                      its port is reused and re-running without --port works.
#                      Prints: CONF_DB_DEV_URL=jdbc:postgresql://localhost:<port>/<db>
#
#   claude-db sync --app APP [--repo-dir DIR]
#                      Apply the migrations this session's DB is missing. `start`
#                      does this for you; run it again after rebasing onto a main
#                      that carries schema changes, or after adding a script on
#                      this branch.
#
# THE TEMPLATE IS ALWAYS BEHIND MAIN. The image tag is the latest RELEASED schema
# tag, so every script merged since that release is missing from a brand-new
# session database, and `end` + `start` re-clones the same stale template. The
# resulting failures read as code defects, not as a stale database — a missing
# relation, or a not-null violation on a column main already dropped. That cost
# two hours on 2026-08-03 (ISS-276). `sync` is why they no longer happen.
#
# AND SO IS THE CHECKOUT SYNC READS. `sync` matches the database to a checkout,
# so a checkout behind main leaves the database behind main by exactly the
# scripts it has not pulled — the same wall of red, one level up. Two things
# close that gap. A caller with no checkout of their own gets one this tooling
# owns and pins to origin/main (SchemaMirror), instead of ~/code/<app>-postgresql
# which no session may write to and therefore no session can pull. A caller whose
# OWN checkout is missing migrations main has is refused rather than warned: a
# warning followed by a working-looking CONF_DB_DEV_URL is a warning that gets
# scrolled past (ISS-545).
#
#   claude-db end [--app APP]
#                      Drop this session's database, from whichever container
#                      holds it. Without --app, every app is checked.
#
#   claude-db status [--app APP]
#                      Show every claude container — app, schema tag, port, and
#                      the session databases inside it.
#
#   claude-db gc [--app APP] [--days N] [--apply]
#                      Drop session databases older than N days (default 3),
#                      then remove containers left holding none and
#                      release their ports. Dry-run unless --apply. Keeps any
#                      database with a live connection, and this session's own.
#                      Age, not "nobody is connected right now", is what makes
#                      this safe to run while other sessions are working — see
#                      DEFAULT_GC_DAYS.
#
# --app is required only for `start`: creating a database means choosing which
# app's schema it holds, and there is no safe default. The read-only and
# reclaiming commands default to every app, so a single `end` cleans up after a
# session that used more than one.
#
# Environment:
#   CLAUDE_SESSION_ID  Session identifier set automatically by Claude Code.
#                      Two concurrent sessions must have different values —
#                      this is what gives each session a distinct database name.
#                      When unset, the ~/code/ai/<feature> directory name is
#                      used; when neither can be determined, claude-db fails
#                      loudly rather than sharing one database across sessions.

DIR = File.dirname(__FILE__)
load File.join(DIR, '../lib/common.rb')

require 'shellwords'

def show_usage
  puts <<~USAGE

    Usage: claude-db <command> [--app APP]

    Commands:
      next-port                    Print a free host port (#{DbPorts::RANGE_MIN}-#{DbPorts::RANGE_MAX}) for `start --port`.

      start --app APP [--port N]   Ensure the <database>-claude-<schema-tag> container
                                   is running and create a per-session database cloned
                                   from <database>_template, then sync it (below).
                                   --port is required only when that container does
                                   not exist yet.
                                   Prints CONF_DB_DEV_URL for the caller to export.

      sync --app APP               Apply the migrations this session's database is
           [--repo-dir DIR]        missing, from the schema repo checkout.  Run after
                                   rebasing onto a main that carries schema changes,
                                   or after adding a script on this branch.
                                   The checkout is the one you are standing in when
                                   that is <app>-postgresql, else a clone of it beside
                                   your feature dir, else a clone this tooling keeps
                                   at origin/main; --repo-dir overrides all three.
                                   Refuses when the checkout it used is itself
                                   missing migrations origin/main has.

      end [--app APP]              Drop this session's database(s).

      status [--app APP]           Show every claude container and its session databases.

      gc [--app APP]               Drop session databases older than --days
         [--days N] [--apply]      (default #{DEFAULT_GC_DAYS}), then remove containers left
                                   holding none.  Keeps anything with a live
                                   connection, and this session's own databases.
                                   Dry-run unless --apply.  Needs no session id,
                                   so it runs from anywhere.

    Apps: #{DbApp.names.join(', ')}   (--app is required for `start`, optional elsewhere)

    Environment:
      CLAUDE_SESSION_ID   Session identifier (auto-set by Claude Code).
                          Falls back to the ~/code/ai/<feature> directory name.

  USAGE
  exit 1
end

# ── next-port ──────────────────────────────────────────────────────────────

def do_next_port
  port = DbPorts.allocate!
  if port.nil?
    Util.exit_with_error(
      "No free port in #{DbPorts::RANGE_MIN}-#{DbPorts::RANGE_MAX}.\n" \
      "Every port in the range is either reserved by a container that still " \
      "exists or bound on this host.\n" \
      "Run `claude-db gc --apply` to reap old session databases and the " \
      "containers left holding none, which releases their ports."
    )
  end
  # Stdout is exactly the port and nothing else — this is meant to be used as
  # `claude-db start --app X --port "$(claude-db next-port)"`.
  puts port
end

# ── start ──────────────────────────────────────────────────────────────────

def do_start(app, requested_port)
  # The image tag IS the schema tag (the recipe hash is gone — see
  # DbImages.image_tag for the regression that accepts and why). It is also what
  # names the container, which is the whole point: a new tag gets a NEW
  # container instead of evicting everyone from the shared one.
  schema_tag = app.current_schema_tag
  image_tag  = DbImages.image_tag(schema_tag)
  container  = app.container_name(schema_tag)

  puts ""
  puts Util.underline("claude-db start  [app: #{app.name}  schema tag: #{schema_tag}  container: #{container}]")
  puts ""

  desired_image = app.image_ref(image_tag)
  port = ensure_container(app, container, desired_image, schema_tag, requested_port)

  # 2. Create this session's database (idempotent).
  sid = DbImages.session_id
  db  = app.session_db_name(sid)
  puts ""
  puts "Session ID : #{sid}"
  puts "Session DB : #{db}"

  if DbImages.database_exists?(port, db)
    puts "Database #{db} already exists — reusing."
  else
    puts ""
    puts "Creating #{db} from template #{app.template_db}..."
    DbImages.psql_exec(
      port,
      "CREATE DATABASE #{db} TEMPLATE #{app.template_db} OWNER #{app.role}"
    )
  end

  # The session DB must be owned by the app role so that migrations applied via
  # `sem-apply` AS that role can issue database-level DDL (CREATE SCHEMA, etc.).
  # Idempotent: succeeds harmlessly when already owned, so it runs on every
  # start (both the create and reuse paths). Quiet to suppress the echo.
  DbImages.psql_exec_quiet(port, "ALTER DATABASE #{db} OWNER TO #{app.role}")

  # 3. Bring it up to the checkout. The template is only ever as current as the
  # last schema RELEASE, so a brand-new session database is normally already
  # behind main — and nothing about that announces itself later. See do_sync.
  puts ""
  do_sync(app)

  # 4. Print the JDBC URL for the caller to export. The port is per container —
  # a caller that hardcodes one is talking to somebody else's database.
  url = "jdbc:postgresql://#{DbImages::HOST}:#{port}/#{db}"
  puts ""
  puts "CONF_DB_DEV_URL=#{url}"
  puts ""
end

# Ensure the container for this app + schema tag is up, and return its host port.
#
# The ONLY container this ever removes is a STOPPED one carrying the same app and
# schema tag — that one holds no live sessions by construction, since a stopped
# container serves nobody. Containers for other tags or other apps, and the
# legacy untagged container, are never touched: they may be holding other
# sessions' databases.
def ensure_container(app, container, desired_image, schema_tag, requested_port)
  if DbImages.container_running?(container)
    port = DbImages.container_port(container)
    Util.exit_with_error(
      "Container #{container} is running but publishes no host port for 5432/tcp. " \
      "Refusing to guess. Stop it (docker stop #{container}) and re-run with --port."
    ) if port.nil?
    puts "Container #{container} already running on :#{port} (#{schema_tag}). Reusing."
    if requested_port && requested_port != port
      puts "NOTE: --port #{requested_port} ignored — the existing container is on :#{port}."
    end
    return port
  end

  if DbImages.container_exists?(container)
    # Stopped container for the SAME tag. Its recorded port binding survives the
    # stop, so re-running with no arguments still works.
    existing_port = DbImages.container_port(container)
    port = requested_port || existing_port
    Util.exit_with_error(
      "Container #{container} exists but is stopped and publishes no host port. " \
      "Re-run with --port \"$(claude-db next-port)\"."
    ) if port.nil?
    puts "Removing stopped container #{container} and recreating it on :#{port}."
    puts "(A stopped container serves no session — nothing is lost.)"
    Util.run("docker rm -f #{Shellwords.shellescape(container)}")
    start_container(app, container, desired_image, schema_tag, port)
    DbPorts.record(
      :port => port, :schema_tag => schema_tag, :container => container,
      :session_id => DbImages.session_id_or_nil.to_s
    )
    return port
  end

  # No container for this tag: a new one, and only now is a port needed.
  if requested_port.nil?
    Util.exit_with_error(
      "No container exists for #{app.name} schema tag #{schema_tag}, so a new one " \
      "must be created — and that needs a host port.\n\n" \
      "  claude-db start --app #{app.name} --port \"$(claude-db next-port)\"\n\n" \
      "`claude-db next-port` picks a free port in " \
      "#{DbPorts::RANGE_MIN}-#{DbPorts::RANGE_MAX} and records it in " \
      "#{DbPorts::HISTORY_PATH}.\n" \
      "Ports are per container now — there is no fixed port to fall back on, " \
      "and guessing one would mean publishing over another session's container."
    )
  end

  start_container(app, container, desired_image, schema_tag, requested_port)
  DbPorts.record(
    :port => requested_port, :schema_tag => schema_tag, :container => container,
    :session_id => DbImages.session_id_or_nil.to_s
  )
  requested_port
end

# Postgres's stock max_connections is 100, sized for one client. A session
# container is shared by every session on a schema tag, and each session's Play
# app alone opens up to hikaricp.maximumPoolSize = 50 — so two concurrent
# sessions can exhaust it and the third gets "sorry, too many clients already",
# which reads as a broken branch rather than as a full container. 300 leaves room
# for four or five. Idle slots cost ~400 bytes each; the real cost is per-backend
# work_mem on active queries, so this is cheap on a dev box.
#
# It belongs on `docker run` (everything after the image name is passed to
# postgres) rather than per container: max_connections is a postmaster GUC, so
# ALTER SYSTEM needs a restart, and a new schema tag builds a new container from
# the image and is back to 100 regardless.
MAX_CONNECTIONS = 300

# Pull (or build+push) the image, then run the container on `port`.
def start_container(app, container, desired_image, schema_tag, port)
  ensure_image(app, desired_image, schema_tag)
  Util.run(
    "docker run -d -p #{port}:5432 --name #{Shellwords.shellescape(container)} " \
      "#{desired_image} -c max_connections=#{MAX_CONNECTIONS}"
  )
  print "Waiting for Postgres on :#{port}..."
  $stdout.flush
  DbImages.wait_for_postgres(port)
  puts " ready."
end

# Ensure the image is available locally, pulling from the registry or
# self-healing via `db-image build --push` if the image does not exist yet.
def ensure_image(app, desired_image, schema_tag)
  if DbImages.image_available_locally?(desired_image)
    puts "Image #{desired_image} found in local cache."
    return
  end

  puts "Image not in local cache — pulling from registry..."
  Util.run("doctl registry login --expiry-seconds 3600", :ignore_error => true)

  if system("docker pull #{Shellwords.shellescape(desired_image)}")
    return
  end

  # Pull failed — image not in registry.  Build and push it now.
  puts ""
  puts "Image not found in registry. Self-healing: building and pushing #{app.name} #{schema_tag}..."
  app.require_repo!
  Util.run(
    "#{File.join(DIR, 'db-image')} build --app #{Shellwords.shellescape(app.name)} " \
    "--tag #{Shellwords.shellescape(schema_tag)} --push"
  )
  puts ""
  puts "Pulling freshly built image..."
  Util.run("docker pull #{desired_image}")
end

# ── sync ───────────────────────────────────────────────────────────────────
#
# Bring this session's database up to the schema repo checkout.
#
# The image tag is the latest RELEASED schema tag, so a freshly cloned session DB
# is already behind main by every script merged since that release — four of them
# on platform the day this was written. Recreating the database does not help:
# `end` + `start` clone the SAME stale template. And a branch that adds its own
# migration is behind by that too.
#
# The delta is applied with sem-apply, not with generated DDL, for three reasons
# that a hand-patched database gets wrong:
#   - ordering and DROPs come out right, because these are the same scripts, in
#     the same order, that production ran;
#   - the objects end up owned by the app role, because sem-apply connects AS
#     that role to a role-owned database (hand-applied DDL runs as postgres, and
#     every table it creates is then permission-denied to the app);
#   - the tracking rows land, so the next sync knows what this one did.
def do_sync(app)
  Util.assert_sem_installed
  Util.assert_installed("sem-apply", "https://github.com/mbryzek/schema-evolution-manager")

  sid = DbImages.session_id
  db  = app.session_db_name(sid)

  holder = app.find_container_with_db(db)
  if holder.nil?
    Util.exit_with_error(
      "No session database #{db} in any running #{app.name} container.\n\n" \
      "  claude-db start --app #{app.name}\n\n" \
      "creates it (and syncs it)."
    )
  end
  container, port = holder

  unless app.sem_tracking?(port, db)
    # Bail rather than treat "no tracking table" as "nothing applied": that
    # reading would replay the entire script history against a full schema.
    Util.exit_with_error(
      "#{db} has no #{DbApp::SEM_SCRIPTS_TABLE} table, so there is no way to tell " \
      "which migrations it already has.\n" \
      "The image bakes SEM tracking in, so this means the database was not cloned " \
      "from #{app.template_db} — or the container is not reachable on :#{port}.\n\n" \
      "Recreate it:  claude-db end --app #{app.name} && claude-db start --app #{app.name}"
    )
  end

  pending = app.pending_scripts(port, db)
  puts "Schema repo : #{app.repo_dir} @ #{app.repo_head}#{app.repo_source == :mirror ? '  (tooling clone, pinned to origin/main)' : ''}"

  # "In sync" only ever means in sync WITH THIS CHECKOUT, so the checkout has to
  # be measured against main before anything here can be called up to date.
  # Fetched now, read after the apply — see assert_matches_origin!.
  fetched = app.repo_fetch_origin

  if pending.empty?
    puts "Schema      : up to date with the checkout (#{app.repo_scripts.length} scripts applied)."
    assert_matches_origin!(app, db, fetched)
    return
  end

  puts ""
  puts "#{pending.length} migration(s) in the checkout that #{db} does not have:"
  pending.each { |f| puts "  #{f}" }
  puts ""

  # 127.0.0.1, not the HOST constant: `localhost` resolves to ::1 first on this
  # box, and sem-apply follows that resolution to a refused connection where
  # plain psql happens to fall back to IPv4.
  url = "postgresql://#{app.role}@127.0.0.1:#{port}/#{db}"
  ok = Dir.chdir(app.repo_dir) { system("sem-apply", "--url", url) }

  unless ok
    Util.exit_with_error(
      "sem-apply failed against #{db}.\n\n" \
      "The database is REAL but INCOMPLETE — it is missing the migrations listed " \
      "above, so a test suite run against it will fail in ways that look like code " \
      "defects (missing relation, not-null violation on a dropped column).\n\n" \
      "Retry after fixing the script, from #{app.repo_dir}:\n" \
      "  sem-apply --url #{url}\n\n" \
      "Or, if the checkout itself is the problem, pass a different one:\n" \
      "  claude-db sync --app #{app.name} --repo-dir <path-to-#{app.name}-postgresql>"
    )
  end

  still = app.pending_scripts(port, db)
  unless still.empty?
    Util.exit_with_error(
      "sem-apply reported success but #{still.length} script(s) are still unrecorded " \
      "in #{db}: #{still.join(', ')}"
    )
  end

  puts ""
  puts "Applied #{pending.length} migration(s) to #{db} in #{container}."
  assert_matches_origin!(app, db, fetched)
end

# Refuse to report success over a database that is provably missing migrations
# main already has.
#
# `sync` matched the database to a CHECKOUT. That closes the first staleness gap
# (template -> checkout) and says nothing about the second one (checkout ->
# main), which looks identical from inside the database and produces exactly the
# same failures: a missing relation, a not-null violation on a column main
# dropped. This used to be a warning, and `start` printed a working-looking
# CONF_DB_DEV_URL underneath it — a warning followed by a URL is a warning that
# gets scrolled past, and the run continues into a wall of red that reads like
# the branch's fault. Eight tests on 2026-08-05, twelve missing migrations
# (ISS-545).
#
# The measure is the SCRIPT list, not the commit count: a checkout twenty
# commits behind on README edits runs a perfectly good suite, while one commit
# behind on a migration does not. Nothing to compare against (no origin, no
# main, offline with refs never fetched) means no refusal — an unknown must
# never become a block.
#
# Nothing here fires for the fallback checkout any more: that one is the
# tooling's own clone, pinned to origin/main before it is used (SchemaMirror).
# What is left is a checkout the CALLER owns and only the caller can move, so
# the remedy is theirs and the message names it.
def assert_matches_origin!(app, db, fetched)
  # The mirror was pinned to origin/main moments ago, so measuring it against
  # origin again buys nothing and can only produce a false alarm: a migration
  # merged DURING this sync would read as drift in a checkout the caller does
  # not own, cannot rebase, and is not responsible for. The next start or sync
  # picks it up. Only checkouts the caller owns are measured, because those are
  # the ones that go stale and stay stale.
  return if app.repo_source == :mirror

  missing = app.missing_scripts_vs_origin
  return if missing.nil? || missing.empty?

  behind = app.repo_behind_origin
  context = behind && behind > 0 ? " (#{fetched ? '' : 'at least '}#{behind} commit(s) behind)" : ""
  Util.exit_with_error(
    "#{db} is synced to #{app.repo_dir}, and THAT CHECKOUT is missing " \
    "#{missing.length} migration(s) that origin/main has#{context}:\n" \
    "#{missing.map { |f| "  #{f}" }.join("\n")}\n\n" \
    "So the database is missing them too. A test suite run against it fails in " \
    "ways that look like code defects rather than like a stale database, which " \
    "is why this stops here instead of warning.\n\n" \
    "Update the checkout, then re-run:\n" \
    "  git -C #{app.repo_dir} fetch origin && git -C #{app.repo_dir} rebase origin/main\n" \
    "  claude-db sync --app #{app.name}\n\n" \
    "Or sync from a checkout that is current:\n" \
    "  claude-db sync --app #{app.name} --repo-dir <path-to-#{app.name}#{DbApp::POSTGRESQL_SUFFIX}>" \
    "#{fetched ? '' : "\n\n(The fetch failed, so this is read from the last one the checkout did — there can be more.)"}"
  )
end

# ── end ────────────────────────────────────────────────────────────────────

def do_end(apps)
  sid = DbImages.session_id
  puts ""
  puts Util.underline("claude-db end")
  puts "Session ID : #{sid}"
  puts ""

  found = false
  apps.each do |app|
    db = app.session_db_name(sid)
    # No state file: session DB names are unique, so the database is found by
    # scanning the containers for it. That is what makes `end` work when the
    # schema tag has moved on since `start` and the database is in an older
    # container — the case a fixed port silently got wrong.
    holders = app.running_containers_with_ports.select { |(_name, port)|
      DbImages.database_exists?(port, db)
    }
    next if holders.empty?

    found = true
    holders.each do |(name, port)|
      puts "Found #{db} in #{name} (:#{port})."
      # Terminate active connections before dropping.
      DbImages.psql_exec_quiet(
        port,
        "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '#{db}'"
      )
      DbImages.psql_exec(port, "DROP DATABASE #{db}")
      puts "Dropped #{db} from #{name}."
    end
  end

  unless found
    puts "No session database for #{sid} in any running claude container — already cleaned up."
  end
  puts ""
end

# ── status ─────────────────────────────────────────────────────────────────

def do_status(apps)
  puts ""
  puts Util.underline("claude-db status")
  puts ""

  # Read-only: report that this session cannot name itself rather than aborting a
  # command whose whole job is to show you the state.
  sid = DbImages.session_id_or_nil

  apps.each do |app|
    current_db = sid ? app.session_db_name(sid) : nil
    containers = app.containers

    puts Util.underline("#{app.name}  (#{app.database})")
    if containers.empty?
      puts "No #{app.container_prefix}* containers."
      puts ""
      next
    end

    containers.each do |name|
      tag     = app.container_schema_tag(name) || "(legacy — pre per-tag split)"
      running = DbImages.container_running?(name)
      port    = DbImages.container_port(name)
      state   = running ? "RUNNING" : "stopped"
      puts "#{name}"
      puts "  state      : #{state}"
      puts "  schema tag : #{tag}"
      puts "  port       : #{port || '(none published)'}"
      puts "  image      : #{DbImages.container_image(name)}"

      if !running || port.nil?
        puts "  databases  : (not reachable while #{running ? 'unpublished' : 'stopped'})"
        puts ""
        next
      end

      dbs    = app.list_session_dbs(port)
      active = app.active_session_dbs(port)
      if dbs.empty?
        puts "  databases  : none"
      else
        puts "  databases  :"
        dbs.each do |db|
          flags = [active.include?(db) ? "active" : "idle"]
          flags << "THIS SESSION" if db == current_db
          # Drift, stated where the database is listed. Measured against THIS
          # checkout, which is the only schema any of these can be compared to
          # from here. Silent when in sync — the point is to make behind-ness
          # visible, not to add a line to every healthy row.
          behind = app.sem_tracking?(port, db) ? app.pending_scripts(port, db).length : nil
          flags << "#{behind} MIGRATION(S) BEHIND" if behind && behind > 0
          puts "    #{db}  [#{flags.join(', ')}]"
        end
      end
      puts ""
    end

    if current_db
      holder = app.find_container_with_db(current_db)
      if holder
        name, port = holder
        puts "Current session DB : #{current_db}  in #{name}"
        puts "CONF_DB_DEV_URL=jdbc:postgresql://#{DbImages::HOST}:#{port}/#{current_db}"
      else
        puts "Current session DB : #{current_db}  (not created yet — run `claude-db start --app #{app.name}`)"
      end
    else
      puts "Current session DB : (none — export CLAUDE_SESSION_ID, or run from ~/code/ai/<feature>)"
    end
    puts ""
  end
end

# ── gc ─────────────────────────────────────────────────────────────────────

# Session databases are reaped on AGE, not on "has no backend connected right
# now". The old rule dropped every database no other session happened to be
# querying at that instant, which is the normal state of a session sitting
# between test runs: on 2026-08-04, 11 live sessions held ~60 databases and
# pg_stat_activity was empty for every one of them, so a single `gc` would have
# destroyed all of them.
#
# Age is also what lets gc run from anywhere. Reaping "everything but mine"
# needs to know which database is mine, which is why gc used to require a
# session id and abort in ~/code; reaping "everything older than N days" does
# not, because the current session's database is newer than any sane cutoff.
DEFAULT_GC_DAYS = 3

def do_gc(apps, days, apply)
  puts ""
  puts Util.underline("claude-db gc")
  puts ""
  puts "Reaping session databases older than #{days} day(s)#{apply ? '' : ' (dry-run — pass --apply to do it)'}."
  puts ""

  cutoff = days * 86_400
  # Belt-and-braces only: a current session's database is younger than the
  # cutoff anyway. session_id_or_nil, never session_id — gc must not abort just
  # because it cannot name the session running it.
  sid = DbImages.session_id_or_nil
  total_dropped = 0

  apps.each do |app|
    current_db = sid ? app.session_db_name(sid) : nil
    containers = app.containers

    if containers.empty?
      puts "#{app.name}: no #{app.container_prefix}* containers — nothing to GC."
      next
    end

    containers.each do |name|
      running = DbImages.container_running?(name)
      port    = running ? DbImages.container_port(name) : nil

      if !running || port.nil?
        # A container that cannot be inspected for databases is left alone. It may
        # hold a stopped session's data, and removing it on a guess is exactly the
        # class of mistake this rewrite exists to prevent.
        puts "#{name}: #{running ? 'no published port' : 'stopped'} — skipping (cannot list its databases)."
        next
      end

      dbs    = app.list_session_dbs(port)
      active = app.active_session_dbs(port)
      ages   = app.session_db_ages(port)

      stale = app.reapable_session_dbs(
        dbs, :active => active, :ages => ages,
        :cutoff_seconds => cutoff, :current_db => current_db
      )

      # What was ACTUALLY dropped, which is not the same as what was planned:
      # the re-check below can spare a database that woke up mid-run, and the
      # container must then not be reclaimed out from under it.
      dropped = []

      if stale.empty?
        puts "#{name} (:#{port}): nothing older than #{days} day(s) (#{dbs.length} database(s) kept)."
      else
        verb = apply ? "dropping" : "would drop"
        puts "#{name} (:#{port}): #{verb} #{stale.length} of #{dbs.length} database(s)..."
        stale.each do |db|
          age_days = (ages[db] / 86_400.0).round(1)
          unless apply
            puts "  would drop #{db} (#{age_days}d)"
            next
          end
          # Asked again, immediately before the drop. The `active` set above was
          # sampled once for the whole container, and everything between that
          # sample and this line is time a session had to reconnect to a
          # database we had already decided was idle. Since the drop terminates
          # backends first, losing that race destroys live work rather than just
          # failing.
          if app.session_db_active?(port, db)
            puts "  skipped #{db} (#{age_days}d) — became active since the scan"
            next
          end
          # Terminate lingering connections (safety net — active dbs are kept above).
          DbImages.psql_exec_quiet(
            port,
            "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '#{db}'"
          )
          DbImages.psql_exec(port, "DROP DATABASE #{db}")
          puts "  dropped #{db} (#{age_days}d)"
          dropped << db
        end
        # A dry run reports what it WOULD drop; only a real run counts.
        total_dropped += apply ? dropped.length : stale.length
      end

      # A container is removed only once it holds no session databases at all —
      # never on its own age. One container serves a whole schema tag and is
      # reused by every session on that tag, so its age is the age of the OLDEST
      # session in it: platformdb-claude-0.5.39 was created 07-31 but still held
      # a database created 08-02. Reaping containers by age would take the newer
      # sessions with them.
      #
      # On an --apply run this asks what is actually GONE, not what was planned:
      # a database the re-check above spared is still in the container, and
      # removing the container would destroy it just as surely as the DROP would
      # have.
      remaining = apply ? (dbs - dropped) : (dbs - stale)
      next unless remaining.empty?

      # An empty container is only reclaimed once it is itself older than the
      # cutoff. `claude-db start` creates the container and then the database as
      # two steps, so a container seconds old with no databases in it is far more
      # likely to be a session mid-start than an abandoned one — reaping it there
      # deletes the container out from under a session that is about to use it.
      # An unreadable age counts as young and is left alone.
      container_age = DbImages.container_age_seconds(name)
      if container_age.nil? || container_age < cutoff
        puts "#{name}: holds no session databases but is only #{container_age ? (container_age / 86_400.0).round(1).to_s + 'd' : 'unknown age'} — keeping (a session may be starting in it)."
        next
      end

      unless apply
        puts "#{name}: would hold no session databases — would remove it and release its port."
        next
      end
      puts "#{name}: holds no session databases — removing and releasing its port."
      Util.run("docker rm -f #{Shellwords.shellescape(name)}")
      released = DbPorts.release_container(name)
      puts "  released #{released} port allocation(s) from #{DbPorts::HISTORY_PATH}" if released > 0
    end
  end
  puts ""
  puts "Pass --apply to drop them." if !apply
  puts "Dropped #{total_dropped} database(s)." if apply
  puts ""
end

# ── entry point ─────────────────────────────────────────────────────────────

# Parsed here rather than through Args: Args' shared option table has neither
# --port nor an optional --app in it.
def parse_args!(argv)
  opts = {}
  until argv.empty?
    arg = argv.shift
    case arg
    when "--app"
      opts[:app] = argv.shift
      Util.exit_with_error("--app requires a value") if opts[:app].nil?
    when /\A--app=(.*)\z/
      opts[:app] = Regexp.last_match(1)
    when "--port"
      opts[:port] = argv.shift
      Util.exit_with_error("--port requires a value") if opts[:port].nil?
    when /\A--port=(.*)\z/
      opts[:port] = Regexp.last_match(1)
    when "--repo-dir"
      opts[:repo_dir] = argv.shift
      Util.exit_with_error("--repo-dir requires a value") if opts[:repo_dir].nil?
    when /\A--repo-dir=(.*)\z/
      opts[:repo_dir] = Regexp.last_match(1)
    when "--days"
      opts[:days] = argv.shift
      Util.exit_with_error("--days requires a value") if opts[:days].nil?
    when /\A--days=(.*)\z/
      opts[:days] = Regexp.last_match(1)
    when "--apply"
      opts[:apply] = true
    else
      Util.exit_with_error("Unknown argument: #{arg}")
    end
  end

  if opts[:days]
    # 0 is allowed and means "everything not currently in use" — the old
    # behaviour, still reachable but now only by asking for it explicitly.
    unless opts[:days] =~ /\A\d+\z/
      Util.exit_with_error("--days must be a non-negative integer (got: #{opts[:days]})")
    end
  end

  if opts[:port]
    unless opts[:port] =~ /\A\d+\z/ && DbPorts.port_in_range?(opts[:port].to_i)
      Util.exit_with_error(
        "--port must be an integer in #{DbPorts::RANGE_MIN}-#{DbPorts::RANGE_MAX} (got: #{opts[:port]}).\n" \
        "Get one with: claude-db next-port"
      )
    end
    opts[:port] = opts[:port].to_i
  end
  opts
end

# `start` creates a database and `sync` migrates one, so both must be told which
# app's schema is involved — there is no safe default, and inferring one from the
# cwd is how a session ends up developing against the wrong schema. Every other
# command either reads or reclaims, and defaults to all apps.
def require_app(opts, command: "start")
  if opts[:app].nil?
    Util.exit_with_error(
      "--app is required for `#{command}` (one of: #{DbApp.names.join(', ')}).\n\n" \
      "  claude-db #{command} --app platform#{command == 'start' ? " --port \"$(claude-db next-port)\"" : ""}"
    )
  end
  with_current_schema(app_from(opts))
end

# The checkout `start` and `sync` read migration scripts out of — with the
# last-resort one replaced by a clone this tooling keeps at origin/main.
#
# Only :default is replaced, and that is the whole safety argument. The other
# three sources are a CHOICE: the caller is standing in that schema repo, has a
# clone of it beside their feature dir, or named it with --repo-dir. Any of
# those may hold a migration in progress that exists nowhere else, so swapping
# it for main would silently drop exactly the script the caller is testing.
# :default is the one nobody chose — ~/code/<app>-postgresql, assumed because
# there was nothing else to go on — and on the agent runner it is a tree no
# session is allowed to write to and therefore no session can pull, so it only
# ever gets staler (ISS-545).
#
# Read-only and reclaiming commands (status, gc, end) do not come through here:
# they touch no migration scripts, and none of them should clone or fetch as a
# side effect of being asked what exists.
def with_current_schema(app)
  return app if app.nil? || app.repo_source != :default

  dir = SchemaMirror.checkout(app.name, :origin_from => app.repo_dir)
  if dir.nil?
    puts "NOTE: could not refresh the tooling's clone of #{app.name}#{DbApp::POSTGRESQL_SUFFIX} " \
         "(offline?) — falling back to #{app.repo_dir}, which may be behind main."
    return app
  end
  app.with_repo_dir(dir, :repo_source => :mirror)
end

# The app AND the schema checkout its scripts come from.
#
# DbApp.resolve adopts the current directory as the checkout when that directory
# IS this app's schema repo — the db-image convention (#269), and the case that
# matters here: a session standing in its feature clone of <app>-postgresql is
# standing in the schema it is developing against, which is exactly what `sync`
# should apply and what the drift count should be measured from. Anywhere else
# (a feature dir root, ~/code) nothing is inferred and ~/code/<app>-postgresql is
# assumed — which is what `start` and `sync` then swap for a current clone; see
# with_current_schema. --repo-dir overrides both.
def app_from(opts)
  DbApp.resolve(:name => opts[:app], :repo_dir => opts[:repo_dir])
end

def apps_for(opts)
  if opts[:app]
    [app_from(opts)]
  else
    Util.exit_with_error("--repo-dir names one app's schema repo, so it needs --app too") if opts[:repo_dir]
    DbApp.all
  end
end

show_usage if ARGV.empty?

subcommand = ARGV.shift
show_usage if ["-h", "--help", "help"].include?(subcommand)

opts = parse_args!(ARGV)

case subcommand
when "start"     then do_start(require_app(opts), opts[:port])
when "sync"      then do_sync(require_app(opts, :command => "sync"))
when "end"       then do_end(apps_for(opts))
when "status"    then do_status(apps_for(opts))
when "gc"        then do_gc(apps_for(opts), (opts[:days] || DEFAULT_GC_DAYS).to_i, opts[:apply] == true)
when "next-port" then do_next_port
else
  $stderr.puts "Unknown command: #{subcommand}"
  show_usage
end
