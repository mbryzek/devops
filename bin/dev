#!/usr/bin/env ruby

# Cron/exec invocations have no locale set, so Ruby's default external encoding
# falls back to US-ASCII and any non-ASCII byte in repo files or subprocess
# output raises "invalid byte sequence in US-ASCII". Force UTF-8 here — and
# hand child processes (api, git, gh, claude) a UTF-8 locale — so behavior
# never depends on the ambient environment.
Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8
unless [ENV["LC_ALL"], ENV["LANG"]].any? { |v| v.to_s.match?(/utf-?8/i) }
  ENV["LC_ALL"] = "en_US.UTF-8"
end

require 'fileutils'
require 'io/console'
require 'json'
require 'open3'
require 'set'
require 'time'
require 'timeout'
require 'uri'

load File.join(File.dirname(__FILE__), '../lib/common.rb')

$LOAD_PATH.unshift(File.expand_path('~/code/claude/lib'))
require 'work/registry'

$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))
require 'codegen/api_config'
require 'codegen/graph'
require 'codegen/sync'

# Single source of truth for each command's invocation line, keyed by the command
# path. The same string is interpolated into the USAGE block below and shown
# inline (via usage_for) on an argument error, so help text and error hints can't
# drift. Add a command here and reference it in both places.
INVOCATIONS = {
  "login"               => 'login [--email EMAIL] [--app APP] [--localhost]',
  "logout"              => 'logout [--localhost]',
  "invariants check"    => 'invariants [check] [--app APP] [--localhost] [--examples N | --all-examples]',
  "invariants snoozes"  => 'invariants snoozes [--app APP] [--localhost]',
  "invariants snooze"   => 'invariants snooze <name> --app APP --days N --reason "TEXT" [--localhost]',
  "invariants unsnooze" => 'invariants unsnooze <name> --app APP [--localhost]',
  "tasks requeue"       => 'tasks requeue [--app APP] [--localhost]',
  "slow-routes"         => 'slow-routes [--app member|admin] [--days N] [--sort -p95] [--limit N] [--localhost]',
  "deploy status"       => 'deploy [status] [--app APP]',
  "deploy all"          => 'deploy all [--app APP] [--concurrency N]',
  "config check"        => 'config check [--app APP]',
  "config rollout"      => 'config rollout [--app APP]',
  "docker prune"        => 'docker prune [--days N] [--apply]',
  "aidirs prune"        => 'aidirs prune [--days N] [--apply] [--trash]',
  "browserslist update" => 'browserslist update [--app NAME] [--verbose] [--keep-tmp-dir]',
  "scripts run"         => 'scripts run <name> [args...]',
  "codegen sync"        => 'codegen [sync] [--app APP] [--concurrency N] [--dry-run] [--regen-only] [--full-tests]',
  "issues claim"        => 'issues claim [--category CATEGORY] [--localhost] [--yes] [--no-spawn]',
  "issues status"       => 'issues status <number> --status STATUS [--comment "TEXT"] [--url URL] [--app APP --baseline-version VERSION] [--localhost]',
  "issues reconcile"    => 'issues reconcile [--apply] [--localhost]',
  "changelog capture"   => 'changelog [capture] [--app APP]...',
  "changelog build"     => 'changelog build [--app APP]... [--limit N] [--batch-size N] [--localhost]',
}.freeze

# The full `dev ...` form passed as `example:` to usage_exit on an arg error.
# fetch (not []) so a typo'd command key fails loudly instead of showing "dev ".
def usage_for(command)
  "dev #{INVOCATIONS.fetch(command)}"
end

USAGE = <<~USAGE
  Usage: dev <command> [subcommand] [options]

  Commands:
    #{INVOCATIONS["login"]}
        Log in to platform and acumen. Prompts for email + password
        separately per app (credentials differ between stacks). If
        --email is passed it is reused for both; password is always
        re-prompted. Per-app failures warn but do not abort others.
        Pass `--app acumen` or `--app platform` to target just one.
        `--app playbook` logs in to the playbook tenant admin (used by
        `dev issues`); it is opt-in only, never part of the default
        login. Sessions are stored under ~/.platform/.

    #{INVOCATIONS["logout"]}
        Clear the cached devops sessions (platform + acumen).

    #{INVOCATIONS["invariants check"]}
        Check invariants across endpoints. `check` is the default when no
        subcommand is given. Shows up to N examples per failure (default 10),
        or all with --all-examples.

    #{INVOCATIONS["invariants snoozes"]}
        List active invariant snoozes.

    #{INVOCATIONS["invariants snooze"]}
        Snooze an invariant for N days. --app is required.

    #{INVOCATIONS["invariants unsnooze"]}
        Remove an invariant snooze. --app is required.

    #{INVOCATIONS["tasks requeue"]}
        Requeue failed async tasks.

    #{INVOCATIONS["slow-routes"]}
        Show the slowest routes by response time over the last N days
        (default 7). Sort with --sort (default -p95), cap rows with
        --limit (default 10), filter with --app member|admin.

    #{INVOCATIONS["deploy status"]}
        Print every tracked app and DB repo with its latest tag, the version
        production is running, and a status — the full fleet picture even
        when everything is up to date. `status` is the default when no
        subcommand is given.

        An item needs a release when origin/main is ahead of the latest tag,
        OR production is running a version other than the latest tag (tagged
        but never deployed). The prod version comes from /_internal_/version
        or the live k8s image tag; *-postgresql repos and apps with no prod
        probe are checked on git state only. --app APP matches an app or DB
        name exactly (e.g. `platform` vs `platform-postgresql`).

        If anything is pending, you are prompted to pick which items to
        release — numbers (e.g. 1,3), `all` (the default), or `none` — and
        the selection releases exactly as `deploy all` would. The prompt is
        skipped when stdin is not a terminal (pipes, cron), so scripted
        callers just get the table.
    #{INVOCATIONS["deploy all"]}
        Release every pending item without prompting. Two phases:
          1. DB repos (*-postgresql) release serially via `release-db`,
             with RELEASE_AUTO_TAG=1 and RELEASE_DB_AUTO_CONFIRM=1.
          2. Apps release in parallel (concurrency defaults to 10) via
             `release` with RELEASE_AUTO_TAG=1.
        If a DB release fails, the matching app (foo for foo-postgresql)
        is skipped to avoid deploying an app against an unmigrated schema.
        Skips repos not on `main` or with a dirty tree.

    #{INVOCATIONS["config check"]}
        Diff live ConfigMap in cluster against env/apps/<app>/env/production.env.
    #{INVOCATIONS["config rollout"]}
        Apply k8s-secrets and rollout restart workloads (picks up ConfigMap changes).

    #{INVOCATIONS["docker prune"]}
        Remove Docker images, build cache, and dangling volumes older than N days
        (default 7). Useful when local disk fills from pushed-but-unused builds.
        Dry-run by default (lists what would be removed); pass --apply to remove.

    #{INVOCATIONS["aidirs prune"]}
        Reap feature dirs under ~/code/ai. These are throwaway clones, so any dir
        idle more than N days (default 3) is removed regardless of git state: clean/
        pushed dirs are hard-deleted, while dirs holding work not on a remote
        (uncommitted, stashed, detached, loose files, or local-only commits) are
        moved to ~/code/ai-trash/<timestamp> so they stay recoverable. Dirs touched
        within N days are protected (with `gh` consulted so a landed merged/closed
        PR still lets a recent dir be deleted). Dry-run by default: prints the
        keep/delete/trash split and removes nothing. Pass --apply to act; --trash
        additionally routes the clean/pushed deletes to the trash instead of rm.

    #{INVOCATIONS["browserslist update"]}
        Shallow-clone every ~/code/* repo with a package.json into
        ~/code/browserslist.<YYYYMMDD>/<name>, run `npx update-browserslist-db@latest`,
        and push changes to main. Use --app NAME to limit to one repo (matched by
        directory name under ~/code). The temp dir is deleted on success unless
        --keep-tmp-dir is passed; it is always kept if any repo fails so output
        can be inspected. Quiet by default; use --verbose to stream full output.

    #{INVOCATIONS["codegen sync"]}
        Regenerate every codegen-consuming repo against the latest generator and
        registry, opening a review-ready PR per repo that changes. Backends
        (platform, acumen) upload their specs and regenerate first, serially;
        consumers regenerate in parallel. `sync` is the default subcommand.
        --dry-run reports diffs without spawning Claude or opening PRs;
        --regen-only opens draft PRs but skips the review-completion workflow;
        --full-tests runs the full Scala suite instead of Test/compile.

    scripts [list]
        List utility scripts in devops/scripts/ with their allowed targets and
        a one-line description. `list` is the default when no subcommand given.

    #{INVOCATIONS["scripts run"]}
        Run a utility script (or wrapper) — the NAME comes first. For `.sql`
        scripts the args are env flags: local platformdb by default, or `--prod` /
        `--env development` to run via `db exec` (production prompts for
        confirmation; non-local targets must be listed in the script's
        `dev-script:` header). Executable scripts/wrappers run locally with every
        arg forwarded to them (a leading `--` separator is dropped) — including
        their own `--env`/`--prod` flags.

    #{INVOCATIONS["issues claim"]}
        Claim open issues into local plans for a Claude session to work on. With no
        --category (the default) it scans every category (graphs, worker, insights),
        lists the open issues grouped by category, and — after you confirm (or with
        --yes) — atomically claims each category and writes ONE plan per category to
        ~/code/claude/plans/<date>-issues-<category>.md. Pass --category CATEGORY to
        scope to a single one. It then hands the terminal to an interactive Claude
        session (Opus 4.8, 1M context — the `ccd` model): one plan → it implements
        the plan directly; several → it dispatches one subagent per plan and works
        them in parallel. Pass --no-spawn to just write the plan(s) and print their
        paths. Authenticates with your persisted playbook session — run
        `dev login --app playbook` once first (the issues API requires a playbook
        admin, not the platform `dev login`).

    #{INVOCATIONS["issues status"]}
        Close a claimed issue. NUMBER is the per-tenant issue number shown as
        ISS-<number> (034, or unpadded 34). STATUS is one of open, claimed, fixed,
        deployed, verified, dismissed, needs_input. Marking `fixed` requires --url:
        the merged PR, or a document describing a manual/process fix. Pass --app
        <deployable-app> and --baseline-version <live release tag> TOGETHER (both or
        neither) for a code fix: they are what let `dev issues reconcile` flip the
        issue to `deployed` once that app releases past the baseline; a
        document-linked fix has neither and is advanced by hand. --comment carries
        the question (needs_input) or a reason (dismissed). The generated plan tells
        the fix session to call this so no session token is written into the plan file.

    #{INVOCATIONS["issues reconcile"]}
        Flip `fixed` issues to `deployed` once their target app has released past the
        fix. Read-only against the deploy registry (same live-version signal as
        `dev deploy status`) — the release pipeline is untouched. Dry-run by default;
        pass --apply to record the transitions (e.g. from a cron).

    #{INVOCATIONS["changelog capture"]}
        Record the changelog for the playbook* apps into the `changelog` data repo
        (github.com/mbryzek/changelog, cloned to ~/code/changelog). With no
        subcommand it runs `capture` then `build`. `capture` reads each tracked app's
        git tags (playbook-admin, playbook-app, playbook-www) and, for every tag missing
        a <version>.tag.json, writes all commits since the previous tag — idempotent,
        so it both records new releases and backfills history. Repeat --app to scope;
        default is all tracked apps. Runs automatically (best-effort) at the end of
        `release`; never blocks a release.

    #{INVOCATIONS["changelog build"]}
        Turn raw <version>.tag.json files into curated <version>.notes.json via a
        headless Claude session that judges which commits are worth a human note,
        summarizes them, and links each to its PR and (best-effort) in-house issue
        (ISS-###). Only versions without a notes file are built (cached — never
        re-evaluated), newest first, a batch of versions per Claude session
        (--batch-size N to change the batch; session startup, not the notes
        themselves, dominates the cost). Pass --limit N to build only the N most
        recent pending versions (e.g. to seed history without evaluating every past
        release). Enrichment uses your persisted playbook session; run
        `dev login --app playbook` once first. After writing notes it regenerates
        playbook-admin's committed snapshot (src/lib/changelog/data.json, what
        /admin/changelog actually renders) in a scratch worktree and force-pushes it
        to the long-lived `changelog-data` branch, opening the PR if none is open —
        best-effort, never fails the build. The page updates once that PR is merged
        AND playbook-admin is released.

  Common options:
    --app APP       Limit to a single app (acumen, platform)
    --localhost     Hit local development servers instead of production
USAGE

# No message => the user asked for help (`dev`, `dev help`, `-h`); print the
# full usage and exit 0. With a message it's an error: keep it short and point
# at `dev help` rather than dumping the whole usage block on every mistake.
# Pass `example:` to show the one-line invocation for the failing command inline
# so the user doesn't have to hunt through `dev help` to find the right syntax.
def usage_exit(msg = nil, example: nil)
  if msg
    warn msg
    warn "  Usage: #{example}" if example
    warn "Run `dev help` for usage."
    exit 1
  else
    warn USAGE
    exit 0
  end
end

# Known commands and their subcommands, used to suggest a correction when the
# user mistypes one (e.g. `task` -> `tasks`, `requeu` -> `requeue`).
COMMANDS = %w[login logout invariants tasks deploy config docker aidirs browserslist scripts codegen issues changelog].freeze
SUBCOMMANDS = {
  "changelog"    => %w[capture build],
  "invariants"   => %w[check snoozes snooze unsnooze],
  "tasks"        => %w[requeue],
  "deploy"       => %w[status all],
  "config"       => %w[check rollout],
  "docker"       => %w[prune],
  "aidirs"       => %w[prune],
  "browserslist" => %w[update],
  "scripts"      => %w[list run],
  "codegen"      => %w[sync],
  "issues"       => %w[claim status reconcile],
}.freeze

def levenshtein(a, b)
  return b.length if a.empty?
  return a.length if b.empty?
  prev = (0..b.length).to_a
  a.each_char.with_index do |ca, i|
    curr = [i + 1]
    b.each_char.with_index do |cb, j|
      cost = ca == cb ? 0 : 1
      curr << [curr[j] + 1, prev[j + 1] + 1, prev[j] + cost].min
    end
    prev = curr
  end
  prev[b.length]
end

# Closest candidate to `input`. A *unique* prefix wins outright (handles `inv`
# -> `invariants`); an ambiguous prefix (2+ matches, e.g. `lo` for login/logout)
# is not resolved on the prefix branch. Everything else — including ambiguous
# prefixes — falls to nearest-by-edit-distance within a small, length-scaled
# threshold, so `lo` (distance 3 to `login`, over threshold) yields nothing
# while `versio` (distance 1) still resolves to `version`. The threshold keeps
# unrelated typos from getting bogus suggestions.
def suggest(input, candidates)
  s = input.to_s.downcase
  return nil if s.empty?

  prefix_matches = candidates.select { |c| c.downcase != s && c.downcase.start_with?(s) }
  return prefix_matches.first if prefix_matches.length == 1 && s.length >= 2

  best, dist = candidates.map { |c| [c, levenshtein(s, c.downcase)] }.min_by { |_, d| d }
  best if dist <= [2, s.length / 3].max
end

def unknown(kind, value, candidates)
  hint = suggest(value, candidates)
  msg = "Unknown #{kind}: #{value}"
  msg += " (did you mean '#{hint}'?)" if hint
  usage_exit(msg)
end

# `dev <command>` with no subcommand: name the valid subcommands inline instead
# of a bare "requires a subcommand", so the user doesn't have to open `dev help`
# just to discover what's available.
def require_subcommand(command)
  subs = SUBCOMMANDS[command] || []
  hint = subs.length == 1 ? subs.first : "one of: #{subs.join(', ')}"
  usage_exit("#{command} requires a subcommand (#{hint})")
end

# Pick the subcommand for `dev <command> [subcommand] ...`. The first token names
# it, unless it's absent or a flag — those belong to the default subcommand's own
# args, so `dev deploy --app X` and bare `dev invariants` both run the default.
# Shifts the token off `argv` only when it named a subcommand, leaving flags and
# positionals for the handler. Returns the chosen (or default) subcommand name;
# an unrecognized name is returned as-is so the caller can report it.
def resolve_subcommand(argv, default:)
  first = argv.first
  return default if first.nil? || first.start_with?("-")
  argv.shift
end

# Commands that take only common flags (--app/--localhost) accept no positional
# args or other flags; anything left over is a typo. Reject it with the command's
# usage inline instead of silently ignoring it (parse_common_flags returns these
# leftover tokens, which such commands would otherwise discard).
def reject_unknown_args(command, leftover)
  return if leftover.empty?
  label = leftover.length == 1 ? "argument" : "arguments"
  usage_exit("#{command}: unknown #{label}: #{leftover.join(', ')}", example: usage_for(command))
end

def parse_common_flags(args)
  app_filter = nil
  use_localhost = false
  rest = []
  i = 0
  while i < args.length
    a = args[i]
    case a
    when "--app"
      app_filter = args[i + 1]
      usage_exit("--app requires a value") if app_filter.nil?
      i += 2
    when "--localhost"
      use_localhost = true
      i += 1
    when "-h", "--help"
      usage_exit
    else
      rest << a
      i += 1
    end
  end
  [rest, app_filter, use_localhost]
end

def resolve_endpoints(app_filter, use_localhost)
  list = ApiClient.endpoints(use_localhost: use_localhost, app_filter: app_filter)
  if list.empty?
    valid = ApiClient::ENDPOINTS.map { |e| e[:app] }.join(", ")
    Util.exit_with_error("Unknown app '#{app_filter}'. Valid apps: #{valid}")
  end
  list
end

def handle_errors
  yield
rescue SessionExpired => e
  warn e.message
  exit 1
rescue ApiError => e
  warn e.message
  exit 1
end

def platform_endpoint(use_localhost)
  ApiClient.endpoints(use_localhost: use_localhost, app_filter: "platform").first
end

# ---------- login / logout ----------

def login_platform(use_localhost, email, password)
  res = ApiClient.request(platform_endpoint(use_localhost), :post, "/tenant/platform/session/logins",
                          body: { email: email, password: password },
                          auth_required: false)
  raise ApiError, "unexpected response: #{res.inspect}" unless res.is_a?(Hash) && res["discriminator"] == "tenant_session"

  session_id = res.dig("session", "id")
  raise ApiError, "response missing session.id: #{res.inspect}" if session_id.nil? || session_id.empty?

  ApiClient.write_session_id_for("platform", session_id, use_localhost: use_localhost)
  user_email = res.dig("user", "email") || email
  puts "Logged in to platform as #{user_email}"
end

def login_acumen(use_localhost, email, password)
  acumen_ep = ApiClient.endpoints(use_localhost: use_localhost, app_filter: "acumen").first
  res = ApiClient.request(acumen_ep, :post, "/sessions/login",
                          body: { email: email, password: password },
                          auth_required: false)
  raise ApiError, "unexpected response: #{res.inspect}" unless res.is_a?(Hash)

  session_id = res["id"]
  raise ApiError, "response missing session id: #{res.inspect}" if session_id.nil? || session_id.empty?

  ApiClient.write_session_id_for("acumen", session_id, use_localhost: use_localhost)
  user_email = res.dig("user", "email") || email
  puts "Logged in to acumen as #{user_email}"
end

def login_playbook(use_localhost, email, password)
  ep = ApiClient.tenant_endpoint("playbook", use_localhost: use_localhost)
  res = ApiClient.request(ep, :post, "/tenant/playbook/session/logins",
                          body: { email: email, password: password },
                          auth_required: false)
  raise ApiError, "unexpected response: #{res.inspect}" unless res.is_a?(Hash) && res["discriminator"] == "tenant_session"

  session_id = res.dig("session", "id")
  raise ApiError, "response missing session.id: #{res.inspect}" if session_id.nil? || session_id.empty?

  ApiClient.write_session_id_for("playbook", session_id, use_localhost: use_localhost)
  user_email = res.dig("user", "email") || email
  puts "Logged in to playbook as #{user_email}"
end

# Read a password from the terminal without echoing it, stripping surrounding
# whitespace. Strip, not chomp: a password pasted from a manager routinely
# carries a trailing space or tab, and the browser login forms strip before
# sending (playbook-admin's getRequiredString does value.trim()). Chomping only
# the newline made the CLI send a credential the browser never would, and the
# server reports that as a bare "Incorrect password" on the password field -
# indistinguishable from a genuinely wrong password. Matches the `.strip` the
# email prompt already applies.
#
# `io` is a seam for tests: StringIO has no #noecho, so fall back to #gets when
# stdin is not a terminal.
def read_password(io = STDIN)
  raw = io.respond_to?(:noecho) ? io.noecho(&:gets) : io.gets
  raw&.strip
end

# playbook is a tenant login, opt-in via `--app playbook` only — never part of the
# default `dev login` fanout (which is the deployable apps in ENDPOINTS).
LOGIN_APPS = (ApiClient::ENDPOINTS.map { |e| e[:app] } + ["playbook"]).freeze

def cmd_login(args)
  email = nil
  use_localhost = false
  app_filter = nil
  i = 0
  while i < args.length
    a = args[i]
    case a
    when "--email"
      email = args[i + 1]
      usage_exit("--email requires a value", example: usage_for("login")) if email.nil?
      i += 2
    when "--app"
      app_filter = args[i + 1]
      usage_exit("--app requires a value", example: usage_for("login")) if app_filter.nil?
      i += 2
    when "--localhost"
      use_localhost = true
      i += 1
    else
      usage_exit("Unknown argument: #{a}", example: usage_for("login"))
    end
  end

  apps = if app_filter
           unless LOGIN_APPS.include?(app_filter)
             usage_exit("--app must be one of: #{LOGIN_APPS.join(', ')}", example: usage_for("login"))
           end
           [app_filter]
         else
           # Default fanout is the deployable apps only; playbook is opt-in.
           ApiClient::ENDPOINTS.map { |e| e[:app] }
         end

  targets = apps.map do |app|
    if app == "playbook"
      ApiClient.tenant_endpoint("playbook", use_localhost: use_localhost)
    else
      ApiClient.endpoints(use_localhost: use_localhost, app_filter: app).first
    end
  end
  puts "Logging in to: #{targets.map { |e| "#{e[:name]} (#{e[:active_url]})" }.join(', ')}"

  any_ok = false
  targets.each do |target|
    puts ""
    puts "[#{target[:name]}] (#{target[:active_url]})"

    target_email = email
    if target_email.nil? || target_email.empty?
      print "  Email: "
      target_email = STDIN.gets&.strip
      if target_email.nil? || target_email.empty?
        warn "  skipped (no email)"
        next
      end
    end

    print "  Password: "
    password = read_password
    puts ""
    if password.nil? || password.empty?
      warn "  skipped (no password)"
      next
    end

    begin
      case target[:app]
      when "platform" then login_platform(use_localhost, target_email, password)
      when "acumen"   then login_acumen(use_localhost, target_email, password)
      when "playbook" then login_playbook(use_localhost, target_email, password)
      else
        warn "  unknown app: #{target[:app]}"
        next
      end
      any_ok = true
    rescue ApiError => e
      warn "  #{target[:name]} login failed: #{e.message}"
    end
  end

  Util.exit_with_error("No logins succeeded") unless any_ok
end

def cmd_logout(args)
  use_localhost = false
  args.each do |a|
    case a
    when "--localhost" then use_localhost = true
    else usage_exit("Unknown argument: #{a}", example: usage_for("logout"))
    end
  end

  platform_sid = ApiClient.session_id_for("platform", use_localhost: use_localhost)
  acumen_sid   = ApiClient.session_id_for("acumen", use_localhost: use_localhost)
  playbook_sid = ApiClient.session_id_for("playbook", use_localhost: use_localhost)

  if platform_sid.nil? && acumen_sid.nil? && playbook_sid.nil?
    puts "No active session"
    return
  end

  if platform_sid
    begin
      ApiClient.request(platform_endpoint(use_localhost), :delete, "/tenant/platform/session", auth_required: true)
    rescue SessionExpired, ApiError
      # ignore - we'll clear locally anyway
    end
    ApiClient.clear_session_id_for("platform", use_localhost: use_localhost)
  end

  if acumen_sid
    begin
      acumen_ep = ApiClient.endpoints(use_localhost: use_localhost, app_filter: "acumen").first
      ApiClient.request(acumen_ep, :post, "/logout", auth_required: true)
    rescue SessionExpired, ApiError
      # ignore - we'll clear locally anyway
    end
    ApiClient.clear_session_id_for("acumen", use_localhost: use_localhost)
  end

  if playbook_sid
    begin
      playbook_ep = ApiClient.tenant_endpoint("playbook", use_localhost: use_localhost)
      ApiClient.request(playbook_ep, :delete, "/tenant/playbook/session", auth_required: true)
    rescue SessionExpired, ApiError
      # ignore - we'll clear locally anyway
    end
    ApiClient.clear_session_id_for("playbook", use_localhost: use_localhost)
  end

  puts "Logged out"
end

# ---------- invariants ----------

def print_invariant_failures(result, example_limit: 10)
  (result["non_zero"] || []).each do |inv|
    puts "  - #{inv['name']}"
    puts "    Count: #{inv['count']}"
    examples = inv["examples"] || []
    unless examples.empty?
      puts "    Examples:"
      shown = example_limit.nil? ? examples : examples.take(example_limit)
      shown.each { |ex| puts "      * #{ex}" }
      if !example_limit.nil? && examples.length > example_limit
        puts "      ... and #{examples.length - example_limit} more"
      end
    end
  end

  (result["error"] || []).each do |inv|
    puts "  - #{inv['name']}"
    puts "    Error: #{inv['error'] || 'Unknown error'}"
  end
end

def cmd_invariants_check(args)
  rest, app_filter, use_localhost = parse_common_flags(args)
  example_limit = 10
  i = 0
  while i < rest.length
    case rest[i]
    when "--examples"
      example_limit = Integer(rest[i + 1] || usage_exit("--examples requires a value", example: usage_for("invariants check")))
      i += 2
    when "--all-examples"
      example_limit = nil
      i += 1
    else
      usage_exit("Unknown flag: #{rest[i]}", example: usage_for("invariants check"))
    end
  end
  endpoints = resolve_endpoints(app_filter, use_localhost)

  puts ""
  puts Util.underline("Checking Invariants#{use_localhost ? ' (localhost)' : ''}")
  puts ""

  print "Fetching #{endpoints.map { |e| e[:name] }.join(', ')}..."
  $stdout.flush

  results = endpoints.map do |endpoint|
    Thread.new do
      begin
        data = ApiClient.request(endpoint, :get, "/dev/invariant/checks")
        { endpoint: endpoint, data: data, error: nil }
      rescue SessionExpired => e
        { endpoint: endpoint, data: nil, error: "session expired - run 'dev login'" }
      rescue ApiError => e
        { endpoint: endpoint, data: nil, error: e.message }
      rescue => e
        { endpoint: endpoint, data: nil, error: e.message }
      end
    end
  end.map(&:value)

  puts " done"
  puts ""

  all_passed = true
  results.sort_by { |r| r[:endpoint][:name] }.each do |r|
    endpoint = r[:endpoint]
    if r[:error]
      puts Util.underline("#{endpoint[:name]}: ERROR - #{r[:error]}")
      all_passed = false
    else
      result = r[:data] || {}
      success = result["success"] || []
      non_zero = result["non_zero"] || []
      errors = result["error"] || []
      total_count = success.length + non_zero.length + errors.length
      failure_count = non_zero.length + errors.length

      if failure_count == 0
        puts "#{endpoint[:name]}: #{total_count} invariants passed"
      else
        puts Util.underline("#{endpoint[:name]}: #{failure_count} FAILURES (#{total_count} total)")
        print_invariant_failures(result, example_limit: example_limit)
        all_passed = false
      end
    end
    puts ""
  end

  if all_passed
    puts "All invariants passed"
    exit 0
  else
    puts "Some invariants failed"
    exit 1
  end
end

# Render the `created_by` audit union (from bryzek/audit), keyed off its discriminator:
#   - "person":    resolved profile — show name and/or email, falling back to the person id.
#   - "reference": unresolved user — only the opaque user id is available.
# Any other discriminator is a newer variant this client predates; show it verbatim.
def format_created_by(created_by)
  case created_by['discriminator']
  when 'person'
    person = created_by['person'] || {}
    name   = blank_to_nil(person['name'])
    email  = blank_to_nil(person.dig('email', 'address'))
    parts  = [name, email && "<#{email}>"].compact
    parts.empty? ? (blank_to_nil(person['id']) || 'unknown') : parts.join(' ')
  when 'reference'
    blank_to_nil((created_by['user'] || {})['id']) || 'unknown'
  else
    created_by['discriminator'] || 'unknown'
  end
end

def blank_to_nil(value)
  value.to_s.strip.empty? ? nil : value
end

def cmd_invariants_snoozes(args)
  rest, app_filter, use_localhost = parse_common_flags(args)
  reject_unknown_args("invariants snoozes", rest)
  endpoints = resolve_endpoints(app_filter, use_localhost)

  puts ""
  puts Util.underline("Invariant Snoozes#{use_localhost ? ' (localhost)' : ''}")
  puts ""

  handle_errors do
    endpoints.each do |endpoint|
      snoozes = ApiClient.request(endpoint, :get, "/dev/invariant/snoozes") || []
      puts "#{endpoint[:name]}: #{snoozes.length} active"
      snoozes.each do |s|
        created_by = s['created_by'] || {}
        puts "  - #{s['invariant_name']}"
        puts "    Until:   #{s['snoozed_until']}"
        puts "    Reason:  #{s['reason']}"
        puts "    By:      #{format_created_by(created_by)} at #{created_by['created_at']}"
      end
      puts ""
    end
  end
end

APP_REQUIRED = "--app is required (mutations must target a single app)"

# The invariant name is a positional argument, but a natural first guess is
# `--name X`, which lands both tokens in `leftover`. Split leftover tokens into
# the single positional name vs stray `--flags` and describe exactly what went
# wrong, returning [name, problems] so the caller can add its own required-arg
# checks.
def collect_invariant_name(leftover)
  unknown_flags = leftover.select { |a| a.start_with?("--") }
  positional = leftover.reject { |a| a.start_with?("--") }
  problems = []
  unless unknown_flags.empty?
    label = unknown_flags.length == 1 ? "flag" : "flags"
    problems << "unknown #{label} #{unknown_flags.join(', ')} (the invariant name is a positional argument — pass it without a flag)"
  end
  if positional.empty?
    problems << "missing invariant name (positional argument)"
  elsif positional.length > 1
    problems << "expected a single invariant name but got #{positional.length}: #{positional.join(', ')}"
  end
  [positional.first, problems]
end

# Report every argument problem at once (with the command's usage line inline)
# instead of failing on one missing flag at a time. No-op when problems is empty.
def report_arg_problems(command, problems, example)
  return if problems.empty?
  header =
    if problems.length == 1
      "#{command}: #{problems.first}"
    else
      ["#{command}: #{problems.length} problems:", *problems.map { |p| "  - #{p}" }].join("\n")
    end
  usage_exit(header, example: example)
end

def cmd_invariants_snooze(args)
  rest, app_filter, use_localhost = parse_common_flags(args)
  days = nil
  reason = nil
  leftover = []
  i = 0
  while i < rest.length
    a = rest[i]
    case a
    when "--days"
      days = rest[i + 1]
      usage_exit("--days requires a value", example: usage_for("invariants snooze")) if days.nil?
      i += 2
    when "--reason"
      reason = rest[i + 1]
      usage_exit("--reason requires a value", example: usage_for("invariants snooze")) if reason.nil?
      i += 2
    else
      leftover << a
      i += 1
    end
  end

  name, problems = collect_invariant_name(leftover)
  problems << APP_REQUIRED if app_filter.nil? || app_filter.empty?
  problems << "--days is required" if days.nil?
  problems << "--reason is required" if reason.nil? || reason.empty?
  days_i = days && (Integer(days) rescue nil)
  problems << "--days must be an integer >= 1" if days && (days_i.nil? || days_i < 1)
  report_arg_problems("snooze", problems, usage_for("invariants snooze"))

  endpoints = resolve_endpoints(app_filter, use_localhost)

  handle_errors do
    endpoints.each do |endpoint|
      res = ApiClient.request(endpoint, :post, "/dev/invariant/snoozes",
                              body: { invariant_name: name, days: days_i, reason: reason })
      puts "#{endpoint[:name]}: snoozed #{res['invariant_name']} until #{res['snoozed_until']}"
    end
  end
end

def cmd_invariants_unsnooze(args)
  rest, app_filter, use_localhost = parse_common_flags(args)
  name, problems = collect_invariant_name(rest)
  problems << APP_REQUIRED if app_filter.nil? || app_filter.empty?
  report_arg_problems("unsnooze", problems, usage_for("invariants unsnooze"))
  endpoints = resolve_endpoints(app_filter, use_localhost)

  handle_errors do
    endpoints.each do |endpoint|
      ApiClient.request(endpoint, :delete, "/dev/invariant/snoozes/#{URI.encode_www_form_component(name)}")
      puts "#{endpoint[:name]}: removed snooze for #{name}"
    end
  end
end

# ---------- tasks ----------

def cmd_tasks_requeue(args)
  rest, app_filter, use_localhost = parse_common_flags(args)
  reject_unknown_args("tasks requeue", rest)
  endpoints = resolve_endpoints(app_filter, use_localhost)

  puts ""
  puts Util.underline("Requeuing Failed Tasks#{use_localhost ? ' (localhost)' : ''}")
  puts ""

  all_ok = true
  endpoints.each do |endpoint|
    begin
      res = ApiClient.request(endpoint, :post, "/dev/task/requeues", body: {})
      count = res && res["requeued"]
      puts "  #{endpoint[:name]}: #{count} tasks requeued"
    rescue SessionExpired
      puts "  #{endpoint[:name]}: ERROR - session expired or invalid - run 'dev login'"
      all_ok = false
    rescue ApiError => e
      puts "  #{endpoint[:name]}: ERROR - #{e.message}"
      all_ok = false
    end
  end

  puts ""
  exit 1 unless all_ok
end

# ---------- issues ----------

ISSUE_STATUSES = %w[open claimed fixed deployed verified dismissed needs_input].freeze

# Routing key for a fix session: one category per session, one durable prompt
# body per category (devops/claude-issues/<category>-body.md). Mirrors the
# issue_category enum in the platform `issues` spec — keep them in step.
ISSUE_CATEGORIES = %w[graphs worker insights].freeze

# Model the spawned session runs on: Opus 4.8 with the 1M-context window. This is
# the interactive default (the `ccd` alias's model), NOT the headless-codegen
# `CODEGEN_CLAUDE_MODEL` (haiku) — a human is driving this one to fix real bugs.
ISSUE_CLAUDE_MODEL = "claude-opus-4-8[1m]".freeze

# The prompt handed to the spawned Claude session when exactly one category was
# claimed (one plan). Unchanged: the session works the plan directly.
def issue_session_prompt(path)
  "read the plan at #{path} and implement it"
end

# The prompt when several categories were claimed at once (one plan each). A
# single session can only take one TTY (we `exec`), so the parallelism moves
# INSIDE it: the session fans out one subagent per plan. Categories are
# independent pipelines/repos, so the subagents share no state.
def issue_fanout_prompt(plans)
  listed = plans.map { |category, path| "- #{category}: #{path}" }.join("\n")
  "#{plans.length} issue plans have been claimed, one per category. Dispatch ONE " \
    "subagent per plan and work them in parallel — do NOT implement the fixes " \
    "yourself in this session. Give each subagent its plan path and tell it to read " \
    "the plan, implement the fixes, open PRs, and close each issue with " \
    "`dev issues status`. Plans:\n#{listed}"
end

# The prompt for the spawned session, keyed on how many category plans were
# claimed: today's single-plan prompt for one, the subagent fan-out for several.
# `plans` is a list of [category, plan_path].
def issue_claim_prompt(plans)
  plans.length == 1 ? issue_session_prompt(plans.first[1]) : issue_fanout_prompt(plans)
end

# Pure, testable seam: the argv for the interactive session `dev issues claim`
# launches after writing the plan(s). Mirrors the `ccd` alias
# (`claude --dangerously-skip-permissions`) pinned to Opus 4.8 (1M context).
def issue_claude_argv(prompt)
  ["claude", "--dangerously-skip-permissions", "--model", ISSUE_CLAUDE_MODEL, prompt]
end

# Single-plan argv (kept as the one-plan spawn path and its regression test).
def issue_claude_command(path)
  issue_claude_argv(issue_session_prompt(path))
end

# Known categories (in ISSUE_CATEGORIES order) that have at least one open issue
# in `open`. Drives both the grouped preview and the per-category claim loop, so
# an unknown/retired category in the tracker is simply never claimed here.
def issue_categories_present(open)
  ISSUE_CATEGORIES.select { |cat| open.any? { |c| c["category"] == cat } }
end

# The issue tracker is tenant-scoped (/:tenant_id/issues) and authorized for a
# playbook tenant admin, not the platform tenant that `dev login` stores —
# authenticate with the persisted playbook session (`dev login --app playbook`) on
# the platform host.
def issue_endpoint(use_localhost)
  ApiClient.tenant_endpoint("playbook", use_localhost: use_localhost)
end

# Every issues path is scoped to the playbook tenant; the session that authorizes
# the call is the same tenant's, so the id is a constant here.
ISSUE_TENANT_ID = "playbook".freeze

def issues_path(suffix = "")
  "/#{ISSUE_TENANT_ID}/issues#{suffix}"
end

# Path to the issues LIST endpoint filtered to one or more statuses. The spec
# parameter is `statuses` (a repeatable list of issue_status) — NOT `status`. A
# singular `status=open` is an unknown parameter the server silently ignores, so
# it returns issues in EVERY status. That made `dev issues claim` preview (and
# `dev issues reconcile`) act on the whole tracker: e.g. offering to "claim 35
# issues" when only the open ones would actually be claimed server-side. Always
# name the parameter `statuses` so the filter applies.
def issues_list_path(statuses:, category: nil, limit: 100)
  params = { "statuses" => Array(statuses) }
  params["category"] = category if category
  params["limit"] = limit
  params["offset"] = 0
  issues_path("?#{URI.encode_www_form(params)}")
end

# Fail with the exact login command when there is no playbook session yet, rather
# than the generic "run 'dev login'" that handle_errors emits on a 401.
def require_playbook_session!(use_localhost)
  return unless ApiClient.session_id_for("playbook", use_localhost: use_localhost).nil?
  Util.exit_with_error("No playbook session#{use_localhost ? ' (localhost)' : ''}. Run `dev login --app playbook#{use_localhost ? ' --localhost' : ''}` first.")
end

# Display identity of an issue: the per-tenant number, e.g. ISS-034.
def issue_label(issue)
  "ISS-#{issue['number']}"
end

# Human label for the club an issue belongs to. Child clubs are named bare
# ("Baltimore", "Fountain") and are ambiguous without their parent, so render
# "Parent / Child" when the club has a parent. Falls back to the club id, then "?".
def issue_club_label(issue)
  club = issue["club"] || {}
  name = club["name"] || club["id"] || "?"
  parent = club["parent"]
  parent_name = parent && (parent["name"] || parent["id"])
  parent_name.nil? || parent_name.empty? ? name : "#{parent_name} / #{name}"
end

# Who filed it: audit_stamp.by, most identifying field first.
def issue_author_label(issue)
  by = issue.dig("created", "by") || {}
  by["name"] || by["nickname"] || by["email"] || by["id"] || "?"
end

def issue_summary_line(issue, index)
  title = issue["title"].to_s.gsub(/\s+/, " ").strip
  title = "#{title[0, 57]}..." if title.length > 60
  # club is playbook-only context: absent on fleet-wide auto-filed issues.
  club = issue["club"] ? "#{issue_club_label(issue)} · " : ""
  "  #{index}. #{issue_label(issue)} · #{issue['category']} · #{issue['status']} · #{club}#{title}"
end

# One claimed issue rendered as a plan section. Kept separate (and pure) so the
# plan output is unit-testable without any network calls.
def issue_render_item(issue, index)
  lines = []
  lines << "### #{index}. #{issue_label(issue)} — #{issue['title']}"
  lines << ""
  lines << "- Issue: `#{issue_label(issue)}` (id `#{issue['id']}`)"
  lines << "- Category: #{issue['category']}"
  lines << "- Status: #{issue['status']}"
  lines << "- Severity: #{issue['severity'] || 'unspecified'}"
  lines << "- Club: #{issue_club_label(issue)} (`#{issue.dig('club', 'id')}`)" if issue["club"]
  lines << "- Created: #{issue.dig('created', 'at')} by #{issue_author_label(issue)}"
  lines << "- Occurrences: #{issue['occurrence_count'] || 1}"
  lines << "- Fingerprint: `#{issue['fingerprint']}`" if issue["fingerprint"] && !issue["fingerprint"].empty?
  attachments = (issue["attachments"] || []).map do |a|
    url = a.dig("file", "url")
    next if url.nil? || url.empty?
    desc = a["description"]
    desc.nil? || desc.empty? ? url : "#{url} (#{desc})"
  end.compact
  lines << "- Attachments: #{attachments.empty? ? 'none' : attachments.join(', ')}"
  body = issue["body"].to_s
  unless body.empty?
    lines << ""
    lines << "> #{body.gsub("\n", "\n> ")}"
  end
  lines.join("\n")
end

# Durable per-category orientation (pipeline map, decoding guide, working rules)
# appended to every generated plan. Read from disk rather than inlined so the
# prose lives in one editable place, and one file per category so a session only
# ever sees the pipeline it is working in.
def issue_body_text(category)
  File.read(File.expand_path("../claude-issues/#{category}-body.md", __dir__))
end

def issue_plan_markdown(items:, date:, category:, body:)
  rendered = items.each_with_index.map { |c, i| issue_render_item(c, i + 1) }.join("\n\n")
  <<~PLAN
    # #{category} issues — #{items.length} item(s) claimed #{date}

    Generated by `dev issues claim --category #{category}`. These issues are CLAIMED
    (status `claimed`) and waiting for you. Implement the fixes, open PRs, and close
    each issue with `dev issues status` (below) so nothing stays stuck in `claimed`.

    ## Issues to fix

    #{rendered}

    ---

    #{body.strip}

    ## Closing each issue (do this — issues must not stay `claimed`)

    Run from anywhere (re-authenticates from ~/code/env each call). `<number>` is the
    issue number shown above (e.g. `034`; unpadded `34` works too):

    - Fixed in a merged PR → `dev issues status <number> --status fixed --url "<PR URL>" --app <deployable-app> --baseline-version <live version>`
      (--app + --baseline-version let `dev issues reconcile` flip the issue to `deployed`
      once that app releases past the baseline. `dev deploy status` lists the deployable
      app names and their live release tags — read the tag BEFORE your fix ships.)
    - Fixed by a document (process/manual fix, e.g. a Google Doc) →
      `dev issues status <number> --status fixed --url "<doc URL>"`
      (no app/baseline: nothing to detect, so `deployed` is set by hand later)
    - Needs a human decision, or not actionable / already fixed →
      `dev issues status <number> --status needs_input --comment "<question or reason>"`
  PLAN
end

def write_issue_plan(items, category)
  date = Time.now.strftime("%Y-%m-%d")
  dir = File.expand_path("~/code/claude/plans")
  FileUtils.mkdir_p(dir)
  base = "#{date}-issues-#{category}"
  path = File.join(dir, "#{base}.md")
  n = 2
  while File.exist?(path)
    path = File.join(dir, "#{base}-#{n}.md")
    n += 1
  end
  File.write(path, issue_plan_markdown(items: items, date: date, category: category, body: issue_body_text(category)))
  path
end

def cmd_issues_claim(args)
  rest, _app, use_localhost = parse_common_flags(args)
  assume_yes = false
  spawn_session = true
  category = nil
  leftover = []
  i = 0
  while i < rest.length
    a = rest[i]
    case a
    when "--category"
      category = rest[i + 1]
      usage_exit("--category requires a value", example: usage_for("issues claim")) if category.nil?
      i += 2
    when "--yes", "-y"
      assume_yes = true
      i += 1
    when "--no-spawn"
      spawn_session = false
      i += 1
    else
      leftover << a
      i += 1
    end
  end

  problems = []
  problems << "unexpected argument(s): #{leftover.join(', ')}" unless leftover.empty?
  # --category is optional: with none, discover open issues across ALL categories
  # and claim each. When given it must still name a real category.
  problems << "--category must be one of: #{ISSUE_CATEGORIES.join(', ')}" if category && !category.empty? && !ISSUE_CATEGORIES.include?(category)
  report_arg_problems("issues claim", problems, usage_for("issues claim"))

  require_playbook_session!(use_localhost)

  handle_errors do
    endpoint = issue_endpoint(use_localhost)
    # No --category => one call returns every open issue (grouped below); with a
    # category the server filters to it. `present` is the enum-ordered set of
    # categories we will actually claim.
    open = ApiClient.request(endpoint, :get, issues_list_path(statuses: "open", category: category)) || []
    present = issue_categories_present(open)
    if present.empty?
      puts category ? "No open #{category} issues." : "No open issues."
      return
    end

    claimable = open.count { |c| present.include?(c["category"]) }
    puts ""
    present.each do |cat|
      issues = open.select { |c| c["category"] == cat }
      puts Util.underline("#{cat} (#{issues.length})")
      issues.each_with_index { |c, i| puts issue_summary_line(c, i + 1) }
      puts ""
    end

    unless assume_yes
      scope = present.length == 1 ? "#{present.first} issue(s)" : "issue(s) across #{present.length} categories"
      print "Claim #{claimable} open #{scope} and write plan(s)? [y/N] "
      answer = $stdin.gets&.strip&.downcase
      unless %w[y yes].include?(answer)
        puts "Aborted. Nothing claimed."
        return
      end
    end

    # Claim each present category server-side (one atomic claim per category, as
    # today) and write one plan per category actually claimed. A category the
    # race just lost (nothing claimed) is dropped with no plan.
    plans = []
    total_claimed = 0
    present.each do |cat|
      claimed = ApiClient.request(endpoint, :post, issues_path("/claims"), body: { category: cat }) || []
      next if claimed.empty?
      total_claimed += claimed.length
      path = write_issue_plan(claimed, cat)
      plans << [cat, path]
      puts "Claimed #{claimed.length} #{cat} issue(s) → #{path}"
    end

    if plans.empty?
      puts "Nothing claimed — the open issue(s) were just claimed by another session. No plan written."
      return
    end

    puts ""
    puts "Claimed #{total_claimed} issue(s) across #{plans.length} categor#{plans.length == 1 ? 'y' : 'ies'}."

    unless spawn_session
      if plans.length == 1
        puts "Hand it to a session with:  claude \"#{issue_session_prompt(plans.first[1])}\""
      else
        puts "Start a session and dispatch one subagent per plan:"
        plans.each { |cat, p| puts "  #{cat}: #{p}" }
      end
      return
    end

    # Hand the terminal directly to an interactive Claude session (Opus 4.8, 1M
    # context) so it starts immediately. One plan → it works the plan; several →
    # it fans out one subagent per plan. exec replaces this process, so the
    # session inherits the TTY and this is the last thing we do.
    puts plans.length == 1 ?
      "Starting Claude session (Opus 4.8, 1M context) to implement the plan..." :
      "Starting Claude session (Opus 4.8, 1M context) to dispatch one subagent per category plan..."
    puts "  (re-run with --no-spawn to just write the plan(s))"
    puts ""
    begin
      exec(*issue_claude_argv(issue_claim_prompt(plans)))
    rescue SystemCallError => e
      # `claude` not on PATH (or otherwise unlaunchable). The plan(s) are already
      # written, so degrade to the manual hand-off rather than a stack trace.
      warn "Could not start Claude (#{e.message}). The plan(s) are saved — run with:"
      warn "  claude \"#{issue_claim_prompt(plans)}\""
    end
  end
end

def cmd_issues_status(args)
  rest, target_app, use_localhost = parse_common_flags(args)
  status = nil
  comment = nil
  url = nil
  baseline_version = nil
  leftover = []
  i = 0
  while i < rest.length
    a = rest[i]
    case a
    when "--status"
      status = rest[i + 1]
      usage_exit("--status requires a value", example: usage_for("issues status")) if status.nil?
      i += 2
    when "--comment"
      comment = rest[i + 1]
      usage_exit("--comment requires a value", example: usage_for("issues status")) if comment.nil?
      i += 2
    when "--url"
      url = rest[i + 1]
      usage_exit("--url requires a value", example: usage_for("issues status")) if url.nil?
      i += 2
    when "--baseline-version"
      baseline_version = rest[i + 1]
      usage_exit("--baseline-version requires a value", example: usage_for("issues status")) if baseline_version.nil?
      i += 2
    else
      leftover << a
      i += 1
    end
  end

  number = leftover.shift
  has_app = !(target_app.nil? || target_app.empty?)
  has_baseline = !(baseline_version.nil? || baseline_version.empty?)
  problems = []
  problems << "missing issue number (positional argument, e.g. 034)" if number.nil? || number.empty?
  problems << "unexpected argument(s): #{leftover.join(', ')}" unless leftover.empty?
  problems << "--status is required" if status.nil? || status.empty?
  problems << "--status must be one of: #{ISSUE_STATUSES.join(', ')}" if status && !status.empty? && !ISSUE_STATUSES.include?(status)
  # Every fix links to how it shipped: a merged PR, or a document describing a
  # manual/process fix.
  problems << "marking fixed requires --url <url> (the merged PR, or a document describing the fix)" if status == "fixed" && (url.nil? || url.empty?)
  # --app + --baseline-version are the deploy-detection pair: together they let
  # `dev issues reconcile` flip the issue to `deployed`. One without the other
  # detects nothing, so it is always a mistake.
  problems << "--app requires --baseline-version (the app's live release tag at fix time)" if has_app && !has_baseline
  problems << "--baseline-version requires --app (the deployable app the fix ships in)" if has_baseline && !has_app
  report_arg_problems("issues status", problems, usage_for("issues status"))

  body = { status: status }
  body[:comment] = comment if comment && !comment.empty?
  body[:url] = url if url && !url.empty?

  if has_app
    registry = Work::Registry.load
    # deploy_tracked, not deployable: a fix can ship in an app (e.g. playbook-app)
    # that has no pingable prod URL, and reconcile reads its live version from k8s.
    app = registry.deploy_tracked.find { |a| a.name == target_app }
    unless app
      valid = registry.deploy_tracked.map(&:name).sort.join(", ")
      Util.exit_with_error("Unknown --app '#{target_app}'. Valid apps: #{valid}")
    end
    body[:app] = target_app
    body[:baseline_version] = baseline_version
  end

  require_playbook_session!(use_localhost)

  handle_errors do
    res = ApiClient.request(issue_endpoint(use_localhost), :put,
                            issues_path("/#{URI.encode_www_form_component(number)}/status"),
                            body: body)
    puts "#{issue_label(res)}: status set to #{res['status']}"
    puts "  target app: #{target_app} (baseline #{baseline_version})" if has_app
  end
end

# The deploy-detection info of the most recent fix, or nil when the latest fix
# shipped without one (a document fix — advanced to `deployed` by hand).
def issue_fix_deployment(issue)
  (issue["fixes"] || []).last&.fetch("deployment", nil)
end

# Flip `fixed` issues to `deployed` once their target app has released past the fix.
# Read-only against the deploy registry (the same live-version signal `dev deploy status`
# uses) — the release pipeline is never touched. Dry-run by default; --apply records
# the transitions.
def cmd_issues_reconcile(args)
  rest, _app, use_localhost = parse_common_flags(args)
  apply = false
  leftover = []
  rest.each { |a| a == "--apply" ? (apply = true) : leftover << a }
  reject_unknown_args("issues reconcile", leftover)
  require_playbook_session!(use_localhost)

  registry = Work::Registry.load
  version_cache = {}

  handle_errors do
    endpoint = issue_endpoint(use_localhost)
    fixed = ApiClient.request(endpoint, :get, issues_list_path(statuses: "fixed")) || []
    if fixed.empty?
      puts "No fixed issues awaiting deploy."
      return
    end

    deployed = 0
    skipped = 0
    fixed.each do |c|
      deployment = issue_fix_deployment(c)
      if deployment.nil?
        puts "  skip #{issue_label(c)}: no deploy info (document fix — advance manually)"
        skipped += 1
        next
      end
      app_name = deployment["app"]
      info = version_cache[app_name] ||= begin
        app = registry.deploy_tracked.find { |a| a.name == app_name }
        app ? fetch_app_version(registry, app) : { error: "unknown app '#{app_name}'" }
      end
      if info[:error]
        puts "  skip #{issue_label(c)} (#{app_name}): #{info[:error]}"
        skipped += 1
        next
      end

      live = info["version"]
      if issue_released_since_fix?(info, c)
        if apply
          ApiClient.request(endpoint, :put,
                            issues_path("/#{URI.encode_www_form_component(c['number'])}/status"),
                            body: { status: "deployed", comment: "Deployed in #{app_name} #{live}" })
          puts "  deployed #{issue_label(c)} (#{app_name}: #{deployment['baseline_version'] || '?'} -> #{live})"
        else
          puts "  would deploy #{issue_label(c)} (#{app_name}: #{deployment['baseline_version'] || '?'} -> #{live})"
        end
        deployed += 1
      else
        puts "  waiting  #{issue_label(c)} (#{app_name}: still #{live})"
      end
    end

    puts ""
    puts "#{deployed} #{apply ? 'deployed' : 'would deploy'}, #{skipped} skipped, #{fixed.length} fixed total."
    puts "Re-run with --apply to record the transitions." if !apply && deployed > 0
  end
end

# True when the target app has released since the fix was recorded. Primary signal:
# release timestamp is newer than fixed_at (can't false-positive on a later tag that
# predates the fix). Falls back to "live tag differs from the fix-time baseline" when a
# timestamp is missing or unparseable.
def issue_released_since_fix?(info, issue)
  released_at = info["released_at"]
  fixed_at = issue["fixed_at"]
  if released_at && fixed_at
    begin
      return Time.parse(released_at) > Time.parse(fixed_at)
    rescue ArgumentError
      # fall through to tag comparison
    end
  end
  baseline = issue_fix_deployment(issue)&.fetch("baseline_version", nil)
  live = info["version"]
  !baseline.nil? && !live.nil? && live != baseline
end

# ---------- docker prune ----------

def cmd_docker_prune(args)
  days = 7
  apply = false
  while (arg = args.shift)
    case arg
    when "--days"
      raw = args.shift or usage_exit("--days requires a value", example: usage_for("docker prune"))
      days = Integer(raw) rescue usage_exit("--days must be an integer", example: usage_for("docker prune"))
    when "--apply" then apply = true
    when "-h", "--help" then puts USAGE; exit 0
    else usage_exit("Unknown flag: #{arg}", example: usage_for("docker prune"))
    end
  end
  usage_exit("--days must be > 0", example: usage_for("docker prune")) if days <= 0

  hours = days * 24
  filter = "until=#{hours}h"

  puts "Pruning Docker resources older than #{days} day(s) (filter: #{filter})."
  puts ""
  puts "Pre-prune state:"
  abort("docker not available or daemon not running") unless system("docker", "system", "df")
  puts ""
  puts "(dry-run — pass --apply to remove)" unless apply

  steps = [
    ["containers",  ["docker", "container", "prune", "-f", "--filter", filter]],
    ["images",      ["docker", "image",     "prune", "-af", "--filter", filter]],
    ["build cache", ["docker", "builder",   "prune", "-af", "--filter", filter]],
    ["volumes (all dangling — no age filter)", ["docker", "volume", "prune", "-f"]],
  ]
  steps.each do |label, cmd|
    puts ""
    suffix = apply ? "" : "  (dry-run, skipping)"
    puts "==> #{label}: #{cmd.join(' ')}#{suffix}"
    next unless apply
    abort("FAILED at step: #{label}") unless system(*cmd)
  end

  puts ""
  puts "Post-prune state:"
  system("docker", "system", "df")
end

# ---------- prod version probes ----------

def fetch_version(url)
  uri = URI.parse("#{url}/_internal_/version")
  # Follow a few redirects: a registry-resolved domain may 301 to the
  # canonical host (e.g. playbook-admin) while still serving the endpoint there.
  3.times do
    http = Net::HTTP.new(uri.host, uri.port)
    http.use_ssl = (uri.scheme == "https")
    http.open_timeout = 5
    http.read_timeout = 10
    res = http.request(Net::HTTP::Get.new(uri.request_uri))
    if res.is_a?(Net::HTTPRedirection) && res["location"]
      uri = URI.join(uri.to_s, res["location"])
      next
    end
    return { error: "HTTP #{res.code}" } unless res.code.to_i.between?(200, 299)
    return { error: "empty body" } if res.body.nil? || res.body.empty?
    return JSON.parse(res.body)
  end
  { error: "too many redirects" }
rescue => e
  { error: e.message }
end

# For docker_k8s apps with no public ingress, read the live image tag straight
# from the cluster. The image tag is what's *actually* running and avoids
# requiring an HTTP /_internal_/version on internal-only services.
def fetch_k8s_version(app)
  ns = app.docker_k8s.namespace
  target = app.docker_k8s.rollout_target  # e.g. "statefulset/workers"
  image, status = Open3.capture2(
    "kubectl", "-n", ns, "get", target,
    "-o", "jsonpath={.spec.template.spec.containers[0].image}"
  )
  return { error: "kubectl get #{target}: failed" } unless status.success?
  image = image.strip
  return { error: "kubectl returned empty image" } if image.empty?
  # Tag is everything after the LAST ':' in the final path segment — this
  # avoids treating a registry port (host:5000/...) as the tag.
  last_segment = image.split("/").last
  tag = last_segment.include?(":") ? last_segment.split(":", 2)[1] : nil
  return { error: "image has no tag: #{image}" } if tag.nil? || tag.empty?

  # released_at = the current pod's start time. This approximates "when this
  # version went live" but advances on any pod restart (OOM kill, liveness
  # failure) — not strictly the deploy time. Good enough for the versions
  # command; we'd need a deploy annotation for a true deploy timestamp.
  started_at, _ = Open3.capture2(
    "kubectl", "-n", ns, "get", "pod",
    "-l", "app=#{app.name}",
    "-o", "jsonpath={.items[0].status.startTime}"
  )
  released_at = started_at.strip
  released_at = nil if released_at.empty?

  { "version" => tag, "released_at" => released_at }
rescue => e
  { error: e.message }
end

def fetch_app_version(registry, app)
  url = registry.prod_url(app)
  return fetch_version(url) if url
  return fetch_k8s_version(app) if app.docker_k8s
  { error: "no prod url or docker_k8s config" }
end

# ---------- deploy (fleet release state) ----------

def db_repo?(name)
  name.end_with?("-postgresql")
end

def deploy_state_for(name, dir, app: nil, registry: nil)
  return { error: "no checkout at #{dir}" } unless File.directory?(File.join(dir, ".git"))

  fetch_err = `git -C #{dir} fetch -q origin 2>&1`
  return { error: "fetch failed: #{fetch_err.strip}" } unless $?.success?

  tag_out, tag_status = Open3.capture2("sem-info", "tag", "latest", chdir: dir)
  tag = tag_status.success? ? tag_out.strip : ""
  return { error: "no tag" } if tag.empty? || tag == "0.0.0"

  ref = `git -C #{dir} rev-parse --verify --quiet origin/main`.strip
  ref = `git -C #{dir} rev-parse --verify --quiet origin/master`.strip if ref.empty?
  return { error: "no origin/main" } if ref.empty?

  count = `git -C #{dir} rev-list --count #{tag}..#{ref}`.strip.to_i
  last = `git -C #{dir} log -1 --format=%h\\ %s #{ref}`.strip
  { tag: tag, ahead: count, last: last }.merge(prod_status(registry, app, tag))
end

# Compare the *running* production version against the latest tag. Git state
# alone cannot distinguish "released and deployed" from "tagged but the deploy
# failed or never ran" — only asking prod catches the latter. Reuses the same
# probes as `dev deploy status` (/_internal_/version, or the live k8s image tag).
# Items with nothing to ask — *-postgresql repos and apps with no prod probe
# (host-derived-tenant frontends like playbook-app) — stay git-only.
def prod_status(registry, app, tag)
  return {} unless registry && app
  return {} unless registry.prod_url(app) || app.docker_k8s
  v = fetch_app_version(registry, app)
  return { prod_error: v[:error] } if v[:error]
  prod = (v["version"] || "").to_s.strip
  return { prod_error: "prod reported an empty version" } if prod.empty?
  { prod: prod, prod_stale: prod != tag }
end

# The single definition of "needs a release": unreleased commits on
# origin/main, or the latest tag is not what production is running.
# Shared by `deploy status` and `deploy all` so they never disagree.
def needs_deploy?(d)
  d[:error].nil? && (d[:ahead].to_i > 0 || d[:prod_stale])
end

# The local checkout of a deployable: ~/code/<repo>, which is not always
# ~/code/<app name> — a deployable can be rebranded ahead of its repo.
def app_checkout_dir(app)
  File.expand_path("~/code/#{app.repo_name}")
end

# Same, by deploy-item name. Falls back to the name itself for items with no
# registry entry (the derived <repo>-postgresql DB repos).
def deploy_item_dir(name)
  app = cached_registry.find(name)
  app ? app_checkout_dir(app) : File.expand_path("~/code/#{name}")
end

# Loading the registry shells out to `pkl eval` per app, so share one across the
# release fan-out. Racing threads may each build one; they are identical.
def cached_registry
  $cached_registry ||= Work::Registry.load
end

def deploy_items(registry = Work::Registry.load)
  # deploy_tracked (not deployable): we release every non-ignored app with a real
  # deploy path, including host-derived-tenant apps like playbook-app that have no
  # single pingable prod URL and so are absent from `deployable`.
  items = registry.deploy_tracked.map { |app| [app.name, app_checkout_dir(app), app] }
  # DB repos are derived from the apps registry, not a filesystem glob: every
  # deployable scala app declares a database in its config.pkl and ships a
  # conventional "<repo>-postgresql" repo checked out next to it. Driving
  # discovery from the registry keeps stray/abandoned *-postgresql checkouts
  # out of the list; scoping to deploy_tracked excludes ignored/archived apps.
  registry.deploy_tracked.select { |app| app.stack == :scala }.each do |app|
    db = "#{app.repo_name}-postgresql"
    items << [db, File.expand_path("~/code/#{db}"), nil]
  end
  # Array#uniq keeps the first occurrence, so deployable-app entries win over a
  # DB entry if a name collides. Don't reorder.
  items.uniq { |name, _| name }.sort_by { |name, _| name }
end

def resolve_deploy_items(name_filter)
  registry = Work::Registry.load
  all_items = deploy_items(registry)
  items = name_filter ? all_items.select { |name, _| name == name_filter } : all_items
  if items.empty?
    valid = all_items.map(&:first).join(", ")
    Util.exit_with_error("Unknown app '#{name_filter}'. Valid names: #{valid}")
  end
  items.map { |name, dir, app| Thread.new { [name, deploy_state_for(name, dir, app: app, registry: registry)] } }.map(&:value)
end

# Prints one row of the deploy status table. Column widths are shared across
# every section so the two buckets stay aligned under one set of headers.
def print_deploy_status_row(name, d, name_w, tag_w, prod_w)
  if d[:error]
    puts "#{name.ljust(name_w)}  ERROR - #{d[:error]}"
    return
  end
  status = []
  status << "+#{d[:ahead]} unreleased" if d[:ahead] > 0
  status << "tag #{d[:tag]} not deployed" if d[:prod_stale]
  # A failed prod probe means we could not verify what production is running —
  # it does NOT mark the app pending, but it must not pass silently either.
  status << "prod check failed: #{d[:prod_error]}" if d[:prod_error]
  status << "up to date" if status.empty?
  puts "#{name.ljust(name_w)}  #{(d[:tag] || '').ljust(tag_w)}  #{(d[:prod] || '-').ljust(prod_w)}  #{status.join(', ')}"
end

# Prints every tracked item with its latest tag, the version production is
# running, and a status — the full fleet picture even when everything is up to
# date. When the fleet is a mix of up-to-date and pending apps, the pending ones
# are split into a trailing "needs deploy" section so what actually needs a
# release is easy to pick out; a uniform fleet prints as a single table.
def print_deploy_status_table(rows)
  name_w = rows.map { |n, _| n.length }.max
  tag_w  = [rows.map { |_, d| (d[:tag] || "").length }.max, "tag".length].max
  prod_w = [rows.map { |_, d| (d[:prod] || "-").length }.max, "prod".length].max
  header = "#{'app'.ljust(name_w)}  #{'tag'.ljust(tag_w)}  #{'prod'.ljust(prod_w)}  status"

  pending, current = rows.partition { |_, d| needs_deploy?(d) }

  # Uniform fleet (all current, or all pending): one plain table, no sections.
  if pending.empty? || current.empty?
    puts header
    rows.each { |name, d| print_deploy_status_row(name, d, name_w, tag_w, prod_w) }
    return
  end

  puts header
  current.each { |name, d| print_deploy_status_row(name, d, name_w, tag_w, prod_w) }
  puts ""
  puts "needs deploy"
  puts header
  pending.each { |name, d| print_deploy_status_row(name, d, name_w, tag_w, prod_w) }
end

# Whether we can prompt. A pipe or cron has no one to answer, so the caller must
# print and exit instead of blocking on stdin forever.
def interactive_terminal?
  $stdin.tty?
end

# The default `dev deploy`: show the fleet, then offer to release whatever is
# pending. Selecting items runs the same orchestration as `deploy all`.
def cmd_deploy_status(args)
  rest, name_filter, _ = parse_common_flags(args)
  reject_unknown_args("deploy status", rest)
  rows = resolve_deploy_items(name_filter)

  print_deploy_status_table(rows)

  pending = rows.select { |_, d| needs_deploy?(d) }.map(&:first)
  if pending.empty?
    puts ""
    puts "All production apps are running the latest versions."
    return
  end

  unless interactive_terminal?
    puts ""
    puts "#{pending.length} pending: #{pending.join(', ')} (run `dev deploy all` to release)"
    return
  end

  puts ""
  noun = pending.length == 1 ? "item needs" : "items need"
  selected = Ask.select_multiple_from_list("#{pending.length} #{noun} a release. Deploy which?", pending)
  if selected.empty?
    puts ""
    puts "Nothing selected."
    return
  end

  puts ""
  # Detection errors are already shown in the table above, so they are not
  # repeated in the release summary.
  run_deploys(selected, concurrency: DEPLOY_CONCURRENCY_DEFAULT)
end

# Apps release in parallel; DBs are always serial regardless of this.
DEPLOY_CONCURRENCY_DEFAULT = 10

def parse_deploy_all_args(args)
  app_filter = nil
  concurrency = DEPLOY_CONCURRENCY_DEFAULT
  i = 0
  while i < args.length
    a = args[i]
    case a
    when "--app"
      app_filter = args[i + 1]
      usage_exit("--app requires a value", example: usage_for("deploy all")) if app_filter.nil?
      i += 2
    when "--concurrency"
      raw = args[i + 1]
      usage_exit("--concurrency requires a positive integer", example: usage_for("deploy all")) if raw.nil? || raw.to_i <= 0
      concurrency = raw.to_i
      i += 2
    else
      usage_exit("Unknown argument: #{a}", example: usage_for("deploy all"))
    end
  end
  [app_filter, concurrency]
end

def parse_codegen_sync_args(argv)
  opts = { app: nil, concurrency: 4, dry_run: false, regen_only: false, full_tests: false }
  args = argv.dup
  until args.empty?
    case (a = args.shift)
    when "--app"
      opts[:app] = args.shift or usage_exit("--app requires a value", example: usage_for("codegen sync"))
    when "--concurrency"
      n = args.shift.to_i
      usage_exit("--concurrency must be a positive integer", example: usage_for("codegen sync")) if n < 1
      opts[:concurrency] = n
    when "--dry-run"    then opts[:dry_run] = true
    when "--regen-only" then opts[:regen_only] = true
    when "--full-tests" then opts[:full_tests] = true
    else usage_exit("unknown option #{a}", example: usage_for("codegen sync"))
    end
  end
  opts
end

CODEGEN_DEVOPS_REPO = "mbryzek/devops".freeze
# Every sweep uses a fresh, unique branch (`<prefix>-<run_id>`) so a leftover
# branch from a prior run never blocks or gets clobbered. The gate against
# duplicate work is an OPEN PR (see open_codegen_pr), not branch existence.
CODEGEN_BRANCH_PREFIX = "codegen-sync".freeze
CODEGEN_STACKS = %i[scala elm sveltekit].freeze
CODEGEN_CLAUDE_TIMEOUT_SECS = 20 * 60
# The per-repo sessions do mechanical work (fix compile errors, commit, open a
# PR), so a cheap/fast model is the right default.
CODEGEN_CLAUDE_MODEL = "haiku".freeze

def github_origin(repo_slug)
  "git@github.com:#{repo_slug}.git"
end

# Every repo's `.api/config.pkl` does `amends "../../devops/..."`, resolved
# relative to the file's own path two directories up. That's the shape of a
# normal checkout (`~/code/<repo>/.api/config.pkl`, with `devops` a sibling of
# `<repo>` under `~/code`). A scratch clone at `<workdir>/<repo>/.api/config.pkl`
# needs the same shape one level in: `devops` cloned as a sibling of every repo
# clone, i.e. at `<workdir>/devops` — NOT the real `~/code/devops` (verified via
# `pkl eval`: the amends is a plain relative-path resolution against the config
# file's own location, so a workdir nested under `~/code` does not reach the
# real `~/code/devops`). Cloned fresh from GitHub main every run — including a
# same-date rerun that reuses `workdir` — so the sweep never drives codegen off
# a stale sibling left over from a prior run; `clone_repo` wipes any existing
# dir before cloning.
def ensure_codegen_devops(workdir)
  captured = +""
  clone_path = clone_repo(github_origin(CODEGEN_DEVOPS_REPO), "devops", workdir, false, captured)
  Util.exit_with_error("codegen sync: failed to clone devops into #{workdir}:\n#{captured}") unless clone_path
  clone_path
end

# `Codegen::ApiConfig.load` runs `pkl eval` under the hood (via the top-level
# `ApiConfig` class), which calls `Util.exit_with_error` (hard `exit 1`) on any
# parse failure. That's fine for a single-repo CLI invocation but would abort
# the entire multi-repo sweep here — one repo's bad pkl state shouldn't take
# down every other repo's run. Rescue both the raised SystemExit and any
# StandardError and treat it as "no config for this repo" instead.
def safe_load_api_config(clone_path)
  Codegen::ApiConfig.load(clone_path)
rescue SystemExit, StandardError => e
  warn "codegen sync: failed to parse #{clone_path}/.api/config.pkl: #{e.message}"
  nil
end

# Which registry apps to clone + parse for this run. A single-consumer `--app`
# needs nothing else (its own `.api/config.pkl` fully determines its stack and
# generators). A single-backend `--app` needs every consumer candidate cloned
# too, so `Codegen::Graph` can compute which consumers actually depend on it
# (a consumer's dependency on a backend is only knowable by intersecting the
# consumer's parsed `app_names` with the backend's, which requires cloning the
# consumer). No `--app` (full sweep) needs everything.
def codegen_clone_set(target, eligible)
  return eligible if target.nil?
  return [target] if target.stack != :scala
  [target] + eligible.reject { |a| a.stack == :scala }
end

# Resolves `--app` against the eligible (non-ignored, scala/elm/sveltekit)
# registry apps. nil means "no filter" (full sweep). Exits with a clear error
# if the name matches neither a backend nor a consumer.
def resolve_codegen_target(app_filter, eligible)
  return nil if app_filter.nil?
  target = eligible.find { |a| a.name == app_filter }
  return target if target
  Util.exit_with_error(
    "codegen sync: '#{app_filter}' is not an eligible app. " \
    "Eligible: #{eligible.map(&:name).sort.join(', ')}"
  )
end

# Given the resolved target (nil = full sweep, or an eligible registry App with
# #name/#stack) and the built graph, returns the ordered run plan:
#   { backends: [sorted names], consumers: [sorted names], run_names: [...] }
# Full sweep runs all backends then all consumers. A scala (backend) target runs
# that backend plus only the consumers that depend on it. A consumer target runs
# just that consumer (empty if it isn't in the graph).
def codegen_run_plan(target, graph)
  run_names =
    if target.nil?
      graph.backends + graph.consumers
    elsif target.stack == :scala
      [target.name] + graph.consumers.select { |c| graph.depends_on(c).include?(target.name) }
    else
      [target.name] & (graph.backends + graph.consumers)
    end
  {
    backends: (run_names & graph.backends).sort,
    consumers: (run_names & graph.consumers).sort,
    run_names: run_names,
  }
end

# Generic concurrency-capped worker pool, modeled directly on `release_concurrent`
# (Queue + fixed-size Thread pool, `pop(true) rescue nil` to drain without
# blocking) but generic over the per-name block instead of hardcoding
# `release_one`, since codegen's per-repo work (`run_repo`) has a different
# signature. Returns { name => block-result }.
def run_concurrent(names, concurrency)
  results = {}
  return results if names.empty?
  mutex = Mutex.new
  queue = Queue.new
  names.each { |n| queue << n }
  workers = Array.new([concurrency, names.length].min) do
    Thread.new do
      while (name = (queue.pop(true) rescue nil))
        mutex.synchronize { puts "  #{name} [starting]" }
        result =
          begin
            yield name
          rescue => e
            { status: :error, error: "worker crashed: #{e.class}: #{e.message}" }
          end
        mutex.synchronize do
          results[name] = result
          puts "  #{name} [#{result[:status]}]"
        end
      end
    end
  end
  workers.each(&:join)
  results
end

# Every dir in the clone that has its own `.api/config.pkl` — `api` must run in
# each. Some repos have a second one under ./playwright (its own test-client
# config); the root `api` run does not regenerate those, so without this the
# wipe would leave playwright/generated files deleted. Root (shortest) first.
def codegen_api_dirs(clone)
  Dir.glob(File.join(clone, "**", ".api", "config.pkl"), File::FNM_DOTMATCH)
     .reject { |p| p.include?("#{File::SEPARATOR}node_modules#{File::SEPARATOR}") }
     .map { |p| File.dirname(File.dirname(p)) }
     .uniq
     .sort_by(&:length)
end

# `git checkout` every modified file whose diff is only noise — the apibuilder
# `Service version:` timestamp comment and/or the trailing-newline the generator
# omits — so a no-op regen stays out of the diff. Only modified (M) files are
# considered; deleted orphans and new files are never noise. Returns the count.
def revert_noise_only_changes(clone)
  _, names = run_step(["git", "diff", "--name-only", "--diff-filter=M"], clone, false, +"")
  reverted = 0
  names.to_s.split("\n").map(&:strip).reject(&:empty?).each do |f|
    _, diff = run_step(["git", "diff", "--", f], clone, false, +"")
    next unless Codegen::Sync.noise_only_diff?(diff)
    run_step(["git", "checkout", "--", f], clone, false, +"")
    reverted += 1
  end
  reverted
end

# URL of an already-open PR from a prior codegen sweep for this repo (its head
# branch starts with the codegen-sync prefix), or nil. `gh` infers the repo
# from the clone's origin.
def open_codegen_pr(clone)
  _, out = run_step(["gh", "pr", "list", "--state", "open", "--limit", "200", "--json", "url,headRefName"], clone, false, +"")
  Codegen::Sync.open_codegen_pr_url(out, CODEGEN_BRANCH_PREFIX)
end

# Deterministic, mechanical pass for one repo: branch, wipe generated files,
# rerun `api`, classify the diff. Only reaches for Claude if there's an actual
# diff and the caller isn't in --dry-run.
def run_repo(name, workdir, stack, opts, branch, &announce)
  clone = File.join(workdir, name)
  note = ->(msg) { announce&.call(msg) }

  # Gate on an OPEN PR, not on branch existence: this run uses a fresh unique
  # branch, so a leftover branch can't collide or be clobbered. But if a prior
  # sweep's PR for this repo is still open, don't stack a second one — skip and
  # let the human land/close it first. --dry-run never pushes, so it's exempt.
  unless opts[:dry_run]
    if (pr = open_codegen_pr(clone))
      return { status: :needs_attention, error: "an open codegen-sync PR already exists (#{pr}) — merge or close it before re-running" }
    end
  end

  # Fetch origin/main fresh and branch off FETCH_HEAD rather than trusting the
  # shallow clone's default-branch tip: a clone made earlier in a long sweep
  # (or reused across a rerun) can otherwise serve a stale main.
  fetch_ok, fetch_out = run_step(["git", "fetch", "--depth=1", "origin", "main"], clone, false, +"")
  return { status: :error, error: "fetch origin main failed: #{fetch_out}" } unless fetch_ok

  branch_ok, branch_out = run_step(["git", "checkout", "-B", branch, "FETCH_HEAD"], clone, false, +"")
  return { status: :error, error: "branch checkout failed: #{branch_out}" } unless branch_ok

  # Load the config purely to validate it parses — a repo whose .api/config.pkl
  # is broken should error rather than silently regenerate nothing. The wipe
  # itself is marker-driven and needs no config.
  return { status: :error, error: "no usable .api/config.pkl" } unless safe_load_api_config(clone)

  wiped = Codegen::Sync.generated_paths(clone).each { |p| File.delete(p) if File.exist?(p) }
  note.call("wiped #{wiped.length} generated file(s)")

  # For a backend, bare `api` uploads specs to the shared registry AND
  # regenerates — --dry-run must never mutate the shared registry, so it runs
  # codegen only. For a consumer `api` is already codegen-only, so this is a
  # no-op change for that case. Run it in every dir with a .api/config.pkl
  # (root, plus e.g. ./playwright) so all generated files are recreated — the
  # wipe deleted them all.
  api_cmd = opts[:dry_run] ? ["api", "codegen"] : ["api"]
  api_dirs = codegen_api_dirs(clone)
  base = stack == :scala && !opts[:dry_run] ? "uploading specs + regenerating (backend — can take a few minutes)" : "regenerating client"
  note.call("running api in #{api_dirs.length} config dir(s): #{base}…")
  api_dirs.each do |dir|
    log = +""
    ok, _ = run_step(api_cmd, dir, false, log)
    rel = dir == clone ? "." : dir.sub("#{clone}#{File::SEPARATOR}", "")
    return { status: :error, error: "api failed in #{rel}: #{log.strip}" } unless ok
  end

  reverted = revert_noise_only_changes(clone)
  note.call("reverted #{reverted} no-op (timestamp/whitespace) file(s)") if reverted.positive?

  porcelain, _ = Open3.capture2("git", "-C", clone, "status", "--porcelain")
  porcelain = porcelain.force_encoding(Encoding::UTF_8).scrub
  return { status: :in_sync } if Codegen::Sync.classify_diff(porcelain) == :in_sync
  return { status: :changed, note: "diff only (dry-run)" } if opts[:dry_run]

  # regen-only: commit the regen as-is and open a DRAFT PR — no build, no Claude.
  return commit_and_open_pr(clone, branch, draft: true) if opts[:regen_only]

  # Build-gate: if the regenerated repo builds, the change is clean — commit and
  # open the PR directly, NO Claude. Only a genuine build failure (a real API
  # contract change that broke consuming code) hands off to Claude to fix.
  verify_cmd = Codegen::Sync.verify_cmd_for(stack, full_tests: opts[:full_tests])
  note.call("verifying (#{verify_cmd})…")
  verify_ok, verify_log = run_verify(clone, stack, verify_cmd)
  if verify_ok
    note.call("build clean — committing + opening PR (no Claude)")
    commit_and_open_pr(clone, branch, draft: false)
  else
    note.call("build failed — handing to Claude to fix")
    prompt = Codegen::Sync.fix_prompt(repo: name, branch: branch,
                                      verify_cmd: verify_cmd, regen_only: false,
                                      build_error: verify_log)
    spawn_claude(clone, prompt)
  end
rescue => e
  { status: :error, error: "run_repo crashed: #{e.class}: #{e.message}" }
end

# Build/typecheck the regenerated repo so a clean regen can skip Claude. Installs
# node deps first when there's a package.json (a fresh clone has no
# node_modules; this also warms it for a Claude handoff on failure). Returns
# [ok, combined_log].
def run_verify(clone, stack, verify_cmd)
  log = +""
  if File.exist?(File.join(clone, "package.json"))
    ok, _ = run_step(["npm", "install", "--no-audit", "--no-fund"], clone, false, log)
    return [false, log] unless ok
  end
  ok, _ = run_step(verify_cmd.split, clone, false, log)
  [ok, log]
end

CODEGEN_COMMIT_MSG = "Sync regenerated apibuilder/DAO code".freeze

# Deterministic clean-regen path (no Claude): stage everything, commit, push the
# branch, and open a PR. Returns {status: :pr_opened, pr_url:} or an error /
# needs_attention hash. Never merges. draft: true opens a draft PR (regen-only).
def commit_and_open_pr(clone, branch, draft:)
  run_step(["git", "add", "-A"], clone, false, +"")
  commit_ok, commit_out = run_step(["git", "commit", "-m", CODEGEN_COMMIT_MSG], clone, false, +"")
  return { status: :error, error: "commit failed: #{commit_out}" } unless commit_ok
  push_ok, push_out = run_step(["git", "push", "-u", "origin", branch], clone, false, +"")
  return { status: :error, error: "push failed: #{push_out}" } unless push_ok
  # --head: the clone is single-branch (--depth=1), so its fetch refspec only
  # maps main and `git push -u` never creates refs/remotes/origin/<branch>.
  # Without --head, gh aborts with "you must first push the current branch".
  create = ["gh", "pr", "create", "--fill", "--head", branch]
  create << "--draft" if draft
  create_ok, create_out = run_step(create, clone, false, +"")
  url = create_out[%r{https://github\.com/\S+/pull/\d+}]
  unless create_ok && url
    return { status: :needs_attention, error: "PR create failed (clone left at #{clone}): #{create_out.to_s.strip}" }
  end
  { status: :pr_opened, pr_url: url }
end

# Thin integration glue: run a fresh Claude session in `clone` to make the
# regenerated repo build, commit, and open a draft PR (per the prompt built by
# `Codegen::Sync.fix_prompt`). Bounded by a timeout so one stuck repo can't hang
# the whole sweep. On timeout/failure the clone + branch are left in place
# (never deleted) so a human can pick up where Claude left off.
#
# Deliberately NOT `Open3.capture2e`/block-form `popen2e`: both wait on the
# child internally (capture2e blocks until exit; popen2e's block form runs a
# `wait_thr.join` in its `ensure`, which fires *before* our `rescue
# Timeout::Error` regains control) — a `Timeout.timeout` wrapped around either
# would unwind our Ruby frame while the orphaned `claude` process keeps running
# in the background, free to push/open a PR after we've already recorded
# :needs_attention. Instead we open the pipes ourselves, capture the pid before
# the blocking read, and on timeout kill the process directly.
def spawn_claude(clone, prompt)
  # pgroup: true makes the spawned `claude` process its own process group
  # leader (its pid == its pgid), so killing -pid on timeout signals the whole
  # group — including grandchildren like `gh pr create`/`git push` that could
  # otherwise outlive the direct child and still push/open a PR after we've
  # already recorded :needs_attention.
  # --dangerously-skip-permissions: a headless `claude --print` session has no
  # human to answer permission prompts, so without it every Bash/Edit/gh call is
  # blocked and the session does nothing (no commit, no push, no PR). It runs in
  # a throwaway clone and only ever pushes the codegen-sync branch, so the blast
  # radius is bounded.
  stdin, out_err, wait_thr = Open3.popen2e("claude", "--print", "--dangerously-skip-permissions", "--model", CODEGEN_CLAUDE_MODEL, prompt, chdir: clone, pgroup: true)
  stdin.close
  pid = wait_thr.pid

  output =
    begin
      Timeout.timeout(CODEGEN_CLAUDE_TIMEOUT_SECS) { out_err.read }
    rescue Timeout::Error
      begin
        Process.kill("TERM", -pid)
      rescue Errno::ESRCH
      end
      begin
        Process.kill("KILL", -pid)
      rescue Errno::ESRCH
      end
      return { status: :needs_attention, error: "claude --print timed out after #{CODEGEN_CLAUDE_TIMEOUT_SECS}s (clone left at #{clone}); process killed" }
    ensure
      out_err.close unless out_err.closed?
    end

  status = wait_thr.value
  # Same scrub as run_step: the PR-URL regex below must not crash on a
  # malformed byte in Claude's output.
  output = output.to_s.force_encoding(Encoding::UTF_8).scrub
  unless status.success?
    return { status: :needs_attention, error: "claude --print failed (clone left at #{clone}): #{output}" }
  end

  pr_url = output[%r{https://github\.com/\S+/pull/\d+}]
  return { status: :needs_attention, error: "claude finished but no PR URL found in output (clone left at #{clone})" } unless pr_url

  { status: :pr_opened, pr_url: pr_url }
end


# Pure, testable seam: one sorted [name, status_string, pr_url_or_dash] row per
# repo, shared by both the human-readable printer below and the
# machine-readable JSON writer so they can never drift out of agreement.
def codegen_status_rows(results)
  results.keys.sort.map do |name|
    r = results[name]
    [name, r[:status].to_s, r[:pr_url] || "-"]
  end
end

def print_codegen_summary(results)
  puts ""
  puts Util.underline("codegen sync summary")
  if results.empty?
    puts "  (no apps processed)"
    return
  end
  codegen_status_rows(results).each do |name, status, pr_url|
    r = results[name]
    line = +"  #{name} [#{status}]"
    line << " #{pr_url}" unless pr_url == "-"
    line << " (#{r[:note]})" if r[:note]
    line << " - #{r[:error]}" if r[:error]
    puts line
  end
end

# Writes codegen-sync-status.json into workdir: an array of
# {repo, status, pr_url, error} objects (pr_url/error may be nil) for
# openclaw's morning briefing to consume.
def write_codegen_status_json(workdir, results)
  data = results.keys.sort.map do |name|
    r = results[name]
    { repo: name, status: r[:status].to_s, pr_url: r[:pr_url], error: r[:error] }
  end
  File.write(File.join(workdir, "codegen-sync-status.json"), JSON.pretty_generate(data))
end

def cmd_codegen_sync(argv)
  opts = parse_codegen_sync_args(argv)
  registry = Work::Registry.load
  # One id per sweep, to the second, drives both the workdir and the branch
  # name so reruns never collide with a prior run's clones or remote branch.
  run_id = ENV["CODEGEN_SYNC_DATE"] || Time.now.strftime("%Y%m%d-%H%M%S")
  branch = "#{CODEGEN_BRANCH_PREFIX}-#{run_id}"
  workdir = File.expand_path("~/code/codegen-sync.#{run_id}")
  FileUtils.mkdir_p(workdir)
  ensure_codegen_devops(workdir)

  eligible = registry.apps.reject(&:ignored).select { |a| CODEGEN_STACKS.include?(a.stack) }
  target = resolve_codegen_target(opts[:app], eligible)
  to_clone = codegen_clone_set(target, eligible)

  puts "Working in #{workdir}"
  puts "Cloning #{to_clone.length} repo(s): #{to_clone.map(&:name).sort.join(', ')}"
  puts ""

  configs = {}
  to_clone.each_with_index do |app, i|
    puts "  [#{i + 1}/#{to_clone.length}] cloning #{app.name}…"
    clone_path = clone_repo(github_origin(app.repo), app.name, workdir, false, +"")
    if clone_path && File.exist?(File.join(clone_path, ".api", "config.pkl"))
      cfg = safe_load_api_config(clone_path)
      configs[app.name] = cfg if cfg
    end
    next if configs.key?(app.name)

    # A backend (scala) that silently drops out of `configs` vanishes from
    # `graph.backends` too (Graph.build filters on configs.key?) — the sweep
    # would print an empty summary with no error while consumers regenerate
    # against a registry missing that backend's specs. Fatal. A consumer
    # failing the same way is expected/handled: Graph.build already excludes
    # it from `graph.consumers`, so just warn and move on.
    if app.stack == :scala
      Util.exit_with_error(
        "codegen sync: backend '#{app.name}' has no usable .api/config.pkl " \
        "(clone failed, missing file, or parse error) — aborting sweep"
      )
    else
      warn "codegen sync: skipping '#{app.name}' — no usable .api/config.pkl (clone failed, missing file, or parse error)"
    end
  end

  graph = Codegen::Graph.build(apps: to_clone, configs: configs)

  plan = codegen_run_plan(target, graph)
  if target && plan[:run_names].empty?
    Util.exit_with_error("codegen sync: '#{target.name}' has no usable .api/config.pkl — nothing to run")
  end
  backend_names = plan[:backends]
  consumer_names = plan[:consumers]
  results = {}

  unless backend_names.empty?
    puts Util.underline("Backends (serial)")
    backend_names.each do |name|
      puts "  #{name}:"
      r = run_repo(name, workdir, :scala, opts, branch) { |msg| puts "    #{msg}" }
      results[name] = r
      report_repo_line(name, r[:status], r[:error] || r[:note], false)
    end
    puts ""
  end

  unless consumer_names.empty?
    puts Util.underline("Consumers (concurrency=#{opts[:concurrency]})")
    consumer_stacks = registry.apps.each_with_object({}) { |a, h| h[a.name] = a.stack }
    # A consumer that regenerates against a registry missing a failed backend's
    # freshly-uploaded specs would be regenerating against stale/incomplete
    # data — skip it rather than run codegen on a bad premise.
    # Gate on :error only. A backend ending :needs_attention either already
    # uploaded its specs (api runs before spawn_claude) or never touched the
    # registry (pre-existing-branch guard fired before api) — consumers are
    # safe either way, so do NOT skip them for :needs_attention.
    failed_backends = backend_names.select { |b| results[b] && results[b][:status] == :error }.to_set
    results.merge!(run_concurrent(consumer_names, opts[:concurrency]) do |name|
      bad = graph.depends_on(name).select { |d| failed_backends.include?(d) }
      if bad.empty?
        run_repo(name, workdir, consumer_stacks.fetch(name), opts, branch)
      else
        { status: :skipped, error: "skipped: dependency backend(s) failed: #{bad.join(', ')}" }
      end
    end)
    puts ""
  end

  print_codegen_summary(results)
  write_codegen_status_json(workdir, results)
end

def release_one(name)
  dir = deploy_item_dir(name)
  return { ok: false, log: "no checkout at #{dir}" } unless File.directory?(File.join(dir, ".git"))

  branch = git_current_branch(dir)
  unless branch == "main"
    where = branch.nil? ? "detached HEAD" : "on #{branch.inspect}"
    return { ok: false, log: "not on main (#{where})" }
  end
  return { ok: false, log: "working tree is dirty" } unless git_clean?(dir)

  pull_out = `git -C #{dir} pull --ff-only origin main 2>&1`
  return { ok: false, log: "pull --ff-only failed: #{pull_out.strip}" } unless $?.success?

  if db_repo?(name)
    release_bin = File.expand_path(File.join(__dir__, "release-db"))
    env = { "RELEASE_AUTO_TAG" => "1", "RELEASE_DB_AUTO_CONFIRM" => "1" }
  else
    release_bin = File.expand_path(File.join(__dir__, "release"))
    env = { "RELEASE_AUTO_TAG" => "1" }
  end
  # release-db accepts either `foo` or `foo-postgresql` as --app; pass the full
  # name so the script doesn't have to guess.
  out, status = Open3.capture2e(env, release_bin, "--app", name, chdir: dir)
  { ok: status.success?, log: out }
rescue => e
  { ok: false, log: "release_one raised: #{e.class}: #{e.message}" }
end

def release_serial(names, results, results_mutex)
  names.each do |name|
    puts "  #{name} [starting]"
    result =
      begin
        release_one(name)
      rescue => e
        { ok: false, log: "worker crashed: #{e.class}: #{e.message}" }
      end
    results_mutex.synchronize { results[name] = result }
    puts "  #{name} [#{result[:ok] ? 'done' : 'FAIL'}]"
  end
end

def release_concurrent(names, concurrency, results, results_mutex)
  return if names.empty?
  queue = Queue.new
  names.each { |n| queue << n }
  workers = Array.new([concurrency, names.length].min) do
    Thread.new do
      while (name = (queue.pop(true) rescue nil))
        result =
          begin
            puts "  #{name} [starting]"
            release_one(name)
          rescue => e
            { ok: false, log: "worker crashed: #{e.class}: #{e.message}" }
          end
        results_mutex.synchronize { results[name] = result }
        puts "  #{name} [#{result[:ok] ? 'done' : 'FAIL'}]"
      end
    end
  end
  workers.each(&:join)
end

def cmd_deploy_all(args)
  name_filter, concurrency = parse_deploy_all_args(args)
  rows = resolve_deploy_items(name_filter)

  pending = rows.select { |_, d| needs_deploy?(d) }.map(&:first)
  errors  = rows.select { |_, d| d[:error] }

  if pending.empty?
    puts "All apps up to date"
    unless errors.empty?
      puts ""
      errors.each { |name, d| puts "#{name}: #{d[:error]}" }
    end
    return
  end

  run_deploys(pending, concurrency: concurrency, errors: errors)
end

# Phase 2 banner for an app release. A single app releases serially, so the
# concurrency detail is noise — omit it. For multiple apps, show the effective
# pool size (`release_concurrent` caps workers at the number of apps), never the
# raw requested concurrency.
def deploy_phase2_message(to_run, concurrency)
  if to_run.length == 1
    "Phase 2: releasing #{to_run.first}"
  else
    "Phase 2: releasing #{to_run.length} app(s) with concurrency=#{[concurrency, to_run.length].min}: #{to_run.join(', ')}"
  end
end

# Releases `names` (DBs first, serially; then apps in parallel) and prints the
# summary. Shared by `deploy all` and the `deploy status` prompt, so both get
# identical ordering, skip-on-DB-failure, and exit-code behavior. `errors` are
# deploy-detection failures to report alongside the summary; callers that have
# already displayed them pass none. Exits non-zero if any release fails.
def run_deploys(pending, concurrency:, errors: [])
  db_pending  = pending.select { |n| db_repo?(n) }
  app_pending = pending.reject { |n| db_repo?(n) }

  results_mutex = Mutex.new
  results = {}
  skipped = {}

  unless db_pending.empty?
    puts "Phase 1: releasing #{db_pending.length} database(s) serially: #{db_pending.join(', ')}"
    puts ""
    release_serial(db_pending, results, results_mutex)
    puts ""
  end

  # Skip an app whose matching DB just failed: deploying an app against an
  # unmigrated schema is exactly the failure mode the DB-first ordering is
  # meant to prevent.
  failed_db_apps = db_pending.reject { |n| results[n] && results[n][:ok] }.map { |n| n.sub(/-postgresql\z/, "") }
  to_run = app_pending.reject do |n|
    if failed_db_apps.include?(n)
      skipped[n] = "db release failed (#{n}-postgresql)"
      true
    else
      false
    end
  end

  if to_run.empty? && !app_pending.empty?
    puts "Phase 2: all #{app_pending.length} app(s) skipped due to DB failures"
    puts ""
  elsif !to_run.empty?
    puts deploy_phase2_message(to_run, concurrency)
    puts ""
    release_concurrent(to_run, concurrency, results, results_mutex)
  end

  pending.each do |n|
    next if skipped.key?(n)
    results[n] ||= { ok: false, log: "no result recorded (worker died?)" }
  end
  attempted = pending.reject { |n| skipped.key?(n) }
  succeeded = attempted.select { |n| results[n][:ok] }
  failed    = attempted.reject { |n| results[n][:ok] }

  puts ""
  puts Util.underline("Summary")
  puts "  released: #{succeeded.empty? ? '(none)' : succeeded.join(', ')}"
  puts "  failed:   #{failed.join(', ')}" unless failed.empty?
  unless skipped.empty?
    skipped.each { |n, reason| puts "  skipped:  #{n} (#{reason})" }
  end

  unless errors.empty?
    puts ""
    puts "Deploy-detection errors:"
    errors.each { |name, d| puts "  #{name}: #{d[:error]}" }
  end

  unless failed.empty?
    puts ""
    failed.each do |name|
      puts Util.underline(name)
      puts results[name][:log]
      puts ""
    end
    exit 1
  end

  # Defensive: today every skip implies a failed DB (which already triggers
  # exit 1 above). Future skip paths that don't correspond to a failure must
  # still surface a non-zero exit.
  exit 1 unless skipped.empty?
end

# ---------- config drift ----------

K8S_NAMESPACE = 'bryzek-production'

def k8s_apps(app_filter)
  registry = Work::Registry.load
  apps = registry.deployable.map(&:name).sort
  apps = apps.select { |n| File.exist?(File.expand_path("~/code/env/apps/#{n}/env/production.env")) }
  apps = apps.select { |n| n == app_filter } if app_filter
  Util.exit_with_error("No apps with production.env match '#{app_filter}'") if apps.empty?
  apps
end

def expected_config_vars(app)
  vars = JSON.parse(EnvironmentVariables.load(app, 'production').serialize('json'))
  vars.select { |k, _| k.start_with?('CONF_') }
end

def live_config_vars(app)
  out, status = Open3.capture2("kubectl", "get", "configmap", "#{app}-config",
                                "-n", K8S_NAMESPACE, "-o", "json")
  return nil unless status.success?
  JSON.parse(out)["data"] || {}
end

def diff_config(app)
  expected = expected_config_vars(app)
  live = live_config_vars(app)
  return { error: "ConfigMap #{app}-config not found" } if live.nil?

  missing  = expected.keys - live.keys
  extra    = live.keys - expected.keys
  changed  = (expected.keys & live.keys).select { |k| expected[k] != live[k] }
  { missing: missing, extra: extra, changed: changed, expected: expected, live: live }
end

def cmd_config_check(args)
  require 'open3'
  rest, app_filter, _ = parse_common_flags(args)
  reject_unknown_args("config check", rest)
  apps = k8s_apps(app_filter)

  any_drift = false
  apps.each do |app|
    d = diff_config(app)
    if d[:error]
      puts "#{app}: ERROR - #{d[:error]}"
      any_drift = true
      next
    end
    drift_count = d[:missing].length + d[:extra].length + d[:changed].length
    if drift_count == 0
      puts "#{app}: in sync (#{d[:expected].size} keys)"
    else
      any_drift = true
      puts "#{app}: DRIFT (#{drift_count} differences)"
      d[:missing].sort.each { |k| puts "  + #{k} (in env, not in cluster)" }
      d[:extra].sort.each   { |k| puts "  - #{k} (in cluster, not in env)" }
      d[:changed].sort.each do |k|
        puts "  ~ #{k}"
        puts "      env:     #{d[:expected][k].inspect}"
        puts "      cluster: #{d[:live][k].inspect}"
      end
    end
  end
  exit(any_drift ? 1 : 0)
end

def cmd_config_rollout(args)
  require 'open3'
  rest, app_filter, _ = parse_common_flags(args)
  reject_unknown_args("config rollout", rest)
  apps = k8s_apps(app_filter)

  apps.each do |app|
    puts ""
    puts Util.underline("#{app}: apply k8s-secrets")
    Util.sync_k8s_secrets(app)

    puts ""
    puts Util.underline("#{app}: rollout restart")
    Util.run("kubectl rollout restart statefulset,deployment -l app=#{app} -n #{K8S_NAMESPACE}")
    Util.run("kubectl rollout status statefulset,deployment -l app=#{app} -n #{K8S_NAMESPACE} --timeout=5m")
  end
end

# ---------- browserslist ----------

def git_current_branch(path)
  # -q keeps `symbolic-ref` from printing "fatal: ref HEAD is not a symbolic ref"
  # to stderr for a detached HEAD — that's an expected state here (caller treats a
  # nil branch as detached), not an error worth surfacing during a prune scan.
  out, status = Open3.capture2("git", "-C", path, "symbolic-ref", "-q", "--short", "HEAD")
  status.success? ? out.strip : nil
end

def git_clean?(path)
  out, status = Open3.capture2("git", "-C", path, "status", "--porcelain")
  status.success? && out.strip.empty?
end

def run_step(cmd, path, verbose, captured_log)
  if verbose
    ok = system(*cmd, chdir: path)
    [ok, nil]
  else
    out, status = Open3.capture2e(*cmd, chdir: path)
    # Subprocess output can contain arbitrary bytes; scrub so one malformed
    # byte can't crash the regex/string matching every caller does on it.
    out = out.force_encoding(Encoding::UTF_8).scrub
    captured_log << out
    [status.success?, out]
  end
end

def report_repo_line(name, status, detail, verbose)
  return if verbose
  suffix = detail ? "#{status}: #{detail}" : status
  puts "  #{name} [#{suffix}]"
end

def git_origin_url(path)
  out, status = Open3.capture2("git", "-C", path, "config", "--get", "remote.origin.url")
  status.success? ? out.strip : nil
end

# ---------- aidirs prune ----------
#
# Feature dirs under ~/code/ai are throwaway clones (one branch per dir, same
# name across every repo inside) and cheap to recreate, so prune is AGGRESSIVE:
# once a dir has gone `--days` (default 3) without activity we reap it whatever
# its git state. The only concession is recoverability — an aged-out dir holding
# work that isn't safely on a remote (uncommitted/stashed/detached/loose files or
# local-only commits) is moved to ~/code/ai-trash/<ts>/ instead of hard-deleted,
# so a stale clone that turns out to matter can be restored.
#
# RECENT dirs (touched within the window) keep full protection: any at-risk state
# keeps them, and `gh` is asked for the PR state so a squash-merged branch — whose
# local commits never match main and look "unpushed" — is recognized as landed and
# deleted even though it was just touched. `gh` is consulted ONLY for recent dirs;
# aged-out dirs reap regardless of PR state, so the lookup would change nothing.

AI_ROOT = File.expand_path("~/code/ai")

def git_repo?(path)
  File.exist?(File.join(path, ".git"))
end

# True if HEAD has commits that live on no remote-tracking branch. On a merged,
# squash-landed branch this is true even though the work is on main — callers
# gate on the PR state before treating it as unsafe.
def git_has_local_only_commits?(path)
  out, status = Open3.capture2("git", "-C", path, "log", "--branches", "--not", "--remotes", "--oneline", "-1")
  status.success? && !out.strip.empty?
end

# owner/repo parsed from the origin url (git@github.com:o/r.git or https://…/o/r).
def git_slug(path)
  url = git_origin_url(path) or return nil
  m = url.match(%r{github\.com[:/](.+?)(?:\.git)?/?\z}) or return nil
  m[1]
end

# A branch's PR as {state: :merged|:closed|:open, number: N}, or nil when there is
# no PR or `gh` is unavailable/erroring. nil is treated as "not safe" by the
# caller, so a missing `gh` binary degrades to keeping the dir, not crashing.
def gh_pr_state(slug, branch)
  return nil unless slug && branch
  out, status = Open3.capture2(
    "gh", "pr", "list", "--repo", slug, "--head", branch,
    "--state", "all", "--json", "state,number",
    "--jq", ".[0] | select(.) | \"\\(.state) \\(.number)\""
  )
  return nil unless status.success?
  state_s, num = out.strip.split(" ", 2)
  sym = { "MERGED" => :merged, "CLOSED" => :closed, "OPEN" => :open }[state_s]
  sym && { state: sym, number: num.to_i }
rescue Errno::ENOENT
  nil
end

def git_has_stash?(path)
  out, status = Open3.capture2("git", "-C", path, "stash", "list")
  status.success? && !out.strip.empty?
end

# Real (non-symlink) git repos inside a feature dir: the dir itself when it is a
# clone, plus each immediate subdir. Symlinks (e.g. devops@ -> shared checkout)
# are skipped — deleting the feature dir only removes the link, not the target.
def ai_dir_repos(dir)
  candidates = [dir] + Dir.children(dir).map { |c| File.join(dir, c) }
  candidates.select { |p| !File.symlink?(p) && File.directory?(p) && git_repo?(p) }
end

def dir_effectively_empty?(dir)
  Dir.children(dir).all? { |c| File.symlink?(File.join(dir, c)) }
end

# Top-level entries that are neither a symlink nor one of the detected repos —
# loose files or non-repo dirs that no git check below would ever cover. Skipped
# when the feature dir is itself a clone (repos includes dir): then every
# top-level file is git-tracked and git_clean? already accounts for it.
def ai_dir_has_loose_content?(dir, repos)
  return false if repos.include?(dir)
  repo_names = repos.map { |r| File.basename(r) }
  Dir.children(dir).any? do |c|
    !File.symlink?(File.join(dir, c)) && !repo_names.include?(c)
  end
end

# Newest activity across the dir and its repos' git metadata — catches a session
# committing deep inside a repo without touching the top-level dir mtime.
def ai_dir_last_activity(dir, repos)
  times = [File.mtime(dir)]
  repos.each do |r|
    %w[.git/index .git/HEAD .git/ORIG_HEAD].each do |f|
      p = File.join(r, f)
      times << File.mtime(p) if File.exist?(p)
    end
  end
  times.max
end

# Returns [action, reason, pr_notes] where action is :keep, :delete, or :trash,
# reason is a short explanation (nil when hard-deleting), and pr_notes is an array
# of "repo#N STATE" strings for any PR consulted while classifying — surfaced in
# the output so the dir<->PR tie is visible (e.g. deleted because platform#1204
# merged). pr_state is injected for testing; it defaults to the gh-backed lookup.
#
# Feature dirs are cheap to recreate, so the default posture is AGGRESSIVE: once a
# dir has gone `cutoff` days without activity we reap it, whatever its git state.
# The only concession is recoverability — an aged-out dir that still holds work
# that isn't on a remote (uncommitted/stashed/detached/loose files, or local-only
# commits) is :trash'd (moved aside, restorable) rather than hard-deleted, so a
# stale clone that turns out to matter can be pulled back. Aged-out clean/pushed
# dirs (nothing at risk) are :delete'd outright.
#
# RECENT dirs (touched within cutoff) keep the full old protection: any at-risk
# state → :keep, and gh is consulted so a merged/closed PR still lets a landed dir
# be deleted even though it was touched today. gh is ONLY called for recent dirs —
# aged-out dirs reap regardless of PR state, so the lookup would change nothing.
def classify_ai_dir(dir, cutoff_time:, pr_state:)
  repos = ai_dir_repos(dir)
  recent = ai_dir_last_activity(dir, repos) >= cutoff_time

  # ---- aged out: reap regardless of git state; trash anything not safely on a
  # remote, hard-delete only clean/pushed dirs. No gh calls. ----
  unless recent
    return classify_aged_out(dir, repos)
  end

  # ---- recent: full protection (unchanged behavior) ----
  if repos.empty?
    return [:delete, nil, []] if dir_effectively_empty?(dir)
    return [:keep, "no git repo (unexpected content)", []]
  end

  return [:keep, "unexpected non-repo content", []] if ai_dir_has_loose_content?(dir, repos)

  repos.each do |r|
    name = File.basename(r)
    # Detached HEAD: commits made while detached hang off no branch ref, so
    # git_has_local_only_commits? (which walks --branches) can't see them. Keep
    # rather than risk deleting unreachable work.
    return [:keep, "detached HEAD in #{name}", []] if git_current_branch(r).nil?
    return [:keep, "uncommitted changes in #{name}", []] unless git_clean?(r)
    return [:keep, "stashed changes in #{name}", []] if git_has_stash?(r)
  end

  pr_notes = []
  merged_confirmed = false
  repos.each do |r|
    name = File.basename(r)
    branch = git_current_branch(r)
    has_local = git_has_local_only_commits?(r)
    # A repo sitting on main/master with everything pushed has no branch work to
    # reason about — nothing to lose, and no PR to look up. Skip it entirely.
    next if %w[main master].include?(branch) && !has_local

    # Consult the PR even when nothing is local-only: a squash-merged branch stays
    # on its (lingering) origin/<branch> ref, so it reads as "fully pushed" — the
    # only way to know it LANDED (vs. an open/unopened PR) is to ask gh.
    pr = pr_state.call(git_slug(r), branch)
    landed = pr && %i[merged closed].include?(pr[:state])
    pr_notes << "#{name}##{pr[:number]} #{pr[:state].to_s.upcase}" if pr

    if landed
      merged_confirmed = true
      next
    end
    # Local commits that never landed = unsaved work. Never delete.
    if has_local
      label = pr ? pr_notes.last : "#{name} (no PR)"
      pr_notes << label unless pr
      return [:keep, "local-only commits: #{label}", pr_notes]
    end
    # Otherwise: pushed to a feature branch with an open/unopened PR — safe on the
    # remote but plausibly still active. It's recent, so keep it.
  end

  # A merged/closed PR is proof the work landed — delete even though recent.
  # Otherwise everything is merely pushed with nothing landed; it's recent, so
  # keep the still-active dir.
  return [:delete, nil, pr_notes] if merged_confirmed
  [:keep, "modified within cutoff", pr_notes]
end

# Classify a dir that has gone quiet past the cutoff. Aged-out dirs are always
# reaped; the only question is HOW: :trash (recoverable) when it holds work not
# safely on a remote, :delete (hard) when it's clean/pushed with nothing at risk.
# gh is never consulted here — the action is the same whether or not a PR landed.
def classify_aged_out(dir, repos)
  if repos.empty?
    return [:delete, nil, []] if dir_effectively_empty?(dir)
    return [:trash, "aged out: unexpected non-repo content", []]
  end

  return [:trash, "aged out: unexpected non-repo content", []] if ai_dir_has_loose_content?(dir, repos)

  repos.each do |r|
    name = File.basename(r)
    return [:trash, "aged out: detached HEAD in #{name}", []] if git_current_branch(r).nil?
    return [:trash, "aged out: uncommitted changes in #{name}", []] unless git_clean?(r)
    return [:trash, "aged out: stashed changes in #{name}", []] if git_has_stash?(r)
    # Local-only commits aren't provably on a remote (a squash-merge would land
    # them, but confirming that needs gh, which we skip for aged-out dirs). Trash
    # so they stay recoverable rather than risk hard-deleting unlanded work.
    if git_has_local_only_commits?(r)
      return [:trash, "aged out: local-only commits in #{name}", []]
    end
  end

  # Every repo is clean and fully pushed — nothing at risk, hard-delete.
  [:delete, nil, []]
end

def cmd_aidirs_prune(args)
  days = 3
  apply = false
  trash = false
  while (arg = args.shift)
    case arg
    when "--days"
      raw = args.shift or usage_exit("--days requires a value", example: usage_for("aidirs prune"))
      days = Integer(raw) rescue usage_exit("--days must be an integer", example: usage_for("aidirs prune"))
    when "--apply" then apply = true
    when "--trash" then trash = true
    when "-h", "--help" then puts USAGE; exit 0
    else usage_exit("Unknown flag: #{arg}", example: usage_for("aidirs prune"))
    end
  end
  usage_exit("--days must be >= 0", example: usage_for("aidirs prune")) if days < 0

  unless Dir.exist?(AI_ROOT)
    puts "Nothing to prune: #{AI_ROOT} does not exist."
    return
  end

  cutoff = Time.now - days * 24 * 60 * 60
  dirs = Dir.children(AI_ROOT)
            .map { |c| File.join(AI_ROOT, c) }
            .select { |p| !File.symlink?(p) && File.directory?(p) }
            .sort
  pr_state = method(:gh_pr_state)

  # An aged-out at-risk dir is classified :trash and is ALWAYS moved aside, never
  # hard-deleted, regardless of the --trash flag. --trash additionally routes the
  # clean/pushed :delete dirs to the trash too (belt-and-suspenders).
  effective_trash = ->(action) { trash || action == :trash }

  keep = []
  to_delete = [] # hard rm: aged-out clean/pushed dirs (unless --trash)
  to_trash  = [] # moved aside: aged-out at-risk dirs, plus everything if --trash
  dirs.each do |dir|
    action, reason, notes = classify_ai_dir(dir, cutoff_time: cutoff, pr_state: pr_state)
    if action == :keep
      keep << [dir, reason, notes]
    elsif effective_trash.call(action)
      to_trash << [dir, reason, notes]
    else
      to_delete << [dir, reason, notes]
    end
  end

  puts "Scanned #{dirs.length} dir(s) under #{AI_ROOT}."
  puts "Reaping any dir idle > #{days} day(s): clean/pushed dirs are deleted; dirs holding work not on a remote (uncommitted, stashed, detached, loose files, or local-only commits) are moved to trash so they stay recoverable."
  puts "Keeping dirs touched within #{days} day(s) (recent work is fully protected, and a landed merged/closed PR still lets a recent dir be deleted)."
  puts ""
  puts "Keeping #{keep.length}:"
  keep.each { |d, r, _| puts "  #{File.basename(d)}  (#{r})" }

  print_removal_list = lambda do |label, list|
    return if list.empty?
    puts ""
    puts "#{label} #{list.length}:"
    list.each do |d, reason, notes|
      note_parts = [reason, *(notes || [])].compact.reject(&:empty?)
      suffix = note_parts.empty? ? "" : "  (#{note_parts.join(', ')})"
      puts "  #{File.basename(d)}#{suffix}"
    end
  end
  print_removal_list.call("Delete", to_delete)
  print_removal_list.call("Trash", to_trash)

  if to_delete.empty? && to_trash.empty?
    puts ""
    puts "Nothing to remove."
    return
  end
  unless apply
    puts ""
    puts "(dry-run — pass --apply to remove these)"
    return
  end

  trash_root = nil
  ensure_trash_root = lambda do
    trash_root ||= begin
      root = File.join("#{AI_ROOT}-trash", Time.now.strftime("%Y%m%d-%H%M%S"))
      FileUtils.mkdir_p(root)
      root
    end
  end

  deleted = 0
  trashed = 0
  skipped = []
  (to_delete + to_trash).each do |dir, _, _|
    # Re-check immediately before removing: parallel sessions routinely touch
    # ~/code/ai/* between the scan and here, so a dir can become dirty/active in
    # the window. Skip anything no longer classified for removal; re-derive the
    # disposition too, in case it flipped between :delete and :trash.
    action, reason = classify_ai_dir(dir, cutoff_time: cutoff, pr_state: pr_state)
    if action == :keep
      skipped << [File.basename(dir), reason]
      next
    end
    if effective_trash.call(action)
      FileUtils.mv(dir, File.join(ensure_trash_root.call, File.basename(dir)))
      trashed += 1
    else
      FileUtils.rm_rf(dir)
      deleted += 1
    end
  end

  puts ""
  unless skipped.empty?
    puts "Skipped #{skipped.length} dir(s) that changed since the scan:"
    skipped.each { |name, r| puts "  #{name}  (#{r})" }
    puts ""
  end
  puts "Deleted #{deleted} dir(s)." if deleted.positive?
  if trashed.positive?
    puts "Moved #{trashed} dir(s) to #{trash_root}"
    puts "Restore: mv #{trash_root}/<name> #{AI_ROOT}/   —   empty: rm -rf #{trash_root}"
  end
end

# Shared shallow-clone-into-workdir idiom used by both `browserslist update`
# and `codegen sync`: wipe any stale directory left from a prior run, then
# `git clone --depth=1 --quiet`. Returns the clone path on success, nil on
# failure (caller decides how to report/log it).
def clone_repo(origin, name, workdir, verbose, captured)
  clone_path = File.join(workdir, name)
  FileUtils.rm_rf(clone_path) if File.directory?(clone_path)
  ok, _ = run_step(["git", "clone", "--depth=1", "--quiet", origin, clone_path], workdir, verbose, captured)
  ok ? clone_path : nil
end

def cmd_browserslist_update(args)
  verbose = false
  keep_tmp = false
  app_filter = nil
  i = 0
  rest = []
  while i < args.length
    a = args[i]
    case a
    when "--verbose", "-v" then verbose = true; i += 1
    when "--keep-tmp-dir"  then keep_tmp = true; i += 1
    when "--app"
      app_filter = args[i + 1]
      usage_exit("--app requires a value", example: usage_for("browserslist update")) if app_filter.nil?
      i += 2
    else
      rest << a
      i += 1
    end
  end
  usage_exit("browserslist update takes no positional arguments", example: usage_for("browserslist update")) unless rest.empty?

  code_root = File.expand_path("~/code")
  source_repos = Dir.children(code_root)
    .map { |name| File.join(code_root, name) }
    .select { |path| File.directory?(path) && File.exist?(File.join(path, "package.json")) && File.directory?(File.join(path, ".git")) }
    .sort

  if app_filter
    source_repos = source_repos.select { |p| File.basename(p) == app_filter }
    if source_repos.empty?
      Util.exit_with_error("No repo named '#{app_filter}' with package.json + .git under #{code_root}")
    end
  end

  if source_repos.empty?
    puts "No repos with package.json + .git under #{code_root}"
    return
  end

  date = Time.now.strftime("%Y%m%d")
  workdir = File.join(code_root, "browserslist.#{date}")
  FileUtils.mkdir_p(workdir) unless File.directory?(workdir)

  puts "Working in #{workdir}"
  puts "Processing #{source_repos.length} repo(s)..."
  puts ""

  failures = []
  updated = []
  no_changes = []
  no_remote = []
  logs = {}

  source_repos.each do |src_path|
    name = File.basename(src_path)
    puts Util.underline(name) if verbose

    origin = git_origin_url(src_path)
    if origin.nil? || origin.empty?
      no_remote << name
      report_repo_line(name, "skipped", "no remote", verbose)
      puts "" if verbose
      next
    end

    captured = +""
    clone_path = clone_repo(origin, name, workdir, verbose, captured)
    unless clone_path
      failures << "#{name} (clone failed)"
      logs[name] = captured unless verbose
      report_repo_line(name, "FAIL", "git clone", verbose)
      puts "" if verbose
      next
    end

    ok, _ = run_step(["npx", "--yes", "update-browserslist-db@latest"], clone_path, verbose, captured)
    unless ok
      failures << name
      logs[name] = captured unless verbose
      report_repo_line(name, "FAIL", "update-browserslist-db", verbose)
      puts "" if verbose
      next
    end

    if git_clean?(clone_path)
      no_changes << name
      report_repo_line(name, "no changes", nil, verbose)
      puts "" if verbose
      next
    end

    msg = "Update caniuse-lite via update-browserslist-db"
    ok, _ = run_step(["git", "-C", clone_path, "commit", "-am", msg], clone_path, verbose, captured)
    unless ok
      failures << "#{name} (commit failed)"
      logs[name] = captured unless verbose
      report_repo_line(name, "FAIL", "git commit", verbose)
      puts "" if verbose
      next
    end

    ok, _ = run_step(["git", "-C", clone_path, "push", "origin", "HEAD:main"], clone_path, verbose, captured)
    unless ok
      failures << "#{name} (push failed)"
      logs[name] = captured unless verbose
      report_repo_line(name, "FAIL", "git push", verbose)
      puts "" if verbose
      next
    end

    updated << name
    report_repo_line(name, "done", nil, verbose)
    puts "" if verbose
  end

  puts ""
  puts Util.underline("Summary")
  puts "  updated + pushed: #{updated.empty? ? '(none)' : updated.join(', ')}"
  puts "  no changes:       #{no_changes.join(', ')}" unless no_changes.empty?
  puts "  no remote:        #{no_remote.join(', ')}" unless no_remote.empty?
  puts "  failed:           #{failures.join(', ')}" unless failures.empty?

  unless verbose || logs.empty?
    puts ""
    puts "Re-run with --verbose for full output. Captured failure output:"
    logs.each do |name, out|
      puts ""
      puts Util.underline(name)
      puts out
    end
  end

  if failures.empty? && !keep_tmp
    FileUtils.rm_rf(workdir)
    puts ""
    puts "Removed #{workdir}"
  elsif !failures.empty?
    puts ""
    puts "Kept #{workdir} for inspection (failures present)"
  end

  exit 1 unless failures.empty?
end

# ---------- scripts ----------
#
# `scripts/` is the single home for ad-hoc developer/ops utility scripts (see
# scripts/README.md). `dev scripts list` discovers them; `dev scripts run <name>`
# runs one. Each script may declare a `dev-script:` metadata header:
#
#   -- dev-script: targets=local,production app=platform
#
# `targets` (default `local`) lists the environments it may run against; `app`
# names the app for `db exec` when a non-local target is used. A local run of a
# `.sql` script goes straight at the local platformdb via psql; a production /
# development run delegates to `db exec`, which tunnels through the bastion.
# Executable scripts (including thin wrappers around scripts that live in other
# repos) are exec'd directly with all args forwarded; they own their environment.
# Adding a script needs no code change here.

SCRIPTS_DIR = File.expand_path(File.join(__dir__, "..", "scripts")).freeze
SCRIPT_META_RE = /\A(?:--+|#+)\s*dev-script:\s*(.*)\z/.freeze
LOCAL_ENVS = %w[local localhost].freeze

def scripts_available
  return [] unless Dir.exist?(SCRIPTS_DIR)
  Dir.children(SCRIPTS_DIR).select { |f| File.file?(File.join(SCRIPTS_DIR, f)) }
     .reject { |f| f.start_with?(".") || f.casecmp?("readme.md") }
     .sort
end

def script_base(filename)
  filename.sub(/\.[^.]+\z/, "")
end

# Scan leading comment lines for `dev-script:` key=value pairs.
def script_metadata(path)
  meta = {}
  File.foreach(path) do |line|
    s = line.strip
    next if s.empty? || s.start_with?("#!")
    if (m = SCRIPT_META_RE.match(s))
      m[1].split(/\s+/).each { |pair| k, v = pair.split("=", 2); meta[k] = v }
      next
    end
    break unless s.start_with?("--", "#")
  end
  meta
end

def script_targets(meta)
  (meta["targets"] || "local").split(",").map(&:strip).reject(&:empty?)
end

# First non-blank, non-shebang, non-metadata comment line — shown by `list`.
def script_description(path)
  File.foreach(path) do |line|
    s = line.strip
    next if s.empty? || s.start_with?("#!") || SCRIPT_META_RE.match?(s)
    return s.sub(/\A(--+|#+)\s*/, "").strip if s.start_with?("--", "#")
    break
  end
  ""
end

def resolve_script(name)
  scripts = scripts_available
  matches = scripts.select { |f| f == name || script_base(f) == name }
  if matches.empty?
    unknown("script", name, scripts.map { |f| script_base(f) }.uniq)
  elsif matches.length > 1
    usage_exit("Ambiguous script '#{name}' matches: #{matches.join(', ')}", example: usage_for("scripts run"))
  end
  File.join(SCRIPTS_DIR, matches.first)
end

def cmd_scripts_list(_args)
  scripts = scripts_available
  puts ""
  puts Util.underline("Utility Scripts")
  puts ""
  if scripts.empty?
    puts "  (none yet — drop a file in #{Util.cleanpath(SCRIPTS_DIR)})"
  else
    name_w = scripts.map { |f| script_base(f).length }.max
    rows = scripts.map do |f|
      full = File.join(SCRIPTS_DIR, f)
      [script_base(f), script_targets(script_metadata(full)).join(","), script_description(full)]
    end
    tgt_w = rows.map { |r| r[1].length }.max
    rows.each do |name, targets, desc|
      desc = "#{desc[0, 69]}…" if desc.length > 70
      puts "  #{name.ljust(name_w)}  [#{targets.ljust(tgt_w)}]  #{desc}".rstrip
    end
  end
  puts ""
  puts "Run with: dev scripts run <name> [args...]   (.sql: [--prod | --env ENV])"
  puts ""
end

# Local .sql run: mirrors the working local invocation (unix socket / user api),
# adds ON_ERROR_STOP so a mid-script failure aborts and rolls back, and refuses
# to run if PGHOST points at a non-local host so a stray env var can't redirect a
# destructive script at production.
def run_local_sql(path)
  host = ENV["PGHOST"]
  if host && !host.empty? && !host.start_with?("/") && !%w[localhost 127.0.0.1 ::1].include?(host)
    Util.exit_with_error("PGHOST=#{host} points at a non-local host. Local scripts only run against the local platformdb — unset PGHOST and retry.")
  end
  cmd = ["psql", "-U", "api", "-v", "ON_ERROR_STOP=1", "-f", path, "platformdb"]
  puts "==> #{cmd.join(' ')}"
  Util.exit_with_error("Script failed: #{File.basename(path)}") unless system(*cmd)
end

# Non-local .sql run: delegate to `db exec`, which tunnels through the bastion.
# Production is destructive on real data, so confirm explicitly first.
# Only ever called for a .sql script (run_sql_script gates on the extension).
def run_remote_sql(path, env, meta)
  app = meta["app"]
  if app.nil? || app.empty?
    Util.exit_with_error("Script targets #{env} but its dev-script header has no app= (needed for db exec).")
  end
  if env == "production"
    unless $stdin.tty?
      Util.exit_with_error("Refusing to run #{File.basename(path)} against #{app} production in a non-interactive shell (confirmation required).")
    end
    print "About to run #{File.basename(path)} against #{app} PRODUCTION. Type 'yes' to continue: "
    unless $stdin.gets&.strip == "yes"
      puts "Aborted."
      exit 1
    end
  end
  cmd = [File.join(__dir__, "db"), "exec", "--app", app, "--env", env, "--sql", path]
  puts "==> #{cmd.join(' ')}"
  Util.exit_with_error("Script failed: #{File.basename(path)}") unless system(*cmd)
end

# The script NAME is always the first token. How the rest is handled depends on
# the script type:
#   - .sql     -> the remaining tokens are OUR env-selection flags (--env/--prod/
#                 --localhost); the dev runner routes local psql vs `db exec`.
#   - executable (wrapper) -> the script manages its own environment, so every
#                 remaining token is passed straight through to it, verbatim
#                 (including any --env/--prod, which are the inner script's flags).
def cmd_scripts_run(args)
  name = args.shift
  if name.nil? || name.start_with?("-")
    usage_exit("scripts run requires a script name first (see 'dev scripts list')", example: usage_for("scripts run"))
  end
  path = resolve_script(name)

  if File.extname(path) == ".sql"
    run_sql_script(path, name, args)
  elsif File.executable?(path)
    # Wrapper scripts run locally and own their environment; forward all args.
    args.shift if args.first == "--" # tolerate a legacy `--` separator
    exec(path, *args)
  else
    Util.exit_with_error("#{File.basename(path)} has no runner: not a .sql file and not executable. Add a shebang and `chmod +x`, or rename to .sql.")
  end
end

# Parse OUR env-selection flags for a .sql script and route it. SQL scripts take
# no positional arguments — anything unexpected is an error.
def run_sql_script(path, name, args)
  env = "local"
  i = 0
  while i < args.length
    case args[i]
    when "--env"
      usage_exit("--env requires a value (local, development, or production)", example: usage_for("scripts run")) if i + 1 >= args.length
      env = args[i + 1]; i += 1
    when "--prod", "--production" then env = "production"
    when "--dev", "--development" then env = "development"
    when "--localhost", "--local" then env = "local"
    else
      Util.exit_with_error("#{File.basename(path)} is a SQL script; unexpected argument '#{args[i]}' (only --env/--prod/--localhost are accepted).")
    end
    i += 1
  end

  env = "local" if LOCAL_ENVS.include?(env)
  meta = script_metadata(path)
  targets = script_targets(meta)
  unless targets.include?(env) || (env == "local" && targets.any? { |t| LOCAL_ENVS.include?(t) })
    Util.exit_with_error("Script '#{name}' does not support env '#{env}'. Allowed: #{targets.join(', ')}")
  end

  if env == "local"
    run_local_sql(path)
  else
    run_remote_sql(path, env, meta)
  end
end

# ---------- slow-routes ----------

def slow_routes_truncate(str, width)
  str.length > width ? str[0, width - 3] + "..." : str
end

def cmd_slow_routes(args)
  days = 7
  sort = "-p95"
  limit = 10
  app = nil
  use_localhost = false
  i = 0
  while i < args.length
    case args[i]
    when "--app"
      app = args[i + 1] || usage_exit("--app requires a value", example: usage_for("slow-routes"))
      i += 2
    when "--days"
      days = Integer(args[i + 1] || usage_exit("--days requires a value", example: usage_for("slow-routes")))
      i += 2
    when "--sort"
      sort = args[i + 1] || usage_exit("--sort requires a value", example: usage_for("slow-routes"))
      i += 2
    when "--limit"
      limit = Integer(args[i + 1] || usage_exit("--limit requires a value", example: usage_for("slow-routes")))
      i += 2
    when "--localhost"
      use_localhost = true
      i += 1
    when "-h", "--help"
      usage_exit
    else
      usage_exit("Unknown flag: #{args[i]}", example: usage_for("slow-routes"))
    end
  end

  # The playbook admin API lives on the platform host but authenticates with the playbook
  # tenant session, so use tenant_endpoint (playbook is deliberately not in ENDPOINTS).
  endpoint = ApiClient.tenant_endpoint("playbook", use_localhost: use_localhost)

  since = (Time.now - days * 86_400).utc.iso8601
  params = { "since" => since, "sort" => sort, "limit" => limit.to_s }
  params["app"] = app if app
  query = params.map { |k, v| "#{k}=#{URI.encode_www_form_component(v)}" }.join("&")

  rows = begin
    ApiClient.request(endpoint, :get, "/admin/user/tracking/page/views/latency?#{query}")
  rescue SessionExpired
    Util.exit_with_error("session expired - run 'dev login'")
  rescue ApiError => e
    Util.exit_with_error(e.message)
  end

  puts ""
  puts Util.underline("Slowest routes - last #{days}d#{app ? " (#{app})" : ''}, sort #{sort}")
  puts ""
  if rows.nil? || rows.empty?
    puts "No page-view timing data in the window."
    return
  end

  printf("%-7s %-40s %8s %7s %7s %7s %7s %7s\n", "app", "route", "views", "p50", "p75", "p95", "p99", "ttfb")
  rows.each do |r|
    printf(
      "%-7s %-40s %8d %7d %7d %7d %7d %7d\n",
      r["app"], slow_routes_truncate(r["route"].to_s, 40), r["view_count"],
      r["p50_load_ms"], r["p75_load_ms"], r["p95_load_ms"], r["p99_load_ms"], r["p75_ttfb_ms"]
    )
  end

  top = rows.first
  server_dominant = top["p75_ttfb_ms"].to_f >= 0.5 * [top["p75_load_ms"].to_f, 1.0].max
  app_repo = top["app"] == "admin" ? "playbook-admin" : "playbook-app"
  puts ""
  puts Util.underline("Claude handoff - paste to investigate the worst route")
  puts <<~PROMPT

    Investigate why the #{top['app']} route `#{top['route']}` is slow for end users. Over the last
    #{days} days it had #{top['view_count']} views with load p50=#{top['p50_load_ms']}ms
    p75=#{top['p75_load_ms']}ms p95=#{top['p95_load_ms']}ms p99=#{top['p99_load_ms']}ms, and
    time-to-first-byte p75=#{top['p75_ttfb_ms']}ms.

    Attribution: p75 TTFB is #{server_dominant ? 'a large' : 'a small'} share of p75 load, so the cost is
    likely #{server_dominant ? 'server-side (backend endpoint / SSR load function)' : 'client-side (hydration, bundle, render)'}.

    Use the systematic-debugging skill: instrument this route's load path, drive an authenticated load,
    measure per-call timing, find the dominant cost, fix the one thing, and verify p95 drops. The app is
    #{app_repo}; its backend is the platform playbook subproject.
  PROMPT
end

# ---------- changelog ----------

# Apps whose releases feed the changelog. Each tags independently with its own
# semver sequence; the app name is also its GitHub repo slug (mbryzek/<app>) and
# its local sibling checkout (~/code/<app>) we read git history from. platform is
# intentionally excluded: its monorepo tag spans HOA/acumen/playbook.
CHANGELOG_APPS = %w[playbook-admin playbook-app playbook-www].freeze

# Judgment + summarization quality matters here, so use a stronger model than the
# mechanical codegen sync (haiku).
CHANGELOG_CLAUDE_MODEL = "sonnet".freeze

# Versions per Claude session. Each version is a small, independent commit list, so
# batching them amortizes the ~15-30s session startup (process spawn, skill read,
# tool setup) that used to be paid once per version — the dominant cost on a
# backfill. Kept bounded so one session's context stays small, a bad commit set can
# only poison its own batch, and a killed session loses at most this many versions
# (already-written notes files are cached, so a re-run resumes). See also
# CHANGELOG_BUILD_BATCH_COMMITS, the other half of the bound.
CHANGELOG_BUILD_BATCH_SIZE = 10

# Version count alone is a poor proxy for batch size: a typical release carries ~2
# commits, but the first tag of an app carries its whole history (500+). So a batch
# also closes once it has this many commits — a huge version travels alone rather
# than dragging nine others into a context that cannot hold them.
CHANGELOG_BUILD_BATCH_COMMITS = 100

# Group newest-first pending versions into sessions, bounded by both version count
# and cumulative commits. A single version over the commit bound still gets its own
# batch (never dropped).
def changelog_batches(pending, batch_size)
  pending.each_with_object([]) do |p, batches|
    current = batches.last
    if current.nil? || current.length >= batch_size ||
       current.sum { |q| q[:commit_count].to_i } + p[:commit_count].to_i > CHANGELOG_BUILD_BATCH_COMMITS
      batches << [p]
    else
      current << p
    end
  end
end

# A batch gets proportionally longer to finish, but never less than a single
# version's old budget, and never more than an hour.
def changelog_claude_timeout_secs(version_count)
  [[20 * 60, 5 * 60 * version_count].max, 60 * 60].min
end

def changelog_repo_dir
  File.expand_path("~/code/changelog")
end

def changelog_app_checkout(app)
  File.expand_path("~/code/#{changelog_app_repo(app)}")
end

# The GitHub repo backing a changelog app. They match today, but a deployable can be
# rebranded ahead of its repo, and the page links PRs off the repo.
# Goes through Config (which rebuilds dist/ from the env pkl sources once per process)
# rather than reading dist/ directly: dist/ is an untracked build artifact, and a stale
# one silently resolves a renamed app back to its own name — which reads as "no
# checkout" and skips the app. Not Work::Registry, whose tenant lookups hit the network
# for a value this path never needs. An unconfigured app keeps its own name.
def changelog_app_repo(app)
  @changelog_app_repos ||= {}
  @changelog_app_repos[app] ||= begin
    Config.all.find { |a| a.name == app }&.repo_name || app
  rescue StandardError
    app
  end
end

# Array-form git so paths/refs never go through the shell.
def changelog_git_out(*cmd)
  IO.popen(["git", *cmd], err: File::NULL, &:read)
end

# Ensure the changelog data repo is present (clone on first use) and best-effort
# up to date before we write into it.
def ensure_changelog_repo!
  dir = changelog_repo_dir
  unless Dir.exist?(File.join(dir, ".git"))
    puts "Cloning changelog repo to #{dir}..."
    system("git", "clone", "git@github.com:mbryzek/changelog.git", dir) ||
      Util.exit_with_error("Failed to clone changelog repo")
  end
  system("git", "-C", dir, "pull", "--rebase", "--quiet")
  dir
end

# Commit + push best-effort. A push failure warns but never raises — capture runs
# inside the release path and must not fail a release.
def changelog_git_commit_push!(dir, message)
  system("git", "-C", dir, "add", "-A")
  unless system("git", "-C", dir, "commit", "-q", "-m", message)
    puts "changelog: nothing to commit"
    return
  end
  warn "changelog: push failed (committed locally at #{dir})" unless system("git", "-C", dir, "push", "-q")
end

# Repeatable --app (defaults to all tracked apps), plus --localhost, --limit and
# --batch-size. Rejects an unknown app loudly rather than silently producing nothing.
# Returns { apps:, use_localhost:, limit:, batch_size: } (limit nil = no cap,
# batch_size nil = CHANGELOG_BUILD_BATCH_SIZE).
def changelog_parse_flags(args)
  apps = []
  use_localhost = false
  limit = nil
  batch_size = nil
  i = 0
  while i < args.length
    a = args[i]
    case a
    when "--app"
      v = args[i + 1]
      usage_exit("--app requires a value", example: usage_for("changelog capture")) if v.nil?
      unknown("--app", v, CHANGELOG_APPS) unless CHANGELOG_APPS.include?(v)
      apps << v
      i += 2
    when "--limit"
      v = args[i + 1]
      usage_exit("--limit requires a positive integer", example: usage_for("changelog build")) if v.nil? || v !~ /\A[1-9]\d*\z/
      limit = v.to_i
      i += 2
    when "--batch-size"
      v = args[i + 1]
      usage_exit("--batch-size requires a positive integer", example: usage_for("changelog build")) if v.nil? || v !~ /\A[1-9]\d*\z/
      batch_size = v.to_i
      i += 2
    when "--localhost"
      use_localhost = true
      i += 1
    when "-h", "--help"
      usage_exit
    else
      usage_exit("unexpected argument: #{a}", example: usage_for("changelog build"))
    end
  end
  apps = CHANGELOG_APPS.dup if apps.empty?
  { apps: apps.uniq, use_localhost: use_localhost, limit: limit, batch_size: batch_size }
end

# Commits in `range`, oldest-first, no merges. Extracts the squash-merge PR number
# from the trailing "(#NN)" of the subject when present.
def changelog_commits(checkout, range)
  raw = changelog_git_out("-C", checkout, "log", "--no-merges", "--reverse",
                          "--format=%H%x1f%s%x1f%b%x1e", range)
  raw.split("\x1e").map(&:strip).reject(&:empty?).map do |rec|
    sha, subject, body = rec.split("\x1f", 3)
    subject = (subject || "").strip
    pr = subject[/\(#(\d+)\)\s*\z/, 1]
    {
      "sha" => (sha || "").strip,
      "subject" => subject,
      "body" => (body || "").strip,
      "pr_number" => (pr ? pr.to_i : nil),
    }
  end
end

def cmd_changelog_capture(args)
  apps = changelog_parse_flags(args)[:apps]
  repo = ensure_changelog_repo!
  written = []
  apps.each do |app|
    checkout = changelog_app_checkout(app)
    unless Dir.exist?(File.join(checkout, ".git"))
      warn "changelog: skipping #{app} (no checkout at #{checkout})"
      next
    end
    tags = changelog_git_out("-C", checkout, "tag", "--list", "--sort=creatordate")
           .split("\n").map(&:strip).reject(&:empty?)
    out_dir = File.join(repo, app)
    FileUtils.mkdir_p(out_dir)
    tags.each_with_index do |tag, i|
      file = File.join(out_dir, "#{tag}.tag.json")
      next if File.exist?(file)
      prev = i.positive? ? tags[i - 1] : nil
      range = prev ? "#{prev}..#{tag}" : tag
      released_at = changelog_git_out("-C", checkout, "log", "-1", "--format=%cI", tag).strip
      data = {
        "application" => app,
        # The GitHub repo, recorded alongside the app because they can differ: the
        # /admin/changelog page links PRs off this, not off the app name.
        "repo" => changelog_app_repo(app),
        "version" => tag,
        "previous_version" => prev,
        "released_at" => released_at,
        "commits" => changelog_commits(checkout, range),
      }
      File.write(file, "#{JSON.pretty_generate(data)}\n")
      written << "#{app}/#{tag}.tag.json"
    end
  end
  if written.empty?
    puts "changelog capture: nothing new"
    return
  end
  changelog_git_commit_push!(repo, "changelog: capture #{written.length} release(s)\n\n#{written.join("\n")}")
  puts "changelog capture: wrote #{written.length} file(s)"
  written.each { |w| puts "  #{w}" }
end

# tag.json files (for the selected apps) that do not yet have a sibling notes.json,
# newest-first (by release timestamp) so a --limit builds the most recent releases.
def changelog_pending(repo, apps)
  apps.flat_map do |app|
    dir = File.join(repo, app)
    next [] unless Dir.exist?(dir)
    Dir.glob(File.join(dir, "*.tag.json")).filter_map do |tag_file|
      version = File.basename(tag_file).sub(/\.tag\.json\z/, "")
      notes_file = File.join(dir, "#{version}.notes.json")
      next if File.exist?(notes_file)
      tag = JSON.parse(File.read(tag_file)) rescue {}
      { app: app, version: version, tag_file: tag_file, notes_file: notes_file,
        released_at: tag["released_at"].to_s, commit_count: (tag["commits"] || []).length }
    end
  end.sort_by { |p| p[:released_at] }.reverse
end

# Stamp the app's GitHub repo onto a notes file the Claude session just wrote. Done
# here, not in the session's own output, so it is deterministic: the page links PRs
# off this field, and the app name is not always the repo.
def changelog_stamp_notes_repo!(p)
  data = JSON.parse(File.read(p[:notes_file]))
  repo = changelog_app_repo(p[:app])
  return if data["repo"] == repo
  File.write(p[:notes_file], "#{JSON.pretty_generate(data.merge('repo' => repo))}\n")
rescue StandardError => e
  warn "changelog: could not stamp repo on #{p[:notes_file]}: #{e.message}"
end

# Map "<repo-slug>#<pr-number>" => issue number, from playbook issues that carry a
# fix linked to a mbryzek PR. Best-effort: any failure yields an empty map so the
# build still produces notes, just without ISS links.
def changelog_issue_map(use_localhost)
  if ApiClient.session_id_for("playbook", use_localhost: use_localhost).nil?
    warn "changelog: no playbook session; skipping ISS enrichment (run `dev login --app playbook` to enable)"
    return {}
  end
  map = {}
  begin
    issues = ApiClient.request(issue_endpoint(use_localhost), :get,
                               issues_list_path(statuses: %w[fixed deployed verified])) || []
    issues.each do |issue|
      number = issue["number"]
      (issue["fixes"] || []).each do |fix|
        m = fix["url"].to_s.match(%r{github\.com/mbryzek/([^/]+)/pull/(\d+)})
        map["#{m[1]}##{m[2].to_i}"] = number if m
      end
    end
  rescue StandardError => e
    warn "changelog: issue enrichment unavailable (#{e}); continuing without ISS links"
  end
  map
end

# Headless Claude session that writes the notes files. Unlike spawn_claude (which
# expects a PR URL), this only asks Claude to write files we validate afterwards.
def changelog_run_claude(repo, input_path, version_count)
  timeout_secs = changelog_claude_timeout_secs(version_count)
  prompt = <<~PROMPT
    Follow the process in .claude/skills/changelog-build/SKILL.md exactly.
    Input file: #{input_path}
    It lists #{version_count} version(s). For each version under "versions", decide which
    commits are worth telling a human about, write concise plain-language release notes,
    and write the result as JSON to that version's "notes_file" path. Write each file as
    soon as you finish that version rather than batching the writes at the end. Every
    version must get a file, even if its "entries" is empty. Do not modify any other
    files; do not commit or push.
  PROMPT
  stdin, out_err, wait_thr = Open3.popen2e("claude", "--print", "--dangerously-skip-permissions",
                                           "--model", CHANGELOG_CLAUDE_MODEL, prompt,
                                           chdir: repo, pgroup: true)
  stdin.close
  pid = wait_thr.pid
  output =
    begin
      Timeout.timeout(timeout_secs) { out_err.read }
    rescue Timeout::Error
      begin Process.kill("TERM", -pid) rescue Errno::ESRCH end
      begin Process.kill("KILL", -pid) rescue Errno::ESRCH end
      return "claude timed out after #{timeout_secs}s"
    ensure
      out_err.close unless out_err.closed?
    end
  wait_thr.value
  output.to_s.force_encoding(Encoding::UTF_8).scrub
end

# One batch's input payload for the Claude session, with ISS numbers resolved.
def changelog_build_input(batch, iss_map)
  { "versions" => batch.map { |p| changelog_version_input(p, iss_map) } }
end

def changelog_version_input(p, iss_map)
  tag = JSON.parse(File.read(p[:tag_file]))
  commits = (tag["commits"] || []).map do |c|
    pr = c["pr_number"]
    {
      "sha" => c["sha"],
      "subject" => c["subject"],
      "body" => c["body"],
      "pr_number" => pr,
      # The map is keyed by REPO slug (it is parsed out of PR urls), which is not
      # the app name once an app is rebranded ahead of its repo.
      "issue_number" => pr ? iss_map["#{changelog_app_repo(p[:app])}##{pr}"] : nil,
    }
  end
  {
    "application" => p[:app],
    "version" => p[:version],
    "released_at" => tag["released_at"],
    "notes_file" => p[:notes_file],
    "commits" => commits,
  }
end

# --- /admin/changelog snapshot -------------------------------------------------
#
# playbook-admin renders the notes from a COMMITTED snapshot (its
# src/lib/changelog/data.json, assembled from this data lake by its own
# scripts/build-changelog.ts). Newly built notes are therefore invisible on the page
# until that snapshot is regenerated AND merged — which nobody was doing, so the page
# silently fell months behind the lake. After a successful build we regenerate it and
# park it on a single long-lived bot branch + PR for Mike to merge (playbook-admin is
# PR-reviewed; only the lake itself is direct-push).
CHANGELOG_ADMIN_APP = "playbook-admin".freeze
CHANGELOG_ADMIN_BRANCH = "changelog-data".freeze

# The GitHub repo of the admin app. Resolved rather than hardcoded: it tracks the
# deployable's configured repo, which can differ from its name.
def changelog_admin_repo
  "mbryzek/#{changelog_app_repo(CHANGELOG_ADMIN_APP)}"
end

# A dedicated git worktree so we never touch whatever Mike has checked out (or
# half-edited) in the admin checkout. Cheap: it shares the checkout's object store.
def changelog_admin_worktree
  File.expand_path("~/.devops/worktrees/#{CHANGELOG_ADMIN_APP}-changelog")
end

# Point the worktree at a pristine origin/main, creating it on first use.
# Returns the path, or nil if it could not be prepared.
def changelog_prepare_admin_worktree(checkout)
  wt = changelog_admin_worktree
  FileUtils.mkdir_p(File.dirname(wt))
  unless system("git", "-C", checkout, "fetch", "--quiet", "origin")
    warn "changelog: could not fetch #{CHANGELOG_ADMIN_APP}; skipping the /admin/changelog snapshot"
    return nil
  end

  if File.exist?(File.join(wt, ".git"))
    ok = system("git", "-C", wt, "checkout", "-q", "-B", CHANGELOG_ADMIN_BRANCH, "origin/main") &&
      system("git", "-C", wt, "reset", "-q", "--hard", "origin/main") &&
      system("git", "-C", wt, "clean", "-qfd")
  else
    FileUtils.rm_rf(wt)
    ok = system("git", "-C", checkout, "worktree", "add", "--quiet", "--force",
                "-B", CHANGELOG_ADMIN_BRANCH, wt, "origin/main")
  end

  unless ok
    warn "changelog: could not prepare #{wt}; skipping the /admin/changelog snapshot"
    return nil
  end
  wt
end

# Open the bot PR if one is not already open. The branch is long-lived, so a later
# refresh just force-pushes onto the SAME open PR rather than opening a second one.
def changelog_open_admin_pr(wt)
  open = IO.popen(["gh", "pr", "list", "--repo", changelog_admin_repo,
                   "--head", CHANGELOG_ADMIN_BRANCH, "--state", "open", "--json", "number"],
                  err: File::NULL, &:read).to_s
  if open.include?("number")
    puts "changelog: updated the open /admin/changelog snapshot PR"
    return
  end

  body = <<~BODY
    Regenerated `src/lib/changelog/data.json` from the `changelog` data lake after
    `dev changelog build` curated new release notes. Data only — no code changes.

    Opened automatically by `dev changelog build`. The branch is long-lived: later
    refreshes force-push onto this same PR until it is merged.
  BODY
  ok = system("gh", "pr", "create", "--repo", changelog_admin_repo,
              "--head", CHANGELOG_ADMIN_BRANCH, "--title",
              "Refresh /admin/changelog data from the changelog data lake",
              "--body", body, chdir: wt)
  warn "changelog: `gh pr create` failed; branch #{CHANGELOG_ADMIN_BRANCH} is pushed, open the PR by hand" unless ok
end

# Regenerate playbook-admin's committed snapshot and push it to the bot branch/PR.
# Entirely best-effort: the notes are already committed to the lake by the time we
# get here, so nothing in this path may fail the build.
def changelog_refresh_admin_snapshot!(repo)
  checkout = changelog_app_checkout(CHANGELOG_ADMIN_APP)
  unless Dir.exist?(File.join(checkout, ".git"))
    warn "changelog: no #{CHANGELOG_ADMIN_APP} checkout at #{checkout}; skipping the /admin/changelog snapshot"
    return
  end

  wt = changelog_prepare_admin_worktree(checkout)
  return if wt.nil?

  unless system({ "CHANGELOG_REPO_DIR" => repo }, "node", "scripts/build-changelog.ts", chdir: wt)
    warn "changelog: build-changelog.ts failed in #{wt}; skipping the /admin/changelog snapshot"
    return
  end

  if IO.popen(["git", "-C", wt, "status", "--porcelain"], err: File::NULL, &:read).to_s.strip.empty?
    puts "changelog: /admin/changelog snapshot already current"
    return
  end

  system("git", "-C", wt, "add", "-A")
  unless system("git", "-C", wt, "commit", "-q", "-m",
                "Refresh changelog data.json from the changelog data lake")
    warn "changelog: nothing to commit for the /admin/changelog snapshot"
    return
  end
  unless system("git", "-C", wt, "push", "-q", "--force-with-lease", "origin", CHANGELOG_ADMIN_BRANCH)
    warn "changelog: could not push #{CHANGELOG_ADMIN_BRANCH} (committed locally at #{wt})"
    return
  end
  changelog_open_admin_pr(wt)
end

def cmd_changelog_build(args)
  flags = changelog_parse_flags(args)
  repo = ensure_changelog_repo!
  pending = changelog_pending(repo, flags[:apps])
  total_pending = pending.length
  pending = pending.first(flags[:limit]) if flags[:limit]
  if pending.empty?
    puts "changelog build: nothing to build"
    return
  end
  if flags[:limit] && total_pending > pending.length
    puts "changelog build: #{total_pending} versions pending; building the #{pending.length} most recent (--limit)."
  end

  iss_map = changelog_issue_map(flags[:use_localhost])

  # One bounded Claude session per BATCH of versions: session startup dominated the
  # old one-session-per-version loop, and each version's commit list is small enough
  # that several fit comfortably in one context. Still bounded, so a bad commit set
  # can only poison its own batch, and a large backfill stays resumable (each written
  # notes file is cached, so a re-run skips what already succeeded).
  built = []
  failed = []
  batches = changelog_batches(pending, flags[:batch_size] || CHANGELOG_BUILD_BATCH_SIZE)
  batches.each_with_index do |batch, idx|
    puts "changelog build [batch #{idx + 1}/#{batches.length}]: #{batch.length} version(s) " \
         "via Claude (#{CHANGELOG_CLAUDE_MODEL}): #{batch.map { |p| "#{p[:app]}/#{p[:version]}" }.join(', ')}"
    input_path = File.join(repo, "_build_input.json")
    File.write(input_path, "#{JSON.pretty_generate(changelog_build_input(batch, iss_map))}\n")
    output = changelog_run_claude(repo, input_path, batch.length)
    File.delete(input_path) if File.exist?(input_path)

    batch.each do |p|
      if File.exist?(p[:notes_file]) && (JSON.parse(File.read(p[:notes_file])) rescue false)
        changelog_stamp_notes_repo!(p)
        built << p
      else
        failed << p
        warn "  failed (#{p[:app]}/#{p[:version]}): #{output.to_s.lines.last}"
      end
    end
  end

  unless built.empty?
    changelog_git_commit_push!(repo, "changelog: build notes for #{built.length} version(s)\n\n" \
                                     "#{built.map { |p| "#{p[:app]}/#{p[:version]}" }.join("\n")}")
    puts "changelog build: wrote #{built.length} notes file(s)"
    # New notes are useless until playbook-admin's committed snapshot catches up.
    changelog_refresh_admin_snapshot!(repo)
  end
  unless failed.empty?
    Util.exit_with_error("changelog build: #{failed.length} version(s) failed (re-run to retry): " \
                         "#{failed.map { |p| "#{p[:app]}/#{p[:version]}" }.join(', ')}")
  end
end

def cmd_changelog_all(args)
  cmd_changelog_capture(args.dup)
  cmd_changelog_build(args.dup)
end

# ---------- dispatch ----------

if __FILE__ == $PROGRAM_NAME
  argv = ARGV.dup
  # Global flag, stripped before dispatch so no subcommand parser has to know it.
  Config.skip_regenerate! if argv.delete(Config::SKIP_REGENERATE_FLAG)
  usage_exit if argv.empty?
  usage_exit if %w[-h --help help].include?(argv.first)

  command = argv.shift
  case command
when "login"
  cmd_login(argv)
when "logout"
  cmd_logout(argv)
when "invariants"
  sub = resolve_subcommand(argv, default: "check")
  case sub
  when "check"    then cmd_invariants_check(argv)
  when "snoozes"  then cmd_invariants_snoozes(argv)
  when "snooze"   then cmd_invariants_snooze(argv)
  when "unsnooze" then cmd_invariants_unsnooze(argv)
  else                 unknown("invariants subcommand", sub, SUBCOMMANDS["invariants"])
  end
when "slow-routes"
  cmd_slow_routes(argv)
when "deploy"
  sub = resolve_subcommand(argv, default: "status")
  case sub
  when "status" then cmd_deploy_status(argv)
  when "all"    then cmd_deploy_all(argv)
  else               unknown("deploy subcommand", sub, SUBCOMMANDS["deploy"])
  end
when "config"
  sub = argv.shift
  case sub
  when "check"   then cmd_config_check(argv)
  when "rollout" then cmd_config_rollout(argv)
  when nil       then require_subcommand("config")
  else                unknown("config subcommand", sub, SUBCOMMANDS["config"])
  end
when "tasks"
  sub = argv.shift
  case sub
  when "requeue" then cmd_tasks_requeue(argv)
  when nil       then require_subcommand("tasks")
  else                unknown("tasks subcommand", sub, SUBCOMMANDS["tasks"])
  end
when "browserslist"
  sub = argv.shift
  case sub
  when "update" then cmd_browserslist_update(argv)
  when nil      then require_subcommand("browserslist")
  else               unknown("browserslist subcommand", sub, SUBCOMMANDS["browserslist"])
  end
when "docker"
  sub = argv.shift
  case sub
  when "prune" then cmd_docker_prune(argv)
  when nil     then require_subcommand("docker")
  else              unknown("docker subcommand", sub, SUBCOMMANDS["docker"])
  end
when "aidirs"
  sub = argv.shift
  case sub
  when "prune" then cmd_aidirs_prune(argv)
  when nil     then require_subcommand("aidirs")
  else              unknown("aidirs subcommand", sub, SUBCOMMANDS["aidirs"])
  end
when "codegen"
  sub = resolve_subcommand(argv, default: "sync")
  case sub
  when "sync" then cmd_codegen_sync(argv)
  else             unknown("codegen subcommand", sub, SUBCOMMANDS["codegen"])
  end
when "scripts"
  sub = resolve_subcommand(argv, default: "list")
  case sub
  when "list" then cmd_scripts_list(argv)
  when "run"  then cmd_scripts_run(argv)
  else             unknown("scripts subcommand", sub, SUBCOMMANDS["scripts"])
  end
when "issues"
  sub = argv.shift
  case sub
  when "claim"     then cmd_issues_claim(argv)
  when "status"    then cmd_issues_status(argv)
  when "reconcile" then cmd_issues_reconcile(argv)
  when nil         then require_subcommand("issues")
  else               unknown("issues subcommand", sub, SUBCOMMANDS["issues"])
  end
when "changelog"
  sub = resolve_subcommand(argv, default: "all")
  case sub
  when "capture" then cmd_changelog_capture(argv)
  when "build"   then cmd_changelog_build(argv)
  when "all"     then cmd_changelog_all(argv)
  else                unknown("changelog subcommand", sub, SUBCOMMANDS["changelog"])
  end
else
  unknown("command", command, COMMANDS)
end
end
