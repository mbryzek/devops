# The full `dev ...` form passed as `example:` to usage_exit on an arg error.
# fetch (not []) so a typo'd command key fails loudly instead of showing "dev ".
def usage_for(command)
  "dev #{INVOCATIONS.fetch(command)}"
end

# The server's own ceiling on examples per failing invariant (spec: `examples`,
# default 10, max 100). The CLI always asks for the ceiling rather than taking
# the default: truncating for the terminal is a display decision made here
# (--examples / --all-examples), and the investigating session needs as much of
# the failing population as the server will give it. Before ISS-173 the server
# returned 10 no matter what, so --all-examples could only ever narrow those 10.
INVARIANT_EXAMPLES_MAX = 100

def invariant_checks_path(examples: INVARIANT_EXAMPLES_MAX)
  "/dev/invariant/checks?examples=#{examples}"
end

# The rollout guard's two dials (ISS-517): how many times to sample
# /_internal_/version before trusting a FAILING invariant result, and how long
# after a release the fleet is assumed to be possibly mixed. Declared up here
# rather than beside the guard because USAGE below interpolates them and USAGE is
# evaluated when this file loads; the guard and the reasoning for both values are
# under "rollout guard" further down.
INVARIANTS_VERSION_PROBES = 5
INVARIANTS_ROLLOUT_WINDOW_SECS = 15 * 60

USAGE = <<~USAGE
  Usage: dev <command> [subcommand] [options]

  Commands:
    #{INVOCATIONS["auth status"]}
        Every credential `dev` holds for a target, in one view: which app
        sessions are stored (platform, acumen, playbook), whether the AI token
        is present, and which of the two THIS process would authenticate with.
        `status` is the default when no subcommand is given.

    #{INVOCATIONS["auth login"]}
        Log in to platform and acumen. Prompts for email + password
        separately per app (credentials differ between stacks). If
        --email is passed it is reused for both; password is always
        re-prompted. Per-app failures warn but do not abort others.
        Pass `--app acumen` or `--app platform` to target just one.
        `--app playbook` logs in to the playbook tenant admin (used by
        `dev issues`); it is opt-in only, never part of the default
        login. Sessions are stored under ~/.platform/.

    #{INVOCATIONS["auth logout"]}
        Clear the cached devops sessions (platform + acumen + playbook).

    #{INVOCATIONS["auth ai status"]}
        Show the API token for the AI actor, "Otto AI", masked, and say whether
        this process would use it. Inside a Claude session `dev` authenticates
        with this token instead of your session, so work the AI does is
        attributed to the AI and not to you. Your own runs are unaffected.

    #{INVOCATIONS["auth ai provision"]}
        Mint Otto's token and store it — the whole setup in one command. Using
        YOUR playbook session (Otto is a playbook-tenant user, and user lookups
        are scoped to the caller's tenant) it creates the token (POST /tokens),
        reads the cleartext back (readable exactly once), writes it to
        ~/.platform/, and verifies the stored token authenticates as Otto before
        reporting success. Refuses to run inside a Claude
        session: a human authorizes the AI's credential, never the AI itself.
        If Otto already has live tokens it stops and lists them; --rotate mints
        and stores the new one first, then revokes the old ones (which breaks
        any other machine still holding them).

    #{INVOCATIONS["auth ai set"]}
        Store a token you minted elsewhere (e.g. provisioned on another machine).

    #{INVOCATIONS["auth ai clear"]}
        Forget the token locally. The token stays valid server-side.

    #{INVOCATIONS["auth ai revoke"]}
        The kill switch: revoke every live token for Otto server-side, then
        forget the local copy. Use this if the token leaks.

    #{INVOCATIONS["invariants check"]}
        Check invariants across endpoints. `check` is the default when no
        subcommand is given. Shows up to N examples per failure (default 10),
        or every example the server returned with --all-examples. The server
        caps examples at #{INVARIANT_EXAMPLES_MAX} per invariant, which is what this always
        requests — so --all-examples shows up to #{INVARIANT_EXAMPLES_MAX}, not necessarily every
        failing row. Compare against the reported count.

        When an app has failures with data behind them, hands them to a Claude
        session (Opus 5, 1M context) to investigate. The session gets every
        example the server returned (up to #{INVARIANT_EXAMPLES_MAX}), not just the 10
        shown. Nothing is ever handed over for an app the CLI could not reach —
        that is an auth/infra failure with nothing to investigate. The prompt prose lives in devops/claude-invariants/.

        At a terminal you are asked first (--fix skips the question), and the
        terminal is handed to one interactive session: it works a single failing
        app directly, or fans out a subagent per app when several fail at once.

        With no terminal (cron, a pipe) --fix is required, and the session runs
        headless instead — one detached `claude --print` per failing app, in
        parallel, logging to ~/Library/Logs/dev-invariants/. Without --fix a
        non-interactive run just reports and exits, as it always did. An
        unattended session is briefed to end on a ready PR, written findings, or
        a snooze, and to announce itself with an openclaw system event. The same
        set of failures is not re-dispatched for 3 days, so a failure that
        persists does not spawn a session every night; any change to the set of
        failing invariant names dispatches immediately.

        Failures are DEFERRED while the app is rolling out. An invariant is SQL
        that ships inside the app and the check is answered by whichever replica
        the load balancer picks, so right after a release a pod on the previous
        version can report a failure its own release already fixed. Before
        reporting findings the command samples /_internal_/version #{INVARIANTS_VERSION_PROBES} times: two
        versions at once, or a release less than #{INVARIANTS_ROLLOUT_WINDOW_SECS / 60} minutes old, means the
        verdict is not trustworthy — nothing is filed, no session is dispatched,
        and the exit code is 2 (uncheckable) rather than 1 (findings). Passes
        are never deferred, and an unreachable version endpoint defers nothing.

    #{INVOCATIONS["queries top"]}
        Rank the queries the platform ran, with the code that issued each, from
        the samples the platform records every flush window. `top` is the default
        when no subcommand is given. Sorted by TOTAL database time, which is what
        surfaces a query whose modest mean is multiplied by a large call count;
        --by-mean sorts by average for the opposite shape.

        MULTI is the share of a statement's calls whose block ran more than one
        statement. A duration covers its whole block and is charged to the first
        statement in it, so at a high share the cost belongs partly to a sibling
        and the statement shown is not the thing to optimize.

        Rows are numbered: at the prompt, pick any of them to file an
        `improvement` issue holding those queries and hand it straight to a
        Claude session, the way `dev issues create` does. Blank input files
        nothing, and nothing is offered when output is piped.

    #{INVOCATIONS["claude-usage top"]}
        Rank Claude API token usage/cost by (feature, model), from the daily
        rollups computed by the platform's ComputeClaudeUsageRollupProcessor.
        `top` is the default when no subcommand is given. Sorted by cost_usd by
        default -- `--sort input_tokens|output_tokens|requests` for the others.

        Rows are numbered: at the prompt, pick any of them to file an
        `improvement` issue investigating why that feature costs what it does,
        handed straight to a Claude session, the way `dev issues create` does.
        Blank input files nothing, and nothing is offered when output is piped.

    #{INVOCATIONS["invariants snoozes"]}
        List active invariant snoozes.

    #{INVOCATIONS["invariants snooze"]}
        Snooze an invariant for N days. --app is required.

    #{INVOCATIONS["invariants unsnooze"]}
        Remove an invariant snooze. --app is required.

    #{INVOCATIONS["tasks requeue"]}
        Requeue failed async tasks.

    #{INVOCATIONS["tasks delete"]}
        Delete task rows outright, in any state (pending, working, gave-up,
        completed). --id is repeatable and removes exactly those rows;
        --discriminator removes every row for one queue, which is step three of
        retiring a task type: once the deploy that dropped the enum value is
        live, the rows it left behind can never be dispatched again and trip
        `unknown_task_discriminators` until they are cleared. A discriminator
        the code no longer defines is exactly what this expects.

        Deleting by discriminator prints the matching row count per app and asks
        before doing anything; --yes skips the prompt and is required when stdin
        is not a terminal. Find candidates with `dev invariants check` or the
        Task Queues board in playbook-admin.

    #{INVOCATIONS["slow-routes"]}
        Show the slowest routes by response time over the last N days
        (default 7). Sort with --sort (default -p95), cap rows with
        --limit (default 10), filter with --app member|admin.

    #{INVOCATIONS["deploy status"]}
        Print every tracked app, DB repo, scala library (lib-*), and devops
        itself with its latest tag, the version production is running, and a
        status — the full fleet picture even when everything is up to date.
        `status` is the default when no subcommand is given.

        An item needs a release when origin/main is ahead of the latest tag,
        OR production is running a version other than the latest tag (tagged
        but never deployed). The prod version comes from /_internal_/version
        or the live k8s image tag; *-postgresql repos, libraries (which
        publish to Maven Central, so their prod column is always `-`), and
        apps with no prod probe are checked on git state only. --app APP
        matches an app, DB, library, or `devops` name exactly (e.g. `platform`
        vs `platform-postgresql` vs `lib-util`).

        devops is the one item with no tag and no artifact: the ~/code/devops
        checkout IS the deployment, so its tag column is origin/main's sha, its
        prod column is the local HEAD sha you are running, and it is pending
        whenever it is behind — a release there is just `git pull`.

        If anything is pending, you are prompted to pick which items to
        release — numbers (e.g. 1,3), `all` (the default), or `none` — and
        the selection releases exactly as `deploy all` would. The prompt is
        skipped when stdin is not a terminal (pipes, cron), so scripted
        callers just get the table.
    #{INVOCATIONS["deploy all"]}
        Release every pending item without prompting. Five phases:
          1. EXPANDING DB repos (*-postgresql) release serially via
             `release-db`, with RELEASE_AUTO_TAG=1 and
             RELEASE_DB_AUTO_CONFIRM=1 — alongside, in parallel, every app
             that does NOT depend on one of them (acumen does not wait on
             platform-postgresql, and neither does an app whose own DB is
             contracting, since that one waits on IT).
          2. Apps that DO depend on a pending expanding DB (foo on
             foo-postgresql) release in parallel (concurrency defaults to
             10) via `release` with RELEASE_AUTO_TAG=1, once their DB is
             done. With no expanding DB pending, all apps release here.
          3. CONTRACTING DB repos — those whose new migrations DROP or
             RENAME a table, column, view, sequence, type or function —
             release serially here, AFTER their apps. Dropping something
             the live code still selects is a 500 on every request that
             touches it for the whole length of a rollout, not a slow
             migration (ISS-317). A contracting DB is skipped when its app
             did not release, because the code that still uses the dropped
             objects is then the code in production.
          4. Libraries (lib-*) release serially via `release`, which
             dispatches a lib- checkout to `release-lib`. That stays
             interactive — it confirms the tag and GPG asks for the
             signing passphrase — so its output is not captured. Without a
             terminal (pipe, cron) pending libraries are skipped, named in
             the summary, and the command exits non-zero.
          5. devops, alone and last, as a plain `git pull` — its update
             rewrites the very scripts the phases above shell out to, so it
             must not run while anything else is mid-release.
        If an expanding DB release fails, the matching app (foo for
        foo-postgresql) is skipped to avoid deploying an app against an
        unmigrated schema. Skips repos not on `main` or with a dirty tree.

    #{INVOCATIONS["config check"]}
        Diff live ConfigMap in cluster against env/apps/<app>/env/production.env.
    #{INVOCATIONS["config rollout"]}
        Apply k8s-secrets and rollout restart workloads (picks up ConfigMap changes).

    #{INVOCATIONS["docker prune"]}
        Remove stopped containers and unused images older than N days (default 3),
        plus every unused volume and ALL build cache on every builder — neither of
        those takes an age filter. Useful when local disk fills from
        pushed-but-unused builds.
        Dry-run by default: reports the actual candidates per step, so the sizes
        describe this run rather than `docker system df`'s RECLAIMABLE column,
        which ignores the age filter. Pass --apply to remove.
        Build cache is pruned per BUILDER and in full: `docker builder prune` only
        reaches the current one, so a docker-container builder accumulates cache
        that nothing touches and that `docker system df` does not even report. An
        age filter there spares records that are ancestors of recent ones, which
        buildkit then cannot release — it freed 9.2MB of a 5.27GB builder here.
        The cost of taking it all is one cold build.
        --keep-tags N (default 5) also drops all but the N newest tags per
        repository at any age, since registry tags land faster than any age
        window retires them; --keep-tags 0 disables that step.
        --keep-named-volumes takes anonymous volumes only, leaving named unused
        volumes (stopped session DBs, hand-created ones) in place.

    #{INVOCATIONS["aidirs prune"]}
        Reap feature dirs under ~/code/ai. These are throwaway clones, so any dir
        idle more than N days (default 3) is deleted outright regardless of git
        state — including dirs holding work not on a remote (uncommitted, stashed,
        detached, loose files, or local-only commits); the dry-run names what each
        one is losing. Dirs touched within N days are protected (with `gh` consulted
        so a landed merged/closed PR still lets a recent dir be deleted). Dry-run by
        default: prints the keep/delete split and removes nothing. Pass --apply to
        delete.

    #{INVOCATIONS["prune plans"]}
        `git rm` plan files under ~/code/claude/plans whose last commit is more
        than N days old (default 14). Plans go stale fast and a flat directory of
        thousands makes the live ones unfindable — worse, a months-old plan reads
        exactly like a current one. Nothing is lost: the content stays in git
        history, so `git log`/`git show` recovers any file.
        Only top-level files are considered; subdirectories are curated
        collections and are never touched. A file that is untracked or has
        uncommitted changes is always kept — its content is NOT in history yet,
        so removing it would destroy it.
        The removal runs in a throwaway git worktree and pushes straight to main,
        so a parallel session's work-in-progress in the shared ~/code/claude
        checkout is never disturbed; that checkout picks the deletions up on its
        next pull. Dry-run by default. Pass --apply to remove.

    #{INVOCATIONS["browserslist update"]}
        Shallow-clone every ~/code/* repo with a package.json into
        ~/code/browserslist.<YYYYMMDD>/<name>, run `npx update-browserslist-db@latest`,
        and push changes to main. Use --app NAME to limit to one repo (matched by
        directory name under ~/code). The temp dir is deleted on success unless
        --keep-tmp-dir is passed; it is always kept if any repo fails so output
        can be inspected. Any ~/code/browserslist.* dirs left behind by earlier
        runs (a failed run keeps its clones) are deleted first, so at most one
        run's worth of node_modules is ever on disk. Quiet by default; use
        --verbose to stream full output.
        --check detects without changing anything: it clones and runs the updater
        exactly as above, then reports the repos whose caniuse-lite data WOULD
        change and commits/pushes nothing. Its verdict is its exit code — 0
        nothing to update, 1 repos need updating (listed on stdout), 2 the check
        itself could not run — and it is the first step of the
        `browserslist-update` producer's playbook (agent/bodies/browserslist-update.md),
        which fixes what it finds as a normal PR per repo. Nothing schedules the
        pushing form any more; it stays for running the sweep by hand.
        Writes data/browserslist-status.md in the openclaw workspace, which the
        morning briefing reads — in both modes, so the section does not go dark.

    #{INVOCATIONS["depsguard scan"]}
        Run `depsguard scan` over the supply-chain config files and report the
        failures worth acting on. One known false positive is suppressed: pnpm's
        `minimum-release-age` reported "not set" on an npm-only repo (one with a
        package-lock.json and no pnpm-lock.yaml), where the key is meaningless.
        Suppressing it here rather than in the fixer is what stopped the endless
        add/revert churn it caused on apibuilder-ui's .npmrc.
        The verdict is the exit code — 0 clean, 1 real failures (listed on
        stdout), 2 the scan itself could not run — for the `depsguard` producer
        `depsguard`. It fixes nothing: the producer files unconditionally
        (ISS-525) and the claiming session runs this first, dismissing the issue
        on exit 0.

    #{INVOCATIONS["codegen sync"]}
        Regenerate every codegen-consuming repo against the latest generators and
        specs, opening a review-ready PR per repo that changes. Every repo is
        cloned at main into one working dir under ~/code/ai, so a consumer
        regenerates against the backends' specs AS MERGED, not as last released;
        nothing is ever published (only `api publish`, from a clean merged main,
        moves the registry). Backends (platform, acumen) regenerate first,
        serially; consumers regenerate in parallel. `sync` is the default subcommand.
        --dry-run reports diffs without spawning Claude or opening PRs;
        --regen-only opens draft PRs but skips the review-completion workflow;
        --full-tests runs the full Scala suite instead of Test/compile.
        --check is a dry run whose verdict is its exit code — 0 in sync, 1 drift
        found, 2 the check itself broke — run by the `codegen-sync` playbook as its
        first step (ISS-525). It never opens a PR or spawns Claude.

    #{INVOCATIONS["dependencies check"]}
        Report outdated library dependencies for the scala repos (platform,
        acumen, lib-util, lib-query, lib-cipher, lib-ai) without changing
        anything. Clones each repo, runs sbt-updates (injected via
        --addPluginSbtFile — nothing is committed to the repo), and prints the
        allowed bumps plus anything held back by the denylist
        (devops/lib/dependencies/denylist.yml) or skipped by the version
        policy (stable, plain-numeric targets only; scalaVersion / sbt / plugin
        versions are never touched). `check` is the default subcommand.

    #{INVOCATIONS["dependencies upgrade"]}
        The nightly upgrade pipeline (also fine to run by hand): detect as in
        `check`, then for each repo with allowed bumps spawn a Claude session
        that applies them, compiles, runs the repo's test suite (platform
        against an isolated claude-db session DB), fixes any breakage, reverts
        bumps it cannot make green (listed as "Deferred upgrades" in the PR
        body with a paste-ready denylist entry), and opens a draft PR then
        marks it ready. One PR per repo. Skips a repo that already has an open
        dep-upgrade PR. Lib repo PRs bump the lib's own dependencies only —
        releasing the lib stays manual (release-lib). Scheduled nightly via
        launchd/com.bryzek.dev-dependencies.plist (see that file to install).

    scripts [list]
        List utility scripts in devops/scripts/ with their allowed targets and
        a one-line description. `list` is the default when no subcommand given.

    #{INVOCATIONS["scripts run"]}
        Run a utility script (or wrapper) — the NAME comes first. For `.sql`
        scripts the args are env flags: local platformdb by default, or `--prod` /
        `--env development` to run via `db exec` (production prompts for
        confirmation; non-local targets must be listed in the script's
        `dev-script:` header). Executable scripts/wrappers run locally with every
        arg forwarded to them (a leading `--` separator is dropped) — including
        their own `--env`/`--prod` flags.

    #{INVOCATIONS["issues create"]}
        File a new issue from the laptop and immediately start working it — the
        front door for all new work. Prompts for the category (feature, bug,
        improvement: the manually-filed categories, mirroring the changelog
        vocabulary; graphs/worker/insights are auto-filed and batch-claimed by
        `issues claim`), then opens $EDITOR on a buffer that IS the brief the
        Claude session works from. The brief can come from --body "TEXT" or be
        piped in on stdin instead — that is what a headless caller (a Claude
        session filing the work it is already doing, cron) must use, since there
        is no terminal there to open $EDITOR on; --category is required in that
        case too, for the same reason. No title is needed: the server files it
        under a placeholder ("New Bug", …) and a background task summarizes the
        body into a real one moments later — pass --title to set it yourself.
        A URL on its own line is recorded as the page the issue is about
        (source_url), and any pasted or dragged-in file path is uploaded as a real
        attachment — both are lifted out of the body. Repeat --image PATH to
        attach files explicitly: each is uploaded to the issue AND handed to the
        session as a local path, so it can read the file directly.

        Repeat --repo NAME for every repository the work is in — bare GitHub
        repo names under mbryzek (platform, platform-postgresql, devops, …), not
        owner/repo slugs. It is not a label: the agent executor clones each named
        repo into the attempt's workspace and creates the attempt's branch in it,
        so an autonomous session opens into a checkout instead of cloning for
        itself and picking its own branch name — the ISS-365 failure, where good
        work landed on a branch the executor could not find. An issue with no
        repos still works; its session just clones for itself. An unknown name is
        rejected here, with the full list.

        --status says who the issue belongs to. `claimed` is yours to work now;
        `open` hands it to the queue and starts no session. From a terminal it
        defaults to `claimed` — that is what filing from the laptop means. Off a
        terminal it is REQUIRED, because a Claude session files both work it is
        doing and findings it is only reporting, and a claimed issue nobody is
        working is invisible to `dev issues claim` (which only offers OPEN ones),
        so it is worse than a mislabeled one — it is unpickupable.

        A claimed issue is claimed atomically, in the create request itself — no
        window where it is open and a concurrent sweep could grab it — then
        stamped with the Claude session id (an internal timeline comment),
        written to a plan under ~/code/claude/plans/, and the terminal is handed
        to an interactive session (Opus 5, 1M context) pinned to that session id.
        Reattach later with `dev issues resume`. Pass --no-spawn to stop once the
        issue is filed and claimed — no session id, no plan, nothing to resume:
        that is the mode for filing work you are already doing yourself, and it
        prints the `issues status` command to close it.

        Filing checks the queue for you. When the brief names something a LIVE
        issue already names — an invariant, an entity id — the server links the
        two on both timelines and `create` prints the link here, before the work
        is handed to a session. It never refuses the filing: it says what is
        already tracked while that can still change what you do. (ISS-462 and
        ISS-486 shipped the same acumen fix three minutes apart because nothing
        ever said it.)
        Authenticates with your persisted playbook session — run
        `dev auth login --app playbook` once first.

    #{INVOCATIONS["issues list"]}
        Read-only. Lists every issue by default; repeat --status to filter to
        just those (e.g. --status open --status claimed), and/or --category to
        scope to one category. Use this to check whether work is already
        tracked before filing a new issue — unlike `issues claim`, this never
        claims anything. Pass --epic NUMBER to list just that epic's children.
        Authenticates with your persisted playbook session —
        run `dev auth login --app playbook` once first.

    #{INVOCATIONS["issues parent"]}
        Adopt an existing issue onto an epic, or detach it. An effort is often
        recognised as one AFTER its pieces are already in the queue (the four
        ISS-314 CourtReserve write follow-ups were), so this is the path that
        makes under-calling an epic cheap: one command later, rather than
        filing a container speculatively up front. A child stops appearing in
        the awaiting-verification queue on its own — its epic becomes the one
        item verified once the whole effort has shipped.

    #{INVOCATIONS["issues block"]}
        Record that NUMBER cannot be worked until --on NUMBER has shipped, and stop
        the queue handing it out until then: a blocked issue is never offered by
        `issues claim` or to the autonomous fleet, and naming it with --number is
        REFUSED with its blockers listed rather than silently skipped. An issue
        counts as blocked while any blocker is still live work; it becomes
        claimable on its own the moment the last one reaches fixed, deployed,
        verified or dismissed — nothing has to clear the link. `fixed` is the
        threshold because that is when the blocker's PR is merged and the code the
        dependent builds on exists; waiting for a release would stall a whole epic
        behind a deploy cadence. An edge that would create a cycle is refused with
        the cycle printed, because a cycle makes every issue on it unclaimable
        forever with no status change able to clear it and nothing anywhere to say
        so. --remove drops the edge. Both issues get a timeline note, and both
        ends show up in `issues show`. Use it instead of writing the ordering in a
        comment: nothing reads a comment before claiming at 3am.

    #{INVOCATIONS["issues show"]}
        Print one issue and its full comment history, oldest first, with the status
        transition each comment recorded. This is the only way to READ a timeline
        from the CLI — `issues status --comment` only writes to it. The output is
        the same section `issues claim` puts in a plan, so a re-opened issue shows
        its RE-OPENED banner and previous fix PRs here too.

    #{INVOCATIONS["issues resume"]}
        Reattach to the Claude session `issues create` started on an issue. Reads
        the issue's timeline, takes the most recently recorded session id, and runs
        `claude --resume <id>`. Errors when the issue has no recorded session.

    #{INVOCATIONS["issues claim"]}
        Claim open issues into local plans for a Claude session to work on. With no
        --category (the default) it scans EVERY category — graphs, worker, insights,
        suggestion, feature, bug, improvement — so no open issue is unreachable from
        the CLI. It lists them grouped by category, numbered 1..N across the whole
        list, and asks which to claim: numbers (`1,3`), `all` (the default — just
        press enter), or `none`. It then atomically claims the selection and writes
        ONE plan per ISSUE claimed to
        ~/code/claude/plans/<date>-issue-<number>-<slug>.md — a plan is what one
        subagent gets handed, so it is one unit of work. Pass --number 078,080 to
        select by issue number without the prompt, --yes to take everything a sweep
        takes, or --category CATEGORY to scope to a single category. `suggestion` is
        swept like every other category, but its plan runs as an INVESTIGATION, not
        a fix session — a member's request is a product call, not a defect, so the
        session reads the code and the issue and hands back a recommendation via
        `dev issues status --status needs_review` instead of opening a PR. A
        category you selected in full is claimed as a category (so it picks up
        whatever is open at claim time);
        a partial selection is claimed by number and is all-or-nothing — if one of the
        picked issues was just taken by another session, nothing is claimed and the
        error says which. It then hands the terminal to an interactive Claude
        session (Opus 5, 1M context — the `ccd` model): one plan → it implements
        the plan directly; several → it fans out subagents and works them in
        parallel, one subagent per plan EXCEPT that plans in the same category
        that turn out to touch the same feature go to one subagent together (that
        judgment needs the code read, so the session makes it, not this CLI).
        Never across categories — those are independent pipelines and repos. Pass
        --no-spawn to just write the plans and print their
        paths. Authenticates with your persisted playbook session — run
        `dev auth login --app playbook` once first (the issues API requires a playbook
        admin, not the platform `dev auth login`).

    #{INVOCATIONS["issues status"]}
        Close a claimed issue. NUMBER is the per-tenant issue number shown as
        ISS-<number> (034, or unpadded 34). STATUS is one of open, claimed,
        needs_review, fixed, deployed, verified, dismissed, needs_input.
        `needs_review` is how a `suggestion` investigation hands back its findings
        (see suggestion-body.md) — pass --comment with the recommendation. Marking
        `fixed` requires --url:
        the merged PR, or a document describing a manual/process fix. Pass --app
        <deployable-app> and --baseline-version <live release tag> TOGETHER (both or
        neither) for a code fix: they are what let `dev issues reconcile` flip the
        issue to `deployed` once that app releases past the baseline; a
        document-linked fix has neither and is advanced by hand. --comment carries
        the question (needs_input) or a reason (dismissed). --duplicate-of NUMBER
        records this issue as a duplicate of that one; it applies only to
        `--status dismissed`, and `issues duplicate` is the shorter way to say it. The generated plan tells
        the fix session to call this so no session token is written into the plan file.

        THIS IS THE FIRST FIX ONLY. fixed -> deployed -> verified is a one-way
        ladder and the server refuses a move back down it, so `--status fixed` on an
        issue already deployed or verified comes back 422 rather than silently
        un-verifying it. A SECOND PR on an already-shipped issue is `issues fix`
        below. Reopening is unaffected — `--status open` is how a regression is
        recorded, and the comment is what says so.

    #{INVOCATIONS["issues fix"]}
        Record an ADDITIONAL fix on an issue that has already shipped — "this also
        shipped in devops PR #314" — leaving its status exactly where it is. Use it
        whenever the work landed in more than one PR and the issue is already fixed,
        deployed or verified.
        --url is the merged PR (or a document); --comment says why you are recording
        it; --app and --baseline-version TOGETHER name the deployable, the same pair
        `issues status` takes, and on an issue still at `fixed` they become what
        `issues reconcile` watches.

        Never name a status to do this. `issues status --status fixed --url ...` on
        an issue at `verified` or `deployed` walks it BACKWARD: on 2026-08-05 one
        sweep recording second PRs that way un-verified ten issues in eleven seconds,
        six needed hand-walking forward, and three of Mike's verifications were
        destroyed outright — the one thing here nothing automated can reproduce
        (ISS-536). The server now refuses that write, and this is the command it
        refuses it in favour of. Do NOT fall back to a bare --comment either: a url
        in prose is invisible to `issues show`'s fix list and to `issues reconcile`,
        which is the same loss somewhere quieter.

    #{INVOCATIONS["issues duplicate"]}
        Record NUMBER as a duplicate of --of NUMBER: it is dismissed, both issues
        get a note, and each one shows the link from then on (`issues show`, and a
        `(dup of ISS-<n>)` tag in lists). Sugar for
        `issues status <n> --status dismissed --duplicate-of <m>`. Naming an issue
        that was ITSELF absorbed links to that issue's canonical instead, so the
        chain stays one level deep and `issues show` on the canonical lists every
        duplicate rather than only the last hop. Reopening a duplicate clears the
        link. Use it instead of dismissing with the reason in prose: a comment
        leaves the two records unconnected, so the canonical issue never learns it
        absorbed anything.

    #{INVOCATIONS["issues workaround"]}
        File something this session ROUTED AROUND rather than fixed — an
        instruction it could not execute as written, a weaker substitute data
        source, a guardrail it crossed, a precondition that was not true on this
        runner. The close-out contract in devops/agent/instructions.md §1 is the
        authority on when to reach for it; the short version is that a workaround
        described only in a report dead-ends there, because a session that
        quietly worked around a broken instruction looks exactly like one that
        succeeded. Filing nothing is the normal outcome.

        Files at `open` and starts no session: the caller is reporting this, not
        working it. --key is the dedup key and must name WHAT BROKE, not the run
        that hit it (`openclaw-status-path-missing`, not
        `slow-query-2026-08-05`), so the next session hitting the same thing
        recurs onto the same issue instead of filing a second one. --from is the
        issue the session was working; it is recorded in the new issue's body and
        as a comment on that issue's timeline, so the link reads in both
        directions. Repeat --repo NAME for the repositories the fix would touch,
        exactly as on `issues create` — a finding filed with them is one whose
        session opens into a checkout.

    #{INVOCATIONS["issues handoff"]}
        Hand a human the ONE step this session could not take — a command needing a
        scope, a credential, or a binary no autonomous session has. Retiring an
        openclaw cron is the standing example: `openclaw` is not installed on the
        runners, and the agent identity lacks `operator.admin` (which it should not
        have — that is admin over every cron on the gateway, including the personal
        and financial ones deliberately left there).

        Files at `needs_input`, not `open`, and that is the entire point.
        `dev issues claim` only offers `open` issues, so a handoff cannot be claimed
        by an agent that will fail on it exactly as this one did — which is what
        happened when the same commands were filed as a workaround (ISS-563: two
        sessions handed over two `openclaw cron rm` calls, a third claimed the
        finding, and the crons kept firing). `needs_input` is also a standing
        section of the daily nudge, so it arrives every morning until it is cleared.

        --command is required at least once and is the artifact: the exact line to
        paste, one flag per command. Prose describing the step is what already
        failed twice. --url names the PR or document the commands complete, and is
        rendered into the close-out command the issue tells the human to run.
        --key is the dedup key, naming the PENDING STEP rather than this run, so a
        later session blocked on the same thing recurs onto the same issue instead
        of filing a second one. --from is the issue this session was working; it is
        recorded in both directions.

        A handoff is NOT for work you could do and would rather not. The test is
        whether any autonomous session on any runner could run the command at all.

    #{INVOCATIONS["issues snooze"]}
        Defer an issue for --days N: it drops out of the queue, out of
        `issues claim`, and out of the daily nudge email until then, keeping its
        status. Use --comment to record why you are coming back ("confirm the
        data migration completed"). --wake clears the snooze and returns the
        issue to the queue now.

    #{INVOCATIONS["issues reconcile"]}
        Two passes, in order. First: adopt every `claimed` issue whose fix has
        already merged — a merged PR titled `ISS-<number>: ...` is the signal — so a
        session that forgot to close its issue out cannot strand it outside the
        pipeline. It lands `fixed` when the repo releases a tracked deployable, and
        straight to `deployed` when it does not (devops, acumen, the shared libs:
        there is no release to wait for, so the merge is the release). Then: flip
        `fixed` issues to `deployed` once their target app has released past the fix.
        Read-only against GitHub and the deploy registry (same live-version signal as
        `dev deploy status`) — the release pipeline is untouched. Dry-run by default;
        pass --apply to record the transitions (e.g. from a cron).

    #{INVOCATIONS["autonomy decide"]}
        Ask the autonomy ledger for permission BEFORE acting, and act only if it
        says yes. Records the decision with its reasoning either way. EXITS 0 ONLY
        when the answer is auto_approved, so the shell idiom is:

            dev autonomy decide ... && gh pr merge 1631 --squash

        Every other answer -- pending (the workflow is in propose mode), blocked
        (outside its declared envelope or over its daily budget), suppressed (dry
        run or the global kill switch), a validation failure, or an unreachable
        ledger -- exits non-zero. Doing nothing is the default on anything going
        wrong, which is the point.

        A workflow key the ledger has never seen registers itself at mode dry_run,
        so a new loop records what it WOULD do and acts on nothing until a human
        promotes it. --register-name/--register-description seed that registration.

        --assert supplies the facts the envelope is judged against: --assert
        repo=platform --assert ci_green=true --assert diff_lines=43. `true`/`false`
        and integers are sent as booleans and numbers. The ledger does not verify
        any of them -- they stop a workflow drifting past its boundary, they do not
        defend against one that reports false facts.

        --idempotency-key defaults to a hash of workflow+action+subject, so a
        retried run gets its ORIGINAL answer back instead of a fresh evaluation.

    #{INVOCATIONS["autonomy outcome"]}
        Report what actually happened after acting. Pass --undo-command with the
        command that would take it back (`gh pr revert 1631 --repo mbryzek/platform`)
        so the ledger can offer a revert later. Reporting --applied on a decision
        the ledger never approved marks it `contradicted` and exits non-zero: that
        is a workflow having acted without permission, not a bookkeeping detail.

    #{INVOCATIONS["autonomy workflows"]}
        List every registered workflow with its mode and today's counts, or show
        one workflow's envelope and budgets. Mode, envelope and budgets are edited
        in the admin UI, not here -- granting autonomy is a deliberate human act.

    #{INVOCATIONS["autonomy decisions"]}
        The decision feed, filterable by workflow, status and disposition.

    #{INVOCATIONS["autonomy run"]}
        Open and close a run, so a batch of decisions is grouped under the
        execution that produced them. `start` prints the run id to pass to
        `decide --run-id`. Finish it as completed, failed, or gave_up -- gave_up
        is the one that means decisions were left stranded pending.

    #{INVOCATIONS["autonomy reverts"]}
        Reverts waiting on an executor: decisions whose undo is a command the
        platform cannot run itself. Prints the command and the id to report back.

    #{INVOCATIONS["autonomy reverted"]}
        Report that a command-kind revert was executed. --failed records that it
        was attempted and did not work, which is not the same as never trying.

    #{INVOCATIONS["changelog status"]}
        What platform holds per app: the latest recorded version and how many are still
        awaiting notes.

    #{INVOCATIONS["features list"]}
        Every feature flag in the code-driven catalog with its state, roles, and
        last-enabled-at, plus any flags awaiting cleanup. A flag awaiting cleanup no
        longer appears in the catalog (its enum value is gone), so it is listed
        separately or not at all.

    #{INVOCATIONS["features retire"]}
        Record a removed flag for cleanup, naming every deployable app whose release
        carries the removal. Run it after the removal PRs merge. Baselines are read
        from what production is running now, so they are never typed by hand; an app
        whose live version cannot be read is a hard error rather than a removal that
        could never be confirmed.

    #{INVOCATIONS["features status"]}
        Feature removals awaiting cleanup, with each (app, baseline version) pair
        checked against the version production is running. READY means every pair has
        cleared: production released past the baseline recorded when the removal
        merged. Read-only.

    #{INVOCATIONS["features reconcile"]}
        Soft delete the tenant_features row for every READY removal, then hard delete
        rows whose one-month rollback window has closed. Same live-version signal as
        `dev deploy status`. Dry-run by default; pass --apply to record the changes
        (e.g. from a cron).

        Deliberately fail-closed: an app that has not released, a missing version
        probe, or an unknown app leaves the removal pending rather than advancing it.
        Deleting a flag row while the old code is still serving flips the behavior
        back for real users, so silence must never be read as confirmation. Anything
        stuck for more than a week trips the
        feature_removals_must_be_processed_within_a_week invariant.

    #{INVOCATIONS["features cancel"]}
        Void a removal and restore its soft-deleted flag row. The revert path: the
        flag's removal was undone, so the cleanup must not proceed.

    #{INVOCATIONS["changelog capture"]}
        Record the changelog for the playbook* apps into platform, which serves it at
        /dev/changelog and /playbook/admin/changelog. With no subcommand it runs the full
        pipeline: `capture`, then `build`. `capture` reads each tracked app's
        git tags (playbook-admin, playbook-app, playbook-www) and records every release
        past the server's max_version, with all commits since the previous tag —
        idempotent, so it both records new releases and backfills history. Repeat --app to scope;
        default is all tracked apps. Runs automatically (best-effort) at the end of
        `release`; never blocks a release.

    #{INVOCATIONS["changelog build"]}
        Turn the raw commits of each recorded release into curated notes via a headless
        Claude session that judges which commits are worth a human note, summarizes
        them, and links each to its PR and (best-effort) in-house issue (ISS-###). The
        work list is the server's own `versions_missing_notes`, so a version is built
        once and never re-evaluated; notes are POSTed back per batch, which is what
        makes a large backfill resumable. Newest first, a batch of versions per Claude
        session (--batch-size N to change the batch; session startup, not the notes
        themselves, dominates the cost). Pass --limit N to build only the N most
        recent pending versions (e.g. to seed history without evaluating every past
        release). Enrichment uses your persisted playbook session; run
        `dev auth login --app playbook` once first. /admin/changelog reads the API
        live, so the page reflects new notes as soon as they are recorded.

    #{INVOCATIONS["agent tick"]}
        ONE PASS of the autonomous dispatcher: heartbeat, reap finished sessions,
        run any due producer, and claim the next issue if there is a free slot.
        launchd runs this every 30 seconds (launchd/com.bryzek.dev-agent.plist);
        there is no daemon. Two phases with two locks — vitals always run, work is
        skipped when a previous tick still holds the lock. --dry-run prints every
        decision and executes none, which is also the provisioning smoke test on a
        new machine.

    #{INVOCATIONS["agent status"]}
        This machine: runner identity and concurrency, every live claim with its
        elapsed time and the last line of its session log, and when the last tick
        ran. `status` is the default when no subcommand is given.

    #{INVOCATIONS["agent logs"]}
        The session log for one issue (~/Library/Logs/dev-agent/issues/ISS-<n>/).
        --follow tails it.

    #{INVOCATIONS["agent pause"]}
    #{INVOCATIONS["agent resume"]}
        Kill switch. A paused runner finishes what it is working and claims
        nothing new; `resume` puts it back in service. Neither kills a running
        session — use `dev agent release <issue>` for that.

    #{INVOCATIONS["agent runners"]}
        The fleet: hostname, hardware, max concurrency, paused state, last seen.

    #{INVOCATIONS["agent producers"]}
        The registry — platform rows, managed at /admin/agents — with each
        producer's schedule, last run and result, and when it is next due. Every
        number here is READ from the server, the one thing that schedules
        producers; nothing is computed locally.

    #{INVOCATIONS["agent runs"]}
        Full history: every producer run, and every lease attempt for --issue N.
        "Did it actually fire, when, and what happened" in one command instead of
        a log grep.

    #{INVOCATIONS["agent refresh"]}
        Re-open a `fixed` issue so the fleet resumes its branch — the rebase and
        review-feedback loop. Sugar for `dev issues status <n> --status open`
        with a stock comment; the next claim finds the recorded branch, checks it
        out, rebases onto origin/main, and updates the same PR in place.

    #{INVOCATIONS["agent release"]}
        Force-release a stuck lease and kill its local session, returning the
        issue to the queue.

    #{INVOCATIONS["agent gc"]}
        Apply the retention rules: tick/producer logs 30 days, a terminal issue's
        logs 14 days, a failed one's 30 (the post-mortem window), agent
        workspaces 7 days. One of the chores `agent maintenance` runs.

    #{INVOCATIONS["agent maintenance"]}
        This machine's own housekeeping — `agent gc`, `aidirs prune`,
        `claude-db gc` (session databases, and the containers and ports left
        holding none) and `docker prune` — and what the tick runs once an hour,
        with shorter retention windows whenever free space is under the floor —
        except for session databases, whose window never shortens (ISS-588).
        Runner-local by design: these delete files on THIS disk, so every
        machine runs its own (ISS-520).
        Prints when it last ran, this machine's headroom, and whether a run is
        due. --dry-run says what it would do; --force runs regardless of cadence.

    #{INVOCATIONS["agent doctor"]}
        Compare this machine to the host prerequisites in Agent::Toolchain::TOOLS
        and print what is missing, what it blocks, and the command that installs
        it. Exits 1 if any REQUIRED tool is absent — run it after provisioning a
        runner and before trusting one. Resolution uses the PATH launchd gives
        the tick (`/bin/zsh -lc`), NOT your interactive shell's, so a tool that
        only nvm/rbenv/asdf provides reads as missing here exactly as it does to
        the agent (ISS-531).

  Common options:
    --app APP       Limit to a single app (acumen, platform)
    --localhost     Hit local development servers instead of production
USAGE

# No message => the user asked for help (`dev`, `dev help`, `-h`); print the
# full usage and exit 0. With a message it's an error: keep it short and point
# at `dev help` rather than dumping the whole usage block on every mistake.
# Pass `example:` to show the one-line invocation for the failing command inline
# so the user doesn't have to hunt through `dev help` to find the right syntax.
def usage_exit(msg = nil, example: nil)
  if msg
    warn msg
    warn "  Usage: #{example}" if example
    warn "Run `dev help` for usage."
    exit 1
  else
    warn USAGE
    exit 0
  end
end

# Known commands and their subcommands, used to suggest a correction when the
# user mistypes one (e.g. `task` -> `tasks`, `requeu` -> `requeue`).
COMMANDS = %w[auth invariants tasks deploy config docker aidirs prune browserslist depsguard scripts codegen dependencies issues autonomy changelog features queries claude-usage agent].freeze
SUBCOMMANDS = {
  "auth"         => %w[status login logout ai],
  "auth ai"      => %w[status provision set clear revoke],
  "changelog"    => %w[capture build status],
  "invariants"   => %w[check snoozes snooze unsnooze],
  "tasks"        => %w[requeue delete],
  "deploy"       => %w[status all],
  "config"       => %w[check rollout],
  "docker"       => %w[prune],
  "aidirs"       => %w[prune],
  "prune"        => %w[plans],
  "browserslist" => %w[update],
  "depsguard"    => %w[scan],
  "scripts"      => %w[list run],
  "codegen"      => %w[sync],
  "dependencies" => %w[check upgrade],
  "issues"       => %w[create list parent block duplicate workaround handoff claim show status fix snooze reconcile resume],
  "autonomy"     => %w[decide outcome workflows decisions run reverts reverted],
  "features"     => %w[list retire status reconcile cancel],
  "queries"      => %w[top],
  "claude-usage" => %w[top],
  "agent"        => %w[tick status logs pause resume runners producers runs refresh release gc maintenance doctor],
}.freeze

def levenshtein(a, b)
  return b.length if a.empty?
  return a.length if b.empty?
  prev = (0..b.length).to_a
  a.each_char.with_index do |ca, i|
    curr = [i + 1]
    b.each_char.with_index do |cb, j|
      cost = ca == cb ? 0 : 1
      curr << [curr[j] + 1, prev[j + 1] + 1, prev[j] + cost].min
    end
    prev = curr
  end
  prev[b.length]
end

# Closest candidate to `input`. A *unique* prefix wins outright (handles `inv`
# -> `invariants`); an ambiguous prefix (2+ matches, e.g. `lo` for login/logout)
# is not resolved on the prefix branch. Everything else — including ambiguous
# prefixes — falls to nearest-by-edit-distance within a small, length-scaled
# threshold, so `lo` (distance 3 to `login`, over threshold) yields nothing
# while `versio` (distance 1) still resolves to `version`. The threshold keeps
# unrelated typos from getting bogus suggestions.
def suggest(input, candidates)
  s = input.to_s.downcase
  return nil if s.empty?

  prefix_matches = candidates.select { |c| c.downcase != s && c.downcase.start_with?(s) }
  return prefix_matches.first if prefix_matches.length == 1 && s.length >= 2

  best, dist = candidates.map { |c| [c, levenshtein(s, c.downcase)] }.min_by { |_, d| d }
  best if dist <= [2, s.length / 3].max
end

def unknown(kind, value, candidates)
  hint = suggest(value, candidates)
  msg = "Unknown #{kind}: #{value}"
  msg += " (did you mean '#{hint}'?)" if hint
  usage_exit(msg)
end

# `dev <command>` with no subcommand: name the valid subcommands inline instead
# of a bare "requires a subcommand", so the user doesn't have to open `dev help`
# just to discover what's available.
def require_subcommand(command)
  subs = SUBCOMMANDS[command] || []
  hint = subs.length == 1 ? subs.first : "one of: #{subs.join(', ')}"
  usage_exit("#{command} requires a subcommand (#{hint})")
end

# Pick the subcommand for `dev <command> [subcommand] ...`. The first token names
# it, unless it's absent or a flag — those belong to the default subcommand's own
# args, so `dev deploy --app X` and bare `dev invariants` both run the default.
# Shifts the token off `argv` only when it named a subcommand, leaving flags and
# positionals for the handler. Returns the chosen (or default) subcommand name;
# an unrecognized name is returned as-is so the caller can report it.
def resolve_subcommand(argv, default:)
  first = argv.first
  return default if first.nil? || first.start_with?("-")
  argv.shift
end

# Commands that take only common flags (--app/--localhost) accept no positional
# args or other flags; anything left over is a typo. Reject it with the command's
# usage inline instead of silently ignoring it (parse_common_flags returns these
# leftover tokens, which such commands would otherwise discard).
def reject_unknown_args(command, leftover)
  return if leftover.empty?
  label = leftover.length == 1 ? "argument" : "arguments"
  usage_exit("#{command}: unknown #{label}: #{leftover.join(', ')}", example: usage_for(command))
end

def parse_common_flags(args)
  app_filter = nil
  use_localhost = false
  rest = []
  i = 0
  while i < args.length
    a = args[i]
    case a
    when "--app"
      app_filter = args[i + 1]
      usage_exit("--app requires a value") if app_filter.nil?
      i += 2
    when "--localhost"
      use_localhost = true
      i += 1
    when "-h", "--help"
      usage_exit
    else
      rest << a
      i += 1
    end
  end
  [rest, app_filter, use_localhost]
end

def resolve_endpoints(app_filter, use_localhost)
  list = ApiClient.endpoints(use_localhost: use_localhost, app_filter: app_filter)
  if list.empty?
    valid = ApiClient::ENDPOINTS.map { |e| e[:app] }.join(", ")
    Util.exit_with_error("Unknown app '#{app_filter}'. Valid apps: #{valid}")
  end
  list
end

def handle_errors
  yield
rescue SessionExpired => e
  warn e.message
  exit 1
rescue ApiError => e
  warn e.message
  exit 1
end

def platform_endpoint(use_localhost)
  ApiClient.endpoints(use_localhost: use_localhost, app_filter: "platform").first
end

# ---------- auth ----------
#
# One home for every credential `dev` holds: the per-app sessions a human logs in
# with, and the API token the AI authenticates as. They are two answers to the
# same question ("who is this process?"), so they live under one command.

def login_platform(use_localhost, email, password)
  res = ApiClient.request(platform_endpoint(use_localhost), :post, "/tenant/platform/session/logins",
                          body: { email: email, password: password },
                          auth_required: false)
  raise ApiError, "unexpected response: #{res.inspect}" unless res.is_a?(Hash) && res["discriminator"] == "tenant_session"

  session_id = res.dig("session", "id")
  raise ApiError, "response missing session.id: #{res.inspect}" if session_id.nil? || session_id.empty?

  ApiClient.write_session_id_for("platform", session_id, use_localhost: use_localhost)
  user_email = res.dig("user", "email") || email
  puts "Logged in to platform as #{user_email}"
end

def login_acumen(use_localhost, email, password)
  acumen_ep = ApiClient.endpoints(use_localhost: use_localhost, app_filter: "acumen").first
  res = ApiClient.request(acumen_ep, :post, "/sessions/login",
                          body: { email: email, password: password },
                          auth_required: false)
  raise ApiError, "unexpected response: #{res.inspect}" unless res.is_a?(Hash)

  session_id = res["id"]
  raise ApiError, "response missing session id: #{res.inspect}" if session_id.nil? || session_id.empty?

  ApiClient.write_session_id_for("acumen", session_id, use_localhost: use_localhost)
  user_email = res.dig("user", "email") || email
  puts "Logged in to acumen as #{user_email}"
end

def login_playbook(use_localhost, email, password)
  ep = ApiClient.tenant_endpoint("playbook", use_localhost: use_localhost)
  res = ApiClient.request(ep, :post, "/tenant/playbook/session/logins",
                          body: { email: email, password: password },
                          auth_required: false)
  raise ApiError, "unexpected response: #{res.inspect}" unless res.is_a?(Hash) && res["discriminator"] == "tenant_session"

  session_id = res.dig("session", "id")
  raise ApiError, "response missing session.id: #{res.inspect}" if session_id.nil? || session_id.empty?

  ApiClient.write_session_id_for("playbook", session_id, use_localhost: use_localhost)
  user_email = res.dig("user", "email") || email
  puts "Logged in to playbook as #{user_email}"
end

# Read a password from the terminal without echoing it, stripping surrounding
# whitespace. Strip, not chomp: a password pasted from a manager routinely
# carries a trailing space or tab, and the browser login forms strip before
# sending (playbook-admin's getRequiredString does value.trim()). Chomping only
# the newline made the CLI send a credential the browser never would, and the
# server reports that as a bare "Incorrect password" on the password field -
# indistinguishable from a genuinely wrong password. Matches the `.strip` the
# email prompt already applies.
#
# `io` is a seam for tests: StringIO has no #noecho, so fall back to #gets when
# stdin is not a terminal.
def read_password(io = STDIN)
  raw = io.respond_to?(:noecho) ? io.noecho(&:gets) : io.gets
  raw&.strip
end

# playbook is a tenant login, opt-in via `--app playbook` only — never part of the
# default `dev auth login` fanout (which is the deployable apps in ENDPOINTS).
LOGIN_APPS = (ApiClient::ENDPOINTS.map { |e| e[:app] } + ["playbook"]).freeze

def cmd_auth_login(args)
  email = nil
  use_localhost = false
  app_filter = nil
  i = 0
  while i < args.length
    a = args[i]
    case a
    when "--email"
      email = args[i + 1]
      usage_exit("--email requires a value", example: usage_for("auth login")) if email.nil?
      i += 2
    when "--app"
      app_filter = args[i + 1]
      usage_exit("--app requires a value", example: usage_for("auth login")) if app_filter.nil?
      i += 2
    when "--localhost"
      use_localhost = true
      i += 1
    else
      usage_exit("Unknown argument: #{a}", example: usage_for("auth login"))
    end
  end

  apps = if app_filter
           unless LOGIN_APPS.include?(app_filter)
             usage_exit("--app must be one of: #{LOGIN_APPS.join(', ')}", example: usage_for("auth login"))
           end
           [app_filter]
         else
           # Default fanout is the deployable apps only; playbook is opt-in.
           ApiClient::ENDPOINTS.map { |e| e[:app] }
         end

  targets = apps.map do |app|
    if app == "playbook"
      ApiClient.tenant_endpoint("playbook", use_localhost: use_localhost)
    else
      ApiClient.endpoints(use_localhost: use_localhost, app_filter: app).first
    end
  end
  puts "Logging in to: #{targets.map { |e| "#{e[:name]} (#{e[:active_url]})" }.join(', ')}"

  any_ok = false
  targets.each do |target|
    puts ""
    puts "[#{target[:name]}] (#{target[:active_url]})"

    target_email = email
    if target_email.nil? || target_email.empty?
      print "  Email: "
      target_email = STDIN.gets&.strip
      if target_email.nil? || target_email.empty?
        warn "  skipped (no email)"
        next
      end
    end

    print "  Password: "
    password = read_password
    puts ""
    if password.nil? || password.empty?
      warn "  skipped (no password)"
      next
    end

    begin
      case target[:app]
      when "platform" then login_platform(use_localhost, target_email, password)
      when "acumen"   then login_acumen(use_localhost, target_email, password)
      when "playbook" then login_playbook(use_localhost, target_email, password)
      else
        warn "  unknown app: #{target[:app]}"
        next
      end
      any_ok = true
    rescue ApiError => e
      warn "  #{target[:name]} login failed: #{e.message}"
    end
  end

  Util.exit_with_error("No logins succeeded") unless any_ok
end

def cmd_auth_logout(args)
  use_localhost = false
  args.each do |a|
    case a
    when "--localhost" then use_localhost = true
    else usage_exit("Unknown argument: #{a}", example: usage_for("auth logout"))
    end
  end

  platform_sid = ApiClient.session_id_for("platform", use_localhost: use_localhost)
  acumen_sid   = ApiClient.session_id_for("acumen", use_localhost: use_localhost)
  playbook_sid = ApiClient.session_id_for("playbook", use_localhost: use_localhost)

  if platform_sid.nil? && acumen_sid.nil? && playbook_sid.nil?
    puts "No active session"
    return
  end

  if platform_sid
    begin
      ApiClient.request(platform_endpoint(use_localhost), :delete, "/tenant/platform/session", auth_required: true)
    rescue SessionExpired, ApiError
      # ignore - we'll clear locally anyway
    end
    ApiClient.clear_session_id_for("platform", use_localhost: use_localhost)
  end

  if acumen_sid
    begin
      acumen_ep = ApiClient.endpoints(use_localhost: use_localhost, app_filter: "acumen").first
      ApiClient.request(acumen_ep, :post, "/logout", auth_required: true)
    rescue SessionExpired, ApiError
      # ignore - we'll clear locally anyway
    end
    ApiClient.clear_session_id_for("acumen", use_localhost: use_localhost)
  end

  if playbook_sid
    begin
      playbook_ep = ApiClient.tenant_endpoint("playbook", use_localhost: use_localhost)
      ApiClient.request(playbook_ep, :delete, "/tenant/playbook/session", auth_required: true)
    rescue SessionExpired, ApiError
      # ignore - we'll clear locally anyway
    end
    ApiClient.clear_session_id_for("playbook", use_localhost: use_localhost)
  end

  puts "Logged out"
end

# The AI actor -- see `ApiClient`, which owns the identity alongside its token file because the
# library has to name it on the 401 path too.
AI_USER_ID = ApiClient::AI_USER_ID
AI_USER_LABEL = ApiClient::AI_USER_LABEL

# Only these flags; anything else is a typo worth reporting rather than ignoring.
def parse_auth_flags(args, command, allow: [])
  use_localhost = false
  flags = {}
  args.each do |a|
    case a
    when "--localhost" then use_localhost = true
    when *allow        then flags[a.delete_prefix("--").to_sym] = true
    else usage_exit("Unknown argument: #{a}", example: usage_for(command))
    end
  end
  [use_localhost, flags]
end

def auth_target_label(use_localhost)
  use_localhost ? "localhost" : "prod"
end

# Never print a token in full — enough characters to tell two tokens apart, not enough to use one.
def mask_token(token)
  token.to_s.length > 8 ? "#{token[0, 4]}...#{token[-4, 4]}" : "****"
end

def cmd_auth_status(args)
  use_localhost, = parse_auth_flags(args, "auth status")
  target = auth_target_label(use_localhost)

  puts ""
  puts Util.underline("Credentials (#{target})")
  puts ""

  puts "Sessions:"
  ApiClient::SESSION_CONFIG.keys.each do |app|
    sid = ApiClient.session_id_for(app, use_localhost: use_localhost)
    state = sid ? "stored (#{mask_token(sid)})" : "none"
    puts "  #{app.ljust(9)} #{state}"
  end

  puts ""
  puts "#{AI_USER_LABEL} token:"
  stored = ApiClient.ai_token(use_localhost: use_localhost)
  if stored.nil?
    puts "  none (provision with `dev auth ai provision#{use_localhost ? ' --localhost' : ''}`)"
  else
    source = ENV["PLATFORM_AI_API_TOKEN"].to_s.strip.empty? ? ApiClient.ai_token_file(use_localhost) : "PLATFORM_AI_API_TOKEN"
    puts "  #{mask_token(stored)} (from #{source})"
  end

  puts ""
  puts "This process: #{auth_effective_identity(stored)}"
  puts ""
end

# Which credential THIS process would present. The whole point of the separate account is that the
# answer differs between a Claude session and a human at a keyboard, so say which one you are.
def auth_effective_identity(stored_token)
  if !ApiClient.ai_session?
    "not a Claude session — `dev` authenticates as you."
  elsif stored_token.nil?
    "a Claude session, but with no token stored it falls back to your session."
  else
    "a Claude session — `dev` authenticates as #{AI_USER_LABEL}."
  end
end

def cmd_auth_ai_status(args)
  use_localhost, = parse_auth_flags(args, "auth ai status")
  target = auth_target_label(use_localhost)
  stored = ApiClient.ai_token(use_localhost: use_localhost)
  if stored.nil?
    puts "No #{AI_USER_LABEL} token stored for #{target}. Claude sessions fall back to your own session."
  else
    source = ENV["PLATFORM_AI_API_TOKEN"].to_s.strip.empty? ? ApiClient.ai_token_file(use_localhost) : "PLATFORM_AI_API_TOKEN"
    puts "#{AI_USER_LABEL} token for #{target}: #{mask_token(stored)} (from #{source})"
  end
  puts "This process is #{auth_effective_identity(stored)}"
end

def cmd_auth_ai_set(args)
  token = args.shift if args.first && !args.first.start_with?("--")
  use_localhost, = parse_auth_flags(args, "auth ai set")
  usage_exit("Missing token", example: usage_for("auth ai set")) if token.nil? || token.empty?
  ApiClient.write_ai_token(token, use_localhost: use_localhost)
  puts "Stored the #{AI_USER_LABEL} token for #{auth_target_label(use_localhost)} in #{ApiClient.ai_token_file(use_localhost)}."
end

def cmd_auth_ai_clear(args)
  use_localhost, = parse_auth_flags(args, "auth ai clear")
  ApiClient.clear_ai_token(use_localhost: use_localhost)
  puts "Cleared the local #{AI_USER_LABEL} token for #{auth_target_label(use_localhost)}. It is still valid server-side — `dev auth ai revoke` kills it."
end

# A Claude session must not mint, rotate, or revoke the AI's own credential: the account exists to
# separate the AI's writes from Mike's, and an AI that can issue itself tokens erases that boundary.
# A human at a keyboard authorizes it.
def require_human_session!(action)
  return unless ApiClient.ai_session?
  Util.exit_with_error(
    "Refusing to #{action} inside a Claude session. #{AI_USER_LABEL}'s credential is provisioned by a human — " \
    "run this yourself in a normal terminal."
  )
end

# Otto lives in the `playbook` tenant, and user lookups are tenant-scoped: a TenantAdmin's dbAuth is
# DbAuthorization.Tenant(their own tenant), so a platform-tenant session gets a 404 for `ai` however
# real the row is. Authenticate this flow with the playbook session, the tenant that owns the
# account. The /tokens endpoints themselves are not tenant-scoped, so they are happy either way.
def auth_ai_endpoint(use_localhost)
  ApiClient.tenant_endpoint("playbook", use_localhost: use_localhost)
end

# Tokens belong to the AI user, but every call here authenticates as YOU (require_human_session!
# above means auth_header_for returns nil, so your playbook session is used).
def auth_ai_tokens(endpoint)
  ApiClient.request(endpoint, :get, "/tokens/users/#{AI_USER_ID}") || []
end

# The account has to exist before a token can point at it: `tokens.user_id` is a foreign key, so
# minting against a target that never ran the SEM script fails deep in the DAO with an opaque 500.
# Check first and name the fix.
def require_ai_user!(endpoint, use_localhost)
  ApiClient.request(endpoint, :get, "/users/#{AI_USER_ID}")
rescue ApiError => e
  Util.exit_with_error(
    "No `#{AI_USER_ID}` user visible on #{auth_target_label(use_localhost)} (#{e.message}). The account is created " \
    "by a platform-postgresql migration — release the DB (or apply the script to this session DB) first."
  )
end

def auth_token_description
  "dev CLI on #{`hostname -s`.strip}"
end

def cmd_auth_ai_provision(args)
  use_localhost, flags = parse_auth_flags(args, "auth ai provision", allow: ["--rotate"])
  require_human_session!("provision a token")
  require_playbook_session!(use_localhost)
  endpoint = auth_ai_endpoint(use_localhost)
  target = auth_target_label(use_localhost)

  handle_errors do
    require_ai_user!(endpoint, use_localhost)

    existing = auth_ai_tokens(endpoint)
    if existing.any? && !flags[:rotate]
      warn "#{AI_USER_LABEL} already has #{existing.length} live token(s) on #{target}:"
      existing.each { |t| warn "  #{t['id']}  #{t['masked_token']}  #{t['description'] || '(no description)'}  created #{t['created_at']}" }
      Util.exit_with_error(
        "Not minting another. Re-run with --rotate to mint a new token and revoke these, or " \
        "`dev auth ai set <token>` if you already have the cleartext."
      )
    end

    created = ApiClient.request(endpoint, :post, "/tokens",
                                body: { user_id: AI_USER_ID, description: auth_token_description })
    cleartext = ApiClient.request(endpoint, :get, "/tokens/#{created['id']}/cleartext")
    token = cleartext && cleartext["token"]
    if token.nil? || token.empty?
      Util.exit_with_error("Minted token #{created['id']} but its cleartext was already claimed — revoke it and retry.")
    end

    # Store BEFORE revoking anything: a failure past this point leaves a working credential on disk
    # rather than none at all.
    ApiClient.write_ai_token(token, use_localhost: use_localhost)
    puts "Minted #{created['masked_token']} for #{AI_USER_LABEL} and stored it in #{ApiClient.ai_token_file(use_localhost)}."

    verify_ai_token!(endpoint, token)
    puts "Verified: the stored token authenticates as #{AI_USER_ID}."

    if flags[:rotate] && existing.any?
      existing.each do |t|
        ApiClient.request(endpoint, :delete, "/tokens/#{t['id']}")
        puts "Revoked #{t['masked_token']} (#{t['id']})."
      end
    end
  end
end

# Prove the credential we just wrote actually authenticates, rather than reporting success on a
# token nobody has used yet. Presents it as HTTP Basic exactly as `dev` will.
def verify_ai_token!(endpoint, token)
  ApiClient.request(endpoint, :get, "/tokens/users/#{AI_USER_ID}", as_token: token)
rescue SessionExpired, ApiError => e
  Util.exit_with_error("Stored the token but it failed to authenticate: #{e.message}")
end

def cmd_auth_ai_revoke(args)
  use_localhost, = parse_auth_flags(args, "auth ai revoke")
  require_human_session!("revoke a token")
  require_playbook_session!(use_localhost)
  endpoint = auth_ai_endpoint(use_localhost)
  target = auth_target_label(use_localhost)

  handle_errors do
    existing = auth_ai_tokens(endpoint)
    if existing.empty?
      puts "#{AI_USER_LABEL} has no live tokens on #{target}."
    else
      existing.each do |t|
        ApiClient.request(endpoint, :delete, "/tokens/#{t['id']}")
        puts "Revoked #{t['masked_token']} (#{t['id']})."
      end
    end
    ApiClient.clear_ai_token(use_localhost: use_localhost)
    puts "Cleared the local token for #{target}."
  end
end

# ---------- interactive claude sessions ----------
#
# Shared by every command that hands the terminal to a Claude session to work
# what it just found (`dev issues claim`, `dev invariants check`). The spawn
# details live here once so the sessions they start are the same session.

# Model the spawned session runs on: Opus 5 with the 1M-context window. This is
# the interactive default (the `ccd` alias's model), NOT the headless-codegen
# `CODEGEN_CLAUDE_MODEL` (haiku) — a human is driving this one to fix real bugs.
INTERACTIVE_CLAUDE_MODEL = "claude-opus-5[1m]".freeze

# Pure, testable seam: the argv for an interactive investigate/fix session.
# Mirrors the `ccd` alias (`claude --dangerously-skip-permissions`) pinned to
# Opus 5 (1M context).
def interactive_claude_argv(prompt)
  ["claude", "--dangerously-skip-permissions", "--model", INTERACTIVE_CLAUDE_MODEL, prompt]
end

# Prefix a spawned-session prompt with the tab title to set. Claude Code owns the
# terminal title once it starts, so the only way to pin it is to tell the session
# what it should be — the CLI cannot emit the escape itself and make it stick.
# A nil title (nothing worth naming) passes the prompt through untouched.
def prompt_with_tab_title(title, prompt)
  return prompt if title.nil?
  "Set the terminal tab title to \"#{title}\" (printf '\\e]0;%s\\a' \"#{title}\"), then: #{prompt}"
end

# Hand the terminal to an interactive session. `exec` replaces this process, so
# every caller must treat it as the last thing it does. When `claude` is not
# launchable (not on PATH, or otherwise), degrade to printing the command rather
# than dying on a stack trace and losing the prompt we just built. `note` says
# what survives the failure, which differs by caller.
def exec_claude(prompt, note: "Run it by hand with:")
  exec(*interactive_claude_argv(prompt))
rescue SystemCallError => e
  warn "Could not start Claude (#{e.message}). #{note}"
  warn "  claude \"#{prompt}\""
end

# ---------- invariants ----------

# The failure block for one app, as lines: every non-zero invariant with its
# count and examples, then every invariant that errored. Returned rather than
# printed because the same text is both what the terminal shows and what the
# investigation prompt hands to a Claude session — they must not drift.
def invariant_failure_lines(result, example_limit: 10)
  lines = []
  (result["non_zero"] || []).each do |inv|
    lines << "  - #{inv['name']}"
    lines << "    Count: #{inv['count']}"
    examples = inv["examples"] || []
    unless examples.empty?
      lines << "    Examples:"
      shown = example_limit.nil? ? examples : examples.take(example_limit)
      shown.each { |ex| lines << "      * #{ex}" }
      if !example_limit.nil? && examples.length > example_limit
        lines << "      ... and #{examples.length - example_limit} more"
      end
    end
  end

  (result["error"] || []).each do |inv|
    lines << "  - #{inv['name']}"
    lines << "    Error: #{inv['error'] || 'Unknown error'}"
  end
  lines
end

def print_invariant_failures(result, example_limit: 10)
  puts invariant_failure_lines(result, example_limit: example_limit)
end

# The durable orientation appended to every invariant investigation prompt. Prose
# lives in devops/claude-invariants/investigate-body.md so it can be edited
# without touching this CLI (same arrangement as devops/claude-issues).
def invariants_body_text
  File.read(File.expand_path("../claude-invariants/investigate-body.md", __dir__))
end

# The prompt for ONE app's failures: what failed, verbatim as the terminal just
# printed it, then the shared orientation. The failure block is passed through
# untouched on purpose — a summary here would be the CLI pre-diagnosing, which is
# exactly the thing the body file tells the session not to do.
#
# Every failing invariant goes in with every example the server returned
# (example_limit: nil — up to INVARIANT_EXAMPLES_MAX). The terminal truncates at
# 10 to stay readable; the session is the one consumer that needs the whole
# population, since whether 1 row or 400 rows fail is often the difference
# between two root causes.
def invariants_app_prompt(endpoint, result)
  failures = invariant_failure_lines(result, example_limit: nil).join("\n")
  count = (result["non_zero"] || []).length + (result["error"] || []).length
  total = count + (result["success"] || []).length
  <<~PROMPT.strip
    The `dev invariants` check is failing for #{endpoint[:name]} (#{count} failing invariant(s) of #{total} total).
    Investigate each failure and resolve it.

    Failing invariants, exactly as `dev invariants check --app #{endpoint[:app]}` reported them:

    #{failures}

    #{invariants_body_text.strip}
  PROMPT
end

# Two or more apps failed at once. `dev` can only hand the TTY to one process, so
# the per-app parallelism moves INSIDE the session: one subagent per app, which
# is what "one session per app" means here. The apps are separate stacks and
# separate repos, so the subagents share no state.
def invariants_fanout_prompt(app_prompts)
  sections = app_prompts.map { |app, prompt| "===== #{app} =====\n\n#{prompt}" }.join("\n\n")
  <<~PROMPT.strip
    #{app_prompts.length} apps have failing invariants. Dispatch ONE subagent per app and work
    them in parallel — do NOT work them yourself in this session. Give each subagent its app's
    brief below verbatim, and tell it the brief is the whole task. The apps are independent
    stacks with independent repos, so the subagents share nothing.

    Report back each app's outcome separately: the classification it landed on, and either its
    GitHub PR URL or the path to the findings it wrote. Never a Reviewable URL.

    #{sections}
  PROMPT
end

# The prompt for whatever failed: one app's brief directly, or the fan-out when
# several failed. `app_prompts` is a list of [app_name, prompt].
def invariants_launch_prompt(app_prompts)
  body = app_prompts.length == 1 ? app_prompts.first[1] : invariants_fanout_prompt(app_prompts)
  prompt_with_tab_title(invariants_tab_title(app_prompts.map(&:first)), body)
end

def invariants_tab_title(app_names)
  "Invariants: #{app_names.join(', ')}"
end

# Apps whose failures are worth a session, as [endpoint, result]: those with a
# non-zero count or an invariant that errored. An app whose whole REQUEST failed
# (session expired, unreachable) is deliberately excluded — that is an auth or
# infrastructure problem with no data behind it, and a session pointed at it
# would have nothing to investigate.
def invariants_failing_apps(results)
  results.sort_by { |r| r[:endpoint][:name] }.filter_map do |r|
    next if r[:error]
    next if r[:deferred]
    result = r[:data] || {}
    next if (result["non_zero"] || []).empty? && (result["error"] || []).empty?
    [r[:endpoint], result]
  end
end

# ---------- rollout guard (ISS-517) ----------
#
# An invariant is SQL that ships INSIDE the app, and `/dev/invariant/checks` is
# answered by whichever replica the load balancer picks. So during a rolling
# deploy the verdict depends on which pod answered: a pod still on the previous
# release runs the previous release's invariant SQL. That window opens the moment
# a release is cut, which is exactly the moment an invariant FIX goes live — and
# therefore exactly when the previous run was failing and this producer is most
# likely to fire.
#
# That is ISS-509: acumen 0.10.22 carried the fix at 11:04:39Z, the hourly check
# ran at 11:07:57Z, a 0.10.21 pod answered, and an autonomous session was spent
# investigating a condition that had already been fixed.
#
# The guard is deliberately ASYMMETRIC — it defers FAILURES and never touches a
# pass. A false pass during a rollout costs one hour (the next run files it); a
# false failure costs a session and a bogus issue holding the `invariants:<app>`
# fingerprint. Only one of those is worth spending anything to avoid.
#
# It also FAILS OPEN. If the version endpoint cannot be reached, or reports
# nothing usable, the failures are filed exactly as before. A guard that swallows
# real invariant failures whenever a probe breaks would be strictly worse than
# the bug it replaces, because nothing would ever surface it.

# The two dials are declared beside INVARIANT_EXAMPLES_MAX at the top of this
# file, because USAGE interpolates them. Why they are what they are:
#
#   INVARIANTS_VERSION_PROBES — several samples across separate connections
#   spread over the replicas, and seeing two versions AT ONCE is proof of a
#   rollout rather than an inference from a timestamp. One sample cannot tell
#   "settled" from "answered by the pod that has not been replaced yet".
#
#   INVARIANTS_ROLLOUT_WINDOW_SECS — the observed race (ISS-509) was 3m18s wide
#   and a rolling update of these fleets finishes in single-digit minutes. The
#   cost of being too generous is one hour of delay on a real finding; the cost
#   of being too tight is a whole autonomous session.

# One endpoint's `/_internal_/version` samples. Threaded: this runs inline in
# `dev agent tick`, under the work lock, so the probes cost one round trip in
# wall time rather than five. `fetch_version` never raises — a failed probe comes
# back as `{ error: ... }` and is simply not evidence either way.
def invariants_version_samples(endpoint, probes: INVARIANTS_VERSION_PROBES)
  Array.new(probes) { Thread.new { fetch_version(endpoint[:active_url]) } }.map(&:value)
end

def invariants_humanize_age(secs)
  minutes = (secs / 60.0).round
  return "less than a minute" if minutes < 1
  "#{minutes} minute#{'s' unless minutes == 1}"
end

# Why this app's failures cannot be trusted right now, or nil to trust them.
# Pure — the samples are passed in — because this is the whole decision and it
# has to be readable against the cases it distinguishes.
#
# EVERY arm is bounded by the window, including the one that has proof. A
# rollout can DEADLOCK: a StatefulSet will not delete a pod until it is Ready, so
# a pod that crashlooped on release N is never updated by N+1 and sits on the old
# image indefinitely (that is what lib/rollout_diagnosis.rb exists for). Deferring
# on "two versions at once" alone would then defer forever and this app's
# invariants would silently never be filed again — the guard turning into the
# outage. Past the window a mixed fleet is not a rollout in progress, it is a
# stuck one; the failure is filed, and the session that picks it up finds the
# stuck pod. Loud and wrong beats quiet and wrong.
def invariants_rollout_reason(samples, now: Time.now, window: INVARIANTS_ROLLOUT_WINDOW_SECS)
  usable = samples.compact.reject { |s| s[:error] }
  versions = usable.filter_map { |s| blank_to_nil(s["version"]) }.uniq
  return nil if versions.empty?

  released = usable.filter_map { |s| Time.parse(s["released_at"].to_s) rescue nil }.max
  return nil if released.nil?
  age = now - released
  return nil if age >= window

  return "#{versions.first} was released #{invariants_humanize_age(age)} ago, inside the " \
         "#{window / 60}-minute rollout window — a pod on the previous release may have " \
         "served this result" if versions.length == 1

  "the fleet is serving #{versions.sort.join(' and ')} at once and the newest went out " \
  "#{invariants_humanize_age(age)} ago — a rollout is in progress, so this result may have " \
  "come from a pod on the older release"
end

# Endpoint name => reason, for the failing apps whose verdict is not trustworthy.
#
# Only FAILING apps are probed: a passing app has nothing to defer, and probing
# every app on every clean run would add network to the common case for nothing.
# `--localhost` is skipped outright — there is one local process, nothing rolls
# out, and a dev restart would defer for no reason.
def invariants_rollout_deferrals(results, now: Time.now, probe: method(:invariants_version_samples))
  invariants_failing_apps(results).each_with_object({}) do |(endpoint, _), acc|
    next if endpoint[:use_localhost]
    reason = invariants_rollout_reason(probe.call(endpoint), now: now)
    acc[endpoint[:name]] = reason if reason
  end
end

def invariants_apply_deferrals(results, deferrals)
  results.map do |r|
    reason = deferrals[r[:endpoint][:name]]
    reason ? r.merge(deferred: reason) : r
  end
end

# The exit codes ARE the producer contract: 0 clean, 1 findings, 2 the check
# itself broke. See integrations.agent.scheduler.ProducerCheckOutcome.
# Named here so the two files can be read against each other: `dev invariants
# check` is a producer check, and a producer check that misreports its own
# failure as a finding is indistinguishable from a real one. Both failure codes
# stay nonzero so ordinary callers (cron, CI, `&&` chains) still detect a
# failure without parsing stdout; only the tick tells 1 and 2 apart.
INVARIANTS_EXIT_CLEAN       = 0 # nothing to do
INVARIANTS_EXIT_FINDINGS    = 1 # real data problems — file (or increment) the issue
INVARIANTS_EXIT_UNCHECKABLE = 2 # no trustworthy verdict — recorded as `check_failed`, never filed

# The verdict for a set of per-app results.
#
# Findings win over an unreachable app: a real data problem outranks an infra
# hiccup, and returning UNCHECKABLE would send it down the tick's `check_failed`
# path, which files nothing.
#
# An app whose whole REQUEST failed (session expired, unreachable) checked
# nothing, so it is UNCHECKABLE rather than a finding — the same distinction
# `invariants_failing_apps` already draws to decide what deserves a session.
# Collapsing the two is not merely noisy, it is silencing: the bogus issue takes
# the `invariants:<app>` fingerprint, and the platform's fingerprint dedup then
# blocks every REAL invariant failure from filing for as long as it sits
# non-terminal. An expired session would hide the data problems it never looked
# for, which is exactly what ISS-358 was.
#
# A DEFERRED app (mid-rollout — see the rollout guard above) lands in the same
# bucket for the same reason: this run has no verdict for it. UNCHECKABLE rather
# than CLEAN so the deferral is visible in the producer run history — if the
# guard ever misfires and defers forever, `dev agent runs` shows a wall of
# check_failed instead of a wall of runs that look indistinguishable from green.
def invariants_exit_code(results)
  return INVARIANTS_EXIT_FINDINGS unless invariants_failing_apps(results).empty?
  return INVARIANTS_EXIT_UNCHECKABLE if results.any? { |r| r[:error] || r[:deferred] }

  INVARIANTS_EXIT_CLEAN
end

# Argv for a headless session. `--print` because there is no terminal to attach
# to, and `--dangerously-skip-permissions` because there is no human to answer a
# permission prompt — without it the session is blocked on its first Bash call
# and does nothing at all.
#
# A nil prompt returns the argv WITHOUT one, for the caller that feeds the prompt
# on stdin instead (`dev agent tick` — a dispatcher prompt carries a whole issue
# thread, and an argv is the wrong place for it).
def headless_claude_argv(prompt = nil)
  argv = ["claude", "--print", "--dangerously-skip-permissions", "--model", INTERACTIVE_CLAUDE_MODEL]
  prompt.nil? ? argv : argv + [prompt]
end

# Hand the failures to a Claude session, interactively. Nothing happens when no
# failure has data behind it, and nothing happens at all outside a terminal —
# ISS-396 retired the unattended/headless dispatch path (the `check-invariants`
# cron that used to call `dev invariants check --fix` headlessly): the hourly
# devops producers (`invariants-platform`, `invariants-acumen`) already detect
# and file an issue for the same failures, so a second, independent auto-fix
# session raced the filed issue instead of being the one true remediation path.
# Remediation is now claimed work off that filed issue.
def invariants_offer_investigation(results, auto_fix)
  failing = invariants_failing_apps(results)
  return if failing.empty?
  return unless interactive_terminal?

  names = failing.map { |endpoint, _| endpoint[:name] }

  unless auto_fix
    return unless Ask.for_boolean("Launch a Claude session to investigate #{names.join(', ')}? [y/n]")
  end

  app_prompts = failing.map { |endpoint, result| [endpoint[:name], invariants_app_prompt(endpoint, result)] }
  puts ""
  puts failing.length == 1 ?
    "Starting Claude session (Opus 5, 1M context) to investigate #{names.first}..." :
    "Starting Claude session (Opus 5, 1M context) to dispatch one subagent per failing app..."
  puts ""
  exec_claude(invariants_launch_prompt(app_prompts), note: "Investigate by hand with:")
end

def cmd_invariants_check(args)
  rest, app_filter, use_localhost = parse_common_flags(args)
  example_limit = 10
  auto_fix = false
  i = 0
  while i < rest.length
    case rest[i]
    when "--examples"
      example_limit = Integer(rest[i + 1] || usage_exit("--examples requires a value", example: usage_for("invariants check")))
      i += 2
    when "--all-examples"
      example_limit = nil
      i += 1
    when "--fix"
      auto_fix = true
      i += 1
    else
      usage_exit("Unknown flag: #{rest[i]}", example: usage_for("invariants check"))
    end
  end
  endpoints = resolve_endpoints(app_filter, use_localhost)

  puts ""
  puts Util.underline("Checking Invariants#{use_localhost ? ' (localhost)' : ''}")
  puts ""

  print "Fetching #{endpoints.map { |e| e[:name] }.join(', ')}..."
  $stdout.flush

  results = endpoints.map do |endpoint|
    Thread.new do
      begin
        data = ApiClient.request(endpoint, :get, invariant_checks_path)
        { endpoint: endpoint, data: data, error: nil }
      # One arm, because every failure here reports the same way: whatever the error says. The
      # SessionExpired arm used to substitute a fixed "session expired - run 'dev auth login'" and
      # throw the real message away, so an autonomous session -- which has no session and no
      # terminal -- was told to log in when the server had actually said `User ai does not belong to
      # platform` (ISS-474). ApiClient now words a 401 for the credential it presented; do not
      # re-word it here.
      rescue => e
        { endpoint: endpoint, data: nil, error: e.message }
      end
    end
  end.map(&:value)

  puts " done"
  puts ""

  # Before anything is reported as a finding: is the app mid-rollout, and could
  # this verdict therefore have come from a pod running the previous release?
  results = invariants_apply_deferrals(results, invariants_rollout_deferrals(results))

  results.sort_by { |r| r[:endpoint][:name] }.each do |r|
    endpoint = r[:endpoint]
    if r[:error]
      puts Util.underline("#{endpoint[:name]}: ERROR - #{r[:error]}")
    else
      result = r[:data] || {}
      success = result["success"] || []
      non_zero = result["non_zero"] || []
      errors = result["error"] || []
      total_count = success.length + non_zero.length + errors.length
      failure_count = non_zero.length + errors.length

      if failure_count == 0
        puts "#{endpoint[:name]}: #{total_count} invariants passed"
      else
        puts Util.underline("#{endpoint[:name]}: #{failure_count} FAILURES (#{total_count} total)")
        print_invariant_failures(result, example_limit: example_limit)
        if r[:deferred]
          puts ""
          puts "  DEFERRED — not filed, no session dispatched."
          puts "  #{r[:deferred]}."
          puts "  Re-check once the rollout has finished; the next scheduled run files it if it is real."
        end
      end
    end
    puts ""
  end

  # One verdict, derived once. The printing loop above deliberately keeps no
  # running flag: the bug this replaced (ISS-358) was the loop and the exit
  # logic disagreeing about what an unreachable app meant.
  case invariants_exit_code(results)
  when INVARIANTS_EXIT_CLEAN
    puts "All invariants passed"
    exit INVARIANTS_EXIT_CLEAN
  when INVARIANTS_EXIT_UNCHECKABLE
    puts results.any? { |r| r[:deferred] } && results.none? { |r| r[:error] } ?
      "Invariant failures deferred while a rollout is in progress" :
      "Some invariants could not be checked"
    exit INVARIANTS_EXIT_UNCHECKABLE
  else
    puts "Some invariants failed"
    # execs when it launches, so nothing below runs in that case.
    invariants_offer_investigation(results, auto_fix)
    exit INVARIANTS_EXIT_FINDINGS
  end
end

# Render the `created_by` audit union (from bryzek/audit), keyed off its discriminator:
#   - "person":    resolved profile — show name and/or email, falling back to the person id.
#   - "reference": unresolved user — only the opaque user id is available.
# Any other discriminator is a newer variant this client predates; show it verbatim.
def format_created_by(created_by)
  case created_by['discriminator']
  when 'person'
    person = created_by['person'] || {}
    name   = blank_to_nil(person['name'])
    email  = blank_to_nil(person.dig('email', 'address'))
    parts  = [name, email && "<#{email}>"].compact
    parts.empty? ? (blank_to_nil(person['id']) || 'unknown') : parts.join(' ')
  when 'reference'
    blank_to_nil((created_by['user'] || {})['id']) || 'unknown'
  else
    created_by['discriminator'] || 'unknown'
  end
end

def blank_to_nil(value)
  value.to_s.strip.empty? ? nil : value
end

def cmd_invariants_snoozes(args)
  rest, app_filter, use_localhost = parse_common_flags(args)
  reject_unknown_args("invariants snoozes", rest)
  endpoints = resolve_endpoints(app_filter, use_localhost)

  puts ""
  puts Util.underline("Invariant Snoozes#{use_localhost ? ' (localhost)' : ''}")
  puts ""

  handle_errors do
    endpoints.each do |endpoint|
      snoozes = ApiClient.request(endpoint, :get, "/dev/invariant/snoozes") || []
      puts "#{endpoint[:name]}: #{snoozes.length} active"
      snoozes.each do |s|
        created_by = s['created_by'] || {}
        puts "  - #{s['invariant_name']}"
        puts "    Until:   #{s['snoozed_until']}"
        puts "    Reason:  #{s['reason']}"
        puts "    By:      #{format_created_by(created_by)} at #{created_by['created_at']}"
      end
      puts ""
    end
  end
end

APP_REQUIRED = "--app is required (mutations must target a single app)"

# The invariant name is a positional argument, but a natural first guess is
# `--name X`, which lands both tokens in `leftover`. Split leftover tokens into
# the single positional name vs stray `--flags` and describe exactly what went
# wrong, returning [name, problems] so the caller can add its own required-arg
# checks.
def collect_invariant_name(leftover)
  unknown_flags = leftover.select { |a| a.start_with?("--") }
  positional = leftover.reject { |a| a.start_with?("--") }
  problems = []
  unless unknown_flags.empty?
    label = unknown_flags.length == 1 ? "flag" : "flags"
    problems << "unknown #{label} #{unknown_flags.join(', ')} (the invariant name is a positional argument — pass it without a flag)"
  end
  if positional.empty?
    problems << "missing invariant name (positional argument)"
  elsif positional.length > 1
    problems << "expected a single invariant name but got #{positional.length}: #{positional.join(', ')}"
  end
  [positional.first, problems]
end

# Report every argument problem at once (with the command's usage line inline)
# instead of failing on one missing flag at a time. No-op when problems is empty.
def report_arg_problems(command, problems, example)
  return if problems.empty?
  header =
    if problems.length == 1
      "#{command}: #{problems.first}"
    else
      ["#{command}: #{problems.length} problems:", *problems.map { |p| "  - #{p}" }].join("\n")
    end
  usage_exit(header, example: example)
end

def cmd_invariants_snooze(args)
  rest, app_filter, use_localhost = parse_common_flags(args)
  days = nil
  reason = nil
  leftover = []
  i = 0
  while i < rest.length
    a = rest[i]
    case a
    when "--days"
      days = rest[i + 1]
      usage_exit("--days requires a value", example: usage_for("invariants snooze")) if days.nil?
      i += 2
    when "--reason"
      reason = rest[i + 1]
      usage_exit("--reason requires a value", example: usage_for("invariants snooze")) if reason.nil?
      i += 2
    else
      leftover << a
      i += 1
    end
  end

  name, problems = collect_invariant_name(leftover)
  problems << APP_REQUIRED if app_filter.nil? || app_filter.empty?
  problems << "--days is required" if days.nil?
  problems << "--reason is required" if reason.nil? || reason.empty?
  days_i = days && (Integer(days) rescue nil)
  problems << "--days must be an integer >= 1" if days && (days_i.nil? || days_i < 1)
  report_arg_problems("snooze", problems, usage_for("invariants snooze"))

  endpoints = resolve_endpoints(app_filter, use_localhost)

  handle_errors do
    endpoints.each do |endpoint|
      res = ApiClient.request(endpoint, :post, "/dev/invariant/snoozes",
                              body: { invariant_name: name, days: days_i, reason: reason })
      puts "#{endpoint[:name]}: snoozed #{res['invariant_name']} until #{res['snoozed_until']}"
    end
  end
end

def cmd_invariants_unsnooze(args)
  rest, app_filter, use_localhost = parse_common_flags(args)
  name, problems = collect_invariant_name(rest)
  problems << APP_REQUIRED if app_filter.nil? || app_filter.empty?
  report_arg_problems("unsnooze", problems, usage_for("invariants unsnooze"))
  endpoints = resolve_endpoints(app_filter, use_localhost)

  handle_errors do
    endpoints.each do |endpoint|
      ApiClient.request(endpoint, :delete, "/dev/invariant/snoozes/#{URI.encode_www_form_component(name)}")
      puts "#{endpoint[:name]}: removed snooze for #{name}"
    end
  end
end

# ---------- tasks ----------

def cmd_tasks_requeue(args)
  rest, app_filter, use_localhost = parse_common_flags(args)
  reject_unknown_args("tasks requeue", rest)
  endpoints = resolve_endpoints(app_filter, use_localhost)

  puts ""
  puts Util.underline("Requeuing Failed Tasks#{use_localhost ? ' (localhost)' : ''}")
  puts ""

  all_ok = true
  endpoints.each do |endpoint|
    begin
      res = ApiClient.request(endpoint, :post, "/dev/task/requeues", body: {})
      count = res && res["requeued"]
      puts "  #{endpoint[:name]}: #{count} tasks requeued"
    rescue SessionExpired
      puts "  #{endpoint[:name]}: ERROR - session expired or invalid - run 'dev auth login'"
      all_ok = false
    rescue ApiError => e
      puts "  #{endpoint[:name]}: ERROR - #{e.message}"
      all_ok = false
    end
  end

  puts ""
  exit 1 unless all_ok
end

# The server caps GET /dev/tasks at 201 rows, so a preview count is exact only up to
# that. It is a preview: the authoritative number is what DELETE reports back.
TASK_PREVIEW_LIMIT = 201

def parse_tasks_delete_args(rest)
  task_ids = []
  discriminator = nil
  assume_yes = false
  leftover = []
  i = 0
  while i < rest.length
    a = rest[i]
    case a
    when "--id"
      value = rest[i + 1]
      usage_exit("--id requires a value", example: usage_for("tasks delete")) if value.nil?
      task_ids << value
      i += 2
    when "--discriminator"
      discriminator = rest[i + 1]
      usage_exit("--discriminator requires a value", example: usage_for("tasks delete")) if discriminator.nil?
      i += 2
    when "--yes", "-y"
      assume_yes = true
      i += 1
    else
      leftover << a
      i += 1
    end
  end

  problems = []
  problems << "unexpected argument(s): #{leftover.join(', ')}" unless leftover.empty?
  if task_ids.empty? && discriminator.nil?
    problems << "nothing selected: pass --id ID (repeatable) or --discriminator NAME"
  elsif !task_ids.empty? && discriminator
    # Not a limitation of the endpoint but of the intent: one is a targeted removal of rows
    # you have already looked at, the other wipes a whole queue sight-unseen. Silently doing
    # both under one confirmation would let the second ride in on the first's blast radius.
    problems << "--id and --discriminator are mutually exclusive - run one, then the other"
  end
  problems << "--discriminator requires a value" if discriminator && discriminator.strip.empty?
  report_arg_problems("tasks delete", problems, usage_for("tasks delete"))

  [task_ids, discriminator, assume_yes]
end

# How many rows the discriminator has right now, per endpoint, so the operator confirms
# against a number rather than a name. Capped by the endpoint's page size: "201+" means
# "more than one page", not 201.
def tasks_delete_preview(endpoint, discriminator)
  path = "/dev/tasks?discriminator=#{URI.encode_www_form_component(discriminator)}" \
         "&include_completed=true&limit=#{TASK_PREVIEW_LIMIT}"
  rows = ApiClient.request(endpoint, :get, path) || []
  rows.length >= TASK_PREVIEW_LIMIT ? "#{TASK_PREVIEW_LIMIT - 1}+" : rows.length.to_s
end

def tasks_delete_confirmed?(discriminator, previews)
  puts ""
  previews.each { |name, count| puts "  #{name}: #{count} task row(s) match '#{discriminator}'" }
  puts ""
  # Nothing to read an answer from in a cron/subprocess run, and defaulting to yes there
  # would wipe a queue on a run that never asked to.
  unless $stdin.tty?
    Util.exit_with_error("Refusing to delete a whole queue without confirmation (stdin is not a terminal). Pass --yes.")
  end
  print "Delete every one of these rows, in any state? This cannot be undone [y/N]: "
  answer = $stdin.gets&.strip
  return true if answer&.downcase&.start_with?("y")
  puts "Aborted. Nothing deleted."
  false
end

def cmd_tasks_delete(args)
  rest, app_filter, use_localhost = parse_common_flags(args)
  task_ids, discriminator, assume_yes = parse_tasks_delete_args(rest)
  endpoints = resolve_endpoints(app_filter, use_localhost)
  body = discriminator ? { "discriminator" => discriminator } : { "task_ids" => task_ids }

  puts ""
  puts Util.underline("Deleting Tasks#{use_localhost ? ' (localhost)' : ''}")

  handle_errors do
    if discriminator && !assume_yes
      previews = endpoints.map { |e| [e[:name], tasks_delete_preview(e, discriminator)] }
      return unless tasks_delete_confirmed?(discriminator, previews)
    end

    puts ""
    all_ok = true
    endpoints.each do |endpoint|
      begin
        res = ApiClient.request(endpoint, :delete, "/dev/tasks", body: body)
        puts "  #{endpoint[:name]}: #{res && res['deleted']} tasks deleted"
      rescue SessionExpired
        puts "  #{endpoint[:name]}: ERROR - session expired or invalid - run 'dev auth login'"
        all_ok = false
      rescue ApiError => e
        puts "  #{endpoint[:name]}: ERROR - #{e.message}"
        all_ok = false
      end
    end

    puts ""
    exit 1 unless all_ok
  end
end

# ---------- issues ----------

ISSUE_STATUSES = %w[open claimed needs_review fixed deployed verified dismissed needs_input].freeze

# EVERY issue_category in the platform `issues` spec, in enum order — keep them
# in step. `dev issues claim` sweeps all of them, `suggestion` included: an open
# issue the CLI cannot see is an open issue nobody works, so no category is
# hidden or held back from a blanket claim. What makes `suggestion` different is
# its body file, not the sweep — it turns the claimed session into an
# investigation (see suggestion-body.md), not a fix, so it lands on
# `needs_review` rather than a PR. Each is one plan and one session; the durable
# prompt body is devops/claude-issues/<category>-body.md where a category has
# its own pipeline, and default-body.md otherwise (see issue_body_text).
# `infrastructure` is the autonomous dispatcher's category: chores with no
# deployable version to reconcile against (codegen sync, invariants, weekly
# reviews). For it the MERGE is the deploy — the reconciler advances a merged
# infrastructure issue straight to `deployed` and the 7-day auto-verify applies
# unchanged. What it is excluded from is release metrics and the submitter
# digest, not the lifecycle.
ISSUE_CATEGORIES = %w[graphs worker insights club_backfill suggestion feature bug improvement infrastructure].freeze

# The categories `dev issues create` offers when filing from the laptop, and the
# changelog vocabulary they mirror (a `bug` ships as changelog `fix`). A SUBSET
# of ISSUE_CATEGORIES: the rest arrive on their own (graphs/insights captured in
# playbook-admin, worker auto-filed by the log review, suggestion submitted by a
# member in playbook-app), so none of them is a sensible manual pick.
ISSUE_MANUAL_CATEGORIES = %w[feature bug improvement].freeze

ISSUE_SEVERITIES = %w[low medium high].freeze

# The two statuses `dev issues create` can file INTO, and the whole point of
# making the caller pick: `claimed` means "I am working this right now", `open`
# means "this belongs to the queue".
#
# `create` files claimed by default because that is what filing from the laptop
# means — file it and start. That default is wrong for a headless caller (a
# Claude session), which files an issue for two very different reasons: the work
# it is already doing (claimed), and a finding it is only reporting (open). It
# cannot tell them apart from the outside, so it must say which, and
# `issue_create_status` makes it say so on a non-tty rather than inheriting a
# default that silently parks other people's work in `claimed` — where `dev
# issues claim` will not offer it, because claim only sweeps OPEN issues. A
# phantom claim does not just mislabel the issue, it makes it unpickupable.
ISSUE_CREATE_STATUSES = %w[open claimed].freeze

# The GitHub owner every repo an issue can name lives under, and the shape a name
# has to have. Both are what the agent executor interpolates into
# `gh repo clone mbryzek/<name>` (Agent::Workspace::OWNER), so a slug, a URL or a
# path is not a name it can use.
ISSUE_REPO_OWNER = "mbryzek".freeze
ISSUE_REPO_NAME_RE = /\A[A-Za-z0-9._-]+\z/

# Trimmed, blanks dropped, deduped — what actually goes on the form. The server
# normalizes the same way; doing it here too keeps what the caller is told about
# (below) identical to what is filed.
def issue_normalize_repos(repos)
  repos.map { |r| r.to_s.strip }.reject(&:empty?).uniq
end

# Every repository under the owner, or nil when GitHub cannot be asked (no `gh`,
# not authenticated, offline). Memoized: `create` validates once per run.
#
# nil is deliberately NOT an error. Validation exists to catch a typo at the
# terminal, and refusing to file an issue because the network is down would trade
# a caught typo for a lost finding — the same trade `noteOverlaps` refuses on the
# server. A name that survives a skipped check simply fails to clone later, which
# costs the session a clone it would have done itself anyway.
def issue_github_repo_names
  return @issue_github_repo_names if defined?(@issue_github_repo_names)
  out, status = Open3.capture2e("gh", "repo", "list", ISSUE_REPO_OWNER, "--limit", "500", "--json", "name")
  @issue_github_repo_names = status.success? ? JSON.parse(out).map { |r| r["name"] } : nil
rescue StandardError
  @issue_github_repo_names = nil
end

# Problems with the `--repo` values, in the vocabulary the caller typed. Unknown
# names are listed WITH the full list of what exists, because the answer to "I
# typed the wrong repo name" is the right one, not a rejection.
def issue_repo_problems(repos)
  names = issue_normalize_repos(repos)
  return [] if names.empty?

  problems = names.reject { |n| ISSUE_REPO_NAME_RE.match?(n) }.map do |n|
    "--repo #{n}: not a repository name. Pass the bare name under #{ISSUE_REPO_OWNER} " \
      "(e.g. --repo platform), not an owner/repo slug, url or path"
  end
  return problems unless problems.empty?

  known = issue_github_repo_names
  return problems if known.nil?

  unknown = names.reject { |n| known.include?(n) }
  return problems if unknown.empty?

  problems << "--repo #{unknown.join(', ')}: no such repository under #{ISSUE_REPO_OWNER}. " \
              "Known: #{known.sort.join(', ')}"
  problems
end

# Extensions the platform storage file_type enum accepts, mapped to the MIME type
# the data_url upload needs. Anything not listed is rejected locally, before any
# network call, so a bad path never leaves an orphan issue behind.
ISSUE_FILE_TYPES = {
  "png" => "image/png", "jpg" => "image/jpeg", "jpeg" => "image/jpeg",
  "gif" => "image/gif", "webp" => "image/webp", "bmp" => "image/bmp",
  "heic" => "image/heic", "tiff" => "image/tiff",
  "pdf" => "application/pdf", "csv" => "text/csv", "json" => "application/json",
  "md" => "text/markdown", "txt" => "text/plain", "html" => "text/html",
  "zip" => "application/zip",
}.freeze

# The platform file_type value for a path, or nil when unsupported. `jpeg` is an
# alias for the `jpg` enum value.
def issue_file_type(path)
  ext = File.extname(path).delete_prefix(".").downcase
  return nil unless ISSUE_FILE_TYPES.key?(ext)
  ext == "jpeg" ? "jpg" : ext
end

def issue_data_url(path)
  ext = File.extname(path).delete_prefix(".").downcase
  "data:#{ISSUE_FILE_TYPES.fetch(ext)};base64,#{Base64.strict_encode64(File.binread(path))}"
end

# Git-commit-style buffer: first line is the title, everything after it is the
# body, and `#` lines are instructions that get stripped.
def issue_editor_template
  <<~TEMPLATE

    # Describe the work. This whole buffer is the brief the Claude session works
    # from, so be as specific as you would be typing straight into the terminal.
    #
    # You do NOT need a title: the server files the issue under a placeholder
    # ("New Bug", …) and writes a real title from this text moments later. Pass
    # --title to set one yourself.
    #
    # Paste a URL on its own line to record the page you were on, and paste a
    # file path (or drag a file in) to attach it — both are lifted out of the text.
    #
    # Lines starting with '#' are ignored. An empty message aborts the issue.
  TEMPLATE
end

# Parse the editor buffer into the brief. Returns nil when nothing meaningful was
# saved, which aborts before any API call is made. There is no title line: the
# title is generated server-side (or given with --title), so the whole buffer is
# the body.
def parse_issue_editor_brief(text)
  content = text.to_s.lines.reject { |l| l.start_with?("#") }.join.strip
  content.empty? ? nil : content
end

# A line that is nothing but a URL: the page the issue is about. Lifted out of the
# brief and sent as source_url, which is the field for exactly that — rather than
# left as noise in the body (and, before this, pasted into the title box).
def issue_extract_source_url(brief)
  lines = brief.to_s.lines
  idx = lines.index { |l| l.strip.match?(%r{\Ahttps?://\S+\z}) }
  return [brief.to_s.strip, nil] if idx.nil?
  url = lines[idx].strip
  remaining = lines.reject.with_index { |_, i| i == idx }.join.strip
  [remaining, url]
end

# The longest EXISTING file path starting at each `/` or `~/` in `line`, as
# [raw_text_in_line, absolute_path]. Paths are matched against the filesystem
# rather than by shape, because a path pasted from Finder/a terminal drag carries
# backslash-escaped spaces and no delimiter marking where it ends — so the only
# reliable terminator is "this is a file that exists". Returns nil when the line
# holds no such path.
def issue_find_path_in_line(line)
  line.enum_for(:scan, %r{~?/}).map { Regexp.last_match.begin(0) }.each do |start|
    candidate = line[start..].to_s
    while (raw = candidate.strip) && !raw.empty?
      expanded = File.expand_path(raw.gsub(/\\(.)/, '\1'))
      return [raw, expanded] if File.file?(expanded)
      idx = raw.rindex(/\s/)
      break if idx.nil?
      candidate = raw[0...idx]
    end
  end
  nil
end

# Pull every pasted local file path out of the brief, returning the cleaned brief
# and the absolute paths. A path pasted into the text is an attachment the
# submitter meant to include — before this it was left as literal text and the
# file was silently never uploaded.
def issue_extract_attachment_paths(brief)
  paths = []
  cleaned = brief.to_s.lines.map do |line|
    current = line
    while (found = issue_find_path_in_line(current))
      raw, expanded = found
      paths << expanded
      current = current.sub(raw, "")
    end
    current
  end
  [cleaned.join.gsub(/[ \t]+$/, "").strip, paths]
end

# The internal timeline comment recording which Claude session is working an
# issue. The CLI mints the uuid and passes it to `claude --session-id`, so the id
# is durable even if the session dies on its first turn — never self-reported.
def issue_session_comment_body(uuid)
  "Claude session `#{uuid}` — resume with `claude --resume #{uuid}`"
end

# The uuid from the LAST session comment on a timeline (a reopened issue
# accumulates one per session). nil when no session was ever started on it.
def issue_session_uuid_from_comments(comments)
  Array(comments).reverse_each do |c|
    m = /Claude session `([^`]+)`/.match(c["body"].to_s)
    return m[1] if m
  end
  nil
end

# The prompt handed to the spawned Claude session when exactly one category was
# claimed (one plan): the session works the plan directly. An investigate-only
# category (a member `suggestion`) is briefed as such — its plan writes no code,
# so "implement it" contradicts the plan it points at. Symmetric with the
# INVESTIGATE ONLY labelling in issue_fanout_prompt.
def issue_session_prompt(category, path)
  if issue_investigate_only?(category)
    "read the plan at #{path} and follow it exactly. This is an INVESTIGATE ONLY " \
      "session — no branch, no code, no PR. It ends with " \
      "`dev issues status --status needs_review` and your findings."
  else
    "read the plan at #{path} and implement it"
  end
end

# The prompt when several plans were claimed at once (one per issue). A single
# session can only take one TTY (we `exec`), so the parallelism moves INSIDE it:
# the session fans out subagents.
#
# The default is one subagent per plan, but the session — not this CLI — decides
# whether two plans in the SAME category should go to one subagent together. That
# call needs the code read to answer ("do these touch the same feature?"), and the
# CLI has only a title, a body and a category. A keyword guess here is wrong in
# both directions: bundle unrelated issues and one branch carries fixes that have
# nothing to do with each other, split related ones and two branches collide in the
# same files at rebase. So we hand over the rule and let the session apply it after
# it has looked. The category break is hard either way — categories are independent
# pipelines/repos, so a cross-category bundle is never right.
def issue_fanout_prompt(plans)
  listed = plans.map { |category, path|
    suffix = issue_investigate_only?(category) ? " (INVESTIGATE ONLY — no branch, no code, no PR)" : ""
    "- #{category}: #{path}#{suffix}"
  }.join("\n")
  "#{plans.length} issue plans have been claimed, one per issue, grouped by category " \
    "below. Work them with subagents in parallel — do NOT work the plans yourself in " \
    "this session.\n\n" \
    "How to group them: read the plans first, then dispatch ONE subagent per plan, " \
    "EXCEPT that two or more plans in the SAME category that touch the same feature or " \
    "the same code go to ONE subagent together, so their fixes land on one branch in " \
    "one PR instead of colliding in the same files. Never bundle across categories — " \
    "they are independent pipelines and repos. When in doubt, keep them separate.\n\n" \
    "Give each subagent its plan path(s) and tell it to read them and follow them " \
    "exactly, including each plan's own closing instructions: an implementation plan " \
    "ends in merged PRs and `dev issues status --status fixed`, while an INVESTIGATE " \
    "ONLY plan writes no code and ends in `dev issues status --status needs_review` " \
    "with its findings. EVERY issue must be closed with `dev issues status` " \
    "individually, including each one in a bundle — a subagent working several plans " \
    "closes each of its issues, pointing them all at the same PR URL. Plans:\n#{listed}"
end

# The prompt for the spawned session, keyed on how many category plans were
# claimed: today's single-plan prompt for one, the subagent fan-out for several.
# `plans` is a list of [category, plan_path].
def issue_claim_prompt(plans)
  plans.length == 1 ? issue_session_prompt(plans.first[0], plans.first[1]) : issue_fanout_prompt(plans)
end

# Terminal tab title for a session working `issues`, so a glance at the tab says
# which issues that window is on. One issue is named ("ISS-015: Bars overflow the
# axis"); several are just their numbers ("Issues: 015, 025 & 035") — the titles
# would not fit and the numbers are what you grep the tracker by.
def issue_tab_title(issues)
  issues = Array(issues)
  return nil if issues.empty?
  if issues.length == 1
    return "#{issue_label(issues.first)}: #{issue_tab_title_text(issues.first['title'])}"
  end

  numbers = issues.map { |i| i["number"].to_s }
  "Issues: #{numbers.length == 2 ? numbers.join(' & ') : "#{numbers[0..-2].join(', ')} & #{numbers.last}"}"
end

# An issue title reduced to something a tab (and a shell argument) can hold: one
# line, no quotes or control characters to escape, truncated.
def issue_tab_title_text(title)
  clean = title.to_s.gsub(/[[:cntrl:]]/, " ").tr('"\\', "'").gsub(/\s+/, " ").strip
  clean.length > 60 ? "#{clean[0, 57]}..." : clean
end

# Prefix a spawned-session prompt with the tab title to set. Claude Code owns the
# terminal title once it starts, so the only way to pin it is to tell the session
# what it should be — the CLI cannot emit the escape itself and make it stick.
def issue_prompt_with_tab_title(issues, prompt)
  prompt_with_tab_title(issue_tab_title(issues), prompt)
end

# Single-plan argv (kept as the one-plan spawn path and its regression test).
def issue_claude_command(category, path)
  interactive_claude_argv(issue_session_prompt(category, path))
end

# Every category that has at least one open issue in `open`: the known ones in
# ISSUE_CATEGORIES (enum) order, then any category the tracker returned that this
# script does not know yet — a value added to the spec enum since. Drives both
# the grouped preview and the per-category claim loop. Nothing is filtered out on
# purpose: a category dropped here is an open issue that silently never gets
# claimed, and reports "No open issues." while one is sitting there.
def issue_categories_present(open)
  found = open.map { |c| c["category"] }.compact.uniq
  ISSUE_CATEGORIES.select { |cat| found.include?(cat) } + (found - ISSUE_CATEGORIES)
end

# The open issues in the order the preview lists them (category groups in
# ISSUE_CATEGORIES order). Selection indexes are positions in THIS list, so they
# run 1..N across the whole preview rather than restarting per category — a
# per-category "1" would be ambiguous the moment two categories are shown.
def issue_ordered_open(open, present)
  present.flat_map { |cat| open.select { |c| c["category"] == cat } }
end

# Resolves the --number values against the open issues on offer. Accepts a number
# as displayed or as typed ("078", "78", "ISS-078"); anything that names no open
# issue is an error naming what IS on offer, rather than a claim that silently
# covers less than asked for.
def issue_resolve_requested(raw, ordered)
  wanted = raw.to_s.split(/[\s,]+/).reject(&:empty?)
  by_number = ordered.to_h { |c| [c["number"].to_s.sub(/\A0+/, ""), c] }
  resolved = []
  unknown = []
  wanted.each do |w|
    key = w.sub(/\Aiss-/i, "").sub(/\A0+/, "")
    issue = by_number[key]
    issue ? resolved << issue : unknown << w
  end
  [resolved.uniq, unknown]
end

# Asks which of the listed issues to claim. Reuses Ask.parse_selection (so the
# accepted forms match the rest of the CLI) but not its prompt wrapper, which
# would reprint the list flat and lose the category headings above. `all` is
# answered with `auto` rather than the whole list, which is just `ordered`: a
# blanket claim takes everything a sweep sees, `suggestion` included.
#
# Returns [selected, hand_picked]. `hand_picked` is what the operator DID, not
# what they got: typing the numbers that happen to cover the whole queue is still
# a hand-pick, and only the by-number claim scope reports per-issue reasons back
# (see issue_claim_scope).
def issue_ask_selection(ordered, auto)
  loop do
    raw = Ask.for_string("Claim which issues? Enter numbers (e.g. 1,3), `all`, or `none` [all]:", default: "all")
    return [auto, false] if Ask::ALL.include?(raw.to_s.strip.downcase)
    selected = Ask.parse_selection(raw, ordered)
    return [selected, true] if selected
    puts ""
    puts "Invalid selection. Enter numbers between 1 and #{ordered.length} (e.g. 1,3), `all`, or `none`."
  end
end

# The claim body for one category's selection. Sweeping a whole category claims
# by category — the server takes whatever is open at claim time, so a racing
# session simply leaves fewer issues. A hand-picked selection claims by number,
# which is all-or-nothing: if one of them cannot be claimed, nothing is claimed
# and the server says WHY (taken, snoozed, unknown), rather than quietly claiming
# a different set than the one that was picked.
#
# `hand_picked` is the operator's intent, NOT a count. Keying off "selection
# covers every listed issue" instead collapsed a typed selection to the category
# scope whenever it happened to name the category's only open issue — and the
# category scope reports nothing but a count, so a rejection there surfaced as
# "claimed by another session" no matter the real reason (ISS-244: picking the
# lone, snoozed improvement issue).
def issue_claim_scope(category, selected, category_open, hand_picked: false)
  if !hand_picked && selected.length == category_open.length
    { category: category }
  else
    { numbers: selected.map { |c| c["number"] } }
  end
end

# The issue tracker is tenant-scoped (/:tenant_id/issues) and authorized for a
# playbook tenant admin, not the platform tenant that `dev auth login` stores —
# authenticate with the persisted playbook session (`dev auth login --app playbook`) on
# the platform host.
def issue_endpoint(use_localhost)
  ApiClient.tenant_endpoint("playbook", use_localhost: use_localhost)
end

# Every issues path is scoped to the playbook tenant; the session that authorizes
# the call is the same tenant's, so the id is a constant here.
ISSUE_TENANT_ID = "playbook".freeze

def issues_path(suffix = "")
  "/#{ISSUE_TENANT_ID}/issues#{suffix}"
end

# Path to the issues LIST endpoint filtered to one or more statuses. The spec
# parameter is `statuses` (a repeatable list of issue_status) — NOT `status`. A
# singular `status=open` is an unknown parameter the server silently ignores, so
# it returns issues in EVERY status. That made `dev issues claim` preview (and
# `dev issues reconcile`) act on the whole tracker: e.g. offering to "claim 35
# issues" when only the open ones would actually be claimed server-side. Always
# name the parameter `statuses` so the filter applies.
#
# `is_snoozed` is the same shape of trap one level down: omitted, the server
# returns snoozed AND awake issues. A snoozed issue is still `open`, so anything
# that offers work to do must pass false — `POST /claims` skips snoozed issues
# server-side, and a preview that lists them offers work the claim will refuse.
#
# `types` is the third of the same shape: omitted, the server returns epics
# alongside units of work. An epic is a container that `POST /claims` refuses
# (`type != epic` in InternalIssuesDao.claimOpen), so anything offering work to
# do must pass "issue".
def issues_list_path(statuses:, category: nil, limit: 100, is_snoozed: nil, parent_number: nil, types: nil)
  params = { "statuses" => Array(statuses) }
  params["categories"] = category if category
  params["types"] = Array(types) if types
  params["parent_number"] = parent_number if parent_number
  params["is_snoozed"] = is_snoozed unless is_snoozed.nil?
  params["limit"] = limit
  params["offset"] = 0
  issues_path("?#{URI.encode_www_form(params)}")
end

def issue_comments_path(number)
  issues_path("/#{number}/comments?limit=101&offset=0")
end

# The ONE way anything in this CLI reads an issue's timeline: `dev issues show`,
# the claim-time plan render, and `dev issues resume`'s session lookup all go
# through it, so the limit and the ordering are decided in one place.
def issue_fetch_comments(endpoint, number)
  ApiClient.request(endpoint, :get, issue_comments_path(number)) || []
end

def issue_fetch(endpoint, number)
  ApiClient.request(endpoint, :get, issues_path("/#{number}"))
end

# The timeline of every claimed issue, keyed by issue number, for the plan to
# render. Best-effort per issue: by the time this runs the issues are ALREADY
# claimed server-side, so a failed read must degrade the plan, not abort the
# claim and strand them in `claimed` with no plan written.
def issue_comments_by_number(endpoint, issues)
  issues.to_h do |issue|
    number = issue["number"]
    comments =
      begin
        issue_fetch_comments(endpoint, number)
      rescue StandardError => e
        warn "Could not read ISS-#{number} comments (#{e.message}); its plan will omit the history."
        []
      end
    [number, comments]
  end
end

# Fail with the exact login command when there is no credential yet, rather than the generic
# "run 'dev auth login'" that handle_errors emits on a 401. A Claude session carrying the AI token has
# its own credential and needs no login at all.
def require_playbook_session!(use_localhost)
  return unless ApiClient.auth_header_for("playbook", use_localhost: use_localhost).nil?
  return unless ApiClient.session_id_for("playbook", use_localhost: use_localhost).nil?
  Util.exit_with_error("No playbook session#{use_localhost ? ' (localhost)' : ''}. Run `dev auth login --app playbook#{use_localhost ? ' --localhost' : ''}` first.")
end

# Display identity of an issue: the per-tenant number, e.g. ISS-034. Plain text —
# it also lands in tab titles and in the markdown prompt bodies, which must never
# carry terminal escapes. Use issue_link for output a human reads in a terminal.
def issue_label(issue)
  "ISS-#{issue['number']}"
end

# Where an issue lives in the admin console. admin.clubaid.co is the canonical
# route; admin.plybk.us is a mirror of the same app during the rebrand.
ISSUE_ADMIN_BASE_URL = "https://admin.clubaid.co".freeze

def issue_url(issue)
  "#{ISSUE_ADMIN_BASE_URL}/admin/issues/#{issue['number']}"
end

# issue_label as a clickable link to the admin console. Degrades to the plain
# label when stdout is not a terminal.
def issue_link(issue)
  Util.hyperlink(issue_label(issue), issue_url(issue))
end

# Human label for the club an issue belongs to. Child clubs are named bare
# ("Baltimore", "Fountain") and are ambiguous without their parent, so render
# "Parent / Child" when the club has a parent. Falls back to the club id, then "?".
def issue_club_label(issue)
  club = issue["club"] || {}
  name = club["name"] || club["id"] || "?"
  parent = club["parent"]
  parent_name = parent && (parent["name"] || parent["id"])
  parent_name.nil? || parent_name.empty? ? name : "#{parent_name} / #{name}"
end

# Who filed it: audit_stamp.by, most identifying field first.
def issue_author_label(issue)
  by = issue.dig("created", "by") || {}
  by["name"] || by["nickname"] || by["email"] || by["id"] || "?"
end

# A snoozed issue keeps its status — a deferred issue is still `open` — so the
# status alone reads as claimable when it is not. Render the deferral next to the
# status rather than leaving the line to imply work that `dev issues claim` will
# refuse (ISS-244). Empty for an awake issue, and for a wake time already past:
# `snoozed_until` is not cleared when it expires, the server just stops honoring
# it (see InternalIssuesDao.snoozeClause).
# One slice of an issue's edges, as the server returns them: every link of this type
# on this side of the edge, each entry naming the issue at the far end (with its
# status, which is the whole question for a blocker).
#
# The relationships all live on one `links` list with a closed type enum, so every
# renderer below is this one filter with different arguments — there is no per-
# relationship field to add a reader for.
ISSUE_LINK_BLOCKED_BY = "blocked_by".freeze
ISSUE_LINK_DUPLICATE_OF = "duplicate_of".freeze

def issue_links(issue, type, direction)
  Array(issue["links"])
    .select { |l| l["type"] == type && l["direction"] == direction }
    .map { |l| l.fetch("issue") }
end

# The issues this one is waiting on; and the issues waiting on it.
def issue_blockers(issue)  = issue_links(issue, ISSUE_LINK_BLOCKED_BY, "outgoing")
def issue_blocks(issue)    = issue_links(issue, ISSUE_LINK_BLOCKED_BY, "incoming")

# The canonical this issue was absorbed into; and everything absorbed into it.
def issue_canonical(issue) = issue_links(issue, ISSUE_LINK_DUPLICATE_OF, "outgoing").first
def issue_absorbed(issue)  = issue_links(issue, ISSUE_LINK_DUPLICATE_OF, "incoming")

# ISS-<n> (<status>) — how a blocker is named wherever the reason it still blocks
# matters, which is everywhere a blocker is printed.
def issue_ref_label(ref)
  "ISS-#{ref.fetch('number')} (#{ref.fetch('status')})"
end

# Marks a dismissed issue as absorbed rather than dropped. Without it the two read
# identically in a list, and "dismissed" is the wrong story for work that moved.
def issue_duplicate_note(issue)
  canonical = issue_canonical(issue)
  return "" if canonical.nil?

  " (dup of ISS-#{canonical.fetch('number')})"
end

# A blocked issue is still `open`, so — exactly like a snooze — the status alone
# reads as claimable when it is not. Say what it is waiting on right there, or a
# list of eight epic children in numeric order says nothing about what to work
# next. `is_blocked` is the server's own derived answer, so this can never
# disagree with what `issues claim` will actually accept.
def issue_blocked_note(issue)
  return "" unless issue["is_blocked"]

  live = issue_blockers(issue).reject { |b| ISSUE_UNBLOCKING_STATUSES.include?(b["status"]) }
  return " (blocked)" if live.empty?

  " (blocked by #{live.map { |b| "ISS-#{b.fetch('number')}" }.join(', ')})"
end

# The statuses at which a blocker stops holding its dependents back — the same set
# InternalIssueLinksDao.UnblockingStatuses applies server-side. Kept here only to
# say WHICH blockers are still live when rendering; whether an issue is blocked at
# all is always the server's `is_blocked`, never recomputed from this list.
ISSUE_UNBLOCKING_STATUSES = %w[fixed deployed verified dismissed].freeze

def issue_snooze_note(issue)
  until_at = issue["snoozed_until"]
  return "" if until_at.nil? || until_at.to_s.empty?
  at = begin
    Time.parse(until_at.to_s)
  rescue ArgumentError, TypeError
    return ""
  end
  return "" if at <= Time.now
  " (snoozed until #{at.localtime.strftime('%b %-d')})"
end

def issue_summary_line(issue, index)
  title = issue["title"].to_s.gsub(/\s+/, " ").strip
  title = "#{title[0, 57]}..." if title.length > 60
  # club is playbook-only context: absent on fleet-wide auto-filed issues.
  club = issue["club"] ? "#{issue_club_label(issue)} · " : ""
  # No category here: the only caller prints these under a per-category heading.
  "  #{index}. #{issue_label(issue)} · #{issue['status']}#{issue_snooze_note(issue)}#{issue_blocked_note(issue)}#{issue_duplicate_note(issue)} · #{club}#{title}"
end

# A timeline comment that moved the issue BACK to `open` from anything else is a
# re-open: the issue was closed once and the close did not hold. That is the
# single most load-bearing fact about the issue — what was already tried failed —
# so the plan leads with it instead of reading like a fresh report.
def issue_reopen_transitions(comments)
  Array(comments).select do |c|
    t = c["transition"]
    t && t["to"] == "open" && t["from"] != "open"
  end
end

def issue_reopened?(comments)
  !issue_reopen_transitions(comments).empty?
end

# The bookkeeping comment `dev issues create` writes to record a session id is
# not history a fix session needs — and on a re-opened issue pointing at the
# earlier session invites resuming it, which is exactly what must not happen.
# Dropped unless it also carries a status transition.
def issue_history_comments(comments)
  Array(comments).reject { |c| c["transition"].nil? && /\AClaude session `/.match?(c["body"].to_s) }
end

# The first words of the note the platform writes when a new issue names a symbol
# (an invariant name, an entity id) that a LIVE issue already names — see
# IssuesService.OverlapCommentPrefix, which is the definition; this is the copy
# that recognises it. The note is already on both timelines by the time `create`
# returns, so this is not a second opinion: it is the same finding, reprinted in
# the terminal at the one moment it can still change what the filer does.
#
# Drifting from the server's wording costs the reprint and nothing else — the
# link is on the timeline either way, and the plan below renders the whole
# timeline rather than matching on this.
ISSUE_OVERLAP_COMMENT_PREFIX = "Possible duplicate".freeze

def issue_overlap_notes(comments)
  Array(comments).map { |c| c["body"].to_s }.select { |b| b.start_with?(ISSUE_OVERLAP_COMMENT_PREFIX) }
end

# Two issues on one failure is not an error — the create succeeded and the issue
# is real — so this reads as a finding to act on, not a failure to recover from.
# Indented as a block so it does not read as more of the "Filed ISS-nnn" line.
def issue_render_overlap_notes(notes)
  return "" if notes.empty?
  ["", "⚠ This may already be tracked:", ""].concat(
    notes.flat_map { |n| n.split("\n").map { |line| line.empty? ? "" : "  #{line}" } + [""] }
  ).join("\n")
end

# One timeline entry: when, who, the status transition it recorded, and the note.
# Visibility is called out only for `shared` — that text went to the submitter,
# so it is the one thing here a reply must stay consistent with.
def issue_render_comment(comment)
  t = comment["transition"]
  meta = ["#{comment.dig('created', 'at')}", issue_author_label(comment)]
  meta << "status #{t['from']} → #{t['to']}" if t
  meta << "shared with the submitter" if comment["visibility"] == "shared"
  head = "- #{meta.join(' · ')}"
  body = comment["body"].to_s.strip
  body.empty? ? head : "#{head}\n  > #{body.gsub("\n", "\n  > ")}"
end

# The banner a re-opened issue leads with. Names the two things that otherwise
# get re-derived the slow way: the earlier fix did not work (so re-applying it is
# not the answer), and the earlier working directory/branch must not be reused —
# a second session in the same dir clobbers the first one's tree.
def issue_reopen_callout(issue, comments)
  reopens = issue_reopen_transitions(comments)
  last = reopens.last
  why = last && !last["body"].to_s.strip.empty? ? " Reason given: #{last['body'].to_s.strip.gsub("\n", ' ')}" : ""
  times = reopens.length > 1 ? " #{reopens.length} times" : ""
  # An investigate-only category has no branch to warn about — only the working
  # directory — and telling it to open one would contradict the plan wrapper.
  workspace =
    if issue_investigate_only?(issue["category"])
      "Work it in a NEW `~/code/ai/<short-name>` directory — never reuse the directory\n" \
      "or session from the earlier attempt (two sessions in one working dir clobber\n" \
      "each other)."
    else
      "Work it in a NEW `~/code/ai/<short-name>` directory on a NEW branch — never reuse\n" \
      "the directory, branch, or session from the earlier attempt (two sessions in one\n" \
      "working dir clobber each other)."
    end
  [
    "**RE-OPENED#{times} — the earlier attempt did not hold.**#{why}",
    "",
    "Before writing anything, read this issue's previous fix PR(s) and comment history",
    "below: what looks like the obvious answer has already been tried. Find why it did",
    "not work rather than repeating it.",
    "",
    workspace,
  ].join("\n")
end

# One issue rendered as a plan section. Kept separate (and pure) so the output is
# unit-testable without any network calls. `comments` is the issue's timeline:
# absent for a freshly filed issue, load-bearing for a re-opened one. `index`
# numbers it within a plan's list; nil for `dev issues show`, which renders one
# issue with nothing to count it against. `heading:` is false for a plan, whose
# own H1 already names the issue — repeating it two lines down is pure noise.
def issue_render_item(issue, index = nil, comments: [], heading: true)
  lines = []
  if heading
    lines << "### #{index ? "#{index}. " : ''}#{issue_label(issue)} — #{issue['title']}"
    lines << ""
  end
  if issue_reopened?(comments)
    lines << issue_reopen_callout(issue, comments)
    lines << ""
  end
  lines << "- Issue: `#{issue_label(issue)}` (id `#{issue['id']}`)"
  lines << "- Category: #{issue['category']}"
  lines << "- Status: #{issue['status']}"
  lines << "- Severity: #{issue['severity'] || 'unspecified'}"
  lines << "- Club: #{issue_club_label(issue)} (`#{issue.dig('club', 'id')}`)" if issue["club"]
  lines << "- Created: #{issue.dig('created', 'at')} by #{issue_author_label(issue)}"
  lines << "- Occurrences: #{issue['occurrence_count'] || 1}"
  # The repos the work is in, which the agent executor clones and branches before
  # a session starts. Shown even though nothing about the record depends on it:
  # an issue that names none is one whose session clones for itself, and that is
  # worth seeing HERE rather than discovering from the session's transcript.
  repositories = issue["repositories"] || []
  lines << "- Repos: #{repositories.join(', ')}" unless repositories.empty?
  lines << "- Fingerprint: `#{issue['fingerprint']}`" if issue["fingerprint"] && !issue["fingerprint"].empty?
  # ISS-553. Printed only when set, because it is set on almost nothing — and when
  # it IS set it changes what a reader can do with the issue: the work is about one
  # machine's own local state and only that machine can claim it, so a session
  # reading this anywhere else should stop rather than improvise.
  if issue["assigned_runner_id"] && !issue["assigned_runner_id"].to_s.empty?
    lines << "- Assigned to machine: `#{issue['assigned_runner_id']}` — ONLY that runner can claim this issue"
  end
  attachments = (issue["attachments"] || []).map do |a|
    url = a.dig("file", "url")
    next if url.nil? || url.empty?
    desc = a["description"]
    desc.nil? || desc.empty? ? url : "#{url} (#{desc})"
  end.compact
  lines << "- Attachments: #{attachments.empty? ? 'none' : attachments.join(', ')}"
  # Every fix already recorded on the issue. On a re-opened issue these are the
  # PRs that were supposed to close it — read them before proposing anything.
  fixes = (issue["fixes"] || []).map do |f|
    url = f["url"].to_s
    next if url.empty?
    app = f.dig("deployment", "app")
    app.nil? || app.empty? ? url : "#{url} (#{app} #{f.dig('deployment', 'baseline_version')})"
  end.compact
  lines << "- Previous fixes: #{fixes.join(', ')}" unless fixes.empty?
  body = issue["body"].to_s
  unless body.empty?
    lines << ""
    lines << "> #{body.gsub("\n", "\n> ")}"
  end
  history = issue_history_comments(comments)
  unless history.empty?
    lines << ""
    lines << "**Comment history (#{history.length}, oldest first):**"
    lines << ""
    history.each { |c| lines << issue_render_comment(c) }
  end
  lines.join("\n")
end

# Durable per-category orientation (pipeline map, decoding guide, working rules)
# appended to every generated plan. Read from disk rather than inlined so the
# prose lives in one editable place, and one file per category so a session only
# ever sees the pipeline it is working in. Categories with no pipeline of their
# own — and any category added to the spec enum before its body file exists —
# fall back to the generic guide, so a claim can never die on a missing file.
def issue_body_text(category)
  path = claude_issues_path("#{category}-body.md")
  File.file?(path) ? File.read(path) : issue_default_body_text
end

def claude_issues_path(name)
  File.expand_path("../claude-issues/#{name}", __dir__)
end

# The generic "how to work an issue" guide: the orientation every plan needs
# regardless of category. Its own file so the per-category bodies, the fallback,
# and the hand-filed plan all share ONE copy of the working rules.
def issue_default_body_text
  File.read(claude_issues_path("default-body.md"))
end

# Body for a plan written by `dev issues create`: what is specific to a hand-filed
# issue, then the shared working guide.
def issue_manual_body_text
  "#{File.read(claude_issues_path('manual-body.md')).strip}\n\n#{issue_default_body_text.strip}\n"
end

# Categories whose claimed session must NOT build anything. A `suggestion` is a
# member's product request, not an approved piece of work: the session reads the
# code and hands back a recommendation on `needs_review`, and a human decides
# whether it becomes a feature/bug/improvement. The plan WRAPPER has to say that
# too — suggestion-body.md alone is not enough, because the wrapper's own prose
# ("implement the fixes, open PRs") would contradict it.
ISSUE_INVESTIGATE_ONLY_CATEGORIES = %w[suggestion].freeze

def issue_investigate_only?(category)
  ISSUE_INVESTIGATE_ONLY_CATEGORIES.include?(category)
end

# The wrapper prose above the issue: what this session is FOR. `origin` is the one
# sentence naming where the plan came from (a sweep vs a hand-filed issue);
# everything else is keyed on the category, so a hand-filed `suggestion` gets the
# same no-code framing a swept one does.
def issue_plan_intro(category, origin)
  # `origin` gets its own line: it varies in length, so inlining it would drag the
  # wrap points of every line after it around with it.
  if issue_investigate_only?(category)
    <<~INTRO.strip
      #{origin}
      This issue is CLAIMED (status `claimed`) and waiting for you. This is an
      INVESTIGATION, not an implementation session: do not create a branch, do not
      write code, do not open a PR. Hand back findings with `dev issues status`
      (below) so it does not stay stuck in `claimed`.
    INTRO
  else
    <<~INTRO.strip
      #{origin}
      This issue is CLAIMED (status `claimed`) and waiting for you. Implement the fix,
      open a PR, and close the issue with `dev issues status` (below) so it does not
      stay stuck in `claimed`.
    INTRO
  end
end

def issue_claim_plan_intro(category)
  issue_plan_intro(category, "Generated by `dev issues claim --category #{category}`.")
end

def issue_manual_plan_intro(category, date)
  issue_plan_intro(category, "Filed #{date} with `dev issues create`.")
end

# The closing menu: the statuses this session is allowed to end on. An
# investigate-only session has no `fixed` to offer — its move is `needs_review`.
# `number` is the issue's own number rather than a `<number>` placeholder: one
# plan is one issue, so there is nothing left for the session to substitute.
def issue_plan_closing(category, number)
  if issue_investigate_only?(category)
    <<~CLOSING.strip
      - Findings ready for a human to decide on →
        `dev issues status #{number} --status needs_review --comment "<your findings>"`
        (the recommendation itself goes in --comment; a human reclassifies it into
        feature/bug/improvement, or dismisses it, from playbook-admin)
      - Blocked on something only a human can answer →
        `dev issues status #{number} --status needs_input --comment "<question>"`

      Every comment you write is an INTERNAL note to the team — never a reply
      addressed to the member who filed the suggestion. Say what needs deciding or
      asking; Mike writes any customer-facing reply from playbook-admin.
    CLOSING
  else
    <<~CLOSING.strip
      - Fixed in a merged PR → `dev issues status #{number} --status fixed --url "<PR URL>" --app <deployable-app> --baseline-version <live version>`
        (--app + --baseline-version let `dev issues reconcile` flip the issue to `deployed`
        once that app releases past the baseline. `dev deploy status` lists the deployable
        app names and their live release tags — read the tag BEFORE your fix ships.)
      - Fixed by a document (process/manual fix, e.g. a Google Doc) →
        `dev issues status #{number} --status fixed --url "<doc URL>"`
        (no app/baseline: nothing to detect, so `deployed` is set by hand later)
      - A SECOND PR on an issue already fixed/deployed/verified →
        `dev issues fix #{number} --url "<PR URL>" [--app <app> --baseline-version <version>]`
        (never `--status fixed` again: that walks the issue backward out of
        deployed/verified, and the server refuses it. Never a bare --comment either —
        a url in prose is invisible to `dev issues reconcile` and to the fix list.)
      - Needs a human decision, or not actionable / already fixed →
        `dev issues status #{number} --status needs_input --comment "<question or reason>"`
        (every comment you write is an INTERNAL note to the team — never a reply
        addressed to the club that filed the issue. Say what needs deciding or
        asking; Mike writes any customer-facing reply from playbook-admin.)
    CLOSING
  end
end

# ONE plan = ONE issue, whether it was swept up by `issues claim` or hand-filed by
# `issues create`. A plan is the unit a session (or a subagent) is handed, so it
# has to be the unit of work: bundling several issues into one plan puts unrelated
# fixes on one branch, and a PR title carries only one `ISS-<n>:` prefix — so
# `dev issues reconcile` can adopt only one of them and the rest sit in `claimed`
# forever, invisible no matter how many releases ship the fix.
#
# `comments` is the issue's timeline (load-bearing for a re-opened issue).
# `local_paths` are the on-disk attachments a hand-filed issue carries: the
# session reads them straight off disk, exactly like dropping the images into a
# Claude Code terminal.
def issue_plan_markdown(issue:, category:, body:, intro:, comments: [], local_paths: [])
  attachments =
    if local_paths.empty?
      ""
    else
      listed = local_paths.map { |p| "- `#{p}`" }.join("\n")
      "\n## Attached files (read these directly)\n\n#{listed}\n"
    end
  heading = issue_investigate_only?(category) ? "## The issue to investigate" : "## The issue to fix"
  <<~PLAN
    # #{issue_label(issue)} — #{issue['title']}

    #{intro}
    #{issue_plan_epic_note(issue)}

    #{heading}

    #{issue_render_item(issue, comments: comments, heading: false)}
    #{attachments}
    ---

    #{body.strip}

    ## Closing this issue (do this — it must not stay `claimed`)

    Run from anywhere (re-authenticates from ~/code/env each call):

    #{issue_plan_closing(category, issue['number'])}
  PLAN
end

# The banner a child issue's plan carries. A session working a child would
# otherwise close it out the way it closes any issue -- and verifying it is the
# one thing it must not do, because the epic is what gets verified and a child
# verified on its own is a piece of the effort nobody ever looked at. Empty for a
# standalone issue, which is every issue that has no parent.
def issue_plan_epic_note(issue)
  parent = issue["parent"]
  return "" if parent.nil?

  <<~NOTE.strip
    \n> **Part of EPIC ISS-#{parent.fetch('number')} — #{parent.fetch('title')}.**
    > Close this issue out normally when your fix ships (`--status fixed`), but do
    > NOT move it to `verified`: ISS-#{parent.fetch('number')} advances to `deployed` on its own once
    > every child has landed, and Mike verifies the epic once for the whole effort.
    > A finding you notice that is NOT part of this epic is filed WITHOUT --parent,
    > at `--status open`.
  NOTE
end

# `<date>-issue-<number>-<slug>` — the file name names the issue, because the file
# IS the issue. Pure, so the naming is testable without touching the plans dir.
def issue_plan_basename(issue, date)
  slug = issue["title"].to_s.downcase.gsub(/[^a-z0-9]+/, "-").gsub(/\A-+|-+\z/, "")[0, 40].to_s
  "#{date}-issue-#{issue['number']}#{slug.empty? ? '' : "-#{slug}"}"
end

# The de-duplicated path to write that plan at. Shared by both plan writers so a
# swept issue and a hand-filed one land under the same naming.
def issue_plan_path(issue, date, dir = File.expand_path("~/code/claude/plans"))
  FileUtils.mkdir_p(dir)
  base = issue_plan_basename(issue, date)
  path = File.join(dir, "#{base}.md")
  n = 2
  while File.exist?(path)
    path = File.join(dir, "#{base}-#{n}.md")
    n += 1
  end
  path
end

def write_issue_plan(issue, category, comments = [])
  date = Time.now.strftime("%Y-%m-%d")
  path = issue_plan_path(issue, date)
  File.write(path, issue_plan_markdown(issue: issue, category: category,
                                       body: issue_body_text(category),
                                       intro: issue_claim_plan_intro(category),
                                       comments: comments))
  path
end

# `comments` is the freshly filed issue's timeline. Usually empty of anything a
# session needs — but not always: the server writes the "this may already be
# tracked" link there at create time, and a plan that drops it hands the session
# the exact blind spot that shipped one acumen fix twice.
def write_manual_issue_plan(issue, local_paths, comments = [])
  date = Time.now.strftime("%Y-%m-%d")
  category = issue["category"]
  path = issue_plan_path(issue, date)
  File.write(path, issue_plan_markdown(issue: issue, category: category,
                                       body: issue_manual_body_text,
                                       intro: issue_manual_plan_intro(category, date),
                                       comments: comments,
                                       local_paths: local_paths))
  path
end

# Spawn argv for `dev issues create`: the batch-claim argv plus --session-id, so
# the uuid recorded on the issue IS the session's id and `--resume` works later.
def issue_create_claude_argv(prompt, uuid)
  ["claude", "--dangerously-skip-permissions", "--model", INTERACTIVE_CLAUDE_MODEL,
   "--session-id", uuid, prompt]
end

def issue_resume_claude_argv(uuid)
  ["claude", "--resume", uuid]
end

# Where the brief comes from, in precedence order: --body, then piped stdin, then
# $EDITOR. Only the last of those needs a terminal, so a headless caller (a Claude
# session filing its own work, cron, `claude --print`) has two ways to file without
# one — before this, every `create` shelled out to $EDITOR unconditionally and died
# on the non-tty with a screenful of vim escape codes.
#
# Returns nil when nothing meaningful was supplied, which aborts before any API call.
# `#` lines are stripped ONLY out of the editor buffer, where they are the
# template's own instructions. A --body/piped brief is taken verbatim: it is written
# by a caller, not a template, and markdown headings there are content.
def issue_resolve_brief(body)
  return issue_nonempty_brief(body) if body && !body.empty?
  return issue_edit_in_editor if $stdin.tty?

  # Non-interactive with no --body: stdin IS the brief. Empty stdin here is a
  # caller that meant to pass one and didn't, so say which flag to reach for
  # rather than aborting with the generic "empty issue".
  piped = issue_nonempty_brief($stdin.read)
  if piped.nil?
    Util.exit_with_error(
      "No issue body (stdin is not a terminal, so $EDITOR cannot be opened, and nothing was piped in). " \
      "Pass --body \"TEXT\" or pipe the brief on stdin."
    )
  end
  piped
end

# A brief supplied verbatim (--body, piped stdin): nil when it holds nothing but
# whitespace, mirroring parse_issue_editor_brief's contract so both sources abort
# the same way.
def issue_nonempty_brief(text)
  content = text.to_s.strip
  content.empty? ? nil : content
end

# Open $EDITOR on the commit-style template and parse the result. Falls back to
# vi when neither VISUAL nor EDITOR is set, matching git's own behaviour.
def issue_edit_in_editor
  editor = ENV["VISUAL"] || ENV["EDITOR"] || "vi"
  Tempfile.create(["ISSUE_EDITMSG", ".md"]) do |f|
    f.write(issue_editor_template)
    f.flush
    system(editor, f.path) or Util.exit_with_error("Editor `#{editor}` exited non-zero. Nothing filed.")
    parse_issue_editor_brief(File.read(f.path))
  end
end

# File a new issue and (unless --no-spawn) hand it straight to a Claude session.
# Ordering is load-bearing: the brief and every upload happen BEFORE the issue
# is created, and the session comment + plan are written BEFORE the spawn — so a
# failure leaves either nothing at all or a fully recoverable claimed issue,
# never a half-filed one.
def cmd_issues_create(args)
  rest, _app, use_localhost = parse_common_flags(args)
  title = nil
  category = nil
  severity = nil
  status = nil
  body = nil
  images = []
  repos = []
  is_epic = false
  parent = nil
  spawn_session = true
  leftover = []
  i = 0
  while i < rest.length
    a = rest[i]
    case a
    when "--body"
      body = rest[i + 1]
      usage_exit("--body requires a value", example: usage_for("issues create")) if body.nil?
      i += 2
    when "--title"
      title = rest[i + 1]
      usage_exit("--title requires a value", example: usage_for("issues create")) if title.nil?
      i += 2
    when "--category"
      category = rest[i + 1]
      usage_exit("--category requires a value", example: usage_for("issues create")) if category.nil?
      i += 2
    when "--severity"
      severity = rest[i + 1]
      usage_exit("--severity requires a value", example: usage_for("issues create")) if severity.nil?
      i += 2
    when "--status"
      status = rest[i + 1]
      usage_exit("--status requires a value", example: usage_for("issues create")) if status.nil?
      i += 2
    when "--image"
      path = rest[i + 1]
      usage_exit("--image requires a path", example: usage_for("issues create")) if path.nil?
      images << path
      i += 2
    when "--repo"
      repo = rest[i + 1]
      usage_exit("--repo requires a repository name", example: usage_for("issues create")) if repo.nil?
      repos << repo
      i += 2
    when "--epic"
      is_epic = true
      i += 1
    when "--parent"
      parent = rest[i + 1]
      usage_exit("--parent requires an issue number", example: usage_for("issues create")) if parent.nil?
      i += 2
    when "--no-spawn"
      spawn_session = false
      i += 1
    else
      leftover << a
      i += 1
    end
  end

  problems = []
  problems << "unexpected argument(s): #{leftover.join(', ')}" unless leftover.empty?
  # The server refuses this too; catching it here saves a round trip and says it
  # in the vocabulary the caller typed.
  problems << "--epic and --parent are mutually exclusive: an epic cannot belong to another epic" if is_epic && parent
  if category && !category.empty? && !ISSUE_MANUAL_CATEGORIES.include?(category)
    problems << "--category must be one of: #{ISSUE_MANUAL_CATEGORIES.join(', ')} " \
                "(#{(ISSUE_CATEGORIES - ISSUE_MANUAL_CATEGORIES).join('/')} are filed automatically " \
                "or in-app — work those with `dev issues claim`)"
  end
  problems << "--severity must be one of: #{ISSUE_SEVERITIES.join(', ')}" if severity && !ISSUE_SEVERITIES.include?(severity)
  if status && !status.empty? && !ISSUE_CREATE_STATUSES.include?(status)
    problems << "--status must be one of: #{ISSUE_CREATE_STATUSES.join(', ')} " \
                "(a new issue is either yours to work now or the queue's — move it anywhere else " \
                "afterwards with `dev issues status`)"
  end
  images.each do |p|
    if !File.file?(p)
      problems << "--image #{p}: no such file"
    elsif issue_file_type(p).nil?
      problems << "--image #{p}: unsupported file type (allowed: #{ISSUE_FILE_TYPES.keys.sort.join(', ')})"
    end
  end
  problems.concat(issue_repo_problems(repos))
  report_arg_problems("issues create", problems, usage_for("issues create"))

  require_playbook_session!(use_localhost)

  # The category prompt is the other thing in this command that needs a terminal:
  # Ask.select_from_list re-asks itself on an unparseable answer, so on a non-tty it
  # would spin on EOF forever rather than fail. Make the caller name it instead.
  if category.nil? && !$stdin.tty?
    Util.exit_with_error(
      "--category is required when stdin is not a terminal (nothing can answer the prompt): " \
      "one of #{ISSUE_MANUAL_CATEGORIES.join(', ')}."
    )
  end
  category ||= Ask.select_from_list("Category", ISSUE_MANUAL_CATEGORIES)

  # An epic is a container: there is nothing to implement until it has been
  # decomposed into children, so it is filed for the queue and no session is
  # started. Both are forced rather than validated -- rejecting `--epic --status
  # claimed` would only make the caller type the combination that was going to be
  # substituted anyway.
  status = is_epic ? "open" : issue_create_status(status)
  spawn_session = false if is_epic
  # Filing something as the queue's work and then opening a session to work it
  # are contradictory instructions. The status is the one the caller stated, so
  # the session is what gives way.
  spawn_session = false if status == "open"

  brief = issue_resolve_brief(body)
  Util.exit_with_error("Aborting: empty issue. Nothing filed.") if brief.nil?

  # Lift the pasted page URL and any pasted file paths out of the brief: the URL
  # becomes source_url and the files become real attachments, instead of both
  # sitting in the body as text that nothing acts on.
  brief, source_url = issue_extract_source_url(brief)
  brief, pasted = issue_extract_attachment_paths(brief)
  bad = pasted.reject { |pth| issue_file_type(pth) }
  Util.exit_with_error("Unsupported attachment type: #{bad.join(', ')} (allowed: #{ISSUE_FILE_TYPES.keys.sort.join(', ')})") unless bad.empty?
  images = (images + pasted).uniq

  handle_errors do
    endpoint = issue_endpoint(use_localhost)

    # Upload every attachment first: a failed upload must not leave an orphan issue.
    attachments = images.map do |p|
      file = ApiClient.request(endpoint, :post, "/#{ISSUE_TENANT_ID}/files/data_url", body: { data: issue_data_url(p) })
      puts "Uploaded #{File.basename(p)}"
      { file_id: file.fetch("id"), description: File.basename(p) }
    end

    # No title unless one was given: the server files a placeholder and queues a
    # summarization of the body, so nothing is lost if that model call fails.
    form = { category: category }
    form[:type] = "epic" if is_epic
    form[:parent_number] = parent if parent
    form[:title] = title if title && !title.empty?
    form[:body] = brief unless brief.empty?
    form[:source_url] = source_url if source_url
    form[:severity] = severity if severity
    form[:repositories] = issue_normalize_repos(repos) unless repos.empty?
    form[:attachments] = attachments unless attachments.empty?

    issue_file_and_start(
      endpoint: endpoint, form: form, category: category, status: status,
      local_paths: images.map { |p| File.expand_path(p) }, spawn_session: spawn_session
    )
  end
end

# Resolve the status the issue is filed into.
#
# On a terminal there is a person at the prompt who ran `create` to start working
# — `claimed` is what they meant, and prompting for it would be a keystroke that
# always has the same answer. Off a terminal there is no such default that is
# right: a Claude session files BOTH the work it is doing and findings it is only
# reporting, and guessing `claimed` for the second kind is exactly the bug this
# flag exists to stop. So make it say which.
def issue_create_status(status)
  return status if status && !status.empty?
  return "claimed" if $stdin.tty?

  Util.exit_with_error(
    "--status is required when stdin is not a terminal: `--status claimed` if you are working " \
    "this issue in THIS session, `--status open` if you are only filing it for the queue. " \
    "A claimed issue is invisible to `dev issues claim`, so claiming work you are not doing " \
    "leaves it for nobody."
  )
end

# Files `form` at `status` and, unless spawn_session is false, writes its plan and
# hands it to a Claude session.
#
# Every caller that files an issue FROM the laptop shares this tail, and the
# claim is derived HERE from `status` rather than set by each caller: a caller
# that forgot `claim_on_create` used to file an OPEN issue and then hand it to a
# session anyway, which is the same phantom-state bug from the other direction
# (`dev claude-usage` did exactly that). One producer of the flag, no drift.
#
# `claim_on_create` claims in the create request itself (IssuesService.insert
# writes status=claimed in the same insert transaction server-side), so a claimed
# issue has no window where it is open and a concurrent `dev issues claim` sweep
# could grab it. With a session, the issue also carries a recorded session id and
# a plan on disk; the ordering there is load-bearing — the session comment and the
# plan are both written BEFORE the spawn, so a failure leaves a fully recoverable
# claimed issue rather than a half-filed one.
def issue_file_and_start(endpoint:, form:, category:, status: "claimed", local_paths: [], spawn_session: true)
  claimed = status == "claimed"
  issue = ApiClient.request(endpoint, :post, issues_path, body: form.merge(claim_on_create: claimed))
  number = issue.fetch("number")
  puts "Filed #{issue_label(issue)} (#{category})"

  # The timeline as the server left it — which already carries the overlap note if
  # this issue names something a live issue names. Read once and used twice: shown
  # to whoever is at the terminal right now, and rendered into the plan below so the
  # session that works this issue is told before it writes a line of code. That is
  # the whole point: on 2026-08-05 two sessions shipped one acumen fix three minutes
  # apart because neither was ever told the other issue existed.
  comments = issue_fetch_comments(endpoint, number)
  overlaps = issue_render_overlap_notes(issue_overlap_notes(comments))
  puts overlaps unless overlaps.empty?

  return issue_filed_open(issue) unless claimed

  # --no-spawn stops HERE, before any session id or plan exists. The session
  # scaffolding is only meaningful when a session is going to run: minting a uuid
  # for a session that never starts leaves `dev issues resume` pointing at a
  # nonexistent Claude session, and the plan is a brief for a fresh session that,
  # in the --no-spawn case, is not coming — the caller (a Claude session filing
  # the work it is already doing) is the one who will close it.
  return issue_filed_without_session(issue) unless spawn_session

  # Mint the session id HERE so it is recorded even if the session dies on its
  # first turn — the model is never asked to self-report it.
  uuid = SecureRandom.uuid
  ApiClient.request(endpoint, :post, issues_path("/#{number}/comments"),
                    body: { body: issue_session_comment_body(uuid), visibility: "internal" })

  path = write_manual_issue_plan(issue, local_paths, comments)
  puts "Claimed #{issue_label(issue)} → #{path}"
  puts "Session #{uuid} (reattach later with `dev issues resume #{number}`)"

  prompt = issue_prompt_with_tab_title([issue], issue_session_prompt(category, path))

  puts ""
  puts "Starting Claude session (Opus 5, 1M context)..."
  puts ""
  begin
    exec(*issue_create_claude_argv(prompt, uuid))
  rescue SystemCallError => e
    warn "Could not start Claude (#{e.message}). #{issue_label(issue)} is claimed and the plan is saved — resume with:"
    warn "  dev issues resume #{number}"
  end
  issue
end

# The --no-spawn tail: the issue is filed and claimed, and that is the whole
# artifact. Print what the filer needs next — how to close it — rather than a
# paste-ready `claude` command for a session nobody asked to start.
#
# The issue IS claimed (claim_on_create), which keeps a concurrent `dev issues
# claim` sweep from handing the same work to a second session. The tradeoff: since
# `claim` only offers OPEN issues, this one will not resurface there — put it back
# in the queue with `dev issues status <n> --status open` if you want it worked by
# someone else after all.
def issue_filed_without_session(issue)
  number = issue.fetch("number")
  puts "Claimed #{issue_label(issue)} — no session started (--no-spawn)."
  puts ""
  puts "Close it when the fix ships:"
  puts "  dev issues status #{number} --status fixed --url \"<PR URL>\" --app <app> --baseline-version <live version>"
  puts "Or hand it back to the queue:"
  puts "  dev issues status #{number} --status open"
  issue
end

# The `--status open` tail: the issue belongs to the queue, and the filer is done
# with it. Nothing is claimed, no session is started, and there is nothing for the
# filer to close — so print how it gets picked up rather than how it gets closed.
def issue_filed_open(issue)
  number = issue.fetch("number")
  # An epic is never claimable, so telling its filer to claim it would be advice
  # the server refuses. What it needs is children.
  if issue["type"] == "epic"
    puts "Filed #{issue_label(issue)} as an EPIC — it holds no work of its own."
    puts ""
    puts "Decompose it. File each separately verifiable piece as a child:"
    puts "  dev issues create --category <cat> --status claimed --parent #{number} --title \"...\" --no-spawn"
    puts ""
    puts "Close each child out individually. Do NOT verify them: this epic advances to"
    puts "deployed on its own once the last child lands, and IT is what gets verified."
    return issue
  end
  puts "Left #{issue_label(issue)} open — nobody is working it."
  puts ""
  puts "Pick it up later with:"
  puts "  dev issues claim --number #{number}"
  issue
end

# ---- issues workaround: the session close-out contract (ISS-507) ----
#
# A session that ROUTES AROUND a broken instruction produces the same artifacts
# as one that succeeded — a PR, a fixed issue, a clean report — so the broken
# instruction survives and the next run works around it again. The ISS-465
# slow-query run hit three of these and filed one; the two it merely described in
# prose were found hours later by a human reading the timeline, and would have
# recurred nightly otherwise.
#
# This is `issues create` with every field a reporting session must not get wrong
# already decided, because each of them has a known failure mode:
#
#   status open       `claimed` would make the finding unpickupable — the session
#                     filing it is closing out, not working it. Sessions get this
#                     wrong often enough that `--status` had to become required
#                     on `create` (ISS-149/151).
#   no session        nothing to spawn: this is a report.
#   fingerprint       the ONLY thing standing between a nightly producer and one
#                     copy of the same finding per night. Server-side, a create
#                     carrying a fingerprint that already exists non-terminally is
#                     a recurrence (occurrence_count++, comment) rather than a
#                     duplicate — this command exists largely to make that
#                     mechanism reachable from a session, since `issues create`
#                     has no way to set one.
#   both directions   the finding names the run that hit it, and that run's
#                     timeline names the finding.
WORKAROUND_FINGERPRINT_PREFIX = "workaround:".freeze

# Lowercase words joined by hyphens, nothing else. The key IS the dedup identity,
# so a DIFFERENT session on a DIFFERENT night has to reproduce it from the same
# facts: "Openclaw status path missing", "openclaw_status_path_missing" and
# "openclaw-status-path-missing" would otherwise be three issues for one finding.
# Narrow enough that there is only one way to write any given key.
#
# Shared with `issues handoff`: two commands whose keys land in the same
# fingerprint namespace cannot afford to disagree about what a key may look like.
# The HINT stays per-command — the rule is identical, but what a key should NAME
# is not (what broke, vs. what is still pending).
ISSUE_DEDUP_KEY_RE = /\A[a-z0-9]+(?:-[a-z0-9]+)*\z/.freeze

WORKAROUND_KEY_HINT =
  "lowercase words joined by hyphens, naming WHAT BROKE rather than the run that hit it " \
  "(openclaw-status-path-missing, not slow-query-2026-08-05) — a key that changes nightly " \
  "dedups against nothing and files the same finding again every night".freeze

def cmd_issues_workaround(args)
  rest, _app, use_localhost = parse_common_flags(args)
  from = nil
  key = nil
  title = nil
  body = nil
  category = nil
  severity = nil
  repos = []
  leftover = []
  i = 0
  while i < rest.length
    case rest[i]
    when "--from"
      from = rest[i + 1]
      usage_exit("--from requires an issue number", example: usage_for("issues workaround")) if from.nil?
      i += 2
    when "--key"
      key = rest[i + 1]
      usage_exit("--key requires a value", example: usage_for("issues workaround")) if key.nil?
      i += 2
    when "--title"
      title = rest[i + 1]
      usage_exit("--title requires a value", example: usage_for("issues workaround")) if title.nil?
      i += 2
    when "--body"
      body = rest[i + 1]
      usage_exit("--body requires a value", example: usage_for("issues workaround")) if body.nil?
      i += 2
    when "--category"
      category = rest[i + 1]
      usage_exit("--category requires a value", example: usage_for("issues workaround")) if category.nil?
      i += 2
    when "--severity"
      severity = rest[i + 1]
      usage_exit("--severity requires a value", example: usage_for("issues workaround")) if severity.nil?
      i += 2
    when "--repo"
      repo = rest[i + 1]
      usage_exit("--repo requires a repository name", example: usage_for("issues workaround")) if repo.nil?
      repos << repo
      i += 2
    else
      leftover << rest[i]
      i += 1
    end
  end

  # A workaround IS a defect in the instruction that could not be executed, so
  # `bug` is the default rather than a prompt. Named categories stay available:
  # ISS-505 (a playbook copied instead of pointed at) was an improvement.
  category = "bug" if category.nil? || category.empty?
  problems = workaround_problems(from: from, key: key, title: title, body: body,
                                 category: category, severity: severity, leftover: leftover)
  problems.concat(issue_repo_problems(repos))
  report_arg_problems("issues workaround", problems, usage_for("issues workaround"))

  require_playbook_session!(use_localhost)

  form = {
    title: title,
    category: category,
    fingerprint: "#{WORKAROUND_FINGERPRINT_PREFIX}#{key}",
    body: workaround_body(body, from),
    # Never claimed: whoever picks this up is not this session.
    claim_on_create: false,
  }
  form[:severity] = severity if severity
  form[:repositories] = issue_normalize_repos(repos) unless repos.empty?

  handle_errors do
    endpoint = issue_endpoint(use_localhost)
    issue = ApiClient.request(endpoint, :post, issues_path, body: form)
    recurrence = issue["occurrence_count"].to_i > 1
    if recurrence
      puts "#{issue_label(issue)}: already tracked (occurrence #{issue['occurrence_count']}) — no duplicate filed."
    else
      puts "Filed #{issue_label(issue)} (#{category}) — open, nobody is working it."
    end
    puts "  fingerprint: #{form[:fingerprint]}"
    workaround_note_on_source(endpoint, from, issue, title: title, recurrence: recurrence)
    issue
  end
end

def workaround_problems(from:, key:, title:, body:, category:, severity:, leftover:)
  problems = []
  problems << "unexpected argument(s): #{leftover.join(', ')}" unless leftover.empty?
  if from.nil? || from.empty?
    problems << "--from is required (the issue this session is working — the run that hit the workaround)"
  elsif !/\A\d+\z/.match?(from)
    problems << "--from must be an issue number (465, or zero-padded 0465), not '#{from}'"
  end
  if key.nil? || key.empty?
    problems << "--key is required: #{WORKAROUND_KEY_HINT}"
  elsif !ISSUE_DEDUP_KEY_RE.match?(key)
    problems << "--key '#{key}' is not a valid dedup key: #{WORKAROUND_KEY_HINT}"
  end
  problems << "--title is required (what could not be done as written)" if title.nil? || title.strip.empty?
  if body.nil? || body.strip.empty?
    problems << "--body is required (what you were told to do, what you did instead, and what that cost this run)"
  end
  unless ISSUE_MANUAL_CATEGORIES.include?(category)
    problems << "--category must be one of: #{ISSUE_MANUAL_CATEGORIES.join(', ')}"
  end
  problems << "--severity must be one of: #{ISSUE_SEVERITIES.join(', ')}" if severity && !ISSUE_SEVERITIES.include?(severity)
  problems
end

# The finding's half of the cross-reference, appended rather than asked for: the
# session writing the brief is describing what broke, and which run it broke on
# is the caller's bookkeeping, not the reporter's prose.
def workaround_body(body, from)
  "#{body.strip}\n\n---\n\nWorked around during ISS-#{from} rather than fixed there, and filed " \
    "under the close-out contract in devops/agent/instructions.md §1 — the session that hit this " \
    "is not working it."
end

# The run's half. Load-bearing on a RECURRENCE specifically: nothing new is
# created that night, so without this the run that hit the workaround again shows
# no trace of it at all — the exact invisibility this command exists to remove.
def workaround_note_on_source(endpoint, from, issue, title:, recurrence:)
  note =
    if recurrence
      "Worked around during this run, not fixed. Already tracked as #{issue_label(issue)} " \
        "(occurrence #{issue['occurrence_count']}): #{title}"
    else
      "Worked around during this run, not fixed. Filed as #{issue_label(issue)}: #{title}"
    end
  note_on_source_issue(endpoint, from, issue, note)
end

# Post a cross-reference comment on the issue the session was working, so the link
# reads in both directions. Shared by `issues workaround` and `issues handoff`.
#
# Best-effort, and deliberately after the create: the filed issue is the artifact
# worth protecting, and losing the back-reference must not also lose it (or, worse,
# leave a caller retrying a create that already succeeded).
def note_on_source_issue(endpoint, from, issue, note)
  ApiClient.request(endpoint, :post, issues_path("/#{URI.encode_www_form_component(from)}/comments"),
                    body: { body: note, visibility: "internal" })
  puts "  noted on ISS-#{from}"
rescue SessionExpired, ApiError => e
  warn "#{issue_label(issue)} is filed, but ISS-#{from} could not be noted (#{e.message}). " \
       "The finding is recorded; only the back-reference from ISS-#{from} is missing — " \
       "say it in that issue's close-out comment instead: #{note}"
end

# ---- issues handoff: the step only a human can take (ISS-563) ----
#
# Some work ends in a command no autonomous session can run: it needs a scope, a
# credential, or a binary that exists only on Mike's laptop. Retiring an openclaw
# cron is the standing example — `openclaw` is not installed on the runners at all
# (the same absence ISS-535 documents for `Agent::Notify`) and the agent identity
# lacks `operator.admin`, so there is no path to the cron store by binary or by
# scope. That is not a gap to close: `operator.admin` is admin over EVERY cron on
# the gateway, including the personal and financial ones ISS-394 deliberately left
# there, so the credential an agent would need is one it must not hold.
#
# Handing the commands over in a PR description or a close-out comment does not
# work, and the failure is recorded rather than hypothetical: ISS-396 handed over
# two `openclaw cron rm` commands on 2026-08-04 and both crons were still firing a
# day later, against code that had been retired around them.
#
# The reason the FIRST attempt to fix that also failed is the one worth encoding.
# ISS-563 was filed with `issues workaround`, which files at `open` — and `open`
# means "an agent may claim this". An agent did, and could no more run
# `openclaw cron rm` than the session that filed it. A human-only step parked in
# the agent queue gets claimed and re-deferred, indefinitely.
#
# So this is `issues workaround`'s sibling with the one field that matters set the
# other way. `needs_input` is the only status that does both halves of the job:
# `dev issues claim` never offers it, so no agent can take it; and it is a standing
# section of the daily nudge (NotifyOpenIssuesProcessor), so it keeps arriving in
# front of the one person who can clear it until they do.
HANDOFF_FINGERPRINT_PREFIX = "handoff:".freeze

HANDOFF_KEY_HINT =
  "lowercase words joined by hyphens, naming the PENDING STEP rather than the run that hands it " \
  "over (openclaw-cron-rm-check-invariants, not iss396-handoff-2026-08-05) — a key that changes " \
  "per run dedups against nothing and files the same pending step again every time".freeze

# A handoff is the tail of whatever work produced it, not a defect in it, so
# `improvement` rather than `workaround`'s `bug`. Named categories stay available.
HANDOFF_DEFAULT_CATEGORY = "improvement".freeze

def cmd_issues_handoff(args)
  rest, _app, use_localhost = parse_common_flags(args)
  from = nil
  key = nil
  title = nil
  body = nil
  url = nil
  category = nil
  severity = nil
  commands = []
  leftover = []
  i = 0
  while i < rest.length
    case rest[i]
    when "--from"
      from = rest[i + 1]
      usage_exit("--from requires an issue number", example: usage_for("issues handoff")) if from.nil?
      i += 2
    when "--key"
      key = rest[i + 1]
      usage_exit("--key requires a value", example: usage_for("issues handoff")) if key.nil?
      i += 2
    when "--title"
      title = rest[i + 1]
      usage_exit("--title requires a value", example: usage_for("issues handoff")) if title.nil?
      i += 2
    when "--body"
      body = rest[i + 1]
      usage_exit("--body requires a value", example: usage_for("issues handoff")) if body.nil?
      i += 2
    when "--command"
      value = rest[i + 1]
      usage_exit("--command requires a value", example: usage_for("issues handoff")) if value.nil?
      commands << value
      i += 2
    when "--url"
      url = rest[i + 1]
      usage_exit("--url requires a value", example: usage_for("issues handoff")) if url.nil?
      i += 2
    when "--category"
      category = rest[i + 1]
      usage_exit("--category requires a value", example: usage_for("issues handoff")) if category.nil?
      i += 2
    when "--severity"
      severity = rest[i + 1]
      usage_exit("--severity requires a value", example: usage_for("issues handoff")) if severity.nil?
      i += 2
    else
      leftover << rest[i]
      i += 1
    end
  end

  category = HANDOFF_DEFAULT_CATEGORY if category.nil? || category.empty?
  problems = handoff_problems(from: from, key: key, title: title, body: body, commands: commands,
                              category: category, severity: severity, leftover: leftover)
  report_arg_problems("issues handoff", problems, usage_for("issues handoff"))

  require_playbook_session!(use_localhost)

  form = {
    title: title,
    category: category,
    fingerprint: "#{HANDOFF_FINGERPRINT_PREFIX}#{key}",
    body: handoff_body(body, from, commands),
    # Never claimed. The move to needs_input below is what actually keeps agents
    # off it; this only closes the window between the create and that move.
    claim_on_create: false,
  }
  form[:severity] = severity if severity

  handle_errors do
    endpoint = issue_endpoint(use_localhost)
    issue = ApiClient.request(endpoint, :post, issues_path, body: form)
    recurrence = issue["occurrence_count"].to_i > 1
    issue = handoff_park(endpoint, issue, url)
    if recurrence
      puts "#{issue_label(issue)}: already handed over (occurrence #{issue['occurrence_count']}) — " \
           "no duplicate filed. Status: #{issue['status']}."
    else
      puts "Filed #{issue_label(issue)} (#{category}) — #{issue['status']}, waiting on a human."
    end
    puts "  fingerprint: #{form[:fingerprint]}"
    note_on_source_issue(endpoint, from, issue, handoff_note(issue, commands, recurrence: recurrence))
    issue
  end
end

def handoff_problems(from:, key:, title:, body:, commands:, category:, severity:, leftover:)
  problems = []
  problems << "unexpected argument(s): #{leftover.join(', ')}" unless leftover.empty?
  if from.nil? || from.empty?
    problems << "--from is required (the issue this session is working — the run handing the step over)"
  elsif !/\A\d+\z/.match?(from)
    problems << "--from must be an issue number (563, or zero-padded 0563), not '#{from}'"
  end
  if key.nil? || key.empty?
    problems << "--key is required: #{HANDOFF_KEY_HINT}"
  elsif !ISSUE_DEDUP_KEY_RE.match?(key)
    problems << "--key '#{key}' is not a valid dedup key: #{HANDOFF_KEY_HINT}"
  end
  problems << "--title is required (the step that is still pending)" if title.nil? || title.strip.empty?
  if body.nil? || body.strip.empty?
    problems << "--body is required (why no session can run this, and what stays broken until it runs)"
  end
  problems.concat(handoff_command_problems(commands))
  unless ISSUE_MANUAL_CATEGORIES.include?(category)
    problems << "--category must be one of: #{ISSUE_MANUAL_CATEGORIES.join(', ')}"
  end
  problems << "--severity must be one of: #{ISSUE_SEVERITIES.join(', ')}" if severity && !ISSUE_SEVERITIES.include?(severity)
  problems
end

# The commands are the whole artifact: a handoff that describes the step in prose
# is the PR description that already failed twice. Each one has to be pasteable as
# it stands, so a newline — which would silently break the block into unrunnable
# fragments — is rejected rather than reflowed.
def handoff_command_problems(commands)
  return ["--command is required at least once (the exact command a human must run, verbatim)"] if commands.empty?

  problems = []
  problems << "--command cannot be empty" if commands.any? { |c| c.strip.empty? }
  if commands.any? { |c| c.include?("\n") }
    problems << "--command must be a single line; pass --command once per command"
  end
  problems
end

def handoff_body(body, from, commands)
  block = commands.map { |command| "    #{command}" }.join("\n")
  "#{body.strip}\n\n## Run these\n\n#{block}\n\n---\n\n" \
    "Handed over from ISS-#{from}. That session could not run the commands above, and no " \
    "autonomous session can: they need a scope, a credential, or a binary the runners do not " \
    "have.\n\n" \
    "Filed at `needs_input` deliberately. `dev issues claim` only ever offers `open` issues, so " \
    "nothing here can be claimed by an agent and deferred again — which is exactly what happened " \
    "when this kind of step was filed at `open` (ISS-563). It stays in the daily nudge every " \
    "morning until a human clears it."
end

# Park the issue where no agent can take it. Only from `open`: a fingerprint
# recurrence folds into whatever live issue already exists, and `fixed`/`deployed`
# are forward of this on a one-way ladder — writing needs_input onto one of those
# would walk it BACKWARD, which is the ISS-536 shape. `open` is both the status a
# fresh create lands on and the one a previous run's failed park left behind, so
# this is idempotent without being destructive.
def handoff_park(endpoint, issue, url)
  return issue unless issue["status"] == "open"

  ApiClient.request(endpoint, :put, issues_path("/#{URI.encode_www_form_component(issue['number'])}/status"),
                    body: { status: "needs_input", visibility: "internal",
                            comment: handoff_park_comment(issue, url) })
rescue SessionExpired, ApiError => e
  # The commands are already filed and visible; what is lost is the guarantee that
  # no agent claims them. That is the entire point of the command, so it is loud.
  warn "#{issue_label(issue)} is filed but is still `open` — moving it to needs_input failed " \
       "(#{e.message}). An agent can claim it in that state and will not be able to run it. Run:\n" \
       "  dev issues status #{issue['number']} --status needs_input --comment \"waiting on a human\""
  issue
end

def handoff_park_comment(issue, url)
  target = url && !url.strip.empty? ? url : "<the PR or document these commands complete>"
  "Waiting on a human: the commands in this issue need a scope, a credential, or a binary no " \
    "autonomous session has. Nothing is working it — `dev issues claim` skips `needs_input`.\n\n" \
    "When they have been run:\n\n" \
    "    dev issues status #{issue['number']} --status fixed --url \"#{target}\""
end

def handoff_note(issue, commands, recurrence:)
  lead =
    if recurrence
      "Handed over again this run. Already tracked as #{issue_label(issue)} " \
        "(occurrence #{issue['occurrence_count']}, #{issue['status']})"
    else
      "Handed over rather than done: this session could not run the step. Filed as " \
        "#{issue_label(issue)} (#{issue['status']})"
    end
  "#{lead} — #{commands.length} command(s) waiting on a human:\n\n" +
    commands.map { |command| "    #{command}" }.join("\n")
end

# Adopt an existing issue onto an epic, or detach it. The four ISS-314 follow-ups
# were filed long before epics existed, so "file it as a child" is not the only
# path that has to work -- an effort is often recognised as one AFTER its pieces
# are already in the queue. Deliberately the escape hatch that makes
# under-calling an epic cheap: one command later, rather than a container filed
# speculatively up front.
def cmd_issues_parent(args)
  rest, _app, use_localhost = parse_common_flags(args)
  number = rest.shift
  epic = nil
  detach = false
  leftover = []
  i = 0
  while i < rest.length
    case rest[i]
    when "--epic"
      epic = rest[i + 1]
      usage_exit("--epic requires an issue number", example: usage_for("issues parent")) if epic.nil?
      i += 2
    when "--detach"
      detach = true
      i += 1
    else
      leftover << rest[i]
      i += 1
    end
  end

  problems = []
  problems << "missing issue number (positional argument, e.g. 343)" if number.nil? || number.empty?
  problems << "unexpected argument(s): #{leftover.join(', ')}" unless leftover.empty?
  problems << "pass exactly one of --epic NUMBER or --detach" unless (epic && !detach) || (detach && !epic)
  report_arg_problems("issues parent", problems, usage_for("issues parent"))

  require_playbook_session!(use_localhost)

  handle_errors do
    endpoint = issue_endpoint(use_localhost)
    # The update endpoint replaces every editable field, so the issue is read
    # first and its own values are sent back unchanged alongside the new parent.
    # Sending a partial form here would silently clear severity, body and club.
    issue = ApiClient.request(endpoint, :get, issues_path("/#{number}"))
    form = {
      category: issue.fetch("category"),
      type: issue.fetch("type"),
      title: issue.fetch("title"),
    }
    form[:body] = issue["body"] if issue["body"]
    form[:severity] = issue["severity"] if issue["severity"]
    form[:club_id] = issue.dig("club", "id") if issue["club"]
    form[:apps] = issue["apps"] if issue["apps"]
    form[:parent_number] = epic unless detach

    updated = ApiClient.request(endpoint, :put, issues_path("/#{number}"), body: form)
    if detach
      puts "Detached #{issue_label(updated)} from its epic."
    else
      puts "#{issue_label(updated)} is now a child of ISS-#{epic}."
      puts "It will not appear in the awaiting-verification queue on its own — ISS-#{epic} is what gets verified."
    end
  end
end

# Read-only. Unlike `issues claim`, which lists open issues but also claims
# whatever is selected, this never has a side effect — it exists so a caller
# (a human, or Claude checking for a duplicate before filing) can see what is
# already tracked without risking claiming it.
def cmd_issues_list(args)
  rest, _app, use_localhost = parse_common_flags(args)
  category = nil
  epic = nil
  # Empty = no statuses param at all on the wire, which the server reads as "every
  # status" (see issues_list_path) — the default is everything, not just open/claimed.
  statuses = []
  leftover = []
  i = 0
  while i < rest.length
    a = rest[i]
    case a
    when "--category"
      category = rest[i + 1]
      usage_exit("--category requires a value", example: usage_for("issues list")) if category.nil?
      i += 2
    when "--status"
      v = rest[i + 1]
      usage_exit("--status requires a value", example: usage_for("issues list")) if v.nil?
      statuses << v
      i += 2
    when "--epic"
      epic = rest[i + 1]
      usage_exit("--epic requires an issue number", example: usage_for("issues list")) if epic.nil?
      i += 2
    else
      leftover << a
      i += 1
    end
  end

  problems = []
  problems << "unexpected argument(s): #{leftover.join(', ')}" unless leftover.empty?
  problems << "--category must be one of: #{ISSUE_CATEGORIES.join(', ')}" if category && !ISSUE_CATEGORIES.include?(category)
  bad = statuses - ISSUE_STATUSES
  problems << "--status must be one or more of: #{ISSUE_STATUSES.join(', ')}" unless bad.empty?
  report_arg_problems("issues list", problems, usage_for("issues list"))

  require_playbook_session!(use_localhost)

  puts ""
  puts Util.underline("Issues#{use_localhost ? ' (localhost)' : ''}")
  puts ""

  handle_errors do
    endpoint = issue_endpoint(use_localhost)
    issues = ApiClient.request(
      endpoint, :get, issues_list_path(statuses: statuses, category: category, parent_number: epic)
    ) || []
    if issues.empty?
      puts "No issues found."
    elsif epic
      # Scoped to one epic, the question is "what do I work next", and the answer is
      # the READY/BLOCKED split — the same renderer `issues show` uses on the epic.
      puts issue_epic_children_lines(issues)
    else
      issues.each_with_index { |issue, idx| puts issue_summary_line(issue, idx + 1) }
    end
    puts ""
  end
end

# Read one issue and its timeline. `dev issues status --comment` has always been
# able to WRITE a comment; until this there was no way to read one back short of
# opening playbook-admin, and the history is the part that says what was already
# tried. Prints the exact section `dev issues claim` puts in a plan — same
# renderer, so a re-opened issue shows the same RE-OPENED banner and previous fix
# PRs here as it does there.
def cmd_issues_show(args)
  rest, _app, use_localhost = parse_common_flags(args)
  number = rest.shift
  problems = []
  problems << "missing issue number (positional argument, e.g. 084)" if number.nil? || number.empty?
  problems << "unexpected argument(s): #{rest.join(', ')}" unless rest.empty?
  report_arg_problems("issues show", problems, usage_for("issues show"))

  require_playbook_session!(use_localhost)

  handle_errors do
    endpoint = issue_endpoint(use_localhost)
    issue = issue_fetch(endpoint, number)
    puts issue_render_item(issue, comments: issue_fetch_comments(endpoint, number))
    puts issue_family_section(endpoint, issue)
    puts issue_links_section(issue)
  end
end

# EVERY edge on the issue, both directions, grouped by type. All four groups matter
# and each changes how the issue should be read:
#
#   blockers      — this is not workable yet, and `issues claim` will refuse it
#   blocks        — finishing this releases other work; that is a reason to do it
#   duplicate of  — a dismissed duplicate is not work that was dropped, it moved
#   absorbed      — the canonical is carrying more reports than its own body shows
#
# Read straight off the issue's own `links`: the edges ride along with the record,
# so nothing here costs a round trip and nothing can render one relationship while
# silently missing another.
def issue_links_section(issue)
  [
    issue_blockers_lines(issue),
    issue_blocks_lines(issue),
    issue_duplicate_lines(issue),
  ].compact.join
end

def issue_blockers_lines(issue)
  blockers = issue_blockers(issue)
  return nil if blockers.empty?

  # Shipped blockers stay in the list: "why is this claimable now" is the same
  # question as "why was it not", and dropping them answers neither. The status on
  # each line is what tells them apart.
  live = blockers.reject { |b| ISSUE_UNBLOCKING_STATUSES.include?(b["status"]) }
  lines = blockers.map { |b| "  - #{issue_ref_label(b)} #{b.fetch('title')}" }.join("\n")
  header =
    if live.empty?
      "\nBLOCKED BY #{blockers.length} issue(s), all shipped — this is claimable now:"
    else
      "\nBLOCKED — waiting on #{live.length} of #{blockers.length} blocker(s):"
    end
  footer =
    if live.empty?
      "\n"
    else
      "\n`dev issues claim` will refuse this issue until every blocker reaches fixed, deployed, verified\n" \
        "or dismissed. Drop an edge that is not really a prerequisite with `dev issues block " \
        "#{issue.fetch('number').sub(/\A0+/, '')} --on <n> --remove`.\n"
    end
  "#{header}\n#{lines}\n#{footer}"
end

def issue_blocks_lines(issue)
  blocked = issue_blocks(issue)
  return nil if blocked.empty?

  lines = blocked.map { |b| "  - #{issue_ref_label(b)} #{b.fetch('title')}" }.join("\n")
  "\nBLOCKS #{blocked.length} issue(s) — they cannot be claimed until this ships:\n#{lines}\n"
end

def issue_duplicate_lines(issue)
  canonical = issue_canonical(issue)
  return "\nDuplicate of ISS-#{canonical.fetch('number')} — #{canonical.fetch('title')} (#{canonical.fetch('status')}).\n" \
         "Work it there; reopening this issue clears the link.\n" if canonical

  # Only ever one level deep, so the edges on this issue reach every duplicate
  # absorbed into it rather than just the most recent hop.
  absorbed = issue_absorbed(issue)
  return nil if absorbed.empty?

  labels = absorbed.map { |d| "ISS-#{d.fetch('number')}" }.join(", ")
  "\nAbsorbed #{absorbed.length} duplicate#{'s' if absorbed.length != 1}: #{labels}.\n"
end

# An epic's children, split READY vs BLOCKED. A flat list in numeric order says
# nothing about ORDER, which is the one thing an epic's reader actually needs —
# ISS-519 shipped with eight children whose every dependency lived in prose. The
# numbering stays global across both groups so a number always means the same row.
#
# Only splits when something is actually blocked: an epic with no edges reads
# exactly as it did before, with no empty heading to skim past.
def issue_epic_children_lines(children)
  positions = children.each_with_index.to_h { |c, i| [c["number"], i + 1] }
  ready, blocked = children.partition { |c| !c["is_blocked"] }
  return children.map { |c| issue_summary_line(c, positions[c["number"]]) }.join("\n") if blocked.empty?

  [
    "  READY (#{ready.length}):",
    ready.empty? ? "    (nothing — every remaining child is waiting on another)" : nil,
    *ready.map { |c| issue_summary_line(c, positions[c["number"]]) },
    "",
    "  BLOCKED (#{blocked.length}) — not offered by `dev issues claim` until their blockers ship:",
    *blocked.map { |c| issue_summary_line(c, positions[c["number"]]) },
  ].compact.join("\n")
end

# The epic/child context an issue's own record does not carry: an epic's children
# with their statuses, or a child's link back up. Printed after the timeline
# because it is orientation, not history -- but printed at all because "which
# other issues am I part of?" is the first thing an epic makes you ask, and
# without it the answer is a trip to playbook-admin.
def issue_family_section(endpoint, issue)
  number = issue.fetch("number")
  if issue["type"] == "epic"
    children = ApiClient.request(
      endpoint, :get, issues_list_path(statuses: [], parent_number: number, limit: 100)
    ) || []
    return "\nEPIC with no children yet. Decompose it:\n" \
           "  dev issues create --category <cat> --status claimed --parent #{number} --title \"...\" --no-spawn\n" if children.empty?

    done = children.count { |c| %w[deployed verified dismissed].include?(c["status"]) }
    "\nEPIC — #{done} of #{children.length} children done:\n#{issue_epic_children_lines(children)}\n" \
      "\nThis epic advances to deployed on its own once every child is done; verifying it closes them all out.\n"
  elsif issue["parent"]
    parent = issue.fetch("parent")
    "\nChild of EPIC ISS-#{parent.fetch('number')} — #{parent.fetch('title')} (#{parent.fetch('status')}).\n" \
      "Close this issue out normally, but do NOT verify it: its epic is what gets verified.\n"
  else
    ""
  end
end

# Reattach to the Claude session `dev issues create` started on an issue. The
# uuid lives on the issue's timeline, so the session survives closing the
# terminal — that is the whole point of recording it.
def cmd_issues_resume(args)
  rest, _app, use_localhost = parse_common_flags(args)
  number = rest.shift
  problems = []
  problems << "missing issue number (positional argument, e.g. 041)" if number.nil? || number.empty?
  problems << "unexpected argument(s): #{rest.join(', ')}" unless rest.empty?
  report_arg_problems("issues resume", problems, usage_for("issues resume"))

  require_playbook_session!(use_localhost)

  handle_errors do
    endpoint = issue_endpoint(use_localhost)
    comments = issue_fetch_comments(endpoint, number)
    uuid = issue_session_uuid_from_comments(comments)
    Util.exit_with_error("ISS-#{number} has no recorded Claude session. File work with `dev issues create` to get one.") if uuid.nil?
    puts "Resuming Claude session #{uuid} for ISS-#{number}..."
    begin
      exec(*issue_resume_claude_argv(uuid))
    rescue SystemCallError => e
      warn "Could not start Claude (#{e.message}). Resume by hand with:  claude --resume #{uuid}"
    end
  end
end

# The open issues held out of the offer because a prerequisite has not shipped, with
# what each is waiting on. Printed rather than silently filtered: "nothing to claim"
# and "everything is waiting on one unwritten scheduler" are different situations,
# and only one of them means there is no work to do.
def issue_print_blocked(blocked)
  return if blocked.empty?

  puts Util.underline("blocked (#{blocked.length}) — not offered")
  blocked.each do |c|
    live = issue_blockers(c).reject { |b| ISSUE_UNBLOCKING_STATUSES.include?(b["status"]) }
    title = c["title"].to_s.gsub(/\s+/, " ").strip
    title = "#{title[0, 57]}..." if title.length > 60
    puts "  #{issue_label(c)} · waiting on #{live.map { |b| issue_ref_label(b) }.join(', ')} · #{title}"
  end
  puts ""
end

# Work filed for ANOTHER machine (ISS-553). Held out of the offer for exactly the
# reason blocked issues are — `POST /claims` refuses it server-side, so listing it
# puts work on the menu that cannot be ordered — and printed for exactly the same
# reason too: "nothing to claim" and "three issues, all of them for mini-2" are
# different situations, and a bare "No open issues" says the wrong one.
def issue_print_assigned_elsewhere(assigned, runners_by_id)
  return if assigned.empty?

  puts Util.underline("assigned to another machine (#{assigned.length}) — not offered here")
  assigned.each do |c|
    id = c["assigned_runner_id"].to_s
    who = runners_by_id[id] || id
    title = c["title"].to_s.gsub(/\s+/, " ").strip
    title = "#{title[0, 57]}..." if title.length > 60
    puts "  #{issue_label(c)} · for #{who} · #{title}"
  end
  puts "  (claim these from that machine, or re-point one in the admin at /admin/issues/<n>)"
  puts ""
end

# This machine's runner id, or nil when it is not a registered runner at all — a
# laptop, a script, CI. nil is not a failure here: it claims UNASSIGNED work only,
# which is what every caller got before assignment existed. Deliberately does NOT
# go through `agent_identity!`, which exits: `dev issues claim` has always worked
# on an unregistered machine and must keep working there.
def issue_claiming_runner_id
  Agent::Host.cached_identity&.runner_id
rescue StandardError
  nil
end

# Hostnames for the machines named in `issues`, so a held-out row reads "for
# mini-2" rather than "for agr-1d2a…". Best effort: a fleet call that fails leaves
# the ids, which is worse to read but never wrong.
def issue_runner_names(assigned, use_localhost)
  return {} if assigned.empty?

  identity = Agent::Host.cached_identity
  return {} unless identity

  Agent::Api.runners(token: identity.token, use_localhost: use_localhost)
            .to_h { |r| [r["id"], r["hostname"]] }
rescue StandardError
  {}
end

def cmd_issues_claim(args)
  rest, _app, use_localhost = parse_common_flags(args)
  assume_yes = false
  spawn_session = true
  category = nil
  requested = nil
  leftover = []
  i = 0
  while i < rest.length
    a = rest[i]
    case a
    when "--category"
      category = rest[i + 1]
      usage_exit("--category requires a value", example: usage_for("issues claim")) if category.nil?
      i += 2
    when "--number"
      requested = rest[i + 1]
      usage_exit("--number requires a value (e.g. --number 078,080)", example: usage_for("issues claim")) if requested.nil?
      i += 2
    when "--issues"
      # Renamed: `dev issues claim --issues 538` said "issues" twice. Falling
      # through to leftover would report it as "unexpected argument(s): --issues,
      # 538", which reads like a parse confusion rather than a rename — and plans
      # written before the rename still spell it the old way (ISS-540).
      usage_exit("--issues was renamed to --number (e.g. --number 078,080)", example: usage_for("issues claim"))
    when "--yes", "-y"
      assume_yes = true
      i += 1
    when "--no-spawn"
      spawn_session = false
      i += 1
    else
      leftover << a
      i += 1
    end
  end

  problems = []
  problems << "unexpected argument(s): #{leftover.join(', ')}" unless leftover.empty?
  # --category is optional: with none, discover open issues across ALL categories
  # and claim each. When given it must still name a real category.
  problems << "--category must be one of: #{ISSUE_CATEGORIES.join(', ')}" if category && !category.empty? && !ISSUE_CATEGORIES.include?(category)
  report_arg_problems("issues claim", problems, usage_for("issues claim"))

  require_playbook_session!(use_localhost)

  handle_errors do
    endpoint = issue_endpoint(use_localhost)
    # No --category => one call returns every open issue (grouped below); with a
    # category the server filters to it. `present` is the enum-ordered set of
    # categories we will actually claim.
    #
    # is_snoozed: false because a snoozed issue is still `open` — its owner
    # parked it, and `POST /claims` refuses it. Offering it puts work on the menu
    # that cannot be ordered.
    #
    # types: issue for the same reason one level over. An epic is a container,
    # never a unit of work, and `POST /claims` skips it server-side — so an
    # unfiltered preview listed epics, and claiming the "all" it offered came
    # back with nothing claimed and no explanation (an epic-only improvement
    # queue read as "every issue listed was taken or deferred").
    all_open = ApiClient.request(
      endpoint,
      :get,
      issues_list_path(statuses: "open", category: category, is_snoozed: false, types: "issue"),
    ) || []
    # Blocked issues are held out of the offer for the same reason snoozed ones and
    # epics are: `POST /claims` refuses them server-side, so listing them puts work
    # on the menu that cannot be ordered. They are NOT hidden — they are printed
    # below with what they are waiting on, because "nothing to claim" and "eight
    # issues all waiting on one unwritten scheduler" are different situations and a
    # bare "No open issues" would say the wrong one.
    open, blocked = all_open.partition { |c| !c["is_blocked"] }
    # ISS-553: an issue filed for one machine is claimable only by that machine.
    claiming_runner_id = issue_claiming_runner_id
    open, assigned_elsewhere = open.partition { |c|
      c["assigned_runner_id"].nil? || c["assigned_runner_id"] == claiming_runner_id
    }
    runner_names = issue_runner_names(assigned_elsewhere, use_localhost)
    present = issue_categories_present(open)
    if present.empty?
      puts category ? "No open #{category} issues to claim." : "No open issues to claim."
      puts "(Snoozed issues and epics are not offered — `dev issues list` shows them; `dev issues snooze <n> --wake` brings a snoozed one back, and an epic is worked through its children.)"
      issue_print_blocked(blocked)
      issue_print_assigned_elsewhere(assigned_elsewhere, runner_names)
      return
    end

    # One flat, globally numbered list behind the per-category headings: the
    # numbers the operator types are positions in it.
    ordered = issue_ordered_open(open, present)
    auto = ordered
    positions = ordered.each_with_index.to_h { |c, i| [c["number"], i + 1] }
    puts ""
    present.each do |cat|
      issues = open.select { |c| c["category"] == cat }
      puts Util.underline("#{cat} (#{issues.length})")
      issues.each { |c| puts issue_summary_line(c, positions[c["number"]]) }
      puts ""
    end
    issue_print_blocked(blocked)
    issue_print_assigned_elsewhere(assigned_elsewhere, runner_names)

    selected, hand_picked =
      if requested
        resolved, unknown = issue_resolve_requested(requested, ordered)
        unless unknown.empty?
          # A blocked issue named by number is REFUSED, naming its blockers — not
          # folded into the generic "not listed above", which would read as a typo.
          # The operator asked for this issue specifically, and the answer is not
          # "that number is wrong", it is "that work is not workable yet". The
          # server refuses it too; this is the same refusal, one round trip earlier
          # and with the same reasons.
          named_blocked, _ = issue_resolve_requested(unknown.join(","), blocked)
          unless named_blocked.empty?
            Util.exit_with_error(
              named_blocked.map { |c|
                live = issue_blockers(c).reject { |b| ISSUE_UNBLOCKING_STATUSES.include?(b["status"]) }
                "#{issue_label(c)} is blocked by #{live.map { |b| issue_ref_label(b) }.join(', ')} — those have to ship first."
              }.join("\n") +
              "\nDrop an edge that is not really a prerequisite with `dev issues block <n> --on <m> --remove`."
            )
          end
          # Same refusal, same reason, for work filed for another machine (ISS-553).
          # The server refuses it too and names the machine; this is that refusal
          # one round trip earlier, so the operator does not learn it after
          # picking a set they thought they had.
          named_assigned, _ = issue_resolve_requested(unknown.join(","), assigned_elsewhere)
          unless named_assigned.empty?
            Util.exit_with_error(
              named_assigned.map { |c|
                id = c["assigned_runner_id"].to_s
                "#{issue_label(c)} is assigned to #{runner_names[id] || id} — only that machine can claim it."
              }.join("\n") +
              "\nClaim it from that machine, or re-point it in the admin at /admin/issues/<n>."
            )
          end
          # "not listed" also covers snoozed and epics — say so, or naming a
          # deferred issue (or a container) looks like the number was wrong.
          Util.exit_with_error(
            "Not open, snoozed, an epic, blocked, or not listed above: #{unknown.join(', ')}. " \
            "On offer: #{ordered.map { |c| c['number'] }.join(', ')}. " \
            "Wake a snoozed issue with `dev issues snooze <n> --wake`; an epic is never " \
            "claimed — claim its children (`dev issues list --epic <n>`)."
          )
        end
        [resolved, true]
      elsif assume_yes
        [auto, false]
      else
        # Non-interactive (pipe, cron, subprocess): there is nobody to answer, and
        # defaulting to `all` would claim the whole queue on a run that never asked
        # to. Make the caller say which it wants.
        unless $stdin.tty?
          Util.exit_with_error("Nothing to read the selection from (stdin is not a terminal). Pass --number NUMBERS or --yes.")
        end
        issue_ask_selection(ordered, auto)
      end

    if selected.empty?
      puts "Aborted. Nothing claimed."
      return
    end

    # Claim server-side one category at a time (that is the scope the claims
    # endpoint takes), then write one plan per ISSUE actually claimed — a plan is
    # what a subagent is handed, so it has to be one unit of work. A category the
    # race just lost (nothing claimed) is dropped with no plans.
    plans = []
    claimed_issues = []
    present.each do |cat|
      cat_selected = selected.select { |c| c["category"] == cat }
      next if cat_selected.empty?
      scope = issue_claim_scope(cat, cat_selected, open.select { |c| c["category"] == cat }, hand_picked: hand_picked)
      body = { scope: scope }
      # Omitted entirely when this machine is not a runner, which the server reads
      # as "claim unassigned work only".
      body[:runner_id] = claiming_runner_id if claiming_runner_id
      claimed = ApiClient.request(endpoint, :post, issues_path("/claims"), body: body) || []
      next if claimed.empty?
      claimed_issues.concat(claimed)
      comments_by_number = issue_comments_by_number(endpoint, claimed)
      claimed.each do |issue|
        path = write_issue_plan(issue, cat, comments_by_number[issue["number"]] || [])
        plans << [cat, path]
        puts "Claimed #{issue_label(issue)} (#{cat}) → #{path}"
      end
    end

    if plans.empty?
      # Only the by-category scope can get here: it claims whatever is still open
      # and unsnoozed at claim time, and reports a count rather than a reason. A
      # by-number claim fails loudly with the server's per-issue reason instead.
      puts "Nothing claimed — every issue listed above was taken or deferred between the list and the claim. No plan written."
      puts "Re-run `dev issues claim` to see the current queue."
      return
    end

    categories = plans.map(&:first).uniq.length
    puts ""
    puts "Claimed #{claimed_issues.length} issue(s) across #{categories} categor#{categories == 1 ? 'y' : 'ies'} — one plan each."

    unless spawn_session
      if plans.length == 1
        puts "Hand it to a session with:  claude \"#{issue_prompt_with_tab_title(claimed_issues, issue_claim_prompt(plans))}\""
      else
        puts "Start a session and fan out subagents (one per plan; same-category plans on the same feature can share one):"
        plans.each { |cat, p| puts "  #{cat}: #{p}" }
      end
      return
    end

    # Hand the terminal directly to an interactive Claude session (Opus 5, 1M
    # context) so it starts immediately. One plan → it works the plan; several →
    # it fans out subagents over them. exec replaces this process, so the session
    # inherits the TTY and this is the last thing we do.
    puts plans.length == 1 ?
      "Starting Claude session (Opus 5, 1M context) to implement the plan..." :
      "Starting Claude session (Opus 5, 1M context) to fan out subagents over #{plans.length} issue plans..."
    puts "  (re-run with --no-spawn to just write the plan(s))"
    puts ""
    prompt = issue_prompt_with_tab_title(claimed_issues, issue_claim_prompt(plans))
    exec_claude(prompt, note: "The plan(s) are saved — run with:")
  end
end

def cmd_issues_status(args)
  rest, target_app, use_localhost = parse_common_flags(args)
  status = nil
  comment = nil
  url = nil
  baseline_version = nil
  duplicate_of = nil
  leftover = []
  i = 0
  while i < rest.length
    a = rest[i]
    case a
    when "--duplicate-of"
      duplicate_of = rest[i + 1]
      usage_exit("--duplicate-of requires an issue number", example: usage_for("issues status")) if duplicate_of.nil?
      i += 2
    when "--status"
      status = rest[i + 1]
      usage_exit("--status requires a value", example: usage_for("issues status")) if status.nil?
      i += 2
    when "--comment"
      comment = rest[i + 1]
      usage_exit("--comment requires a value", example: usage_for("issues status")) if comment.nil?
      i += 2
    when "--url"
      url = rest[i + 1]
      usage_exit("--url requires a value", example: usage_for("issues status")) if url.nil?
      i += 2
    when "--baseline-version"
      baseline_version = rest[i + 1]
      usage_exit("--baseline-version requires a value", example: usage_for("issues status")) if baseline_version.nil?
      i += 2
    else
      leftover << a
      i += 1
    end
  end

  number = leftover.shift
  has_app = !(target_app.nil? || target_app.empty?)
  has_baseline = !(baseline_version.nil? || baseline_version.empty?)
  problems = []
  problems << "missing issue number (positional argument, e.g. 034)" if number.nil? || number.empty?
  problems << "unexpected argument(s): #{leftover.join(', ')}" unless leftover.empty?
  problems << "--status is required" if status.nil? || status.empty?
  problems << "--status must be one of: #{ISSUE_STATUSES.join(', ')}" if status && !status.empty? && !ISSUE_STATUSES.include?(status)
  # Every fix links to how it shipped: a merged PR, or a document describing a
  # manual/process fix.
  problems << "marking fixed requires --url <url> (the merged PR, or a document describing the fix)" if status == "fixed" && (url.nil? || url.empty?)
  # --app + --baseline-version are the deploy-detection pair: together they let
  # `dev issues reconcile` flip the issue to `deployed`. One without the other
  # detects nothing, so it is always a mistake.
  problems << "--app requires --baseline-version (the app's live release tag at fix time)" if has_app && !has_baseline
  problems << "--baseline-version requires --app (the deployable app the fix ships in)" if has_baseline && !has_app
  # Caught here as well as server-side so the mistake reads as a usage error rather than a 422:
  # a duplicate is recorded BY dismissing it, so there is no other status it can travel with.
  problems << "--duplicate-of only applies to --status dismissed (a duplicate is recorded by dismissing it)" if duplicate_of && !duplicate_of.empty? && status != "dismissed"
  report_arg_problems("issues status", problems, usage_for("issues status"))

  # Always internal, never settable from here. This command is how a Claude fix session talks to
  # the tracker, and everything an automated actor writes is a note to the team — the club that
  # filed the issue is replied to by a person, from playbook-admin. Sent explicitly rather than
  # leaning on the server default so this stays true if that default ever changes.
  body = { status: status }
  body[:comment] = comment if comment && !comment.empty?
  body[:visibility] = "internal" if body.key?(:comment)
  body[:url] = url if url && !url.empty?
  body[:duplicate_of_number] = duplicate_of if duplicate_of && !duplicate_of.empty?

  if has_app
    body[:app] = issue_app!(target_app)
    body[:baseline_version] = baseline_version
  end

  require_playbook_session!(use_localhost)

  handle_errors do
    res = ApiClient.request(issue_endpoint(use_localhost), :put,
                            issues_path("/#{URI.encode_www_form_component(number)}/status"),
                            body: body)
    puts "#{issue_label(res)}: status set to #{res['status']}"
    puts "  target app: #{target_app} (baseline #{baseline_version})" if has_app
    print_duplicate_link(res)
  end
end

# Record an ADDITIONAL fix url on an issue that has already shipped, without naming a
# status.
#
# This exists because `issues status` was the only door and taking it was destructive.
# `--status` is required there (see cmd_issues_status), so a session holding "this also
# shipped in PR #90" had two options and both lost something: a bare --comment, which
# records prose and no fix url, or `--status fixed --url ...`, which records the url and
# walks the issue BACKWARD if it had moved past `fixed`. On 2026-08-05 one sweep took the
# second option ten times in eleven seconds — three of Mike's verifications were destroyed
# and six issues had to be hand-walked forward (ISS-536). The two calls are one word apart
# and nothing warned about the difference.
#
# The url is what makes this worth a command of its own: it lands in the fix list that
# `issues show` and `issues reconcile` both read, where a sentence in a comment is
# invisible to either of them.
def cmd_issues_fix(args)
  rest, target_app, use_localhost = parse_common_flags(args)
  comment = nil
  url = nil
  baseline_version = nil
  leftover = []
  i = 0
  while i < rest.length
    case rest[i]
    when "--comment"
      comment = rest[i + 1]
      usage_exit("--comment requires a value", example: usage_for("issues fix")) if comment.nil?
      i += 2
    when "--url"
      url = rest[i + 1]
      usage_exit("--url requires a value", example: usage_for("issues fix")) if url.nil?
      i += 2
    when "--baseline-version"
      baseline_version = rest[i + 1]
      usage_exit("--baseline-version requires a value", example: usage_for("issues fix")) if baseline_version.nil?
      i += 2
    else
      leftover << rest[i]
      i += 1
    end
  end

  number = leftover.shift
  has_app = !(target_app.nil? || target_app.empty?)
  has_baseline = !(baseline_version.nil? || baseline_version.empty?)
  problems = []
  problems << "missing issue number (positional argument, e.g. 034)" if number.nil? || number.empty?
  problems << "unexpected argument(s): #{leftover.join(', ')}" unless leftover.empty?
  # The whole point of the command: there is no fix to record without one.
  problems << "--url is required (the merged PR, or a document describing the fix)" if url.nil? || url.empty?
  # Same deploy-detection pair as `issues status`: one without the other detects nothing.
  problems << "--app requires --baseline-version (the app's live release tag at fix time)" if has_app && !has_baseline
  problems << "--baseline-version requires --app (the deployable app the fix ships in)" if has_baseline && !has_app
  report_arg_problems("issues fix", problems, usage_for("issues fix"))

  body = { url: url }
  body[:comment] = comment if comment && !comment.empty?
  if has_app
    body[:app] = issue_app!(target_app)
    body[:baseline_version] = baseline_version
  end

  require_playbook_session!(use_localhost)

  handle_errors do
    res = ApiClient.request(issue_endpoint(use_localhost), :post,
                            issues_path("/#{URI.encode_www_form_component(number)}/fixes"),
                            body: body)
    puts "#{issue_label(res)}: fix recorded, status left at #{res['status']}"
    puts "  #{url}"
    puts "  target app: #{target_app} (baseline #{baseline_version})" if has_app
  end
end

# The `--app` value as the issues API will accept it, or exit naming the valid ones.
#
# deploy_tracked, not deployable: a fix can ship in an app (e.g. playbook-app) that has no
# pingable prod URL, and reconcile reads its live version from k8s. Intersected with
# ISSUE_APPS because the registry is the wider set — it tracks every deployable under
# ~/code, and naming one the `issue_app` enum does not have is a 422 from the server rather
# than a message from here.
def issue_app!(name)
  registry = Work::Registry.load
  app = registry.deploy_tracked.find { |a| a.name == name && ISSUE_APPS.include?(a.name) }
  unless app
    valid = registry.deploy_tracked.map(&:name).select { |n| ISSUE_APPS.include?(n) }.sort.join(", ")
    Util.exit_with_error("Unknown --app '#{name}'. Valid apps: #{valid}")
  end
  app.name
end

# The link as the server actually stored it, which is not always the number that was
# asked for: naming an issue that was itself absorbed links to ITS canonical instead,
# and saying so here is the only place that collapse is visible.
def print_duplicate_link(issue)
  canonical = issue_canonical(issue)
  return if canonical.nil?

  puts "  duplicate of ISS-#{canonical['number']}: #{canonical['title']}"
end

# Record (or drop) "this issue cannot be worked until that one has shipped".
#
# The one relationship in the tracker with teeth: `dev issues claim` and the
# autonomous lease runner both refuse to hand out an issue with a live blocker, so
# this is the difference between an ordering that holds and an ordering written in a
# comment nobody reads before claiming at 3am.
#
# Blocked-ness is DERIVED from the blocker's current status, so nothing here has to
# be undone: the issue becomes claimable on its own the moment its last blocker
# reaches fixed, deployed, verified or dismissed. --remove exists for the other
# case — the prerequisite turned out not to be one.
def cmd_issues_block(args)
  rest, _app, use_localhost = parse_common_flags(args)
  blocker = nil
  remove = false
  leftover = []
  i = 0
  while i < rest.length
    case rest[i]
    when "--on"
      blocker = rest[i + 1]
      usage_exit("--on requires an issue number", example: usage_for("issues block")) if blocker.nil?
      i += 2
    when "--remove"
      remove = true
      i += 1
    else
      leftover << rest[i]
      i += 1
    end
  end

  number = leftover.shift
  problems = []
  problems << "missing issue number (positional argument, e.g. 526)" if number.nil? || number.empty?
  problems << "unexpected argument(s): #{leftover.join(', ')}" unless leftover.empty?
  problems << "--on is required (the issue this one is blocked by, e.g. 521)" if blocker.nil? || blocker.empty?
  # Caught here as well as server-side so the mistake reads as a usage error rather
  # than a 422. A self-block is the one-hop case of a cycle: it would make the issue
  # permanently unclaimable with nothing able to clear it.
  if number && blocker && number.sub(/\A0+/, "") == blocker.sub(/\A0+/, "")
    problems << "an issue cannot block itself"
  end
  report_arg_problems("issues block", problems, usage_for("issues block"))

  require_playbook_session!(use_localhost)

  handle_errors do
    endpoint = issue_endpoint(use_localhost)
    path = issues_path("/#{URI.encode_www_form_component(number)}/blockers")
    res =
      if remove
        ApiClient.request(endpoint, :delete, "#{path}/#{URI.encode_www_form_component(blocker)}")
      else
        ApiClient.request(endpoint, :post, path, body: { issue_number: blocker })
      end

    if remove
      puts "#{issue_label(res)} is no longer blocked by ISS-#{blocker}."
    else
      puts "#{issue_label(res)} is blocked by ISS-#{blocker}."
    end
    live = issue_blockers(res).reject { |b| ISSUE_UNBLOCKING_STATUSES.include?(b["status"]) }
    if live.empty?
      puts "  Claimable now — nothing it is waiting on is still open."
    else
      puts "  `dev issues claim` will not offer it until #{live.map { |b| issue_ref_label(b) }.join(', ')} ship#{live.length == 1 ? 's' : ''}."
    end
  end
end

# Record one issue as a duplicate of another. Sugar for
# `issues status <n> --status dismissed --duplicate-of <m>`, the same relationship
# `issues reopen` has to `issues status --status open`: one PUT, no read-modify-write,
# so there is nothing for a partial form to clobber.
#
# Exists because the link was previously recorded only in the prose of a dismissal
# comment (ISS-429 into ISS-427), which left the two records unconnected: the canonical
# issue did not know it had absorbed anything, and nothing could answer "what was
# dismissed into this".
def cmd_issues_duplicate(args)
  rest, _app, use_localhost = parse_common_flags(args)
  canonical = nil
  comment = nil
  leftover = []
  i = 0
  while i < rest.length
    case rest[i]
    when "--of"
      canonical = rest[i + 1]
      usage_exit("--of requires an issue number", example: usage_for("issues duplicate")) if canonical.nil?
      i += 2
    when "--comment"
      comment = rest[i + 1]
      usage_exit("--comment requires a value", example: usage_for("issues duplicate")) if comment.nil?
      i += 2
    else
      leftover << rest[i]
      i += 1
    end
  end

  number = leftover.shift
  problems = []
  problems << "missing issue number (positional argument, e.g. 429)" if number.nil? || number.empty?
  problems << "unexpected argument(s): #{leftover.join(', ')}" unless leftover.empty?
  problems << "--of is required (the issue this one duplicates, e.g. 427)" if canonical.nil? || canonical.empty?
  problems << "an issue cannot be a duplicate of itself" if number && canonical && number.sub(/\A0+/, "") == canonical.sub(/\A0+/, "")
  report_arg_problems("issues duplicate", problems, usage_for("issues duplicate"))

  require_playbook_session!(use_localhost)

  body = {
    status: "dismissed",
    duplicate_of_number: canonical,
    # Internal for the same reason every other write from this CLI is: an automated actor
    # writes notes to the team, never words put in front of the club that filed the issue.
    comment: comment && !comment.empty? ? comment : "Duplicate of ISS-#{canonical}.",
    visibility: "internal",
  }

  handle_errors do
    res = ApiClient.request(issue_endpoint(use_localhost), :put,
                            issues_path("/#{URI.encode_www_form_component(number)}/status"),
                            body: body)
    puts "#{issue_label(res)}: dismissed as a duplicate."
    print_duplicate_link(res)
    puts ""
    puts "The canonical issue now carries a note that it absorbed this one:"
    puts "  dev issues show #{(issue_canonical(res)&.fetch('number') || canonical).sub(/\A0+/, '')}"
  end
end

# Defer an issue (or wake it now). A snooze is orthogonal to status: the issue keeps
# its place in the lifecycle and simply stays out of the queue, the per-category claim,
# and the daily nudge until its wake time passes.
def cmd_issues_snooze(args)
  rest, _app, use_localhost = parse_common_flags(args)
  days = nil
  comment = nil
  wake = false
  leftover = []
  i = 0
  while i < rest.length
    a = rest[i]
    case a
    when "--days"
      days = rest[i + 1]
      usage_exit("--days requires a value", example: usage_for("issues snooze")) if days.nil?
      i += 2
    when "--comment"
      comment = rest[i + 1]
      usage_exit("--comment requires a value", example: usage_for("issues snooze")) if comment.nil?
      i += 2
    when "--wake"
      wake = true
      i += 1
    else
      leftover << a
      i += 1
    end
  end

  number = leftover.shift
  days_i = days && (Integer(days) rescue nil)
  problems = []
  problems << "missing issue number (positional argument, e.g. 034)" if number.nil? || number.empty?
  problems << "unexpected argument(s): #{leftover.join(', ')}" unless leftover.empty?
  problems << "pass --days N or --wake" if days.nil? && !wake
  problems << "--days and --wake are opposites — pass one" if days && wake
  problems << "--days must be an integer >= 1" if days && (days_i.nil? || days_i < 1)
  report_arg_problems("issues snooze", problems, usage_for("issues snooze"))

  require_playbook_session!(use_localhost)
  path = issues_path("/#{URI.encode_www_form_component(number)}/snooze")

  handle_errors do
    if wake
      res = ApiClient.request(issue_endpoint(use_localhost), :delete, path)
      puts "#{issue_label(res)}: snooze cleared; back in the queue"
    else
      until_iso = (Time.now + (days_i * 24 * 60 * 60)).utc.iso8601
      body = { snoozed_until: until_iso }
      body[:comment] = comment if comment && !comment.empty?
      res = ApiClient.request(issue_endpoint(use_localhost), :put, path, body: body)
      puts "#{issue_label(res)}: snoozed until #{res['snoozed_until']} (status #{res['status']} unchanged)"
    end
  end
end

# The deploy-detection info this issue's deploy pass watches: the most recent fix that
# CARRIES one, or nil when no fix does (a document fix, or an adopted fix whose repo
# could not be named — see issue_fix_repo).
#
# The most recent one carrying a deployment, not simply the last fix. Recording an
# additional fix no longer implies a status change (`dev issues fix`, ISS-536), so an
# issue at `fixed` legitimately accumulates later fixes with no app — a devops PR that
# releases nothing, a document beside the code fix. Reading the last row would answer
# "no app recorded" for an issue whose real, watchable fix sits one row above, and the
# no-app branch's shortcut ("devops releases nothing, so the merge is the release")
# would then call the whole issue live before its app shipped. That mirrors
# IssueDeployReconciler.watchedFix, deliberately: the two run the same decision.
def issue_fix_deployment(issue)
  (issue["fixes"] || []).reverse.find { |f| f["deployment"] }&.fetch("deployment", nil)
end

# Every repo this issue's fixes shipped from, parsed out of their PR urls, oldest first
# and deduped; a fix that is not a PR (a document link) contributes nothing. Repo-keyed
# rather than app-keyed on purpose: the registry answers "does this repo release
# anything?" by repo_name, and the same parse-the-url technique already keys the
# changelog's ISS map.
def issue_fix_repos(issue)
  (issue["fixes"] || []).filter_map do |fix|
    m = fix["url"].to_s.match(%r{\Ahttps://github\.com/[^/]+/([^/]+)/pull/\d+})
    m && m[1]
  end.uniq
end

# The repo the most recent fix shipped from — what a one-line explanation names.
def issue_fix_repo(issue)
  issue_fix_repos(issue).last
end

# ---------- claimed -> fixed, adopted from merged PRs ----------
#
# `claimed -> fixed` is the one transition in the issue lifecycle with no
# automation behind it: a human or a Claude fix session is supposed to call
# `dev issues status <n> --status fixed` at PR time. When that is missed the issue
# is not merely late, it is INVISIBLE — every downstream automation (this
# command's deploy pass, the platform's hourly IssueDeployReconciler, the 7-day
# auto-verify) starts from `fixed`, so a claimed issue never reaches `deployed`
# ("awaiting verification") no matter how many releases ship its fix. Twelve
# issues sat that way on 2026-07-30 and had to be walked forward by hand.
#
# The backstop needs no one to remember anything: the PR title carries
# `ISS-<number>` (CLAUDE.md requires the prefix), so the merge itself says which
# issue shipped. Adopting at MERGE rather than at PR-open is also the more correct
# signal — an abandoned PR never advances its issue.

# The owner every repo a fix can ship from lives under.
ISSUE_PR_SEARCH_OWNER = "mbryzek".freeze

# How many merged PRs the sweep considers, newest first. The org merges a handful
# a day and a claimed issue turns over in days, so this is generous by an order of
# magnitude — and it is one search call, not one per claimed issue.
ISSUE_PR_SEARCH_LIMIT = 200

# Every issue number named in a PR title: "Fix hover + labels (ISS-095, ISS-096)"
# -> ["095", "096"]. Matched in the zero-padded display form CLAUDE.md requires and
# the API keys on, so no normalization can drift between the two.
def issue_numbers_in_title(title)
  title.to_s.scan(/\bISS-(\d{3,})\b/).flatten.uniq
end

# Merged PRs across the org whose title names an issue, grouped by issue number and
# newest merge first within each. For a merged PR, closedAt IS the merge time.
#
# Returns {} when `gh` is missing, unauthenticated, or the search fails. This runs
# at the tail of every release: GitHub being unreachable costs a warning, never a
# release. Fail-closed — an empty result adopts nothing rather than guessing.
def issue_merged_prs_by_number(limit: ISSUE_PR_SEARCH_LIMIT)
  out, status = Open3.capture2(
    "gh", "search", "prs", "--owner", ISSUE_PR_SEARCH_OWNER, "--merged",
    "--match", "title", "ISS-", "--sort", "created", "--order", "desc",
    "--limit", limit.to_s, "--json", "number,title,url,repository,closedAt"
  )
  unless status.success?
    warn "issues reconcile: `gh search prs` failed; skipping the merged-PR sweep"
    return {}
  end
  by_number = Hash.new { |h, k| h[k] = [] }
  JSON.parse(out).each do |pr|
    entry = {
      "repo" => pr.dig("repository", "name"),
      "number" => pr["number"],
      "url" => pr["url"],
      "title" => pr["title"],
      "merged_at" => pr["closedAt"],
    }
    issue_numbers_in_title(pr["title"]).each { |n| by_number[n] << entry }
  end
  by_number.each_value { |prs| prs.sort_by! { |pr| pr["merged_at"].to_s }.reverse! }
  by_number
rescue Errno::ENOENT
  warn "issues reconcile: `gh` not found; skipping the merged-PR sweep"
  {}
rescue JSON::ParserError => e
  warn "issues reconcile: could not read `gh search prs` output (#{e}); skipping the merged-PR sweep"
  {}
end

def issue_pr_label(pr)
  "#{pr['repo']}##{pr['number']}"
end

# The merged PR that most recently landed for a claimed issue, or nil when none
# has. Only merges AFTER the claim count: a reopened issue accumulates PRs, and the
# one that shipped the previous round says nothing about the round in flight now.
# An issue with no claimed_at (filed before the field existed) takes any merge.
def issue_adoptable_pr(issue, prs_by_number)
  claimed_at = issue_parse_time(issue["claimed_at"])
  (prs_by_number[issue["number"]] || []).find do |pr|
    next true if claimed_at.nil?
    merged_at = issue_parse_time(pr["merged_at"])
    !merged_at.nil? && merged_at > claimed_at
  end
end

def issue_parse_time(value)
  value.nil? ? nil : Time.parse(value)
rescue ArgumentError
  nil
end

# The apps an issue is allowed to name, mirroring the `issue_app` enum in
# platform's spec/issues.json. This is NOT the deploy registry: the registry tracks
# every deployable under ~/code (acumen, rallyd, hoa-frontend, apibuilder-ui, ...),
# while an issue can only name a playbook deployable. Sending any other name is a
# 422 — so the intersection is what makes the sweep's writes valid.
ISSUE_APPS = %w[platform playbook-admin playbook-app playbook-www workers].freeze

# The deployable a repo releases AND an issue can name, or nil. Keyed on repo_name
# rather than name because a deployable can be renamed ahead of its repo
# (reference_deployable_name_is_not_the_repo_name).
def issue_app_for_repo(registry, repo)
  registry.deploy_tracked.find { |a| a.repo_name == repo && ISSUE_APPS.include?(a.name) }
end

# True when nothing will ever release this repo: it ships no deployable at all
# (devops, lib-*, schema-evolution-manager), so the merge IS the release and the
# issue can go straight to `deployed` — the state that means "awaiting
# verification".
#
# Deliberately NOT true of a deployable the tracker simply cannot name (acumen,
# rallyd): those really do release, so calling a merge "live" would be a claim the
# auto-verifier then acts on. Those land `fixed` and the deploy pass lists them for
# a human, which is the honest answer until `issue_app` learns about them.
def issue_repo_releases_nothing?(registry, repo)
  registry.deploy_tracked.none? { |a| a.repo_name == repo }
end

# The fix payload for adopting `pr`: always the PR url, plus the (app,
# baseline_version) pair when the repo maps to a deployable whose live version we
# can actually read. The baseline is the version live RIGHT NOW, not at merge time —
# conservative in the only direction that matters, since a too-high baseline delays
# the deployed transition by a release instead of declaring a fix live early.
def issue_adoption_body(registry, version_cache, pr)
  body = { status: "fixed", url: pr["url"] }
  app = issue_app_for_repo(registry, pr["repo"])
  return body if app.nil?
  info = version_cache[app.name] ||= fetch_app_version(registry, app)
  return body if info[:error] || info["version"].nil?
  body.merge(app: app.name, baseline_version: info["version"])
end

def issue_adoption_note(body, pr, merge_is_release)
  return "#{issue_pr_label(pr)} merged (#{body[:app]} baseline #{body[:baseline_version]})" if body[:app]
  if merge_is_release
    "#{issue_pr_label(pr)} merged; #{pr['repo']} releases nothing, so the merge is the release"
  else
    "#{issue_pr_label(pr)} merged; no issue app for #{pr['repo']} — advance once it releases"
  end
end

# Tail line for the adoption pass, or nil when it adopted nothing. Same rule as
# issues_reconcile_summary: counts are only news when something moved.
def issues_adopt_summary(adopted:, apply:)
  return nil if adopted.zero?
  "#{adopted} #{apply ? 'adopted' : 'would adopt'} from merged PRs."
end

# Tail line for `dev issues reconcile`, or nil when there is nothing worth
# summarizing. Counts are only news when something actually moved: with no
# transitions the per-issue lines above already say everything, and a
# "0 deployed, N skipped" line just pads the release output.
def issues_reconcile_summary(deployed:, skipped:, total:, apply:)
  return nil if deployed.zero?
  "#{deployed} #{apply ? 'deployed' : 'would deploy'}, #{skipped} skipped, #{total} fixed total."
end

# Adopt every claimed issue whose fix has already merged as `fixed`, and return how
# many were adopted. Runs BEFORE the deploy pass so an issue rescued here is
# considered for `deployed` in the same sweep rather than waiting for the next one.
#
# Silent on the zero state, like the deploy pass: this is release output, and
# "nothing to adopt" is the normal case between misses.
def issues_adopt_merged_prs(endpoint:, registry:, version_cache:, apply:)
  claimed = ApiClient.request(endpoint, :get, issues_list_path(statuses: "claimed")) || []
  return 0 if claimed.empty?

  prs_by_number = issue_merged_prs_by_number
  return 0 if prs_by_number.empty?

  adoptable = claimed.filter_map do |issue|
    pr = issue_adoptable_pr(issue, prs_by_number)
    [issue, pr] if pr
  end
  return 0 if adoptable.empty?

  puts ""
  puts "Claimed issues whose fix already merged (adopt as fixed):"
  adoptable.each do |issue, pr|
    body = issue_adoption_body(registry, version_cache, pr)
    merge_is_release = issue_repo_releases_nothing?(registry, pr["repo"])
    note = issue_adoption_note(body, pr, merge_is_release)
    landing = merge_is_release ? "deployed" : "fixed"
    if apply
      path = issues_path("/#{URI.encode_www_form_component(issue['number'])}/status")
      # `fixed` first even when the destination is `deployed`: the url (and with it
      # the recorded fix) is only meaningful on the fixed transition, and the
      # timeline should read as the two facts it is — this PR fixed it, and there is
      # no release to wait for.
      ApiClient.request(endpoint, :put, path,
                        body: body.merge(comment: "#{note}.", visibility: "internal"))
      if merge_is_release
        ApiClient.request(endpoint, :put, path,
                          body: { status: "deployed", visibility: "internal",
                                  comment: "No release to wait for; awaiting verification." })
      end
      puts "  #{landing.ljust(8)} #{issue_link(issue)} <- #{note}"
    else
      puts "  would #{merge_is_release ? 'deploy' : 'fix'} #{issue_link(issue)} <- #{note}"
    end
  end
  adoptable.length
end

# Two passes over the issue tracker, both keyed on facts nobody has to remember:
# claimed issues whose PR has merged become `fixed`, then `fixed` issues whose
# target app has released past the fix become `deployed`. Read-only against GitHub
# and the deploy registry (the same live-version signal `dev deploy status` uses) —
# the release pipeline is never touched. Dry-run by default; --apply records the
# transitions.
def cmd_issues_reconcile(args)
  rest, _app, use_localhost = parse_common_flags(args)
  apply = false
  leftover = []
  rest.each { |a| a == "--apply" ? (apply = true) : leftover << a }
  reject_unknown_args("issues reconcile", leftover)
  require_playbook_session!(use_localhost)

  registry = Work::Registry.load
  version_cache = {}

  handle_errors do
    endpoint = issue_endpoint(use_localhost)

    adopted = issues_adopt_merged_prs(endpoint: endpoint, registry: registry,
                                      version_cache: version_cache, apply: apply)
    adopt_summary = issues_adopt_summary(adopted: adopted, apply: apply)
    if adopt_summary
      puts ""
      puts adopt_summary
    end

    # Read AFTER the adoption pass so anything just rescued is evaluated for deploy
    # in this same run.
    fixed = ApiClient.request(endpoint, :get, issues_list_path(statuses: "fixed")) || []
    # Silent on the zero state. This runs after every release, where "nothing to
    # do" is the common case and a "nothing to do" line is pure noise. `dev issues
    # list --status fixed` is the human-facing view.
    if fixed.empty?
      puts "Re-run with --apply to record the transitions." if !apply && adopted > 0
      return
    end

    puts ""
    puts "Fixed issues awaiting deploy (advance to deployed once their app has released):"

    deployed = 0
    skipped = 0
    fixed.each do |c|
      deployment = issue_fix_deployment(c)
      if deployment.nil?
        # No app recorded. Two very different reasons land here, and only the registry
        # tells them apart — which is exactly why the platform never guesses.
        # `issue_app` names five apps while the registry tracks about twenty
        # deployables, so a fix with no app is either a repo that releases
        # nothing (devops, schema-evolution-manager — the merge IS the release) or a
        # deployable the tracker has no enum value for (acumen, rallyd, lib-* — which
        # really do release, so calling the merge "live" would be a claim the
        # auto-verifier acts on). Promote only the first kind.
        # EVERY repo the issue shipped from has to release nothing, not just the last
        # one: an issue fixed across a devops PR and an acumen PR is not live because
        # devops releases nothing (ISS-536 made multi-PR issues ordinary here).
        repos = issue_fix_repos(c)
        releasing = repos.reject { |r| issue_repo_releases_nothing?(registry, r) }
        phrase = "#{repos.join(' and ')} #{repos.length == 1 ? 'releases' : 'release'} nothing"
        if repos.any? && releasing.empty?
          if apply
            ApiClient.request(endpoint, :put, issues_path("/#{URI.encode_www_form_component(c['number'])}/status"),
                              body: { status: "deployed", visibility: "internal",
                                      comment: "#{phrase}, so the merge is the release; awaiting verification." })
            puts "  deployed #{issue_link(c)}: #{phrase}"
          else
            puts "  would deploy #{issue_link(c)}: #{phrase}"
          end
          deployed += 1
        else
          reason =
            if releasing.any?
              "#{releasing.join(', ')} releases, but no app was recorded — advance once it ships"
            else
              "document fix — advance manually"
            end
          puts "  skip #{issue_link(c)}: #{reason}"
          skipped += 1
        end
        next
      end
      app_name = deployment["app"]
      info = version_cache[app_name] ||= begin
        app = registry.deploy_tracked.find { |a| a.name == app_name }
        app ? fetch_app_version(registry, app) : { error: "unknown app '#{app_name}'" }
      end
      if info[:error]
        puts "  skip #{issue_link(c)} (#{app_name}): #{info[:error]}"
        skipped += 1
        next
      end

      live = info["version"]
      if issue_released_since_fix?(info, c)
        if apply
          ApiClient.request(endpoint, :put,
                            issues_path("/#{URI.encode_www_form_component(c['number'])}/status"),
                            body: { status: "deployed", comment: "Deployed in #{app_name} #{live}" })
          puts "  deployed #{issue_link(c)} (#{app_name}: #{deployment['baseline_version'] || '?'} -> #{live})"
        else
          puts "  would deploy #{issue_link(c)} (#{app_name}: #{deployment['baseline_version'] || '?'} -> #{live})"
        end
        deployed += 1
      else
        puts "  waiting  #{issue_link(c)} (#{app_name}: still #{live})"
      end
    end

    summary = issues_reconcile_summary(deployed: deployed, skipped: skipped, total: fixed.length, apply: apply)
    if summary
      puts ""
      puts summary
    end
    puts "Re-run with --apply to record the transitions." if !apply && (deployed + adopted) > 0
  end
end

# True when the target app has released since the fix was recorded. Primary signal:
# release timestamp is newer than fixed_at (can't false-positive on a later tag that
# predates the fix). Falls back to "live tag differs from the fix-time baseline" when a
# timestamp is missing or unparseable.
def issue_released_since_fix?(info, issue)
  released_at = info["released_at"]
  fixed_at = issue["fixed_at"]
  if released_at && fixed_at
    begin
      return Time.parse(released_at) > Time.parse(fixed_at)
    rescue ArgumentError
      # fall through to tag comparison
    end
  end
  baseline = issue_fix_deployment(issue)&.fetch("baseline_version", nil)
  live = info["version"]
  !baseline.nil? && !live.nil? && live != baseline
end

# ---------- features ----------
#
# Feature-flag cleanup. Removing a flag is a two-phase change: the code stops
# reading it, then its tenant_features row goes away. Deleting the row while the
# old code is still serving flips the behavior back for real users, so the row
# waits here until every app carrying the removal has released past the version
# production was running when it merged.
#
# The readiness decision lives in this CLI, not the backend: it needs the live
# version signal (/_internal_/version, or the k8s image tag) that `dev deploy
# status` reads, and the backend has no business reaching for kubectl. The API
# only records that a cleanup is outstanding and performs the transitions asked
# of it.

FEATURE_REMOVALS_PATH = "/dev/feature-removals".freeze

# A month of soft-deleted life is the rollback window; the purge sweep runs after
# it. Matches the window the feature_removals_must_be_purged_after_the_rollback_window
# invariant watches, which allows a grace period on top of this.
FEATURE_PURGE_AFTER_DAYS = 30

def feature_removal_path(removal, suffix = "")
  subproject = URI.encode_www_form_component(removal["subproject"].to_s)
  feature = URI.encode_www_form_component(removal["feature"].to_s)
  "#{FEATURE_REMOVALS_PATH}/#{subproject}/#{feature}#{suffix}"
end

def feature_label(removal)
  "#{removal['subproject']}/#{removal['feature']}"
end

# Live version per app, memoized for the run. Shares fetch_app_version with
# `dev issues reconcile`, so both commands gate on exactly the same signal.
def feature_version_info(registry, cache, app_name)
  cache[app_name] ||= begin
    app = registry.deploy_tracked.find { |a| a.name == app_name }
    app ? fetch_app_version(registry, app) : { error: "unknown app '#{app_name}'" }
  end
end

# Whether one (app, baseline_version) pair has cleared. Primary signal is the
# release timestamp: production released after the removal was recorded. Falls
# back to "the live tag is no longer the baseline" when a timestamp is missing.
#
# Unconfirmable is NOT confirmed: a missing probe, an unknown app, or an app that
# has not released leaves the pair pending. Silence must never advance a cleanup —
# the whole point is to avoid deleting a flag row before its removal is live.
def feature_pair_confirmed?(info, pair, created_at)
  return false if info.nil? || info[:error]
  live = info["version"]
  return false if live.nil?

  released_at = info["released_at"]
  if released_at && created_at
    begin
      return Time.parse(released_at) > Time.parse(created_at)
    rescue ArgumentError
      # fall through to tag comparison
    end
  end
  baseline = pair["baseline_version"]
  !baseline.nil? && live != baseline
end

# Per-pair readiness, plus a human explanation for the ones still waiting.
def feature_removal_state(registry, cache, removal)
  pairs = removal["apps"] || []
  results = pairs.map do |pair|
    info = feature_version_info(registry, cache, pair["app"])
    confirmed = feature_pair_confirmed?(info, pair, removal["created_at"])
    detail =
      if info && info[:error]
        "#{pair['app']}: #{info[:error]}"
      else
        live = info && info["version"] ? info["version"] : "?"
        "#{pair['app']}: #{pair['baseline_version']} -> #{live}"
      end
    { confirmed: confirmed, detail: detail }
  end
  # A removal with no pairs would be vacuously ready. The API rejects that at
  # creation; treating it as not-ready here too means even a hand-inserted row
  # cannot trip the deletion.
  { ready: !results.empty? && results.all? { |r| r[:confirmed] }, pairs: results }
end

# Retire a flag: record that its code is gone and its row is awaiting cleanup.
# Baselines are resolved from what production is
# running RIGHT NOW rather than taken as arguments: the baseline is a floor
# ("prod was here when the removal merged"), so reading it is more reliable than
# asking a session to type it, and it is the same signal reconcile later compares
# against. An app whose version cannot be read is a hard error — a removal
# recorded against an unknown baseline could never be confirmed.
# Flags for `features retire`. Deliberately NOT parse_common_flags: that helper
# treats --app as a single filter and swallows repeats, so a removal spanning two
# apps would arrive here with an empty list and be rejected as having none.
# `changelog` rolls its own parser for the same reason.
def features_retire_parse_flags(args)
  apps = []
  use_localhost = false
  positional = []
  i = 0
  while i < args.length
    a = args[i]
    case a
    when "--app"
      v = args[i + 1]
      usage_exit("--app requires a value", example: usage_for("features retire")) if v.nil?
      apps << v
      i += 2
    when "--localhost"
      use_localhost = true
      i += 1
    when "-h", "--help"
      usage_exit
    else
      positional << a
      i += 1
    end
  end
  { apps: apps, use_localhost: use_localhost, positional: positional }
end

# Retire a flag: record that its code is gone and its row is awaiting cleanup.
# Baselines are resolved from what production is
# running RIGHT NOW rather than taken as arguments: the baseline is a floor
# ("prod was here when the removal merged"), so reading it is more reliable than
# asking a session to type it, and it is the same signal reconcile later compares
# against. An app whose version cannot be read is a hard error — a removal
# recorded against an unknown baseline could never be confirmed.
def cmd_features_retire(args)
  flags = features_retire_parse_flags(args)
  apps = flags[:apps]
  positional = flags[:positional]
  subproject = positional.shift
  feature = positional.shift
  reject_unknown_args("features retire", positional)

  problems = []
  problems << "features retire requires <subproject> <feature>" if subproject.nil? || feature.nil?
  # Without at least one app, "every app has released" is vacuously true and the
  # first reconcile would delete the flag row immediately.
  problems << "at least one --app is required (the deployable app(s) carrying the removal)" if apps.empty?
  problems << "each --app may be given only once" if apps.uniq.length != apps.length
  report_arg_problems("features retire", problems, usage_for("features retire"))

  registry = Work::Registry.load
  known = registry.deploy_tracked.map(&:name)
  unknown_apps = apps.reject { |a| known.include?(a) }
  unless unknown_apps.empty?
    Util.exit_with_error("Unknown --app #{unknown_apps.map { |a| "'#{a}'" }.join(', ')}. " \
                         "Valid apps: #{known.sort.join(', ')}")
  end

  cache = {}
  pairs = apps.map do |name|
    info = feature_version_info(registry, cache, name)
    if info.nil? || info[:error] || info["version"].nil?
      reason = info && info[:error] ? info[:error] : "no live version available"
      Util.exit_with_error("Cannot read the live version for '#{name}': #{reason}. " \
                           "A removal needs a baseline it can later be compared against.")
    end
    { app: name, baseline_version: info["version"] }
  end

  endpoint = platform_endpoint(flags[:use_localhost])
  handle_errors do
    ApiClient.request(endpoint, :post, FEATURE_REMOVALS_PATH,
                      body: { subproject: subproject, feature: feature, apps: pairs })
    puts "Recorded #{subproject}/#{feature} for cleanup:"
    pairs.each { |p| puts "  #{p[:app]} baseline #{p[:baseline_version]}" }
    puts ""
    puts "The flag row stays live until every app releases past its baseline."
    puts "Check with `dev features status`; `dev features reconcile --apply` performs the cleanup."
  end
end

def cmd_features_list(args)
  rest, _app, use_localhost = parse_common_flags(args)
  reject_unknown_args("features list", rest)

  endpoint = platform_endpoint(use_localhost)
  handle_errors do
    flags = ApiClient.request(endpoint, :get, "/dev/features") || []
    removals = ApiClient.request(endpoint, :get, "#{FEATURE_REMOVALS_PATH}?processed=false&limit=100") || []

    puts ""
    puts Util.underline("Feature Flags#{use_localhost ? ' (localhost)' : ''}")
    puts ""
    if flags.empty?
      puts "No feature flags in the catalog."
    else
      flags.sort_by { |f| [f["subproject"].to_s, f["feature"].to_s] }.each do |f|
        state = f["enabled"] ? "on " : "off"
        roles = (f["roles"] || []).empty? ? "" : " roles=#{f['roles'].join(',')}"
        last = f["last_enabled_at"] ? " last_enabled=#{f['last_enabled_at'][0, 10]}" : ""
        puts "  [#{state}] #{f['subproject']}/#{f['feature']} (#{f['type']})#{roles}#{last}"
      end
    end

    # Removals name features the catalog no longer declares, so they can never
    # appear in the listing above — they are shown here or nowhere.
    unless removals.empty?
      puts ""
      puts "Awaiting cleanup (#{removals.length}): run `dev features status` for readiness."
      removals.each { |r| puts "  #{feature_label(r)} (recorded #{r['created_at'][0, 10]})" }
    end
  end
end

def cmd_features_status(args)
  rest, _app, use_localhost = parse_common_flags(args)
  reject_unknown_args("features status", rest)

  endpoint = platform_endpoint(use_localhost)
  registry = Work::Registry.load
  cache = {}

  handle_errors do
    removals = ApiClient.request(endpoint, :get, "#{FEATURE_REMOVALS_PATH}?processed=false&limit=100") || []
    puts ""
    puts Util.underline("Feature Removals#{use_localhost ? ' (localhost)' : ''}")
    puts ""
    if removals.empty?
      puts "No feature removals awaiting cleanup."
      return
    end

    removals.each do |r|
      state = feature_removal_state(registry, cache, r)
      puts "#{state[:ready] ? 'READY  ' : 'waiting'} #{feature_label(r)} (recorded #{r['created_at'][0, 10]})"
      state[:pairs].each { |p| puts "         #{p[:confirmed] ? 'ok      ' : 'pending '} #{p[:detail]}" }
    end
    puts ""
    ready = removals.count { |r| feature_removal_state(registry, cache, r)[:ready] }
    puts "#{ready} of #{removals.length} ready. Run `dev features reconcile --apply` to process."
  end
end

# Tail line for `dev features reconcile`, or nil when nothing moved. Same rule as
# issues_reconcile_summary: with no processing and no purging the per-removal
# "waiting" lines already carry the state, so the counts are noise.
def features_reconcile_summary(processed:, purged:, outstanding:, apply:)
  return nil if processed.zero? && purged.zero?
  verb = apply ? "processed" : "would process"
  "#{processed} #{verb}, #{purged} #{apply ? 'purged' : 'would purge'}, #{outstanding} outstanding."
end

def cmd_features_reconcile(args)
  rest, _app, use_localhost = parse_common_flags(args)
  apply = false
  leftover = []
  rest.each { |a| a == "--apply" ? (apply = true) : leftover << a }
  reject_unknown_args("features reconcile", leftover)

  endpoint = platform_endpoint(use_localhost)
  registry = Work::Registry.load
  cache = {}

  handle_errors do
    outstanding = ApiClient.request(endpoint, :get, "#{FEATURE_REMOVALS_PATH}?processed=false&limit=100") || []
    # Buffered so the section header is only printed when there is something under
    # it. Between releases there usually is not, and a header over a "0 processed,
    # 0 purged, 0 outstanding" line is the whole section saying nothing.
    lines = []
    processed_count = 0
    outstanding.each do |r|
      state = feature_removal_state(registry, cache, r)
      unless state[:ready]
        waiting = state[:pairs].reject { |p| p[:confirmed] }.map { |p| p[:detail] }.join("; ")
        lines << "  waiting  #{feature_label(r)} (#{waiting})"
        next
      end
      if apply
        ApiClient.request(endpoint, :post, feature_removal_path(r, "/process"))
        lines << "  processed #{feature_label(r)} (flag row soft deleted)"
      else
        lines << "  would process #{feature_label(r)}"
      end
      processed_count += 1
    end

    # Purge sweep: hard delete flag rows whose rollback window has closed. Folded
    # into reconcile so one cron entry covers the whole lifecycle.
    purged_count = 0
    done = ApiClient.request(endpoint, :get, "#{FEATURE_REMOVALS_PATH}?processed=true&limit=100") || []
    cutoff = Time.now - (FEATURE_PURGE_AFTER_DAYS * 24 * 60 * 60)
    done.each do |r|
      next if r["purged_at"]
      next if r["processed_at"].nil?
      begin
        next if Time.parse(r["processed_at"]) > cutoff
      rescue ArgumentError
        next
      end
      if apply
        ApiClient.request(endpoint, :post, feature_removal_path(r, "/purge"))
        lines << "  purged #{feature_label(r)} (rollback window closed)"
      else
        lines << "  would purge #{feature_label(r)}"
      end
      purged_count += 1
    end

    return if lines.empty?

    puts ""
    puts "Feature-flag removals awaiting cleanup (process once every app is past the flag, then purge):"
    lines.each { |l| puts l }
    summary = features_reconcile_summary(processed: processed_count, purged: purged_count,
                                         outstanding: outstanding.length, apply: apply)
    if summary
      puts ""
      puts summary
    end
    if !apply && (processed_count > 0 || purged_count > 0)
      puts "Re-run with --apply to record the changes."
    end
  end
end

def cmd_features_cancel(args)
  rest, _app, use_localhost = parse_common_flags(args)
  subproject = rest.shift
  feature = rest.shift
  reject_unknown_args("features cancel", rest)
  if subproject.nil? || feature.nil?
    usage_exit("features cancel requires <subproject> <feature>", example: usage_for("features cancel"))
  end

  endpoint = platform_endpoint(use_localhost)
  handle_errors do
    ApiClient.request(endpoint, :delete, feature_removal_path({ "subproject" => subproject, "feature" => feature }))
    puts "Cancelled the removal for #{subproject}/#{feature}; a soft-deleted flag row has been restored."
  end
end

# ---------- scratch workdirs ----------
#
# `dev codegen sync` and `dev browserslist update` clone every repo into a
# timestamped throwaway dir: `~/code/ai/cgs.<run_id>` (see CODEGEN_WORKDIR_ROOT
# for why codegen's has to live under ~/code/ai) and `~/code/browserslist.<date>`.
# Each clone drags in its own node_modules — one sweep is ~2-3 GB, largely
# duplicated 112 MB `workerd` binaries — and nothing ever removed them, so by
# 2026-07-30 twenty-eight abandoned sweeps held ~48 GB.
#
# Every run now purges its own older siblings before it clones anything. These
# dirs are pure scratch: the clones are disposable, any real output is already
# pushed as a branch/PR, and the one consumed artifact (codegen-sync-status.json)
# is read out of the newest dir right after the run that wrote it. Purging FIRST
# rather than at the end leaves the current run's dir intact for that reader
# while still bounding disk use to roughly one run's worth.

CODE_ROOT = File.expand_path("~/code")

# A dir touched this recently may belong to a sweep that is still running, whose
# clones must not be deleted from under it. A sweep clones everything up front
# and then works inside the clones, so its top-level mtime can lag the run by a
# long while — hence hours, not minutes.
SCRATCH_ACTIVE_WINDOW_SECS = 3 * 60 * 60

def format_bytes(bytes)
  units = %w[B KB MB GB TB]
  i = 0
  size = bytes.to_f
  while size >= 1024 && i < units.length - 1
    size /= 1024
    i += 1
  end
  i.zero? ? "#{bytes} B" : format("%.1f %s", size, units[i])
end

# Apparent disk usage of `dir` in bytes, or 0 when `du` can't report it. Shelling
# out to du beats walking the tree in Ruby and matches what Finder reports.
def dir_size_bytes(dir)
  out, _err, status = Open3.capture3("du", "-sk", dir)
  return 0 unless status.success?
  out.split("\t").first.to_i * 1024
rescue Errno::ENOENT
  0
end

# Scratch dirs matching ~/code/<prefix>.* that are safe to delete: not `keep`
# (the current run's dir) and not modified inside the active window. `root` and
# `now` are injected by tests; callers use the defaults.
def stale_scratch_workdirs(prefix, keep: nil, root: CODE_ROOT, now: Time.now)
  cutoff = now - SCRATCH_ACTIVE_WINDOW_SECS
  keep = File.expand_path(keep) if keep
  Dir.glob(File.join(root, "#{prefix}.*"))
     .select { |p| File.directory?(p) && !File.symlink?(p) }
     .reject { |p| keep && File.expand_path(p) == keep }
     .reject { |p| File.mtime(p) > cutoff }
     .sort
end

# Deletes prior runs' scratch dirs and reports what it reclaimed. Called at the
# START of a sweep, before cloning, so a run always begins from a clean slate.
def purge_scratch_workdirs(prefix, keep: nil, root: CODE_ROOT)
  stale = stale_scratch_workdirs(prefix, keep: keep, root: root)
  return 0 if stale.empty?

  puts "Cleaning up #{stale.length} stale #{prefix}.* dir(s) from prior runs:"
  reclaimed = 0
  stale.each do |dir|
    bytes = dir_size_bytes(dir)
    FileUtils.rm_rf(dir)
    reclaimed += bytes
    puts "  removed #{File.basename(dir)} (#{format_bytes(bytes)})"
  end
  puts "Reclaimed #{format_bytes(reclaimed)}."
  puts ""
  reclaimed
end

# ---------- docker prune ----------
#
# The RECLAIMABLE column of `docker system df` answers a different question than
# "what will this run delete", and the difference is not small: it ignores the
# --days age filter entirely, and it counts every unused volume even though
# `docker volume prune` (since Docker 23) only removes ANONYMOUS ones unless -a
# is passed. On the box this was written for that gap was 7.49GB of named volumes
# advertised and never touched. So the dry-run below enumerates the actual
# candidates out of `docker system df -v` per step rather than quoting a summary
# table that promises what the commands don't do.

# Docker renders sizes with go-units HumanSize: decimal (1kB = 1000B), suffix
# B/kB/MB/GB/TB/PB. Binary suffixes (KiB) appear in some older output, so tolerate
# the "i" too.
#
# It also emits NEGATIVE sizes in scientific notation — "-9.61e+07B" — because an
# image's UniqueSize is derived as Size - SharedSize and goes negative when layers
# are shared more ways than that arithmetic assumes. 46 of 179 images on the box
# this was written for. A regex that only accepts [\d.] silently reads every one
# of them as zero, so the sign and exponent are parsed here and clamped at the
# point of aggregation instead.
DOCKER_SIZE_UNITS = { "B" => 1, "KB" => 10**3, "MB" => 10**6, "GB" => 10**9,
                      "TB" => 10**12, "PB" => 10**15 }.freeze

def docker_parse_size(str)
  m = /\A\s*(-?[\d.]+(?:[eE][+-]?\d+)?)\s*([kKMGTP]?i?B)\s*\z/.match(str.to_s) or return 0
  (m[1].to_f * DOCKER_SIZE_UNITS.fetch(m[2].delete("i").upcase, 1)).round
end

def docker_format_size(bytes)
  [["TB", 10**12], ["GB", 10**9], ["MB", 10**6], ["kB", 10**3]].each do |name, scale|
    return format("%.2f%s", bytes.to_f / scale, name) if bytes >= scale
  end
  "#{bytes}B"
end

# `docker system df -v` renders timestamps two ways: "2026-07-30 09:05:48 -0400 EDT"
# (images/containers/volumes) and "2026-05-12 03:12:25.566497 +0000 UTC" (build
# cache). Both carry a numeric offset ahead of the zone abbreviation, so parse up
# to the offset and drop the trailing name, which Time.parse reads inconsistently.
def docker_parse_time(str)
  m = /\A(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}(?:\.\d+)?) ([+-]\d{4})/.match(str.to_s) or return nil
  Time.parse("#{m[1]} #{m[2]}")
rescue ArgumentError
  nil
end

# An unparseable timestamp reads as "not old enough", so an object we can't date
# is left OUT of the estimate. This command's failure mode was over-promising;
# under-counting an oddity is the direction that keeps the number trustworthy.
def docker_older?(stamp, cutoff)
  t = docker_parse_time(stamp)
  !t.nil? && t < cutoff
end

# `docker container prune` skips anything running/paused/restarting, and its
# until filter compares CREATED time (not exit time).
DOCKER_LIVE_STATES = %w[running paused restarting].freeze

def docker_anonymous_volume?(volume)
  volume["Labels"].to_s.include?("com.docker.volume.anonymous")
end

# One build cache record, normalized. Two sources describe the same records with
# different schemas — `docker system df -v` says Shared as "true"/"false" where
# `docker buildx du` uses a real boolean — so everything downstream works on this
# shape instead of branching on which command it came from.
#
# No timestamp: the cache steps carry no age filter, so a record's age decides
# nothing. Only whether an image still shares its layers does.
DockerCacheRecord = Struct.new(:id, :shared, :bytes, keyword_init: true)

def docker_cache_record(raw)
  DockerCacheRecord.new(
    id: raw["ID"].to_s,
    shared: [true, "true"].include?(raw["Shared"]),
    bytes: docker_parse_size(raw["Size"])
  )
end

# Every buildx builder, not just the current one. `docker builder prune` only ever
# touches the current builder, so a docker-container builder like bryzek-multi
# accumulates cache that no prune reaches and that `docker system df` does not even
# report — 2,911 records / 5.28GB, invisible, on the box this was written for.
def docker_buildx_builders
  out, status = Open3.capture2("docker", "buildx", "ls", "--format", "json")
  return [] unless status.success?
  out.each_line.filter_map do |line|
    next if line.strip.empty?
    JSON.parse(line)["Name"] rescue nil
  end.compact.uniq
end

# nil (rather than []) when a builder cannot be read: the "default" builder rejects
# `buildx du` unless you switch context to it, and a builder we cannot inspect must
# be reported as skipped rather than silently shown as empty.
def docker_buildx_cache(builder)
  # capture2e, not capture2: the "default" builder answers `buildx du` with an
  # ERROR on stderr telling you to switch context, which would otherwise print
  # itself in the middle of the plan.
  out, status = Open3.capture2e("docker", "buildx", "du", "--builder", builder, "--format", "json")
  return nil unless status.success?
  out.each_line.filter_map do |line|
    next if line.strip.empty?
    raw = JSON.parse(line) rescue nil
    raw && docker_cache_record(raw)
  end
end

def docker_cache_by_builder
  docker_buildx_builders.each_with_object({}) do |name, h|
    records = docker_buildx_cache(name)
    h[name] = records unless records.nil? || records.empty?
  end
end

# Tags beyond the newest `keep` for each repository, regardless of age. Pruning by
# age alone never caps this: registry tags land faster than the window retires
# them, which is how 139 images / 45GB accumulated here. Images a container holds
# are off limits, and untagged ones belong to the age-based step.
def docker_surplus_tag_images(images, keep:)
  return [] if keep <= 0
  images.reject { |i| i["Containers"].to_i > 0 || i["Repository"].to_s == "<none>" }
        .group_by { |i| i["Repository"].to_s }
        .flat_map do |_repo, tagged|
          tagged.sort_by { |i| docker_parse_time(i["CreatedAt"]) || Time.at(0) }.reverse.drop(keep)
        end
end

# One prune step's candidates. `at_least` marks a byte total that is a lower
# bound rather than a figure to hold the command to.
DockerPruneStep = Struct.new(:label, :cmd, :unit, :count, :bytes, :at_least, :note,
                             keyword_init: true)

# Turn parsed `docker system df -v` JSON into the per-step candidate list, applying
# each step's own predicate — the same one the underlying docker command uses.
#
# Two totals are deliberately lower bounds. Images: UniqueSize omits layers shared
# with other images, which do free up once the last holder goes. Build cache:
# shared records are backed by layers an image still references, so they free
# nothing now — but the cache steps run FIRST, so those layers are already
# released by the time the image step is credited with what it frees.
#
# Step ORDER is deliberate and load-bearing for the numbers: build cache pins
# image layers, so pruning cache first means the image row reports image space
# instead of ~0. A run before this reordering showed 37 images freeing 18.54MB
# while the cache step that followed freed 20.55GB — the same bytes, attributed
# to whichever step happened to release them last.
def docker_prune_plan(df, cutoff:, filter:, cache_by_builder: {}, keep_named_volumes: false,
                      keep_tags: DOCKER_PRUNE_DEFAULT_KEEP_TAGS)
  containers = (df["Containers"] || [])
               .reject { |c| DOCKER_LIVE_STATES.include?(c["State"].to_s.downcase) }
               .select { |c| docker_older?(c["CreatedAt"], cutoff) }
  # Containers is "0" for unreferenced and "-1" when docker declined to compute it.
  all_images = df["Images"] || []
  images = all_images.select { |i| i["Containers"].to_i <= 0 && docker_older?(i["CreatedAt"], cutoff) }
  aged_ids = images.map { |i| i["ID"] }.to_set
  # Only the surplus the age step did not already claim, so the two rows never
  # bill the same image twice.
  surplus = docker_surplus_tag_images(all_images, keep: keep_tags)
            .reject { |i| aged_ids.include?(i["ID"]) }
  unused_volumes = (df["Volumes"] || []).select { |v| v["Links"].to_i.zero? }
  volumes = keep_named_volumes ? unused_volumes.select { |v| docker_anonymous_volume?(v) } : unused_volumes

  named_skipped = keep_named_volumes ? unused_volumes.length - volumes.length : 0
  volume_note = if keep_named_volumes
                  "anonymous only, no age filter" +
                    (named_skipped.zero? ? "" : "; #{named_skipped} named unused volume(s) left in place")
                else
                  "every unused volume, no age filter"
                end
  image_bytes = ->(list) { list.sum { |i| [docker_parse_size(i["UniqueSize"]), 0].max } }

  [
    DockerPruneStep.new(
      label: "containers", unit: "container", count: containers.length,
      cmd: ["docker", "container", "prune", "-f", "--filter", filter],
      bytes: containers.sum { |c| docker_parse_size(c["Size"]) }, at_least: false,
      note: "stopped, created before the cutoff; writable layers only"
    ),
    *docker_cache_steps(cache_by_builder),
    DockerPruneStep.new(
      label: "images", unit: "image", count: images.length,
      cmd: ["docker", "image", "prune", "-af", "--filter", filter],
      # Clamp: a negative UniqueSize is a docker accounting artifact, not disk
      # that comes back, and letting it subtract would understate the step.
      bytes: image_bytes.call(images), at_least: false,
      note: "unused and older than the cutoff"
    ),
    DockerPruneStep.new(
      label: "surplus tags", unit: "image", count: surplus.length,
      cmd: surplus.empty? ? nil : ["docker", "image", "rm", *surplus.map { |i| i["ID"] }],
      bytes: image_bytes.call(surplus), at_least: false,
      note: keep_tags.zero? ? "disabled (--keep-tags 0)" : "all but the #{keep_tags} newest tags per repository, any age"
    ),
    DockerPruneStep.new(
      label: "volumes", unit: "volume", count: volumes.length,
      # -a is what makes this reach named unused volumes; without it docker takes
      # anonymous ones only and the step is near-noop on a box full of named ones.
      cmd: ["docker", "volume", "prune", "-f", *(keep_named_volumes ? [] : ["-a"])],
      bytes: volumes.sum { |v| docker_parse_size(v["Size"]) }, at_least: false,
      note: volume_note
    ),
  ]
end

# One step per builder, with NO age filter — the same posture as volumes.
#
# An age filter on cache buys nothing and costs everything. A record it spares is
# usually an ancestor of a recent one, so buildkit selects it and then releases
# nothing: on this box `--filter until=72h` freed 9.2MB of a builder holding
# 5.27GB, and 0B of another holding 101GB. Meanwhile what the filter protects is
# reproducible — the first build after a full prune is cold, and that is the
# entire cost. Sizes remain lower bounds because a shared record's layers come
# back once the image sharing them is pruned later in the same run.
def docker_cache_steps(cache_by_builder)
  cache_by_builder.map do |builder, records|
    DockerPruneStep.new(
      label: "cache/#{builder}", unit: "record", count: records.length,
      cmd: ["docker", "buildx", "prune", "--builder", builder, "-af"],
      bytes: records.reject(&:shared).sum(&:bytes), at_least: true,
      note: "every record, no age filter; non-shared bytes only"
    )
  end
end

def docker_system_df_verbose
  out, status = Open3.capture2("docker", "system", "df", "-v", "--format", "json")
  abort("docker not available or daemon not running") unless status.success?
  JSON.parse(out)
rescue Errno::ENOENT
  abort("docker not available or daemon not running")
rescue JSON::ParserError => e
  abort("could not read `docker system df -v --format json`: #{e.message}")
end

# The tag sweep removes images by ID, so its command can carry a hundred sha256
# arguments — unreadable pasted into a terminal and useless as an explanation of
# what the step does. Summarize the tail instead of printing it.
# Every ordinary prune command fits inside this; only the ID list overruns it, so
# the readable commands stay readable and copy-pasteable.
DOCKER_CMD_DISPLAY_ARGS = 8

def docker_display_cmd(cmd)
  return "(nothing to remove)" if cmd.nil?
  return cmd.join(" ") if cmd.length <= DOCKER_CMD_DISPLAY_ARGS
  head = cmd.take(4).join(" ")
  "#{head} … (#{cmd.length - 4} more arg(s))"
end

def render_docker_prune_plan(steps)
  width = steps.map { |s| s.label.length }.max
  steps.each do |s|
    size = "#{s.at_least ? '>= ' : '   '}#{docker_format_size(s.bytes)}"
    objects = "#{s.count} #{s.unit}#{'s' unless s.count == 1}"
    puts format("  %-#{width}s  %-14s %10s   (%s)", s.label, objects, size, s.note)
  end
  total = steps.sum(&:bytes)
  prefix = steps.any?(&:at_least) ? ">= " : "   "
  puts format("  %-#{width}s  %-14s %10s", "total", "", "#{prefix}#{docker_format_size(total)}")
end

# Stream a prune step's output while collecting the total docker prints at the
# end — that figure is authoritative, unlike anything we can compute up front, so
# the run summary is built from docker's own numbers.
#
# Two spellings, because the build cache step is not the same program: container,
# image and volume prune print "Total reclaimed space: 1.2GB", while `docker
# builder prune` delegates to buildx, which prints a tab-separated "Total:\t0B".
# Matching only the first spelling silently reports every cache prune as 0B.
DOCKER_RECLAIMED_LINE = /^Total(?: reclaimed space)?:\s*(\S+)\s*$/

# reclaimed is nil, not 0, when the command prints no total at all: `docker image
# rm` reports Untagged/Deleted lines and nothing else, and calling that 0B would
# understate the run rather than admit the number is unavailable.
def run_docker_prune_step(cmd)
  reclaimed = nil
  IO.popen(cmd, err: [:child, :out]) do |io|
    io.each_line do |line|
      print line
      m = DOCKER_RECLAIMED_LINE.match(line)
      reclaimed = docker_parse_size(m[1]) if m
    end
  end
  [$?.success?, reclaimed]
end

DockerPruneOptions = Struct.new(:days, :apply, :keep_named_volumes, :keep_tags, keyword_init: true)

# Registry tags land faster than any age window retires them, so age alone never
# caps the image pile. Five per repository is enough to roll back a bad deploy
# locally; everything older re-pulls.
DOCKER_PRUNE_DEFAULT_KEEP_TAGS = 5

# Matches `aidirs prune`: 3 days, on the same reasoning that what this deletes is
# reproducible. An image re-pulls and a cache record rebuilds, so a short window
# costs a slow build, not work. Applies to containers and images only — build
# cache ignores age entirely (see docker_cache_steps).
DOCKER_PRUNE_DEFAULT_DAYS = 3

def parse_docker_prune_args(args)
  opts = DockerPruneOptions.new(days: DOCKER_PRUNE_DEFAULT_DAYS, apply: false, keep_named_volumes: false,
                                keep_tags: DOCKER_PRUNE_DEFAULT_KEEP_TAGS)
  while (arg = args.shift)
    case arg
    when "--days"
      raw = args.shift or usage_exit("--days requires a value", example: usage_for("docker prune"))
      opts.days = Integer(raw) rescue usage_exit("--days must be an integer", example: usage_for("docker prune"))
    when "--keep-tags"
      raw = args.shift or usage_exit("--keep-tags requires a value", example: usage_for("docker prune"))
      opts.keep_tags = Integer(raw) rescue usage_exit("--keep-tags must be an integer", example: usage_for("docker prune"))
    when "--apply" then opts.apply = true
    when "--keep-named-volumes" then opts.keep_named_volumes = true
    when "-h", "--help" then puts USAGE; exit 0
    else usage_exit("Unknown flag: #{arg}", example: usage_for("docker prune"))
    end
  end
  usage_exit("--days must be > 0", example: usage_for("docker prune")) if opts.days <= 0
  usage_exit("--keep-tags must be >= 0", example: usage_for("docker prune")) if opts.keep_tags.negative?
  opts
end

# ---------- depsguard ----------
#
# The whole command is Depsguard.run plus an exit code: the classification lives
# in lib/depsguard.rb so it can be unit-tested without a `depsguard` binary.
def cmd_depsguard_scan(args)
  if args.include?("-h") || args.include?("--help")
    puts USAGE
    exit 0
  end
  usage_exit("depsguard scan takes no arguments", example: usage_for("depsguard scan")) unless args.empty?
  result = Depsguard.run
  result.lines.each { |line| puts line }
  exit result.exit_code
end

def cmd_docker_prune(args)
  opts = parse_docker_prune_args(args)
  apply = opts.apply
  hours = opts.days * 24
  filter = "until=#{hours}h"
  now = Time.now

  puts "Pruning Docker resources older than #{opts.days} day(s) (filter: #{filter})."
  puts ""
  df = docker_system_df_verbose
  steps = docker_prune_plan(df, cutoff: now - hours * 3600, filter: filter,
                            cache_by_builder: docker_cache_by_builder,
                            keep_named_volumes: opts.keep_named_volumes, keep_tags: opts.keep_tags)

  puts apply ? "Removing:" : "Would remove (dry-run — pass --apply to do it):"
  render_docker_prune_plan(steps)

  unless apply
    puts ""
    puts "Commands --apply would run:"
    width = steps.map { |s| s.label.length }.max
    steps.each do |s|
      puts format("  %-#{width}s %s", s.label, docker_display_cmd(s.cmd))
    end
    return
  end

  reclaimed = {}
  steps.each do |step|
    next if step.cmd.nil?
    puts ""
    puts "==> #{step.label}: #{docker_display_cmd(step.cmd)}"
    ok, freed = run_docker_prune_step(step.cmd)
    unless ok
      # Report the failure to the briefing BEFORE aborting: this is the only
      # channel the job has, and the briefing shows a docker-prune line only when
      # it says ERROR. Aborting first would make a broken prune look like a
      # healthy silent one.
      Briefing.write("docker-prune-status.md", "Last run: #{Briefing.today} — ERROR: failed at step: #{step.label}")
      abort("FAILED at step: #{step.label}")
    end
    reclaimed[step.label] = freed
  end
  Briefing.write("docker-prune-status.md", "Last run: #{Briefing.today} — ok")
  return puts("\nNothing to remove.") if reclaimed.empty?

  puts ""
  puts "Reclaimed (docker's own totals):"
  width = reclaimed.keys.map(&:length).max
  reclaimed.each do |label, bytes|
    puts format("  %-#{width}s  %10s", label, bytes.nil? ? "not reported" : docker_format_size(bytes))
  end
  puts format("  %-#{width}s  %10s", "total", docker_format_size(reclaimed.values.compact.sum))
end

# ---------- prod version probes ----------

def fetch_version(url)
  uri = URI.parse("#{url}/_internal_/version")
  # Follow a few redirects: a registry-resolved domain may 301 to the
  # canonical host (e.g. playbook-admin) while still serving the endpoint there.
  3.times do
    http = Net::HTTP.new(uri.host, uri.port)
    http.use_ssl = (uri.scheme == "https")
    http.open_timeout = 5
    http.read_timeout = 10
    res = http.request(Net::HTTP::Get.new(uri.request_uri))
    if res.is_a?(Net::HTTPRedirection) && res["location"]
      uri = URI.join(uri.to_s, res["location"])
      next
    end
    return { error: "HTTP #{res.code}" } unless res.code.to_i.between?(200, 299)
    return { error: "empty body" } if res.body.nil? || res.body.empty?
    return JSON.parse(res.body)
  end
  { error: "too many redirects" }
rescue => e
  { error: e.message }
end

# For docker_k8s apps with no public ingress, read the live image tag straight
# from the cluster. The image tag is what's *actually* running and avoids
# requiring an HTTP /_internal_/version on internal-only services.
def fetch_k8s_version(app)
  ns = app.docker_k8s.namespace
  target = app.docker_k8s.rollout_target  # e.g. "statefulset/workers"
  image, status = Open3.capture2(
    "kubectl", "-n", ns, "get", target,
    "-o", "jsonpath={.spec.template.spec.containers[0].image}"
  )
  return { error: "kubectl get #{target}: failed" } unless status.success?
  image = image.strip
  return { error: "kubectl returned empty image" } if image.empty?
  # Tag is everything after the LAST ':' in the final path segment — this
  # avoids treating a registry port (host:5000/...) as the tag.
  last_segment = image.split("/").last
  tag = last_segment.include?(":") ? last_segment.split(":", 2)[1] : nil
  return { error: "image has no tag: #{image}" } if tag.nil? || tag.empty?

  # released_at = the current pod's start time. This approximates "when this
  # version went live" but advances on any pod restart (OOM kill, liveness
  # failure) — not strictly the deploy time. Good enough for the versions
  # command; we'd need a deploy annotation for a true deploy timestamp.
  started_at, _ = Open3.capture2(
    "kubectl", "-n", ns, "get", "pod",
    "-l", "app=#{app.name}",
    "-o", "jsonpath={.items[0].status.startTime}"
  )
  released_at = started_at.strip
  released_at = nil if released_at.empty?

  { "version" => tag, "released_at" => released_at }
rescue => e
  { error: e.message }
end

def fetch_app_version(registry, app)
  url = registry.prod_url(app)
  return fetch_version(url) if url
  return fetch_k8s_version(app) if app.docker_k8s
  { error: "no prod url or docker_k8s config" }
end

# ---------- deploy (fleet release state) ----------

def db_repo?(name)
  name.end_with?("-postgresql")
end

def lib_repo?(name)
  name.start_with?("lib-")
end

# The scala libraries, which release with `release-lib` to Maven Central rather
# than to a cluster. They are not in the apps registry, so the canonical list is
# the same one `dev dependencies` watches — one definition of "our libs".
def lib_repos
  Dependencies::Updates::APPS.keys.select { |n| lib_repo?(n) }
end

# devops itself. Nothing builds or ships it: the checkout at ~/code/devops IS
# the deployment, so "release" is a `git pull` and the version is a commit sha
# rather than a tag (the repo has none, and a tag here would just be a second
# source of truth that can drift from the commit actually running).
DEVOPS_REPO = "devops".freeze

def devops_repo?(name)
  name == DEVOPS_REPO
end

def deploy_state_for(name, dir, app: nil, registry: nil)
  return { error: "no checkout at #{dir}" } unless File.directory?(File.join(dir, ".git"))

  fetch_err = `git -C #{dir} fetch -q origin 2>&1`
  return { error: "fetch failed: #{fetch_err.strip}" } unless $?.success?

  return devops_deploy_state(dir) if devops_repo?(name)

  tag_out, tag_status = Open3.capture2("sem-info", "tag", "latest", chdir: dir)
  tag = tag_status.success? ? tag_out.strip : ""
  return { error: "no tag" } if tag.empty? || tag == "0.0.0"

  ref = `git -C #{dir} rev-parse --verify --quiet origin/main`.strip
  ref = `git -C #{dir} rev-parse --verify --quiet origin/master`.strip if ref.empty?
  return { error: "no origin/main" } if ref.empty?

  count = `git -C #{dir} rev-list --count #{tag}..#{ref}`.strip.to_i
  last = `git -C #{dir} log -1 --format=%h\\ %s #{ref}`.strip
  { tag: tag, ahead: count, last: last }.merge(prod_status(registry, app, tag))
end

# devops' deploy state, in the same shape every other row uses so the table and
# `needs_deploy?` need no special cases. There is no tag and no prod probe: the
# released version is origin/main and the running version is the local HEAD that
# ~/code/devops/bin is executing out of. Pending = commits not yet pulled.
def devops_deploy_state(dir)
  ref = `git -C #{dir} rev-parse --short --verify --quiet origin/main`.strip
  return { error: "no origin/main" } if ref.empty?

  local = `git -C #{dir} rev-parse --short HEAD`.strip
  count = `git -C #{dir} rev-list --count HEAD..origin/main`.strip.to_i
  last = `git -C #{dir} log -1 --format=%h\\ %s origin/main`.strip
  # Pending is "behind origin/main" only. A checkout that DIFFERS for any other
  # reason — parked on a feature branch, or carrying unpushed commits — is not
  # something a pull fixes, so it is reported rather than queued for release.
  branch = git_current_branch(dir)
  note = "on #{branch || 'detached HEAD'}" unless branch == "main"
  { tag: ref, prod: local, ahead: count, ahead_noun: "to pull", last: last, note: note }
end

# Compare the *running* production version against the latest tag. Git state
# alone cannot distinguish "released and deployed" from "tagged but the deploy
# failed or never ran" — only asking prod catches the latter. Reuses the same
# probes as `dev deploy status` (/_internal_/version, or the live k8s image tag).
# Items with nothing to ask — *-postgresql repos and apps with no prod probe
# (host-derived-tenant frontends like playbook-app) — stay git-only.
def prod_status(registry, app, tag)
  return {} unless registry && app
  return {} unless registry.prod_url(app) || app.docker_k8s
  v = fetch_app_version(registry, app)
  return { prod_error: v[:error] } if v[:error]
  prod = (v["version"] || "").to_s.strip
  return { prod_error: "prod reported an empty version" } if prod.empty?
  { prod: prod, prod_stale: prod != tag }
end

# The single definition of "needs a release": unreleased commits on
# origin/main, or the latest tag is not what production is running.
# Shared by `deploy status` and `deploy all` so they never disagree.
def needs_deploy?(d)
  d[:error].nil? && (d[:ahead].to_i > 0 || d[:prod_stale])
end

# The local checkout of a deployable: ~/code/<repo>, which is not always
# ~/code/<app name> — a deployable can be rebranded ahead of its repo.
def app_checkout_dir(app)
  File.expand_path("~/code/#{app.repo_name}")
end

# Same, by deploy-item name. Falls back to the name itself for items with no
# registry entry (the derived <repo>-postgresql DB repos).
def deploy_item_dir(name)
  app = cached_registry.find(name)
  app ? app_checkout_dir(app) : File.expand_path("~/code/#{name}")
end

# Loading the registry shells out to `pkl eval` per app, so share one across the
# release fan-out. Racing threads may each build one; they are identical.
def cached_registry
  $cached_registry ||= Work::Registry.load
end

def deploy_items(registry = Work::Registry.load)
  # deploy_tracked (not deployable): we release every non-ignored app with a real
  # deploy path, including host-derived-tenant apps like playbook-app that have no
  # single pingable prod URL and so are absent from `deployable`.
  items = registry.deploy_tracked.map { |app| [app.name, app_checkout_dir(app), app] }
  # DB repos are derived from the apps registry, not a filesystem glob: every
  # deployable scala app declares a database in its config.pkl and ships a
  # conventional "<repo>-postgresql" repo checked out next to it. Driving
  # discovery from the registry keeps stray/abandoned *-postgresql checkouts
  # out of the list; scoping to deploy_tracked excludes ignored/archived apps.
  registry.deploy_tracked.select { |app| app.stack == :scala }.each do |app|
    db = "#{app.repo_name}-postgresql"
    items << [db, File.expand_path("~/code/#{db}"), nil]
  end
  # Libraries publish to Maven Central, not to a cluster, so there is no prod
  # version to probe: they are pending purely on unreleased commits on main.
  # Without them a lib change can sit unreleased indefinitely — nothing else
  # reports it.
  lib_repos.each { |lib| items << [lib, File.expand_path("~/code/#{lib}"), nil] }
  # devops last of the derived entries: it is not in the apps registry (it ships
  # nothing) but it still falls behind, and nothing else reports that.
  items << [DEVOPS_REPO, File.expand_path("~/code/#{DEVOPS_REPO}"), nil]
  # Array#uniq keeps the first occurrence, so deployable-app entries win over a
  # DB entry if a name collides. Don't reorder.
  items.uniq { |name, _| name }.sort_by { |name, _| name }
end

def resolve_deploy_items(name_filter)
  registry = Work::Registry.load
  all_items = deploy_items(registry)
  items = name_filter ? all_items.select { |name, _| name == name_filter } : all_items
  if items.empty?
    valid = all_items.map(&:first).join(", ")
    Util.exit_with_error("Unknown app '#{name_filter}'. Valid names: #{valid}")
  end
  items.map { |name, dir, app| Thread.new { [name, deploy_state_for(name, dir, app: app, registry: registry)] } }.map(&:value)
end

# Prints one row of the deploy status table. Column widths are shared across
# every section so the two buckets stay aligned under one set of headers.
def print_deploy_status_row(name, d, name_w, tag_w, prod_w)
  if d[:error]
    puts "#{name.ljust(name_w)}  ERROR - #{d[:error]}"
    return
  end
  status = []
  # ahead_noun: devops is pending a `git pull`, not a release (see devops_deploy_state).
  status << "+#{d[:ahead]} #{d[:ahead_noun] || 'unreleased'}" if d[:ahead] > 0
  status << "tag #{d[:tag]} not deployed" if d[:prod_stale]
  status << d[:note] if d[:note]
  # A failed prod probe means we could not verify what production is running —
  # it does NOT mark the app pending, but it must not pass silently either.
  status << "prod check failed: #{d[:prod_error]}" if d[:prod_error]
  status << "up to date" if status.empty?
  puts "#{name.ljust(name_w)}  #{(d[:tag] || '').ljust(tag_w)}  #{(d[:prod] || '-').ljust(prod_w)}  #{status.join(', ')}"
end

# Prints every tracked item with its latest tag, the version production is
# running, and a status — the full fleet picture even when everything is up to
# date. When the fleet is a mix of up-to-date and pending apps, the pending ones
# are split into a trailing "needs deploy" section so what actually needs a
# release is easy to pick out; a uniform fleet prints as a single table.
def print_deploy_status_table(rows)
  name_w = rows.map { |n, _| n.length }.max
  tag_w  = [rows.map { |_, d| (d[:tag] || "").length }.max, "tag".length].max
  prod_w = [rows.map { |_, d| (d[:prod] || "-").length }.max, "prod".length].max
  header = "#{'app'.ljust(name_w)}  #{'tag'.ljust(tag_w)}  #{'prod'.ljust(prod_w)}  status"

  pending, current = rows.partition { |_, d| needs_deploy?(d) }

  # Uniform fleet (all current, or all pending): one plain table, no sections.
  if pending.empty? || current.empty?
    puts header
    rows.each { |name, d| print_deploy_status_row(name, d, name_w, tag_w, prod_w) }
    return
  end

  puts header
  current.each { |name, d| print_deploy_status_row(name, d, name_w, tag_w, prod_w) }
  puts ""
  puts "needs deploy"
  puts header
  pending.each { |name, d| print_deploy_status_row(name, d, name_w, tag_w, prod_w) }
end

# Whether we can prompt. A pipe or cron has no one to answer, so the caller must
# print and exit instead of blocking on stdin forever.
def interactive_terminal?
  $stdin.tty?
end

# The default `dev deploy`: show the fleet, then offer to release whatever is
# pending. Selecting items runs the same orchestration as `deploy all`.
def cmd_deploy_status(args)
  rest, name_filter, _ = parse_common_flags(args)
  reject_unknown_args("deploy status", rest)
  rows = resolve_deploy_items(name_filter)

  print_deploy_status_table(rows)

  pending = rows.select { |_, d| needs_deploy?(d) }.map(&:first)
  if pending.empty?
    puts ""
    puts "Everything tracked is up to date (apps, databases, libraries, and devops)."
    return
  end

  unless interactive_terminal?
    puts ""
    puts "#{pending.length} pending: #{pending.join(', ')} (run `dev deploy all` to release)"
    return
  end

  puts ""
  noun = pending.length == 1 ? "item needs" : "items need"
  selected = Ask.select_multiple_from_list("#{pending.length} #{noun} a release. Deploy which?", pending)
  if selected.empty?
    puts ""
    puts "Nothing selected."
    return
  end

  puts ""
  # Detection errors are already shown in the table above, so they are not
  # repeated in the release summary.
  run_deploys(selected, concurrency: DEPLOY_CONCURRENCY_DEFAULT)
end

# Apps release in parallel; DBs are always serial regardless of this.
DEPLOY_CONCURRENCY_DEFAULT = 10

def parse_deploy_all_args(args)
  app_filter = nil
  concurrency = DEPLOY_CONCURRENCY_DEFAULT
  i = 0
  while i < args.length
    a = args[i]
    case a
    when "--app"
      app_filter = args[i + 1]
      usage_exit("--app requires a value", example: usage_for("deploy all")) if app_filter.nil?
      i += 2
    when "--concurrency"
      raw = args[i + 1]
      usage_exit("--concurrency requires a positive integer", example: usage_for("deploy all")) if raw.nil? || raw.to_i <= 0
      concurrency = raw.to_i
      i += 2
    else
      usage_exit("Unknown argument: #{a}", example: usage_for("deploy all"))
    end
  end
  [app_filter, concurrency]
end

def parse_codegen_sync_args(argv)
  opts = { app: nil, concurrency: 4, dry_run: false, regen_only: false, full_tests: false, check: false }
  args = argv.dup
  until args.empty?
    case (a = args.shift)
    when "--app"
      opts[:app] = args.shift or usage_exit("--app requires a value", example: usage_for("codegen sync"))
    when "--concurrency"
      n = args.shift.to_i
      usage_exit("--concurrency must be a positive integer", example: usage_for("codegen sync")) if n < 1
      opts[:concurrency] = n
    when "--dry-run"    then opts[:dry_run] = true
    when "--regen-only" then opts[:regen_only] = true
    when "--full-tests" then opts[:full_tests] = true
    # --check IS a dry run: detect drift, mutate nothing. It adds only the exit
    # code contract on top, so it sets dry_run rather than teaching run_repo a
    # second "don't touch anything" flag it could disagree with.
    when "--check"      then opts[:check] = true; opts[:dry_run] = true
    else usage_exit("unknown option #{a}", example: usage_for("codegen sync"))
    end
  end
  # Both of these describe how to PRODUCE the fix, which a check never does.
  # Accepting them would silently ignore them, so reject instead.
  if opts[:check] && (opts[:regen_only] || opts[:full_tests])
    usage_exit("--check cannot be combined with --regen-only or --full-tests", example: usage_for("codegen sync"))
  end
  opts
end

# Every sweep uses a fresh, unique branch (`<prefix>-<run_id>`) so a leftover
# branch from a prior run never blocks or gets clobbered. The gate against
# duplicate work is an OPEN PR (see open_codegen_pr), not branch existence.
CODEGEN_BRANCH_PREFIX = "codegen-sync".freeze
# The scratch dir holding a sweep's clones lives under ~/code/ai, and that is
# load-bearing rather than cosmetic. `api` is hermetic: it treats a repo's own
# working-tree specs as authoritative, then a sibling clone's — but ONLY when the
# clones sit in an `~/code/ai/<dir>/<repo>` layout (sibling_spec_paths in bin/api
# gates on exactly that shape). Anywhere else every spec a repo does not own
# resolves from the registry, and the registry means RELEASED, not merged — so a
# sweep run outside ~/code/ai regenerates each consumer against the last released
# specs and opens PRs walking its client BACKWARDS whenever a merged spec change
# has not shipped yet. Cloning into ~/code/ai/<dir> makes each backend clone a
# sibling of every consumer clone, so consumers regenerate against main.
CODEGEN_WORKDIR_ROOT = File.join(CODE_ROOT, "ai")
# Short on purpose: `<prefix>.<run_id>` must stay within the ~19 chars macOS
# unix-socket paths leave for a feature dir (sbt's
# `<feature>/<repo>/project/.sbtboot/server/<hash>/sock` caps at 104 bytes), and
# the sweep runs sbt in every scala clone. purge_scratch_workdirs finds prior
# runs by this prefix.
CODEGEN_WORKDIR_PREFIX = "cgs".freeze
CODEGEN_STACKS = %i[scala elm sveltekit].freeze
# `--check` is what the `codegen-sync` playbook runs as its first step (ISS-525),
# so its exit codes are the producer contract, not a convenience. 1 means "file
# the issue", which is why a broken sweep must NOT come back as 1: a check that
# crashes every night would otherwise become a nightly stream of bogus issues.
CODEGEN_EXIT_CLEAN       = 0 # every repo regenerated to no diff
CODEGEN_EXIT_FINDINGS    = 1 # real drift — file (or increment) the issue
CODEGEN_EXIT_UNCHECKABLE = 2 # the check itself broke — recorded as `check_failed`
CODEGEN_CLAUDE_TIMEOUT_SECS = 20 * 60
# The per-repo sessions do mechanical work (fix compile errors, commit, open a
# PR), so a cheap/fast model is the right default.
CODEGEN_CLAUDE_MODEL = "haiku".freeze

# The working dir for one sweep: `~/code/ai/cgs.<run_id>`. Its name pairs with the
# run's branch (`codegen-sync-<run_id>`) through the shared run_id.
def codegen_workdir(run_id)
  File.join(CODEGEN_WORKDIR_ROOT, "#{CODEGEN_WORKDIR_PREFIX}.#{run_id}")
end

# HTTPS, never SSH (ISS-478). Every unattended clone in this CLI runs as the
# agent user under launchd, where there is no ssh-agent identity and no private
# key on disk — an SSH origin fails with "Permission denied (publickey)" and the
# nightly sweep reports "clone failed" for a repo it can read perfectly well.
# HTTPS is what the rest of the flow already uses: gh is logged in with `repo`
# scope, the osxkeychain helper answers both fetch and push, and `gh pr create`
# has always gone over it.
def github_origin(repo_slug)
  "https://github.com/#{repo_slug}.git"
end

# The same rule for an origin we did not build: `browserslist update` clones from
# whatever remote the local checkout under ~/code happens to carry, and Mike's
# checkouts are SSH. Rewrite GitHub SSH remotes to their HTTPS form; anything
# else (another host, an already-HTTPS url, a local path) is passed through
# untouched.
def github_https_url(origin)
  case origin.to_s
  when %r{\Agit@github\.com:(?<slug>.+?)(?:\.git)?\z}       then "https://github.com/#{$~[:slug]}.git"
  when %r{\Assh://git@github\.com/(?<slug>.+?)(?:\.git)?\z} then "https://github.com/#{$~[:slug]}.git"
  else origin
  end
end

# Git must never wait on a human here: these clones run in launchd jobs and
# headless sessions, and a credential prompt would hang the sweep for its whole
# timeout instead of failing with a readable error.
GIT_NONINTERACTIVE_ENV = { "GIT_TERMINAL_PROMPT" => "0" }.freeze

# `Codegen::ApiConfig.load` runs `pkl eval` under the hood (via the top-level
# `ApiConfig` class), which calls `Util.exit_with_error` (hard `exit 1`) on any
# parse failure. That's fine for a single-repo CLI invocation but would abort
# the entire multi-repo sweep here — one repo's bad pkl state shouldn't take
# down every other repo's run. Rescue both the raised SystemExit and any
# StandardError and treat it as "no config for this repo" instead.
def safe_load_api_config(clone_path)
  Codegen::ApiConfig.load(clone_path)
rescue SystemExit, StandardError => e
  warn "codegen sync: failed to parse #{clone_path}/.api/config.pkl: #{e.message}"
  nil
end

# Which registry apps to clone + parse for this run. A single-consumer `--app`
# needs every BACKEND cloned alongside it: a consumer owns no specs, so the specs
# it generates against come from the backend clones sitting next to it in the
# workdir — without them `api` falls back to the registry (released) and the run
# regenerates the client backwards. A single-backend `--app` needs every consumer
# candidate cloned, so `Codegen::Graph` can compute which consumers actually
# depend on it (a consumer's dependency on a backend is only knowable by
# intersecting the consumer's parsed `app_names` with the backend's, which
# requires cloning the consumer). No `--app` (full sweep) needs everything.
# Cloning is not running: `codegen_run_plan` still runs only the target and, for
# a backend target, its dependent consumers.
def codegen_clone_set(target, eligible)
  return eligible if target.nil?
  return [target] + eligible.select { |a| a.stack == :scala } if target.stack != :scala
  [target] + eligible.reject { |a| a.stack == :scala }
end

# Resolves `--app` against the eligible (non-ignored, scala/elm/sveltekit)
# registry apps. nil means "no filter" (full sweep). Exits with a clear error
# if the name matches neither a backend nor a consumer.
def resolve_codegen_target(app_filter, eligible)
  return nil if app_filter.nil?
  target = eligible.find { |a| a.name == app_filter }
  return target if target
  Util.exit_with_error(
    "codegen sync: '#{app_filter}' is not an eligible app. " \
    "Eligible: #{eligible.map(&:name).sort.join(', ')}"
  )
end

# Given the resolved target (nil = full sweep, or an eligible registry App with
# #name/#stack) and the built graph, returns the ordered run plan:
#   { backends: [sorted names], consumers: [sorted names], run_names: [...] }
# Full sweep runs all backends then all consumers. A scala (backend) target runs
# that backend plus only the consumers that depend on it. A consumer target runs
# just that consumer (empty if it isn't in the graph).
def codegen_run_plan(target, graph)
  run_names =
    if target.nil?
      graph.backends + graph.consumers
    elsif target.stack == :scala
      [target.name] + graph.consumers.select { |c| graph.depends_on(c).include?(target.name) }
    else
      [target.name] & (graph.backends + graph.consumers)
    end
  {
    backends: (run_names & graph.backends).sort,
    consumers: (run_names & graph.consumers).sort,
    run_names: run_names,
  }
end

# Generic concurrency-capped worker pool, modeled directly on `release_concurrent`
# (Queue + fixed-size Thread pool, `pop(true) rescue nil` to drain without
# blocking) but generic over the per-name block instead of hardcoding
# `release_one`, since codegen's per-repo work (`run_repo`) has a different
# signature. Returns { name => block-result }.
def run_concurrent(names, concurrency)
  results = {}
  return results if names.empty?
  mutex = Mutex.new
  queue = Queue.new
  names.each { |n| queue << n }
  workers = Array.new([concurrency, names.length].min) do
    Thread.new do
      while (name = (queue.pop(true) rescue nil))
        mutex.synchronize { puts "  #{name} [starting]" }
        result =
          begin
            yield name
          rescue => e
            { status: :error, error: "worker crashed: #{e.class}: #{e.message}" }
          end
        mutex.synchronize do
          results[name] = result
          puts "  #{name} [#{result[:status]}]"
        end
      end
    end
  end
  workers.each(&:join)
  results
end

# Every dir in the clone that has its own `.api/config.pkl` — `api` must run in
# each. Some repos have a second one under ./playwright (its own test-client
# config); the root `api` run does not regenerate those, so without this the
# wipe would leave playwright/generated files deleted. Root (shortest) first.
def codegen_api_dirs(clone)
  Dir.glob(File.join(clone, "**", ".api", "config.pkl"), File::FNM_DOTMATCH)
     .reject { |p| p.include?("#{File::SEPARATOR}node_modules#{File::SEPARATOR}") }
     .map { |p| File.dirname(File.dirname(p)) }
     .uniq
     .sort_by(&:length)
end

# `git checkout` every modified file whose diff is only noise — the apibuilder
# `Service version:` timestamp comment and/or the trailing-newline the generator
# omits — so a no-op regen stays out of the diff. Only modified (M) files are
# considered; deleted orphans and new files are never noise. Returns the count.
def revert_noise_only_changes(clone)
  _, names = run_step(["git", "diff", "--name-only", "--diff-filter=M"], clone, false, +"")
  reverted = 0
  names.to_s.split("\n").map(&:strip).reject(&:empty?).each do |f|
    _, diff = run_step(["git", "diff", "--", f], clone, false, +"")
    next unless Codegen::Sync.noise_only_diff?(diff)
    run_step(["git", "checkout", "--", f], clone, false, +"")
    reverted += 1
  end
  reverted
end

# URL of an already-open PR from a prior codegen sweep for this repo (its head
# branch starts with the codegen-sync prefix), or nil. `gh` infers the repo
# from the clone's origin.
def open_pr_with_prefix(clone, branch_prefix)
  _, out = run_step(["gh", "pr", "list", "--state", "open", "--limit", "200", "--json", "url,headRefName"], clone, false, +"")
  Codegen::Sync.open_codegen_pr_url(out, branch_prefix)
end

def open_codegen_pr(clone)
  open_pr_with_prefix(clone, CODEGEN_BRANCH_PREFIX)
end

# Deterministic, mechanical pass for one repo: branch, wipe generated files,
# rerun `api`, classify the diff. Only reaches for Claude if there's an actual
# diff and the caller isn't in --dry-run.
def run_repo(name, workdir, stack, opts, branch, &announce)
  clone = File.join(workdir, name)
  note = ->(msg) { announce&.call(msg) }

  # Gate on an OPEN PR, not on branch existence: this run uses a fresh unique
  # branch, so a leftover branch can't collide or be clobbered. But if a prior
  # sweep's PR for this repo is still open, don't stack a second one — skip and
  # let the human land/close it first. --dry-run never pushes, so it's exempt.
  unless opts[:dry_run]
    if (pr = open_codegen_pr(clone))
      return { status: :needs_attention, error: "an open codegen-sync PR already exists (#{pr}) — merge or close it before re-running" }
    end
  end

  # Fetch origin/main fresh and branch off FETCH_HEAD rather than trusting the
  # shallow clone's default-branch tip: a clone made earlier in a long sweep
  # (or reused across a rerun) can otherwise serve a stale main.
  fetch_ok, fetch_out = run_step(["git", "fetch", "--depth=1", "origin", "main"], clone, false, +"")
  return { status: :error, error: "fetch origin main failed: #{fetch_out}" } unless fetch_ok

  branch_ok, branch_out = run_step(["git", "checkout", "-B", branch, "FETCH_HEAD"], clone, false, +"")
  return { status: :error, error: "branch checkout failed: #{branch_out}" } unless branch_ok

  # Load the config purely to validate it parses — a repo whose .api/config.pkl
  # is broken should error rather than silently regenerate nothing. The wipe
  # itself is marker-driven and needs no config.
  return { status: :error, error: "no usable .api/config.pkl" } unless safe_load_api_config(clone)

  wiped = Codegen::Sync.generated_paths(clone).each { |p| File.delete(p) if File.exist?(p) }
  note.call("wiped #{wiped.length} generated file(s)")

  # Bare `api` is hermetic for every stack: it regenerates from the working-tree
  # specs of this clone and its siblings in the workdir and publishes NOTHING
  # (only `api publish`, from a clean merged main, moves the registry's `latest`).
  # So there is no registry-mutating variant to avoid here and --dry-run runs the
  # same command — it differs only in never committing, pushing, or opening a PR.
  # Run it in every dir with a .api/config.pkl (root, plus e.g. ./playwright) so
  # all generated files are recreated — the wipe deleted them all.
  api_dirs = codegen_api_dirs(clone)
  base = stack == :scala ? "regenerating (backend — can take a few minutes)" : "regenerating client"
  note.call("running api in #{api_dirs.length} config dir(s): #{base}…")
  api_dirs.each do |dir|
    log = +""
    ok, _ = run_step(["api"], dir, false, log)
    rel = dir == clone ? "." : dir.sub("#{clone}#{File::SEPARATOR}", "")
    return { status: :error, error: "api failed in #{rel}: #{log.strip}" } unless ok
  end

  reverted = revert_noise_only_changes(clone)
  note.call("reverted #{reverted} no-op (timestamp/whitespace) file(s)") if reverted.positive?

  porcelain, _ = Open3.capture2("git", "-C", clone, "status", "--porcelain")
  porcelain = Util.to_utf8(porcelain)
  return { status: :in_sync } if Codegen::Sync.classify_diff(porcelain) == :in_sync
  return { status: :changed, note: "diff only (dry-run)" } if opts[:dry_run]

  # regen-only: commit the regen as-is and open a DRAFT PR — no build, no Claude.
  return commit_and_open_pr(clone, branch, draft: true) if opts[:regen_only]

  # Build-gate: if the regenerated repo builds, the change is clean — commit and
  # open the PR directly, NO Claude. Only a genuine build failure (a real API
  # contract change that broke consuming code) hands off to Claude to fix.
  verify_cmd = Codegen::Sync.verify_cmd_for(stack, full_tests: opts[:full_tests])
  note.call("verifying (#{verify_cmd})…")
  verify_ok, verify_log = run_verify(clone, stack, verify_cmd)
  if verify_ok
    note.call("build clean — committing + opening PR (no Claude)")
    commit_and_open_pr(clone, branch, draft: false)
  else
    note.call("build failed — handing to Claude to fix")
    prompt = Codegen::Sync.fix_prompt(repo: name, branch: branch,
                                      verify_cmd: verify_cmd, regen_only: false,
                                      build_error: verify_log)
    spawn_claude(clone, prompt)
  end
rescue => e
  { status: :error, error: "run_repo crashed: #{e.class}: #{e.message}" }
end

# Build/typecheck the regenerated repo so a clean regen can skip Claude. Installs
# node deps first when there's a package.json (a fresh clone has no
# node_modules; this also warms it for a Claude handoff on failure). Returns
# [ok, combined_log].
def run_verify(clone, stack, verify_cmd)
  log = +""
  if File.exist?(File.join(clone, "package.json"))
    ok, _ = run_step(["npm", "install", "--no-audit", "--no-fund"], clone, false, log)
    return [false, log] unless ok
  end
  ok, _ = run_step(verify_cmd.split, clone, false, log)
  [ok, log]
end

CODEGEN_COMMIT_MSG = "Sync regenerated apibuilder/DAO code".freeze

# Deterministic clean-regen path (no Claude): stage everything, commit, push the
# branch, and open a PR. Returns {status: :pr_opened, pr_url:} or an error /
# needs_attention hash. Never merges. draft: true opens a draft PR (regen-only).
def commit_and_open_pr(clone, branch, draft:)
  run_step(["git", "add", "-A"], clone, false, +"")
  commit_ok, commit_out = run_step(["git", "commit", "-m", CODEGEN_COMMIT_MSG], clone, false, +"")
  return { status: :error, error: "commit failed: #{commit_out}" } unless commit_ok
  push_ok, push_out = run_step(["git", "push", "-u", "origin", branch], clone, false, +"")
  return { status: :error, error: "push failed: #{push_out}" } unless push_ok
  # --head: the clone is single-branch (--depth=1), so its fetch refspec only
  # maps main and `git push -u` never creates refs/remotes/origin/<branch>.
  # Without --head, gh aborts with "you must first push the current branch".
  create = ["gh", "pr", "create", "--fill", "--head", branch]
  create << "--draft" if draft
  create_ok, create_out = run_step(create, clone, false, +"")
  url = create_out[%r{https://github\.com/\S+/pull/\d+}]
  unless create_ok && url
    return { status: :needs_attention, error: "PR create failed (clone left at #{clone}): #{create_out.to_s.strip}" }
  end
  { status: :pr_opened, pr_url: url }
end

# Thin integration glue: run a fresh Claude session in `clone` to make the
# regenerated repo build, commit, and open a draft PR (per the prompt built by
# `Codegen::Sync.fix_prompt`). Bounded by a timeout so one stuck repo can't hang
# the whole sweep. On timeout/failure the clone + branch are left in place
# (never deleted) so a human can pick up where Claude left off.
#
# Deliberately NOT `Open3.capture2e`/block-form `popen2e`: both wait on the
# child internally (capture2e blocks until exit; popen2e's block form runs a
# `wait_thr.join` in its `ensure`, which fires *before* our `rescue
# Timeout::Error` regains control) — a `Timeout.timeout` wrapped around either
# would unwind our Ruby frame while the orphaned `claude` process keeps running
# in the background, free to push/open a PR after we've already recorded
# :needs_attention. Instead we open the pipes ourselves, capture the pid before
# the blocking read, and on timeout kill the process directly.
def spawn_claude(clone, prompt, model: CODEGEN_CLAUDE_MODEL, timeout_secs: CODEGEN_CLAUDE_TIMEOUT_SECS)
  # pgroup: true makes the spawned `claude` process its own process group
  # leader (its pid == its pgid), so killing -pid on timeout signals the whole
  # group — including grandchildren like `gh pr create`/`git push` that could
  # otherwise outlive the direct child and still push/open a PR after we've
  # already recorded :needs_attention.
  # --dangerously-skip-permissions: a headless `claude --print` session has no
  # human to answer permission prompts, so without it every Bash/Edit/gh call is
  # blocked and the session does nothing (no commit, no push, no PR). It runs in
  # a throwaway clone and only ever pushes the codegen-sync branch, so the blast
  # radius is bounded.
  stdin, out_err, wait_thr = Open3.popen2e("claude", "--print", "--dangerously-skip-permissions", "--model", model, prompt, chdir: clone, pgroup: true)
  stdin.close
  pid = wait_thr.pid

  output =
    begin
      Timeout.timeout(timeout_secs) { out_err.read }
    rescue Timeout::Error
      begin
        Process.kill("TERM", -pid)
      rescue Errno::ESRCH
      end
      begin
        Process.kill("KILL", -pid)
      rescue Errno::ESRCH
      end
      return { status: :needs_attention, error: "claude --print timed out after #{timeout_secs}s (clone left at #{clone}); process killed" }
    ensure
      out_err.close unless out_err.closed?
    end

  status = wait_thr.value
  # Same scrub as run_step: the PR-URL regex below must not crash on a
  # malformed byte in Claude's output.
  output = Util.to_utf8(output)
  unless status.success?
    return { status: :needs_attention, error: "claude --print failed (clone left at #{clone}): #{output}" }
  end

  pr_url = output[%r{https://github\.com/\S+/pull/\d+}]
  return { status: :needs_attention, error: "claude finished but no PR URL found in output (clone left at #{clone})" } unless pr_url

  { status: :pr_opened, pr_url: pr_url }
end


# Pure, testable seam: one sorted [name, status_string, pr_url_or_dash] row per
# repo, shared by both the human-readable printer below and the
# machine-readable JSON writer so they can never drift out of agreement.
def codegen_status_rows(results)
  results.keys.sort.map do |name|
    r = results[name]
    [name, r[:status].to_s, r[:pr_url] || "-"]
  end
end

def print_codegen_summary(results)
  puts ""
  puts Util.underline("codegen sync summary")
  if results.empty?
    puts "  (no apps processed)"
    return
  end
  codegen_status_rows(results).each do |name, status, pr_url|
    r = results[name]
    line = +"  #{name} [#{status}]"
    line << " #{pr_url}" unless pr_url == "-"
    line << " (#{r[:note]})" if r[:note]
    line << " - #{r[:error]}" if r[:error]
    puts line
  end
end

# Writes codegen-sync-status.json into workdir: an array of
# {repo, status, pr_url, error} objects (pr_url/error may be nil) for
# openclaw's morning briefing to consume.
# The `--check` verdict, derived once from the same results hash the summary
# prints. Findings beat uncheckable deliberately: a repo that demonstrably
# regenerated to a diff is real drift worth filing even when a sibling repo
# failed to clone, and exit 2 would drop that finding on the floor until the
# next nightly run. An empty results hash means nothing was examined at all,
# which is never evidence that generated code is in sync.
def codegen_check_exit_code(results)
  return CODEGEN_EXIT_UNCHECKABLE if results.empty?
  return CODEGEN_EXIT_FINDINGS if results.any? { |_, r| r[:status] == :changed }
  # Clean is asserted, not inferred: every repo must have said :in_sync. A status
  # this function does not recognise (a new one, or one only the PR-opening path
  # can produce) means the sweep did something a check should not have been able
  # to do — say so, rather than report "in sync" on the strength of not knowing.
  return CODEGEN_EXIT_CLEAN if results.all? { |_, r| r[:status] == :in_sync }

  CODEGEN_EXIT_UNCHECKABLE
end

# The check's stdout becomes the filed issue's body, so it has to name the repos
# to resync rather than just say "drift found".
def codegen_check_verdict(results, code)
  case code
  when CODEGEN_EXIT_CLEAN then "Generated code is in sync in every repo"
  when CODEGEN_EXIT_FINDINGS
    drifted = results.select { |_, r| r[:status] == :changed }.keys.sort
    "Generated code is out of sync in #{drifted.length} repo(s): #{drifted.join(', ')}\n" \
      "Resync with: dev codegen sync"
  else "codegen sync --check could not complete — nothing was concluded about generated code"
  end
end

def write_codegen_status_json(workdir, results)
  data = results.keys.sort.map do |name|
    r = results[name]
    { repo: name, status: r[:status].to_s, pr_url: r[:pr_url], error: r[:error] }
  end
  File.write(File.join(workdir, "codegen-sync-status.json"), JSON.pretty_generate(data))
end

def cmd_codegen_sync(argv)
  opts = parse_codegen_sync_args(argv)
  return run_codegen_sweep(opts) unless opts[:check]

  # Check mode: the sweep is the detector, and its verdict is an exit code.
  # Every hard abort inside the sweep (an unknown --app, an unclonable backend,
  # a failing git/api invocation) is `exit 1` via Util.exit_with_error — which
  # in the producer contract would mean "found drift, file the issue". It means
  # the opposite: nothing was concluded. Translate it, so a broken sweep is
  # recorded as check_failed instead of filing a fictional finding.
  results =
    begin
      run_codegen_sweep(opts)
    rescue SystemExit => e
      raise if e.success?

      exit CODEGEN_EXIT_UNCHECKABLE
    end
  code = codegen_check_exit_code(results)
  puts ""
  puts codegen_check_verdict(results, code)
  exit code
end

# Clones every eligible repo, regenerates it, classifies the diff, and returns
# the per-repo results hash. Opens PRs and hands off to Claude unless `opts`
# says otherwise (--dry-run / --check).
def run_codegen_sweep(opts)
  registry = Work::Registry.load
  # Resolve the target BEFORE touching the disk: an unknown --app aborts the
  # sweep, and it should not first delete the prior sweep's clones (which a
  # `needs_attention` repo deliberately leaves behind to be inspected).
  eligible = registry.apps.reject(&:ignored).select { |a| CODEGEN_STACKS.include?(a.stack) }
  target = resolve_codegen_target(opts[:app], eligible)
  to_clone = codegen_clone_set(target, eligible)

  # One id per sweep, to the second, drives both the workdir and the branch
  # name so reruns never collide with a prior run's clones or remote branch.
  run_id = ENV["CODEGEN_SYNC_DATE"] || Time.now.strftime("%Y%m%d-%H%M%S")
  branch = "#{CODEGEN_BRANCH_PREFIX}-#{run_id}"
  workdir = codegen_workdir(run_id)
  # Before cloning ~2-3 GB of fresh checkouts, reclaim every prior sweep's.
  purge_scratch_workdirs(CODEGEN_WORKDIR_PREFIX, keep: workdir, root: CODEGEN_WORKDIR_ROOT)
  # No `devops` clone is needed alongside the repo clones: every `.api/config.pkl`
  # amends `modulepath:/api/ApiConfig.pkl`, which `api` resolves from its own
  # checkout (see ApiConfig::BASE_MODULE_URI), not from a sibling directory.
  FileUtils.mkdir_p(workdir)

  puts "Working in #{workdir}"
  puts "Cloning #{to_clone.length} repo(s): #{to_clone.map(&:name).sort.join(', ')}"
  puts ""

  configs = {}
  to_clone.each_with_index do |app, i|
    puts "  [#{i + 1}/#{to_clone.length}] cloning #{app.name}…"
    clone_path = clone_repo(github_origin(app.repo), app.name, workdir, false, +"")
    if clone_path && File.exist?(File.join(clone_path, ".api", "config.pkl"))
      cfg = safe_load_api_config(clone_path)
      configs[app.name] = cfg if cfg
    end
    next if configs.key?(app.name)

    # A backend (scala) that silently drops out of `configs` vanishes from
    # `graph.backends` too (Graph.build filters on configs.key?) — the sweep
    # would print an empty summary with no error while consumers regenerate
    # against a registry missing that backend's specs. Fatal. A consumer
    # failing the same way is expected/handled: Graph.build already excludes
    # it from `graph.consumers`, so just warn and move on.
    if app.stack == :scala
      Util.exit_with_error(
        "codegen sync: backend '#{app.name}' has no usable .api/config.pkl " \
        "(clone failed, missing file, or parse error) — aborting sweep"
      )
    else
      warn "codegen sync: skipping '#{app.name}' — no usable .api/config.pkl (clone failed, missing file, or parse error)"
    end
  end

  graph = Codegen::Graph.build(apps: to_clone, configs: configs)

  plan = codegen_run_plan(target, graph)
  if target && plan[:run_names].empty?
    Util.exit_with_error("codegen sync: '#{target.name}' has no usable .api/config.pkl — nothing to run")
  end
  backend_names = plan[:backends]
  consumer_names = plan[:consumers]
  results = {}

  unless backend_names.empty?
    puts Util.underline("Backends (serial)")
    backend_names.each do |name|
      puts "  #{name}:"
      r = run_repo(name, workdir, :scala, opts, branch) { |msg| puts "    #{msg}" }
      results[name] = r
      report_repo_line(name, r[:status], r[:error] || r[:note], false)
    end
    puts ""
  end

  unless consumer_names.empty?
    puts Util.underline("Consumers (concurrency=#{opts[:concurrency]})")
    consumer_stacks = registry.apps.each_with_object({}) { |a, h| h[a.name] = a.stack }
    # A consumer reads its backends' specs straight out of their sibling clones
    # in this workdir, so what a backend leg's outcome tells us is whether that
    # clone is really sitting on fresh main. An :error leg may have died in the
    # fetch or the branch checkout, before its clone reached origin/main — its
    # specs are then untrustworthy, so skip the consumers that depend on it
    # rather than regenerate on a bad premise. (Conservative: an :error raised
    # later, e.g. by `api` itself, leaves the specs perfectly fine. Cheap to
    # over-skip, expensive to regenerate a client from the wrong contract.)
    # Gate on :error only. A backend ending :needs_attention has a clone at main
    # either way — the open-PR guard fires before anything mutates the clone, and
    # a Claude handoff happens after the fetch/checkout succeeded — so do NOT
    # skip its consumers.
    failed_backends = backend_names.select { |b| results[b] && results[b][:status] == :error }.to_set
    results.merge!(run_concurrent(consumer_names, opts[:concurrency]) do |name|
      bad = graph.depends_on(name).select { |d| failed_backends.include?(d) }
      if bad.empty?
        run_repo(name, workdir, consumer_stacks.fetch(name), opts, branch)
      else
        { status: :skipped, error: "skipped: dependency backend(s) failed: #{bad.join(', ')}" }
      end
    end)
    puts ""
  end

  print_codegen_summary(results)
  write_codegen_status_json(workdir, results)
  results
end

# ---------- dependencies check / upgrade ----------
#
# Nightly (or manual) library-dependency freshness for the scala repos.
# Detection is deterministic and token-free: sbt-updates injected via
# --addPluginSbtFile (nothing committed to any repo) asks sbt's own resolvers
# what versions exist. Upgrades are one Claude session per repo that must end
# in a verified, review-ready PR. Design: ~/code/claude/plans/2026-07-28-dep-nightly-design.md

DEPS_BRANCH_PREFIX = "dep-upgrade".freeze
DEPS_CLAUDE_TIMEOUT_SECS = 90 * 60
# Upgrades can require real code fixes (deprecations, API changes), unlike
# codegen's mechanical work — use a stronger model than codegen's haiku.
DEPS_CLAUDE_MODEL = "sonnet".freeze
DEPS_DENYLIST_PATH = File.expand_path("../lib/dependencies/denylist.yml", __dir__)

# The process exit code of `dependencies check` / `dependencies upgrade`
# (ISS-478). Both used to end 0 no matter what: a night where every repo failed
# to clone printed `[error] - clone failed` and still looked like a clean run to
# the agent session, the cron and anything else reading `$?`. A repo that did not
# finish is a failed run, and it has to be visible as one.
DEPS_EXIT_OK     = 0
DEPS_EXIT_FAILED = 1
# The statuses that mean "this repo's run finished". `:skipped` is deliberately
# among them: it is the open-PR gate, and the pipeline documents that as a
# successful, self-gating night (agent/bodies/dependency-upgrade-app.md).
DEPS_SUCCESS_STATUSES = %i[ok in_sync pr_opened skipped].freeze

# Success is ASSERTED, never inferred: every repo must have reported a status
# from the list above. A status this does not recognise — a new one, or
# `:needs_attention` from a Claude session that timed out without a PR — is a run
# nobody can call finished, so it exits non-zero rather than being counted as
# fine because it was not explicitly an error. An empty results hash means no
# repo was processed at all, which is never evidence of a healthy sweep.
def dependencies_exit_code(results)
  return DEPS_EXIT_FAILED if results.empty?
  results.all? { |_, r| DEPS_SUCCESS_STATUSES.include?(r[:status]) } ? DEPS_EXIT_OK : DEPS_EXIT_FAILED
end

# Printed under the summary so the non-zero exit says which repos caused it —
# the summary lines scroll away in a nightly log, the verdict is the last line.
def dependencies_verdict(results, code)
  return "All #{results.length} repo(s) completed" if code == DEPS_EXIT_OK
  return "No repos were processed — nothing was concluded" if results.empty?

  failed = results.reject { |_, r| DEPS_SUCCESS_STATUSES.include?(r[:status]) }.keys.sort
  "#{failed.length} repo(s) did not complete: #{failed.join(', ')}"
end

# Returns the app names to process: every `--app` given (validated, deduped),
# or all known apps when none was passed.
def parse_dependencies_args(argv, command_key)
  apps = []
  args = argv.dup
  until args.empty?
    case (a = args.shift)
    when "--app"
      v = args.shift or usage_exit("--app requires a value", example: usage_for(command_key))
      unless Dependencies::Updates::APPS.key?(v)
        usage_exit("unknown app '#{v}' (known: #{Dependencies::Updates::APPS.keys.join(', ')})", example: usage_for(command_key))
      end
      apps << v
    else
      usage_exit("unknown option #{a}", example: usage_for(command_key))
    end
  end
  apps.empty? ? Dependencies::Updates::APPS.keys : apps.uniq
end

# Scratch workdir for the DAY, under ~/code/ai so `dev aidirs prune` purges it
# automatically. Deliberately SHORT (dep-up.<MMDD>, 11 chars — within the
# ≤19-char feature-dir budget) because sbt runs inside <workdir>/<repo> and
# macOS caps unix-socket paths (sbt's boot server socket) at 104 bytes.
#
# Per DAY rather than per run, because the nightly upgrade is now one epic with
# a child issue per repo (ISS-397) and each child invokes this command with its
# own `--app`. Per-run workdirs would give the night six status files, and the
# morning briefing reads the NEWEST one — it would have reported a single repo
# and silently dropped the other five. One workdir a night, merged per repo,
# keeps that file whole. Clones are removed before reuse (clone_repo), so a
# repeat run of the same repo on the same day is safe.
#
# Also writes the sbt-updates plugin files (one per sbt major — the plugin
# needs a different release on sbt 2) the detection step injects. Returns
# workdir.
def dependencies_workdir
  workdir = File.expand_path("~/code/ai/dep-up.#{Time.now.strftime('%m%d')}")
  FileUtils.mkdir_p(workdir)
  File.write(File.join(workdir, "sbt-updates.sbt"), Dependencies::Updates::SBT_UPDATES_PLUGIN + "\n")
  File.write(File.join(workdir, "sbt-updates-sbt2.sbt"), Dependencies::Updates::SBT_UPDATES_PLUGIN_SBT2 + "\n")
  workdir
end

# sbt 2 repos (lib-cipher) have no built-in dependencyUpdates and cannot load
# the sbt-1 plugin build — inject the sbt2 release (0.7.0) there instead.
def dependencies_sbt_cmd(clone, workdir)
  props = File.join(clone, "project", "build.properties")
  sbt_version = File.exist?(props) ? File.read(props)[/sbt\.version\s*=\s*(\S+)/, 1].to_s : ""
  file = sbt_version.start_with?("2") ? "sbt-updates-sbt2.sbt" : "sbt-updates.sbt"
  ["sbt", "--addPluginSbtFile=#{File.join(workdir, file)}", "dependencyUpdates"]
end

# Runs detection in an existing clone and applies policy + denylist. Requires
# a POSITIVE success signal ([success] in sbt output), not just exit status —
# an sbt run that dies early would otherwise read as "everything in sync".
def dependencies_detect(app, clone, workdir, denylist)
  ok, out = run_step(dependencies_sbt_cmd(clone, workdir), clone, false, +"")
  unless ok && out.to_s.include?("[success]")
    return { status: :error, error: "sbt dependencyUpdates failed:\n#{last_lines(out, 15)}" }
  end
  updates = Dependencies::Updates.parse_report(out)
  Dependencies::Updates.apply_policy(updates, denylist, app).merge(status: :ok)
end

def cmd_dependencies_check(argv)
  apps = parse_dependencies_args(argv, "dependencies check")
  denylist = Dependencies::Updates.load_denylist(DEPS_DENYLIST_PATH)
  workdir = dependencies_workdir
  puts "Working in #{workdir}"
  results = {}
  apps.each do |app|
    puts "  #{app}: cloning + running sbt dependencyUpdates…"
    log = +""
    clone = clone_repo(github_origin(Dependencies::Updates::APPS.fetch(app)), app, workdir, false, log)
    results[app] =
      if clone
        dependencies_detect(app, clone, workdir, denylist)
      else
        { status: :error, error: clone_failed_error(log) }
      end
  end
  puts ""
  puts Util.underline("dependencies check")
  results.each do |app, r|
    puts "  #{app}:"
    if r[:status] == :error
      puts "    ERROR: #{r[:error]}"
      next
    end
    if r[:bumps].empty? && r[:held].empty? && r[:skipped].empty?
      puts "    up to date"
      next
    end
    r[:bumps].each { |b| puts "    #{b[:group]}:#{b[:artifact]}  #{b[:current]} -> #{b[:target]}" }
    r[:held].each { |h| puts "    held back: #{h[:group]}:#{h[:artifact]} #{h[:current]} -> #{h[:target]} (#{h[:reason]})" }
    r[:skipped].each { |s| puts "    no stable target: #{s[:group]}:#{s[:artifact]} #{s[:current]} (candidates: #{s[:candidates].join(', ')})" }
  end
  dependencies_finish(results)
end

# The last thing both dependencies commands do: state the verdict and exit with
# it. Nothing runs after this, by design — an exit code that is only printed is
# an exit code nobody checks.
def dependencies_finish(results)
  code = dependencies_exit_code(results)
  puts ""
  puts dependencies_verdict(results, code)
  exit code
end

# One repo, end to end: clone, gate on an already-open dep-upgrade PR, branch
# off freshly-fetched origin/main, detect, and hand allowed bumps to a Claude
# session that must end with a review-ready PR. Mirrors codegen's run_repo.
def dependencies_upgrade_one(app, workdir, branch, denylist, &announce)
  note = ->(msg) { announce&.call(msg) }
  clone_log = +""
  clone = clone_repo(github_origin(Dependencies::Updates::APPS.fetch(app)), app, workdir, false, clone_log)
  return { status: :error, error: clone_failed_error(clone_log) } unless clone

  if (pr = open_pr_with_prefix(clone, DEPS_BRANCH_PREFIX))
    return { status: :skipped, error: "an open dep-upgrade PR already exists (#{pr}) — merge or close it first" }
  end

  fetch_ok, fetch_out = run_step(["git", "fetch", "--depth=1", "origin", "main"], clone, false, +"")
  return { status: :error, error: "fetch origin main failed: #{fetch_out}" } unless fetch_ok
  branch_ok, branch_out = run_step(["git", "checkout", "-B", branch, "FETCH_HEAD"], clone, false, +"")
  return { status: :error, error: "branch checkout failed: #{branch_out}" } unless branch_ok

  note.call("running sbt dependencyUpdates…")
  det = dependencies_detect(app, clone, workdir, denylist)
  return det if det[:status] == :error
  det[:held].each { |h| note.call("held back: #{h[:group]}:#{h[:artifact]} -> #{h[:target]} (#{h[:reason]})") }
  if det[:bumps].empty?
    return { status: :in_sync, held: det[:held] }
  end

  note.call("#{det[:bumps].length} bump(s) — handing to Claude (#{DEPS_CLAUDE_MODEL}, #{DEPS_CLAUDE_TIMEOUT_SECS / 60}m timeout)")
  prompt = Dependencies::Updates.upgrade_prompt(app: app, branch: branch, bumps: det[:bumps])
  spawn_claude(clone, prompt, model: DEPS_CLAUDE_MODEL, timeout_secs: DEPS_CLAUDE_TIMEOUT_SECS)
    .merge(held: det[:held], bumps: det[:bumps])
rescue => e
  { status: :error, error: "dependencies_upgrade_one crashed: #{e.class}: #{e.message}" }
end

def cmd_dependencies_upgrade(argv)
  apps = parse_dependencies_args(argv, "dependencies upgrade")
  denylist = Dependencies::Updates.load_denylist(DEPS_DENYLIST_PATH)
  run_id = Time.now.strftime("%Y%m%d-%H%M%S")
  branch = "#{DEPS_BRANCH_PREFIX}-#{run_id}"
  workdir = dependencies_workdir
  puts "Working in #{workdir}"

  # Serial on purpose: platform's suite is heavy, and parallel claude-db
  # session DBs from sibling headless sessions have collided before.
  results = {}
  apps.each do |app|
    puts "  #{app}:"
    r = dependencies_upgrade_one(app, workdir, branch, denylist) { |msg| puts "    #{msg}" }
    results[app] = r
    report_repo_line(app, r[:status], r[:error] || r[:note], false)
  end

  puts ""
  puts Util.underline("dependencies upgrade summary")
  results.keys.sort.each do |app|
    r = results[app]
    line = +"  #{app} [#{r[:status]}]"
    line << " #{r[:pr_url]}" if r[:pr_url]
    line << " - #{r[:error]}" if r[:error]
    held = r[:held] || []
    line << " (held back: #{held.map { |h| "#{h[:group]}:#{h[:artifact]}" }.join(', ')})" unless held.empty?
    puts line
  end
  # Status file first: it is what the morning briefing reads, and it has to be on
  # disk even when the run ends non-zero — a failed night is exactly the one the
  # briefing must be able to describe.
  write_dependencies_status_json(workdir, results)
  dependencies_finish(results)
end

# dependencies-status.json in workdir, same idea as codegen-sync-status.json:
# machine-readable per-repo outcome for openclaw's morning briefing.
#
# MERGED, not overwritten. The night is one invocation per repo (one per child
# issue of the upgrade epic), and each of them writes this file in the day's
# shared workdir; a plain write would leave the briefing reading whichever repo
# happened to finish last. Later runs of the same repo replace that repo's entry.
def write_dependencies_status_json(workdir, results)
  path = File.join(workdir, "dependencies-status.json")
  existing = File.exist?(path) ? (JSON.parse(File.read(path)) rescue []) : []
  by_repo = Array(existing).each_with_object({}) { |row, acc| acc[row["repo"]] = row if row.is_a?(Hash) }

  results.each do |app, r|
    by_repo[app] = {
      "repo" => app,
      "status" => r[:status].to_s,
      "pr_url" => r[:pr_url],
      "error" => r[:error],
      "bumps" => (r[:bumps] || []).map { |b| "#{b[:group]}:#{b[:artifact]} #{b[:current]} -> #{b[:target]}" },
      "held" => (r[:held] || []).map { |h| "#{h[:group]}:#{h[:artifact]} (#{h[:reason]})" },
    }
  end
  File.write(path, JSON.pretty_generate(by_repo.keys.sort.map { |app| by_repo.fetch(app) }))
end

def release_one(name, progress)
  dir = deploy_item_dir(name)
  return { ok: false, log: "no checkout at #{dir}" } unless File.directory?(File.join(dir, ".git"))

  branch = git_current_branch(dir)
  unless branch == "main"
    where = branch.nil? ? "detached HEAD" : "on #{branch.inspect}"
    return { ok: false, log: "not on main (#{where})" }
  end
  return { ok: false, log: "working tree is dirty" } unless git_clean?(dir)

  pull_out = `git -C #{dir} pull --ff-only origin main 2>&1`
  return { ok: false, log: "pull --ff-only failed: #{pull_out.strip}" } unless $?.success?

  # For devops the pull above IS the release — there is nothing to build, tag or
  # ship (see devops_deploy_state).
  return { ok: true, log: pull_out } if devops_repo?(name)

  return release_lib(dir) if lib_repo?(name)

  if db_repo?(name)
    release_bin = File.expand_path(File.join(__dir__, "release-db"))
    env = { "RELEASE_AUTO_TAG" => "1", "RELEASE_DB_AUTO_CONFIRM" => "1" }
  else
    release_bin = File.expand_path(File.join(__dir__, "release"))
    env = { "RELEASE_AUTO_TAG" => "1" }
  end
  # release-db accepts either `foo` or `foo-postgresql` as --app; pass the full
  # name so the script doesn't have to guess.
  run_release_capturing(env, release_bin, name, dir, progress)
rescue => e
  # Whatever the release printed before the crash is the diagnostic — the
  # exception on its own says nothing about how far the release got. The log
  # file is already on disk, so hand back its contents plus the backtrace.
  { ok: false, log: [release_log_excerpt(name),
                     "release_one raised: #{e.class}: #{e.message}",
                     Util.indent((e.backtrace || []).first(5).join("\n"))].compact.join("\n") }
end

# What the release wrote to its log file before something went wrong, or nil if
# it never got that far. Used when the in-memory buffer is unavailable because
# the capture path itself raised.
def release_log_excerpt(name)
  path = deploy_log_path(name)
  return nil unless File.exist?(path)

  text = Util.to_utf8(File.binread(path)).strip
  text.empty? ? nil : text
end

# Stable path (no timestamp) so `tail -f` can be pointed at it once and keep
# working across every future `dev deploy` run.
def deploy_log_path(app)
  dir = File.expand_path("~/Library/Logs/dev-deploy")
  FileUtils.mkdir_p(dir)
  File.join(dir, "#{app}.log")
end

# Runs a release subprocess, streaming its combined stdout/stderr to `app`'s
# stable log file as it runs (so a `tail -f` started before or during the run
# shows live progress), while also buffering the output to return for the
# failure summary and feeding `progress` for the live phase display. Any file
# left over from a prior run is deleted first, so stale output never
# masquerades as this run's progress.
#
# Reads chunks rather than lines. Util.step writes a stage's label the moment
# the stage begins and its "done (15s)" half only when it ends, so the running
# stage is by definition a line with no newline on it yet — `each_line` would
# hold it back until it was already finished.
#
# Bytes stay BINARY end to end — binary log file, binary buffer, decoded to
# UTF-8 only on the way out. `readpartial` returns ASCII-8BIT, and a text-mode
# IO transcodes on write, so a single "…" in a release script's output used to
# abort the release with `Encoding::UndefinedConversionError: "\xE2" from
# ASCII-8BIT to UTF-8` — reported as the whole failure, with the release's own
# output discarded (acumen + properties, 2026-07-31).
def run_release_capturing(env, release_bin, app, dir, progress)
  path = deploy_log_path(app)
  File.delete(path) if File.exist?(path)
  buffer = +"".b
  capture_error = nil
  status =
    File.open(path, "wb") do |f|
      Open3.popen2e(env, release_bin, "--app", app, chdir: dir) do |_stdin, out_err, wait_thr|
        begin
          loop do
            chunk = out_err.readpartial(4096)
            buffer << chunk
            # Keep draining the pipe even after a capture bug: a child whose
            # output nobody reads blocks forever on a full pipe, and the release
            # itself is still perfectly capable of finishing.
            next if capture_error

            begin
              f.write(chunk)
              f.flush
              progress.feed(app, chunk)
            rescue StandardError => e
              capture_error = "output capture failed after #{buffer.bytesize} bytes: #{e.class}: #{e.message}"
            end
          end
        rescue EOFError
          # Child closed the pipe: normal end of output.
        end
        wait_thr.value
      end
    end
  # A broken display or log file says nothing about whether the release worked
  # — the exit status does. Report the capture bug, don't let it masquerade as
  # a failed deploy.
  progress.message("  #{app}  WARNING: #{capture_error}") if capture_error
  log = Util.to_utf8(buffer)
  log = "#{log}\n#{capture_error}\n" if capture_error
  { ok: status.success?, log: log }
end

# Libraries release through the same `bin/release` entry point as everything
# else — it already dispatches a `lib-` checkout to release-lib — but with the
# terminal INHERITED rather than captured. release-lib is interactive all the
# way down (it confirms the tag, then GPG asks for the signing passphrase), and
# Open3.capture2e closes the child's stdin, so the first prompt would die on
# EOF. The tradeoff: output streams to the console instead of being buffered
# into the failure log, so on failure we point at what was already printed.
def release_lib(dir)
  release_bin = File.expand_path(File.join(__dir__, "release"))
  ok = system(release_bin, chdir: dir)
  { ok: !!ok, log: ok ? "" : "release failed (its output is above, not captured)" }
end

# Where to `tail -f` for the full output behind the phase display. Printed once
# per run rather than per app: the paths differ only by app name, and the live
# display already says which stage each app is on.
def deploy_log_hint
  "Logs: #{File.join(File.dirname(deploy_log_path("app")), "<app>.log")}"
end

# One app's release, start to finish, narrated through `progress`. Shared by
# the serial and concurrent drivers so both render identically.
def release_tracked(name, progress, results, results_mutex)
  progress.start(name)
  result =
    begin
      release_one(name, progress)
    rescue => e
      { ok: false, log: "worker crashed: #{e.class}: #{e.message}" }
    end
  results_mutex.synchronize { results[name] = result }
  progress.finish(name, ok: result[:ok])
  result
end

def release_serial(names, results, results_mutex, progress)
  names.each { |name| release_tracked(name, progress, results, results_mutex) }
end

def release_concurrent(names, concurrency, results, results_mutex, progress)
  return if names.empty?
  queue = Queue.new
  names.each { |n| queue << n }
  workers = Array.new([concurrency, names.length].min) do
    Thread.new do
      while (name = (queue.pop(true) rescue nil))
        release_tracked(name, progress, results, results_mutex)
      end
    end
  end
  workers.each(&:join)
end

def cmd_deploy_all(args)
  name_filter, concurrency = parse_deploy_all_args(args)
  rows = resolve_deploy_items(name_filter)

  pending = rows.select { |_, d| needs_deploy?(d) }.map(&:first)
  errors  = rows.select { |_, d| d[:error] }

  if pending.empty?
    puts "All apps up to date"
    unless errors.empty?
      puts ""
      errors.each { |name, d| puts "#{name}: #{d[:error]}" }
    end
    return
  end

  run_deploys(pending, concurrency: concurrency, errors: errors)
end

# The DB a pending app must wait for, or nil when nothing pending gates it.
# The dependency is the naming convention: `foo` runs against `foo-postgresql`.
# An app with no pending DB of its own (acumen while only platform-postgresql
# is pending) is NOT gated — it releases alongside the DB phase.
#
# Only an EXPANDING database gates its app. A contracting one is the reverse
# dependency — it waits for the app — so passing `db_pending` already narrowed
# to the expanding ones is what makes both orderings fall out of the same rule.
def blocking_db_for(app, db_pending)
  db = "#{app}-postgresql"
  db_pending.include?(db) ? db : nil
end

# The app a DB repo migrates, by the same naming convention.
def app_for_db(db)
  db.sub(/-postgresql$/, "")
end

# Splits pending DB repos into [expanding, contracting].
#
# A release is contracting when any migration it adds DROPs or RENAMEs a schema
# object (see SchemaScripts) — the running code still names those, so the drop
# has to land after the app that stops naming them, not before it. Everything
# else is expanding and keeps the DB-before-app ordering it has always had.
#
# The range is "the latest released tag .. origin/main", which is exactly what
# made the repo pending in the first place. A repo we cannot read that range for
# is treated as expanding: that is the historical behavior, and guessing
# "contracting" would defer a migration the new code may need.
def partition_db_releases(db_pending)
  db_pending.partition do |name|
    dir = deploy_item_dir(name)
    tag_out, tag_status = Open3.capture2("sem-info", "tag", "latest", chdir: dir)
    next true unless tag_status.success?
    SchemaScripts.contracting(dir, tag_out.strip, "origin/main").empty?
  end
end

# Phase banner for an app release. A single app releases serially, so the
# concurrency detail is noise — omit it. For multiple apps, show the effective
# pool size (`release_concurrent` caps workers at the number of apps), never the
# raw requested concurrency.
def deploy_app_phase_message(phase, to_run, concurrency)
  if to_run.length == 1
    "Phase #{phase}: releasing #{to_run.first}"
  else
    "Phase #{phase}: releasing #{to_run.length} app(s) with concurrency=#{[concurrency, to_run.length].min}: #{to_run.join(', ')}"
  end
end

# Releases `names` and prints the summary. Shared by `deploy all` and the
# `deploy status` prompt, so both get identical ordering, skip-on-DB-failure,
# and exit-code behavior. `errors` are deploy-detection failures to report
# alongside the summary; callers that have already displayed them pass none.
# Exits non-zero if any release fails.
#
# Only an app whose OWN database is pending waits for the DB phase. Everything
# else releases concurrently with it: a serial DB phase used to stall the whole
# fleet behind one unrelated migration (acumen sat behind platform-postgresql).
# DBs still release serially among themselves, and still before the app they
# gate — unless the release is contracting, which inverts that one dependency
# and moves the DB behind its app (see partition_db_releases).
def run_deploys(pending, concurrency:, errors: [])
  db_pending     = pending.select { |n| db_repo?(n) }
  lib_pending    = pending.select { |n| lib_repo?(n) }
  devops_pending = pending.select { |n| devops_repo?(n) }
  app_pending    = pending - db_pending - lib_pending - devops_pending

  expanding_dbs, contracting_dbs = partition_db_releases(db_pending)

  # Gating is computed against the EXPANDING databases only. An app whose own
  # database is contracting has to go FIRST, so it belongs with the free apps.
  gated_apps, free_apps = app_pending.partition { |n| blocking_db_for(n, expanding_dbs) }

  results_mutex = Mutex.new
  results = {}
  skipped = {}

  # Only the captured phases write those logs — a libraries-only run has none.
  unless db_pending.empty? && app_pending.empty?
    puts deploy_log_hint
    puts ""
  end

  # The display owns stdout for the captured phases (1 and 2). Phase 3 is
  # excluded on purpose: release-lib inherits the terminal to prompt for a GPG
  # passphrase, and nothing may be redrawing over a prompt.
  DeployProgress.for.run do |progress|
    unless expanding_dbs.empty?
      progress.message("Phase 1: releasing #{expanding_dbs.length} database(s) serially: #{expanding_dbs.join(', ')}")
      unless free_apps.empty?
        progress.message("         in parallel with #{free_apps.length} app(s) that depend on none of them: #{free_apps.join(', ')}")
      end
      progress.message("")
      db_thread = Thread.new { release_serial(expanding_dbs, results, results_mutex, progress) }
      release_concurrent(free_apps, concurrency, results, results_mutex, progress)
      db_thread.join
      progress.message("")
    end

    # Skip an app whose own DB just failed: deploying an app against an
    # unmigrated schema is exactly the failure mode the DB-first ordering is
    # meant to prevent.
    phase2_apps = expanding_dbs.empty? ? app_pending : gated_apps
    to_run = phase2_apps.reject do |n|
      db = blocking_db_for(n, expanding_dbs)
      if db && !(results[db] && results[db][:ok])
        skipped[n] = "db release failed (#{db})"
        true
      else
        false
      end
    end

    if to_run.empty? && !phase2_apps.empty?
      progress.message("Phase 2: all #{phase2_apps.length} app(s) skipped due to DB failures")
      progress.message("")
    elsif !to_run.empty?
      progress.message(deploy_app_phase_message(2, to_run, concurrency))
      progress.message("")
      release_concurrent(to_run, concurrency, results, results_mutex, progress)
    end

    # Contracting databases go here, after every app has rolled out. Dropping a
    # column or table the live code still selects is not a slow migration, it is
    # a 500 on every request that touches it for the length of the rollout —
    # production wore that twice in two days (ISS-317). Skipped, never forced,
    # when the app that stops using the object did not actually ship: the old
    # code is still serving, so the drop would break exactly what it broke then.
    #
    # The hold-back is keyed on the conventional app name, the same convention
    # blocking_db_for uses. A schema repo that feeds a second deployable (the
    # playbook-api copy of platform-postgresql) is still covered by the PHASE
    # ordering — every app in Phase 2 has rolled out by the time this runs — and
    # only by the failure check for its primary app.
    contracting_to_run = contracting_dbs.reject do |db|
      app = app_for_db(db)
      if pending.include?(app) && !(results[app] && results[app][:ok])
        skipped[db] = "contracting migration held back: #{app} did not release, so the code that still uses the dropped objects is live"
        true
      else
        false
      end
    end

    unless contracting_to_run.empty?
      progress.message("Phase 3: releasing #{contracting_to_run.length} contracting database(s) serially, after their apps: #{contracting_to_run.join(', ')}")
      progress.message("")
      release_serial(contracting_to_run, results, results_mutex, progress)
      progress.message("")
    end
  end

  # Libraries go last and one at a time: `release-lib` owns the terminal while
  # it prompts, so it must not compete with the parallel app phase for stdin.
  # Nothing depends on the ordering — consumers pin a released version, so a
  # lib release never affects an app deploy in the same run.
  unless lib_pending.empty?
    if interactive_terminal?
      puts ""
      puts "Phase 4: releasing #{lib_pending.length} librar#{lib_pending.length == 1 ? 'y' : 'ies'} serially (interactive): #{lib_pending.join(', ')}"
      puts ""
      release_serial(lib_pending, results, results_mutex, DeployProgress::Disabled.new)
    else
      lib_pending.each do |n|
        skipped[n] = "library release is interactive - run `release-lib` in #{deploy_item_dir(n)}"
      end
    end
  end

  # devops goes last and alone. Its pull rewrites bin/release, bin/release-scala,
  # bin/dev and friends — the exact scripts every other phase shells out to — so
  # doing it alongside a release would swap those files mid-flight.
  unless devops_pending.empty?
    puts ""
    puts "Phase 5: updating devops (git pull)"
    puts ""
    release_serial(devops_pending, results, results_mutex, DeployProgress::Disabled.new)
  end

  pending.each do |n|
    next if skipped.key?(n)
    results[n] ||= { ok: false, log: "no result recorded (worker died?)" }
  end
  attempted = pending.reject { |n| skipped.key?(n) }
  succeeded = attempted.select { |n| results[n][:ok] }
  failed    = attempted.reject { |n| results[n][:ok] }

  puts ""
  puts Util.underline("Summary")
  puts "  released: #{succeeded.empty? ? '(none)' : succeeded.join(', ')}"
  puts "  failed:   #{failed.join(', ')}" unless failed.empty?
  unless skipped.empty?
    skipped.each { |n, reason| puts "  skipped:  #{n} (#{reason})" }
  end

  unless errors.empty?
    puts ""
    puts "Deploy-detection errors:"
    errors.each { |name, d| puts "  #{name}: #{d[:error]}" }
  end

  unless failed.empty?
    puts ""
    failed.each do |name|
      puts Util.underline(name)
      # Named per app, not just in the one-time hint at the top: by the time a
      # summary is read the hint has scrolled away, and a failure whose captured
      # log is short (or is only a crash message) is exactly when the full file
      # matters most.
      log_path = deploy_log_path(name)
      puts "full log: #{log_path}" if File.exist?(log_path)
      puts results[name][:log]
      puts ""
    end
    exit 1
  end

  # A skip means pending work was not released — a failed DB (which already
  # exits 1 above), or a library skipped for want of a terminal. Either way the
  # fleet is still behind, so the exit code has to say so.
  exit 1 unless skipped.empty?
end

# ---------- config drift ----------

# Namespace + kube context are account-scoped: resolve (and pin kubectl to)
# the app's DO account, returning that account's namespace.
def k8s_namespace_for(app)
  DigitalOceanAccounts.activate_for_app!(Config.load(app))['namespace']
end

def k8s_apps(app_filter)
  registry = Work::Registry.load
  apps = registry.deployable.map(&:name).sort
  apps = apps.select { |n| File.exist?(File.expand_path("~/code/env/apps/#{n}/env/production.env")) }
  apps = apps.select { |n| n == app_filter } if app_filter
  Util.exit_with_error("No apps with production.env match '#{app_filter}'") if apps.empty?
  apps
end

def expected_config_vars(app)
  vars = JSON.parse(EnvironmentVariables.load(app, 'production').serialize('json'))
  vars.select { |k, _| k.start_with?('CONF_') }
end

def live_config_vars(app)
  out, status = Open3.capture2("kubectl", "get", "configmap", "#{app}-config",
                                "-n", k8s_namespace_for(app), "-o", "json")
  return nil unless status.success?
  JSON.parse(out)["data"] || {}
end

def diff_config(app)
  expected = expected_config_vars(app)
  live = live_config_vars(app)
  return { error: "ConfigMap #{app}-config not found" } if live.nil?

  missing  = expected.keys - live.keys
  extra    = live.keys - expected.keys
  changed  = (expected.keys & live.keys).select { |k| expected[k] != live[k] }
  { missing: missing, extra: extra, changed: changed, expected: expected, live: live }
end

def cmd_config_check(args)
  require 'open3'
  rest, app_filter, _ = parse_common_flags(args)
  reject_unknown_args("config check", rest)
  apps = k8s_apps(app_filter)

  any_drift = false
  apps.each do |app|
    d = diff_config(app)
    if d[:error]
      puts "#{app}: ERROR - #{d[:error]}"
      any_drift = true
      next
    end
    drift_count = d[:missing].length + d[:extra].length + d[:changed].length
    if drift_count == 0
      puts "#{app}: in sync (#{d[:expected].size} keys)"
    else
      any_drift = true
      puts "#{app}: DRIFT (#{drift_count} differences)"
      d[:missing].sort.each { |k| puts "  + #{k} (in env, not in cluster)" }
      d[:extra].sort.each   { |k| puts "  - #{k} (in cluster, not in env)" }
      d[:changed].sort.each do |k|
        puts "  ~ #{k}"
        puts "      env:     #{d[:expected][k].inspect}"
        puts "      cluster: #{d[:live][k].inspect}"
      end
    end
  end
  exit(any_drift ? 1 : 0)
end

def cmd_config_rollout(args)
  require 'open3'
  rest, app_filter, _ = parse_common_flags(args)
  reject_unknown_args("config rollout", rest)
  apps = k8s_apps(app_filter)

  apps.each do |app|
    puts ""
    puts Util.underline("#{app}: apply k8s-secrets")
    Util.sync_k8s_secrets(app)

    puts ""
    puts Util.underline("#{app}: rollout restart")
    ns = k8s_namespace_for(app)
    Util.run("kubectl rollout restart statefulset,deployment -l app=#{app} -n #{ns}")
    Util.run("kubectl rollout status statefulset,deployment -l app=#{app} -n #{ns} --timeout=5m")
  end
end

# ---------- browserslist ----------

# Scratch dir stem under ~/code for a browserslist sweep's clones — one dir per
# day, and purge_scratch_workdirs finds earlier days by this prefix.
BROWSERSLIST_WORKDIR_PREFIX = "browserslist".freeze

def git_current_branch(path)
  # -q keeps `symbolic-ref` from printing "fatal: ref HEAD is not a symbolic ref"
  # to stderr for a detached HEAD — that's an expected state here (caller treats a
  # nil branch as detached), not an error worth surfacing during a prune scan.
  out, status = Open3.capture2("git", "-C", path, "symbolic-ref", "-q", "--short", "HEAD")
  status.success? ? out.strip : nil
end

def git_clean?(path)
  out, status = Open3.capture2("git", "-C", path, "status", "--porcelain")
  status.success? && out.strip.empty?
end

def run_step(cmd, path, verbose, captured_log, env: {})
  if verbose
    ok = system(env, *cmd, chdir: path)
    [ok, nil]
  else
    out, status = Open3.capture2e(env, *cmd, chdir: path)
    # Subprocess output can contain arbitrary bytes; scrub so one malformed
    # byte can't crash the regex/string matching every caller does on it.
    out = Util.to_utf8(out)
    captured_log << out
    [status.success?, out]
  end
rescue Errno::ENOENT, Errno::EACCES => e
  # A missing or unexecutable binary is a FAILED STEP, not an exception thrown
  # out of the sweep. `capture2e` raises where `system` merely returns nil, so
  # without this the two modes disagree and one absent tool (`npx` on a box with
  # no node) aborts the loop mid-repo, discarding every result already collected
  # and every one still to come.
  #
  # It also decides an exit code now. `dev browserslist update --check` is the
  # first step of a playbook (ISS-525) and its codes are a contract: an ENOENT
  # escaping here left the process at 1, which in that contract reads "these
  # repos need updating" — sending a session to open PRs for repos nothing ever
  # examined. As a step failure it lands in `failures` and comes back as 2,
  # "nothing was concluded", which is what actually happened. The producer
  # registry got this right for the same reason: checks run through /bin/sh so a
  # missing binary arrives as exit 127 rather than an ENOENT out of the tick.
  message = "#{cmd.first}: #{e.message}\n"
  captured_log << message
  [false, message]
end

# Last `n` non-blank lines of a captured subprocess log: enough to say WHY a step
# failed in a one-repo summary line without pasting a whole sbt run into it.
def last_lines(out, n)
  out.to_s.split("\n").reject { |line| line.strip.empty? }.last(n).to_a.join("\n")
end

def report_repo_line(name, status, detail, verbose)
  return if verbose
  suffix = detail ? "#{status}: #{detail}" : status
  puts "  #{name} [#{suffix}]"
end

def git_origin_url(path)
  out, status = Open3.capture2("git", "-C", path, "config", "--get", "remote.origin.url")
  status.success? ? out.strip : nil
end

# ---------- aidirs prune ----------
#
# Feature dirs under ~/code/ai are throwaway clones (one branch per dir, same
# name across every repo inside) and cheap to recreate, so prune is AGGRESSIVE:
# once a dir has gone `--days` (default 3) without activity we delete it outright,
# whatever its git state. There is no staging area — a dir holding work that isn't
# on a remote (uncommitted/stashed/detached/loose files or local-only commits) is
# deleted too, with the reason printed so the dry-run says what it is losing.
# Deferred deletion just moved the disk usage rather than reclaiming it.
#
# RECENT dirs (touched within the window) keep full protection: any at-risk state
# keeps them, and `gh` is asked for the PR state so a squash-merged branch — whose
# local commits never match main and look "unpushed" — is recognized as landed and
# deleted even though it was just touched. `gh` is consulted ONLY for recent dirs;
# aged-out dirs reap regardless of PR state, so the lookup would change nothing.

AI_ROOT = File.expand_path("~/code/ai")

# The feature dirs under `root` that prune is allowed to consider.
#
# Symlinks are skipped because deleting one removes the link and not the target.
# DOTTED entries are skipped because they are the session tooling's own state
# rather than anybody's work: .claude-db-ports.json records which host port
# belongs to which container, and .claude-db-schema holds the schema clone
# `claude-db` keeps pinned at origin/main. Both live here because ~/code/ai is
# the one root every session — human or agent — can agree on. Neither has a
# branch or a PR behind it, so classifying them as feature dirs puts a line in
# the daily briefing for something nobody is working on, and reaping one throws
# away a cache that then has to be re-cloned.
def prunable_ai_dirs(root)
  Dir.children(root)
     .reject { |c| c.start_with?(".") }
     .map { |c| File.join(root, c) }
     .select { |p| !File.symlink?(p) && File.directory?(p) }
     .sort
end

def git_repo?(path)
  File.exist?(File.join(path, ".git"))
end

# True if HEAD has commits that live on no remote-tracking branch. On a merged,
# squash-landed branch this is true even though the work is on main — callers
# gate on the PR state before treating it as unsafe.
def git_has_local_only_commits?(path)
  out, status = Open3.capture2("git", "-C", path, "log", "--branches", "--not", "--remotes", "--oneline", "-1")
  status.success? && !out.strip.empty?
end

# owner/repo parsed from the origin url (git@github.com:o/r.git or https://…/o/r).
def git_slug(path)
  url = git_origin_url(path) or return nil
  m = url.match(%r{github\.com[:/](.+?)(?:\.git)?/?\z}) or return nil
  m[1]
end

# A branch's PR as {state: :merged|:closed|:open, number: N}, or nil when there is
# no PR or `gh` is unavailable/erroring. nil is treated as "not safe" by the
# caller, so a missing `gh` binary degrades to keeping the dir, not crashing.
def gh_pr_state(slug, branch)
  return nil unless slug && branch
  out, status = Open3.capture2(
    "gh", "pr", "list", "--repo", slug, "--head", branch,
    "--state", "all", "--json", "state,number",
    "--jq", ".[0] | select(.) | \"\\(.state) \\(.number)\""
  )
  return nil unless status.success?
  state_s, num = out.strip.split(" ", 2)
  sym = { "MERGED" => :merged, "CLOSED" => :closed, "OPEN" => :open }[state_s]
  sym && { state: sym, number: num.to_i }
rescue Errno::ENOENT
  nil
end

def git_has_stash?(path)
  out, status = Open3.capture2("git", "-C", path, "stash", "list")
  status.success? && !out.strip.empty?
end

# Real (non-symlink) git repos inside a feature dir: the dir itself when it is a
# clone, plus each immediate subdir. Symlinks (e.g. devops@ -> shared checkout)
# are skipped — deleting the feature dir only removes the link, not the target.
def ai_dir_repos(dir)
  candidates = [dir] + Dir.children(dir).map { |c| File.join(dir, c) }
  candidates.select { |p| !File.symlink?(p) && File.directory?(p) && git_repo?(p) }
end

def dir_effectively_empty?(dir)
  Dir.children(dir).all? { |c| File.symlink?(File.join(dir, c)) }
end

# Top-level entries that are neither a symlink nor one of the detected repos —
# loose files or non-repo dirs that no git check below would ever cover. Skipped
# when the feature dir is itself a clone (repos includes dir): then every
# top-level file is git-tracked and git_clean? already accounts for it.
def ai_dir_has_loose_content?(dir, repos)
  return false if repos.include?(dir)
  repo_names = repos.map { |r| File.basename(r) }
  Dir.children(dir).any? do |c|
    !File.symlink?(File.join(dir, c)) && !repo_names.include?(c)
  end
end

# Newest activity across the dir and its repos' git metadata — catches a session
# committing deep inside a repo without touching the top-level dir mtime.
def ai_dir_last_activity(dir, repos)
  times = [File.mtime(dir)]
  repos.each do |r|
    %w[.git/index .git/HEAD .git/ORIG_HEAD].each do |f|
      p = File.join(r, f)
      times << File.mtime(p) if File.exist?(p)
    end
  end
  times.max
end

# Returns [action, reason, pr_notes] where action is :keep or :delete, reason is a
# short explanation (nil when there was nothing at risk), and pr_notes is an array
# of "repo#N STATE" strings for any PR consulted while classifying — surfaced in
# the output so the dir<->PR tie is visible (e.g. deleted because platform#1204
# merged). pr_state is injected for testing; it defaults to the gh-backed lookup.
#
# Feature dirs are cheap to recreate, so the default posture is AGGRESSIVE: once a
# dir has gone `cutoff` days without activity we delete it, whatever its git state,
# including work that isn't on a remote. The reason names what is being lost so the
# dry-run is reviewable before --apply.
#
# RECENT dirs (touched within cutoff) keep the full old protection: any at-risk
# state → :keep, and gh is consulted so a merged/closed PR still lets a landed dir
# be deleted even though it was touched today. gh is ONLY called for recent dirs —
# aged-out dirs reap regardless of PR state, so the lookup would change nothing.
def classify_ai_dir(dir, cutoff_time:, pr_state:)
  repos = ai_dir_repos(dir)
  recent = ai_dir_last_activity(dir, repos) >= cutoff_time

  # ---- aged out: delete regardless of git state. No gh calls. ----
  unless recent
    return classify_aged_out(dir, repos)
  end

  # ---- recent: full protection (unchanged behavior) ----
  if repos.empty?
    return [:delete, nil, []] if dir_effectively_empty?(dir)
    return [:keep, "no git repo (unexpected content)", []]
  end

  return [:keep, "unexpected non-repo content", []] if ai_dir_has_loose_content?(dir, repos)

  repos.each do |r|
    name = File.basename(r)
    # Detached HEAD: commits made while detached hang off no branch ref, so
    # git_has_local_only_commits? (which walks --branches) can't see them. Keep
    # rather than risk deleting unreachable work.
    return [:keep, "detached HEAD in #{name}", []] if git_current_branch(r).nil?
    return [:keep, "uncommitted changes in #{name}", []] unless git_clean?(r)
    return [:keep, "stashed changes in #{name}", []] if git_has_stash?(r)
  end

  pr_notes = []
  merged_confirmed = false
  repos.each do |r|
    name = File.basename(r)
    branch = git_current_branch(r)
    has_local = git_has_local_only_commits?(r)
    # A repo sitting on main/master with everything pushed has no branch work to
    # reason about — nothing to lose, and no PR to look up. Skip it entirely.
    next if %w[main master].include?(branch) && !has_local

    # Consult the PR even when nothing is local-only: a squash-merged branch stays
    # on its (lingering) origin/<branch> ref, so it reads as "fully pushed" — the
    # only way to know it LANDED (vs. an open/unopened PR) is to ask gh.
    pr = pr_state.call(git_slug(r), branch)
    landed = pr && %i[merged closed].include?(pr[:state])
    pr_notes << "#{name}##{pr[:number]} #{pr[:state].to_s.upcase}" if pr

    if landed
      merged_confirmed = true
      next
    end
    # Local commits that never landed = unsaved work. Never delete.
    if has_local
      label = pr ? pr_notes.last : "#{name} (no PR)"
      pr_notes << label unless pr
      return [:keep, "local-only commits: #{label}", pr_notes]
    end
    # Otherwise: pushed to a feature branch with an open/unopened PR — safe on the
    # remote but plausibly still active. It's recent, so keep it.
  end

  # A merged/closed PR is proof the work landed — delete even though recent.
  # Otherwise everything is merely pushed with nothing landed; it's recent, so
  # keep the still-active dir.
  return [:delete, nil, pr_notes] if merged_confirmed
  [:keep, "modified within cutoff", pr_notes]
end

# Classify a dir that has gone quiet past the cutoff. Every aged-out dir is
# deleted; the only output that varies is the reason, which names what the dir
# still holds that isn't on a remote (nil when it is clean and fully pushed) so
# the dry-run shows what --apply would destroy. gh is never consulted here — the
# action is the same whether or not a PR landed.
def classify_aged_out(dir, repos)
  [:delete, aged_out_at_risk_reason(dir, repos), []]
end

# Short description of the unsaved work an aged-out dir still holds, or nil when
# nothing is at risk (every repo clean and fully pushed).
def aged_out_at_risk_reason(dir, repos)
  return dir_effectively_empty?(dir) ? nil : "aged out: unexpected non-repo content" if repos.empty?
  return "aged out: unexpected non-repo content" if ai_dir_has_loose_content?(dir, repos)

  repos.each do |r|
    name = File.basename(r)
    return "aged out: detached HEAD in #{name}" if git_current_branch(r).nil?
    return "aged out: uncommitted changes in #{name}" unless git_clean?(r)
    return "aged out: stashed changes in #{name}" if git_has_stash?(r)
    # Local-only commits aren't provably on a remote (a squash-merge would land
    # them, but confirming that needs gh, which we skip for aged-out dirs), so
    # flag them even though most are already landed work.
    return "aged out: local-only commits in #{name}" if git_has_local_only_commits?(r)
  end

  nil
end

def cmd_aidirs_prune(args)
  days = 3
  apply = false
  while (arg = args.shift)
    case arg
    when "--days"
      raw = args.shift or usage_exit("--days requires a value", example: usage_for("aidirs prune"))
      days = Integer(raw) rescue usage_exit("--days must be an integer", example: usage_for("aidirs prune"))
    when "--apply" then apply = true
    when "-h", "--help" then puts USAGE; exit 0
    else usage_exit("Unknown flag: #{arg}", example: usage_for("aidirs prune"))
    end
  end
  usage_exit("--days must be >= 0", example: usage_for("aidirs prune")) if days < 0

  unless Dir.exist?(AI_ROOT)
    puts "Nothing to prune: #{AI_ROOT} does not exist."
    write_aidirs_briefing_status([], 0) if apply
    return
  end

  cutoff = Time.now - days * 24 * 60 * 60
  dirs = prunable_ai_dirs(AI_ROOT)
  pr_state = method(:gh_pr_state)

  keep = []
  to_delete = []
  dirs.each do |dir|
    action, reason, notes = classify_ai_dir(dir, cutoff_time: cutoff, pr_state: pr_state)
    (action == :keep ? keep : to_delete) << [dir, reason, notes]
  end

  puts "Scanned #{dirs.length} dir(s) under #{AI_ROOT}."
  puts "Deleting any dir idle > #{days} day(s), including dirs holding work not on a remote (uncommitted, stashed, detached, loose files, or local-only commits) — the reason below names what each one is losing."
  puts "Keeping dirs touched within #{days} day(s) (recent work is fully protected, and a landed merged/closed PR still lets a recent dir be deleted)."
  puts ""
  puts "Keeping #{keep.length}:"
  keep.each { |d, r, _| puts "  #{File.basename(d)}  (#{r})" }

  unless to_delete.empty?
    puts ""
    puts "Delete #{to_delete.length}:"
    to_delete.each do |d, reason, notes|
      note_parts = [reason, *(notes || [])].compact.reject(&:empty?)
      suffix = note_parts.empty? ? "" : "  (#{note_parts.join(', ')})"
      puts "  #{File.basename(d)}#{suffix}"
    end
  end

  if to_delete.empty?
    puts ""
    puts "Nothing to remove."
    write_aidirs_briefing_status([], 0) if apply
    return
  end
  unless apply
    puts ""
    puts "(dry-run — pass --apply to delete these)"
    return
  end

  deleted = 0
  removed = []
  reclaimed_kb = 0
  skipped = []
  to_delete.each do |dir, _, _|
    # Re-check immediately before removing: parallel sessions routinely touch
    # ~/code/ai/* between the scan and here, so a dir can become active in the
    # window. Skip anything no longer classified for deletion.
    action, reason = classify_ai_dir(dir, cutoff_time: cutoff, pr_state: pr_state)
    if action == :keep
      skipped << [File.basename(dir), reason]
      next
    end
    reclaimed_kb += aidirs_size_kb(dir)
    FileUtils.rm_rf(dir)
    deleted += 1
    removed << [File.basename(dir), reason]
  end

  puts ""
  unless skipped.empty?
    puts "Skipped #{skipped.length} dir(s) that changed since the scan:"
    skipped.each { |name, r| puts "  #{name}  (#{r})" }
    puts ""
  end
  puts "Deleted #{deleted} dir(s)."
  write_aidirs_briefing_status(removed, reclaimed_kb)
end

# Disk this dir is about to give back, in KB. `du` rather than a Ruby walk
# because a feature dir holds several full clones plus node_modules — hundreds of
# thousands of files — and this runs once per deleted dir. Best effort: an
# unreadable dir reports 0 rather than failing the prune.
def aidirs_size_kb(dir)
  out, status = Open3.capture2e("du", "-sk", dir)
  return 0 unless status.success?
  out.split(/\s+/).first.to_i
rescue
  0
end

# The morning briefing's "AI Dirs Prune" section (item 19) reads this file and
# skips it unless `Last run:` is today AND at least one dir was removed. Written
# by the command rather than by the caller because the producer that replaced the
# openclaw cron runs the command and nothing else.
def write_aidirs_briefing_status(removed, reclaimed_kb)
  body = +"Last run: #{Briefing.today}\n"
  if removed.empty?
    body << "Nothing to prune.\n"
  else
    removed.each { |name, reason| body << "#{name} (#{reason})\n" }
    body << "Reclaimed: #{docker_format_size(reclaimed_kb * 1024)}\n"
  end
  Briefing.write("aidirs-prune-status.md", body)
end

# ---------- prune plans ----------
#
# ~/code/claude/plans is append-only in practice: ~90% of the files there were
# written in one commit and never touched again, and the directory grows by
# hundreds a month. Old plans have no value in the working tree — nothing indexes
# them, nothing links them, and a flat directory of thousands makes the live ones
# unfindable. The real cost is worse than clutter: a months-old plan reads exactly
# like a current one, so a session can pick up a stale snapshot as present-tense
# truth.
#
# So we `git rm` anything whose last commit is past the window. This is safe
# precisely because it is a git repo — the content stays in history and
# `git show <sha>:plans/<file>` recovers it. That safety is also the one hard
# invariant: a file whose current content is NOT in history (untracked, or tracked
# with uncommitted changes) is ALWAYS kept, because for those "it's in git" is
# false and removal would be permanent.

CLAUDE_ROOT = File.expand_path("~/code/claude")
PLANS_RELPATH = "plans"

# Commit timestamps come back on their own lines, marked so a filename can never
# be mistaken for one (git paths in this repo never start with "@@").
PLANS_LOG_FORMAT = "@@%ct"

# [ok, combined_output] for one command. Output is scrubbed to UTF-8 because it
# is only ever shown in an error message, and one malformed byte from git should
# not crash the reporting path.
def prune_run(cmd)
  out, status = Open3.capture2e(*cmd)
  [status.success?, Util.to_utf8(out).strip]
end

# path (repo-relative) => epoch seconds of the most recent commit touching it,
# for every file under plans/. One `git log` walk rather than a call per file:
# at ~1300 files the per-file form takes minutes.
def plans_last_commit_times(repo)
  out, status = Open3.capture2(
    "git", "-C", repo, "log", "--format=#{PLANS_LOG_FORMAT}", "--name-only", "--", PLANS_RELPATH
  )
  return {} unless status.success?

  times = {}
  current = nil
  out.each_line do |line|
    line = line.chomp
    next if line.empty?
    if line.start_with?("@@")
      current = line[2..].to_i
    else
      # First sighting wins: `git log` is newest-first, so that is the most
      # recent commit to touch the path.
      times[line] ||= current
    end
  end
  times
end

# Repo-relative paths under plans/ whose working-tree content differs from HEAD
# (modified, staged, or untracked). Read from the SHARED checkout, since that is
# where a parallel session's in-flight edits live.
def plans_dirty_paths(repo)
  out, status = Open3.capture2("git", "-C", repo, "status", "--porcelain", "--", PLANS_RELPATH)
  return nil unless status.success?
  out.each_line.map { |line|
    # "XY <path>", with renames as "orig -> new". Take the live path.
    path = line[3..].to_s.chomp.split(" -> ").last.to_s
    path.delete_prefix('"').delete_suffix('"')
  }.reject(&:empty?).to_set
end

# Keep or delete one plan file, and why. Pure so the policy is testable without
# a repo: the three keep reasons are the whole safety story.
def classify_plan_file(path, last_commit_time:, dirty:, cutoff_time:)
  return [:keep, "untracked — content is not in git history"] if last_commit_time.nil?
  return [:keep, "uncommitted changes — content is not in git history"] if dirty
  return [:keep, "committed within window"] if last_commit_time >= cutoff_time.to_i
  [:delete, nil]
end

# Repo-relative paths currently tracked under plans/. This — not the git log — is
# the candidate universe: `git log` also lists paths a PREVIOUS prune already
# removed, which are still in history and would otherwise be re-offered for
# deletion on every run, inflating the count and the commit message.
def plans_tracked_files(repo)
  out, status = Open3.capture2("git", "-C", repo, "ls-files", "--", PLANS_RELPATH)
  return nil unless status.success?
  out.each_line.map(&:chomp).reject(&:empty?)
end

# Top-level plan files only. Subdirectories under plans/ (specs/, prompts/,
# superpowers/, per-app collections) are curated groupings rather than the dated
# write-once stream this reaps, so they are left alone entirely.
def plans_top_level_candidates(paths)
  paths.select { |p|
    p.start_with?("#{PLANS_RELPATH}/") && !p.delete_prefix("#{PLANS_RELPATH}/").include?("/")
  }.sort
end

# Run the removal in a detached worktree off origin/main and push HEAD:main.
# ~/code/claude is a single checkout shared by every concurrent session, so
# staging 700 deletions in it would collide with whatever else is mid-edit there.
# The worktree touches none of that; the shared checkout sees the removals on its
# next pull. Returns true on success.
def prune_plans_apply(repo, paths, days)
  ok, _ = prune_run(["git", "-C", repo, "fetch", "--quiet", "origin", "main"])
  return false unless ok

  worktree = File.join(Dir.tmpdir, "dev-prune-plans-#{Process.pid}")
  FileUtils.rm_rf(worktree)
  ok, err = prune_run(["git", "-C", repo, "worktree", "add", "--quiet", "--detach", worktree, "origin/main"])
  unless ok
    warn "Could not create worktree: #{err}"
    return false
  end

  begin
    # --ignore-unmatch: origin/main can lack a file the local HEAD has (another
    # session's push is not required to be visible here), and that is not an error.
    paths.each_slice(500) do |batch|
      ok, err = prune_run(["git", "-C", worktree, "rm", "--quiet", "--ignore-unmatch", "--", *batch])
      unless ok
        warn "git rm failed: #{err}"
        return false
      end
    end

    _, staged = prune_run(["git", "-C", worktree, "diff", "--cached", "--name-only"])
    if staged.empty?
      puts "Nothing to remove on origin/main (already pruned)."
      return true
    end

    message = "Prune #{paths.length} plan(s) not committed in #{days} day(s)\n\n" \
              "Recover any of these with `git show <sha>:<path>`."
    ok, err = prune_run(["git", "-C", worktree, "commit", "--quiet", "-m", message])
    unless ok
      warn "git commit failed: #{err}"
      return false
    end

    ok, err = prune_run(["git", "-C", worktree, "push", "--quiet", "origin", "HEAD:main"])
    unless ok
      warn "git push failed: #{err}"
      return false
    end
    true
  ensure
    prune_run(["git", "-C", repo, "worktree", "remove", "--force", worktree])
    FileUtils.rm_rf(worktree)
  end
end

def cmd_prune_plans(args)
  days = 14
  apply = false
  while (arg = args.shift)
    case arg
    when "--days"
      raw = args.shift or usage_exit("--days requires a value", example: usage_for("prune plans"))
      days = Integer(raw) rescue usage_exit("--days must be an integer", example: usage_for("prune plans"))
    when "--apply" then apply = true
    when "-h", "--help" then puts USAGE; exit 0
    else usage_exit("Unknown flag: #{arg}", example: usage_for("prune plans"))
    end
  end
  usage_exit("--days must be >= 0", example: usage_for("prune plans")) if days < 0

  plans_dir = File.join(CLAUDE_ROOT, PLANS_RELPATH)
  unless Dir.exist?(plans_dir)
    puts "Nothing to prune: #{plans_dir} does not exist."
    return
  end

  dirty = plans_dirty_paths(CLAUDE_ROOT)
  if dirty.nil?
    warn "Could not read git status in #{CLAUDE_ROOT}."
    exit 1
  end

  tracked = plans_tracked_files(CLAUDE_ROOT)
  if tracked.nil?
    warn "Could not list tracked files in #{CLAUDE_ROOT}."
    exit 1
  end

  cutoff = Time.now - days * 24 * 60 * 60
  times = plans_last_commit_times(CLAUDE_ROOT)
  candidates = plans_top_level_candidates(tracked)

  keep = []
  to_delete = []
  candidates.each do |path|
    action, reason = classify_plan_file(
      path, last_commit_time: times[path], dirty: dirty.include?(path), cutoff_time: cutoff
    )
    (action == :keep ? keep : to_delete) << [path, reason]
  end

  puts "Scanned #{candidates.length} top-level plan file(s) in #{plans_dir}."
  puts "Removing any file whose last commit is more than #{days} day(s) old; content stays recoverable from git history."
  puts "Keeping #{keep.length} (recent, or holding content not yet in history)."
  puts ""

  if to_delete.empty?
    puts "Nothing to remove."
    return
  end

  puts "Remove #{to_delete.length}:"
  to_delete.first(20).each { |path, _| puts "  #{File.basename(path)}" }
  puts "  … and #{to_delete.length - 20} more" if to_delete.length > 20

  protected_now = keep.reject { |_, reason| reason == "committed within window" }
  unless protected_now.empty?
    puts ""
    puts "Protected #{protected_now.length} despite age (content not in git history):"
    protected_now.each { |path, reason| puts "  #{File.basename(path)}  (#{reason})" }
  end

  unless apply
    puts ""
    puts "(dry-run — pass --apply to remove these)"
    return
  end

  puts ""
  exit 1 unless prune_plans_apply(CLAUDE_ROOT, to_delete.map(&:first), days)
  puts "Removed #{to_delete.length} plan(s) and pushed to main."
  puts "#{CLAUDE_ROOT} picks the deletions up on its next pull."
end

# Shared shallow-clone-into-workdir idiom used by `browserslist update`,
# `codegen sync` and `dependencies check/upgrade`: wipe any stale directory left
# from a prior run, then `git clone --depth=1 --quiet`. Returns the clone path on
# success, nil on failure — with git's own output appended to `captured`, which
# is the only place the reason survives (callers report it).
#
# The transport is forced to HTTPS and the prompt is disabled here rather than at
# each call site: all three sweeps run unattended, and this is the single choke
# point every one of them clones through.
def clone_repo(origin, name, workdir, verbose, captured)
  clone_path = File.join(workdir, name)
  FileUtils.rm_rf(clone_path) if File.directory?(clone_path)
  cmd = ["git", "clone", "--depth=1", "--quiet", github_https_url(origin), clone_path]
  ok, _ = run_step(cmd, workdir, verbose, captured, env: GIT_NONINTERACTIVE_ENV)
  ok ? clone_path : nil
end

# A one-line-plus-tail reason for a failed clone. A bare "clone failed" is what
# sent ISS-478 to a human to reproduce by hand — git's own message ("Permission
# denied (publickey)", "Repository not found", "could not read Username") names
# the cause, and it is already in the log clone_repo captured.
def clone_failed_error(log)
  tail = last_lines(log, 5)
  tail.empty? ? "clone failed" : "clone failed: #{tail}"
end

# `--check`'s verdict, in the exit-code contract every producer check speaks
# (0 clean / 1 findings / >1 the check itself broke). It survives the move out of
# a producer's `check` field and into the playbook (ISS-525): the claiming
# session reads these codes the same way the tick used to.
#
# Findings beat uncheckable deliberately, for the reason codegen's check gives:
# a repo that demonstrably regenerated to a diff is a real finding worth a PR
# even when a sibling failed to clone, and exit 2 would drop it on the floor
# until next Monday. Nothing examined at all is never evidence of "up to date".
BROWSERSLIST_EXIT_CLEAN       = 0
BROWSERSLIST_EXIT_FINDINGS    = 1
BROWSERSLIST_EXIT_UNCHECKABLE = 2

def browserslist_check_exit_code(pending:, no_changes:, failures:)
  return BROWSERSLIST_EXIT_FINDINGS unless pending.empty?
  return BROWSERSLIST_EXIT_UNCHECKABLE unless failures.empty?
  return BROWSERSLIST_EXIT_UNCHECKABLE if no_changes.empty?

  BROWSERSLIST_EXIT_CLEAN
end

# The check's stdout is what the claiming session reads to decide what to do, so
# it names the repos rather than just reporting that there is drift.
def browserslist_check_verdict(pending:, no_changes:, failures:, code:)
  case code
  when BROWSERSLIST_EXIT_CLEAN
    "caniuse-lite is up to date in all #{no_changes.length} repo(s) — nothing to update"
  when BROWSERSLIST_EXIT_FINDINGS
    "caniuse-lite is out of date in #{pending.length} repo(s): #{pending.sort.join(', ')}\n" \
      "Update each one on a branch and open a PR — never push to main."
  else
    "browserslist update --check could not complete#{failures.empty? ? ' — no repo was examined' : ": #{failures.join(', ')}"}\n" \
      "Nothing was concluded about caniuse-lite in any repo."
  end
end

def cmd_browserslist_update(args)
  verbose = false
  keep_tmp = false
  check = false
  app_filter = nil
  i = 0
  rest = []
  while i < args.length
    a = args[i]
    case a
    when "--verbose", "-v" then verbose = true; i += 1
    when "--keep-tmp-dir"  then keep_tmp = true; i += 1
    when "--check"         then check = true; i += 1
    when "--app"
      app_filter = args[i + 1]
      usage_exit("--app requires a value", example: usage_for("browserslist update")) if app_filter.nil?
      i += 2
    else
      rest << a
      i += 1
    end
  end
  usage_exit("browserslist update takes no positional arguments", example: usage_for("browserslist update")) unless rest.empty?

  code_root = File.expand_path("~/code")
  source_repos = Dir.children(code_root)
    .map { |name| File.join(code_root, name) }
    .select { |path| File.directory?(path) && File.exist?(File.join(path, "package.json")) && File.directory?(File.join(path, ".git")) }
    .sort

  # Both "nothing to work on" paths exit UNCHECKABLE in check mode rather than
  # reporting clean: an empty repo list means nothing was examined, which is
  # never evidence that caniuse-lite is current. `exit_with_error`'s own status
  # is 1, which in this contract would mean "found repos needing an update".
  if app_filter
    source_repos = source_repos.select { |p| File.basename(p) == app_filter }
    if source_repos.empty?
      message = "No repo named '#{app_filter}' with package.json + .git under #{code_root}"
      Util.exit_with_error(message) unless check
      warn message
      exit BROWSERSLIST_EXIT_UNCHECKABLE
    end
  end

  if source_repos.empty?
    puts "No repos with package.json + .git under #{code_root}"
    exit BROWSERSLIST_EXIT_UNCHECKABLE if check
    return
  end

  date = Time.now.strftime("%Y%m%d")
  workdir = File.join(code_root, "#{BROWSERSLIST_WORKDIR_PREFIX}.#{date}")
  # Reclaim earlier days' clones before adding another day's worth.
  purge_scratch_workdirs(BROWSERSLIST_WORKDIR_PREFIX, keep: workdir)
  FileUtils.mkdir_p(workdir) unless File.directory?(workdir)

  puts "Working in #{workdir}"
  puts "Processing #{source_repos.length} repo(s)..."
  puts ""

  failures = []
  updated = []
  pending = []
  no_changes = []
  no_remote = []
  logs = {}

  source_repos.each do |src_path|
    name = File.basename(src_path)
    puts Util.underline(name) if verbose

    origin = git_origin_url(src_path)
    if origin.nil? || origin.empty?
      no_remote << name
      report_repo_line(name, "skipped", "no remote", verbose)
      puts "" if verbose
      next
    end

    captured = +""
    clone_path = clone_repo(origin, name, workdir, verbose, captured)
    unless clone_path
      failures << "#{name} (clone failed)"
      logs[name] = captured unless verbose
      report_repo_line(name, "FAIL", "git clone", verbose)
      puts "" if verbose
      next
    end

    ok, _ = run_step(["npx", "--yes", "update-browserslist-db@latest"], clone_path, verbose, captured)
    unless ok
      failures << name
      logs[name] = captured unless verbose
      report_repo_line(name, "FAIL", "update-browserslist-db", verbose)
      puts "" if verbose
      next
    end

    if git_clean?(clone_path)
      no_changes << name
      report_repo_line(name, "no changes", nil, verbose)
      puts "" if verbose
      next
    end

    # The detector stops here: the updater rewrote something, which IS the
    # finding. Committing or pushing it is the fix, and the fix belongs to the
    # session that claims the issue this exit code files.
    if check
      pending << name
      report_repo_line(name, "needs update", nil, verbose)
      puts "" if verbose
      next
    end

    msg = "Update caniuse-lite via update-browserslist-db"
    ok, _ = run_step(["git", "-C", clone_path, "commit", "-am", msg], clone_path, verbose, captured)
    unless ok
      failures << "#{name} (commit failed)"
      logs[name] = captured unless verbose
      report_repo_line(name, "FAIL", "git commit", verbose)
      puts "" if verbose
      next
    end

    ok, _ = run_step(["git", "-C", clone_path, "push", "origin", "HEAD:main"], clone_path, verbose, captured)
    unless ok
      failures << "#{name} (push failed)"
      logs[name] = captured unless verbose
      report_repo_line(name, "FAIL", "git push", verbose)
      puts "" if verbose
      next
    end

    updated << name
    report_repo_line(name, "done", nil, verbose)
    puts "" if verbose
  end

  puts ""
  puts Util.underline("Summary")
  if check
    puts "  needs update:     #{pending.empty? ? '(none)' : pending.join(', ')}"
  else
    puts "  updated + pushed: #{updated.empty? ? '(none)' : updated.join(', ')}"
  end
  puts "  no changes:       #{no_changes.join(', ')}" unless no_changes.empty?
  puts "  no remote:        #{no_remote.join(', ')}" unless no_remote.empty?
  puts "  failed:           #{failures.join(', ')}" unless failures.empty?

  unless verbose || logs.empty?
    puts ""
    puts "Re-run with --verbose for full output. Captured failure output:"
    logs.each do |name, out|
      puts ""
      puts Util.underline(name)
      puts out
    end
  end

  if failures.empty? && !keep_tmp
    FileUtils.rm_rf(workdir)
    puts ""
    puts "Removed #{workdir}"
  elsif !failures.empty?
    puts ""
    puts "Kept #{workdir} for inspection (failures present)"
  end

  write_browserslist_briefing_status(updated: updated, pending: pending, no_changes: no_changes,
                                     failures: failures, logs: logs, check: check)

  unless check
    exit 1 unless failures.empty?
    return
  end

  code = browserslist_check_exit_code(pending: pending, no_changes: no_changes, failures: failures)
  puts ""
  puts browserslist_check_verdict(pending: pending, no_changes: no_changes, failures: failures, code: code)
  exit code
end

# The morning briefing's "Browserslist Update" section (item 12) reads this file
# and skips it unless `Last run:` is today AND something was updated or failed.
# Failure output goes in verbatim: a repo that has been failing to push for three
# weeks is the whole reason the section exists.
#
# BOTH modes write it, and after ISS-525 the check is the mode that normally
# does: nothing schedules the pushing sweep any more, so if only that one wrote
# here the section would render for the last time on the day this shipped and
# then go dark for good — the exact silent-stop failure the briefing exists to
# catch. The wording distinguishes them, because "needs update" and "pushed to
# main" are not the same news: the first is a PR somebody still has to ship.
def write_browserslist_briefing_status(updated:, pending:, no_changes:, failures:, logs:, check:)
  changed = check ? pending : updated
  body = +"Last run: #{Briefing.today}#{check ? ' (check only, nothing pushed)' : ''}\n"
  if changed.empty? && failures.empty?
    body << "All #{no_changes.length} projects up to date, no changes.\n"
  else
    body << "\n"
    unless changed.empty?
      label = check ? "Needs update (no PR opened yet)" : "Updated (pushed to main)"
      body << "#{label}: #{changed.join(', ')}\n"
    end
    body << "No changes: #{no_changes.length} projects\n" unless no_changes.empty?
    failures.each do |name|
      log = logs[name.split(" ").first]
      body << "Failed: #{name}#{log ? " (#{log.strip})" : ''}\n"
    end
  end
  Briefing.write("browserslist-status.md", body)
end

# ---------- scripts ----------
#
# `scripts/` is the single home for ad-hoc developer/ops utility scripts (see
# scripts/README.md). `dev scripts list` discovers them; `dev scripts run <name>`
# runs one. Each script may declare a `dev-script:` metadata header:
#
#   -- dev-script: targets=local,production app=platform
#
# `targets` (default `local`) lists the environments it may run against; `app`
# names the app for `db exec` when a non-local target is used. A local run of a
# `.sql` script goes straight at the local platformdb via psql; a production /
# development run delegates to `db exec`, which tunnels through the bastion.
# Executable scripts (including thin wrappers around scripts that live in other
# repos) are exec'd directly with all args forwarded; they own their environment.
# Adding a script needs no code change here.

SCRIPTS_DIR = File.expand_path(File.join(__dir__, "..", "scripts")).freeze
SCRIPT_META_RE = /\A(?:--+|#+)\s*dev-script:\s*(.*)\z/.freeze
LOCAL_ENVS = %w[local localhost].freeze

def scripts_available
  return [] unless Dir.exist?(SCRIPTS_DIR)
  Dir.children(SCRIPTS_DIR).select { |f| File.file?(File.join(SCRIPTS_DIR, f)) }
     .reject { |f| f.start_with?(".") || f.casecmp?("readme.md") }
     .sort
end

def script_base(filename)
  filename.sub(/\.[^.]+\z/, "")
end

# Scan leading comment lines for `dev-script:` key=value pairs.
def script_metadata(path)
  meta = {}
  File.foreach(path) do |line|
    s = line.strip
    next if s.empty? || s.start_with?("#!")
    if (m = SCRIPT_META_RE.match(s))
      m[1].split(/\s+/).each { |pair| k, v = pair.split("=", 2); meta[k] = v }
      next
    end
    break unless s.start_with?("--", "#")
  end
  meta
end

def script_targets(meta)
  (meta["targets"] || "local").split(",").map(&:strip).reject(&:empty?)
end

# First non-blank, non-shebang, non-metadata comment line — shown by `list`.
def script_description(path)
  File.foreach(path) do |line|
    s = line.strip
    next if s.empty? || s.start_with?("#!") || SCRIPT_META_RE.match?(s)
    return s.sub(/\A(--+|#+)\s*/, "").strip if s.start_with?("--", "#")
    break
  end
  ""
end

def resolve_script(name)
  scripts = scripts_available
  matches = scripts.select { |f| f == name || script_base(f) == name }
  if matches.empty?
    unknown("script", name, scripts.map { |f| script_base(f) }.uniq)
  elsif matches.length > 1
    usage_exit("Ambiguous script '#{name}' matches: #{matches.join(', ')}", example: usage_for("scripts run"))
  end
  File.join(SCRIPTS_DIR, matches.first)
end

def cmd_scripts_list(_args)
  scripts = scripts_available
  puts ""
  puts Util.underline("Utility Scripts")
  puts ""
  if scripts.empty?
    puts "  (none yet — drop a file in #{Util.cleanpath(SCRIPTS_DIR)})"
  else
    name_w = scripts.map { |f| script_base(f).length }.max
    rows = scripts.map do |f|
      full = File.join(SCRIPTS_DIR, f)
      [script_base(f), script_targets(script_metadata(full)).join(","), script_description(full)]
    end
    tgt_w = rows.map { |r| r[1].length }.max
    rows.each do |name, targets, desc|
      desc = "#{desc[0, 69]}…" if desc.length > 70
      puts "  #{name.ljust(name_w)}  [#{targets.ljust(tgt_w)}]  #{desc}".rstrip
    end
  end
  puts ""
  puts "Run with: dev scripts run <name> [args...]   (.sql: [--prod | --env ENV])"
  puts ""
end

# Local .sql run: mirrors the working local invocation (unix socket / user api),
# adds ON_ERROR_STOP so a mid-script failure aborts and rolls back, and refuses
# to run if PGHOST points at a non-local host so a stray env var can't redirect a
# destructive script at production.
def run_local_sql(path)
  host = ENV["PGHOST"]
  if host && !host.empty? && !host.start_with?("/") && !%w[localhost 127.0.0.1 ::1].include?(host)
    Util.exit_with_error("PGHOST=#{host} points at a non-local host. Local scripts only run against the local platformdb — unset PGHOST and retry.")
  end
  cmd = ["psql", "-U", "api", "-v", "ON_ERROR_STOP=1", "-f", path, "platformdb"]
  puts "==> #{cmd.join(' ')}"
  Util.exit_with_error("Script failed: #{File.basename(path)}") unless system(*cmd)
end

# Non-local .sql run: delegate to `db exec`, which tunnels through the bastion.
# Production is destructive on real data, so confirm explicitly first.
# Only ever called for a .sql script (run_sql_script gates on the extension).
def run_remote_sql(path, env, meta)
  app = meta["app"]
  if app.nil? || app.empty?
    Util.exit_with_error("Script targets #{env} but its dev-script header has no app= (needed for db exec).")
  end
  if env == "production"
    unless $stdin.tty?
      Util.exit_with_error("Refusing to run #{File.basename(path)} against #{app} production in a non-interactive shell (confirmation required).")
    end
    print "About to run #{File.basename(path)} against #{app} PRODUCTION. Type 'yes' to continue: "
    unless $stdin.gets&.strip == "yes"
      puts "Aborted."
      exit 1
    end
  end
  cmd = [File.join(__dir__, "db"), "exec", "--app", app, "--env", env, "--sql", path]
  puts "==> #{cmd.join(' ')}"
  Util.exit_with_error("Script failed: #{File.basename(path)}") unless system(*cmd)
end

# The script NAME is always the first token. How the rest is handled depends on
# the script type:
#   - .sql     -> the remaining tokens are OUR env-selection flags (--env/--prod/
#                 --localhost); the dev runner routes local psql vs `db exec`.
#   - executable (wrapper) -> the script manages its own environment, so every
#                 remaining token is passed straight through to it, verbatim
#                 (including any --env/--prod, which are the inner script's flags).
def cmd_scripts_run(args)
  name = args.shift
  if name.nil? || name.start_with?("-")
    usage_exit("scripts run requires a script name first (see 'dev scripts list')", example: usage_for("scripts run"))
  end
  path = resolve_script(name)

  if File.extname(path) == ".sql"
    run_sql_script(path, name, args)
  elsif File.executable?(path)
    # Wrapper scripts run locally and own their environment; forward all args.
    args.shift if args.first == "--" # tolerate a legacy `--` separator
    exec(path, *args)
  else
    Util.exit_with_error("#{File.basename(path)} has no runner: not a .sql file and not executable. Add a shebang and `chmod +x`, or rename to .sql.")
  end
end

# Parse OUR env-selection flags for a .sql script and route it. SQL scripts take
# no positional arguments — anything unexpected is an error.
def run_sql_script(path, name, args)
  env = "local"
  i = 0
  while i < args.length
    case args[i]
    when "--env"
      usage_exit("--env requires a value (local, development, or production)", example: usage_for("scripts run")) if i + 1 >= args.length
      env = args[i + 1]; i += 1
    when "--prod", "--production" then env = "production"
    when "--dev", "--development" then env = "development"
    when "--localhost", "--local" then env = "local"
    else
      Util.exit_with_error("#{File.basename(path)} is a SQL script; unexpected argument '#{args[i]}' (only --env/--prod/--localhost are accepted).")
    end
    i += 1
  end

  env = "local" if LOCAL_ENVS.include?(env)
  meta = script_metadata(path)
  targets = script_targets(meta)
  unless targets.include?(env) || (env == "local" && targets.any? { |t| LOCAL_ENVS.include?(t) })
    Util.exit_with_error("Script '#{name}' does not support env '#{env}'. Allowed: #{targets.join(', ')}")
  end

  if env == "local"
    run_local_sql(path)
  else
    run_remote_sql(path, env, meta)
  end
end

# ---------- queries ----------

# Rank the queries the platform ran, from the samples core.actors.QueryStatsActor
# writes every flush window.
#
# Sorts by TOTAL time by default, not mean. That ordering is the whole point: the
# incremental sales_details sync that turned out to be the largest consumer on the
# database had an unremarkable 698ms mean and only stood out once multiplied by
# 25,368 calls. --by-mean sorts by average instead, which surfaces the opposite
# shape -- a query that is individually slow but rarely run.
#
# Reads through /dev/query/stats like `dev invariants check` does, so nothing here
# talks to a database directly and the endpoint applies its own platform-admin auth.
def cmd_queries_top(args)
  limit = 25
  days = 7
  sort = "total_ms"
  use_localhost = false
  i = 0
  while i < args.length
    case args[i]
    when "--limit"
      limit = Integer(args[i + 1] || usage_exit("--limit requires a value", example: usage_for("queries top")))
      i += 1
    when "--days"
      days = Integer(args[i + 1] || usage_exit("--days requires a value", example: usage_for("queries top")))
      i += 1
    when "--by-mean"  then sort = "mean_ms"
    when "--by-calls" then sort = "calls"
    when "--localhost", "--local" then use_localhost = true
    else usage_exit("Unknown flag: #{args[i]}", example: usage_for("queries top"))
    end
    i += 1
  end

  endpoint = platform_endpoint(use_localhost)
  handle_errors do
    stats = ApiClient.request(
      endpoint, :get,
      "/dev/query/stats?days=#{days}&sort=#{sort}&limit=#{limit}&offset=0"
    )

    if stats.nil? || stats.empty?
      puts "No query samples in the last #{days} day(s)."
      next
    end

    puts ""
    puts Util.underline("Top #{stats.length} queries by #{sort} (last #{days} day(s))")
    puts ""
    printf(
      "%4s  %12s  %10s  %9s  %9s  %7s  %s\n",
      "#", "TOTAL MS", "CALLS", "MEAN MS", "MAX MS", "MULTI", "CALL SITE"
    )
    stats.each_with_index do |s, idx|
      printf(
        "%4d  %12d  %10d  %9d  %9d  %7s  %s\n",
        idx + 1, s["total_ms"], s["calls"], s["mean_ms"], s["max_ms"],
        queries_multi_share(s),
        s["call_site"] || "(never got hot)"
      )
      queries_sql_lines(s["sql"].to_s, indent: QUERIES_SQL_INDENT).each { |line| puts line }
    end
    puts ""

    queries_offer_investigation(stats, days: days, sort: sort, use_localhost: use_localhost)
  end
end

# What share of a statement's calls came from a block that ran more than one statement, so its
# duration covers siblings and not just this statement.
#
# Shown as a percentage rather than a count because it is only ever read against `calls`: 100% says
# the number to its left is a whole block's cost and this statement merely happened to be prepared
# first, which is the difference between an expensive query and a cheap query in an expensive block.
# A batch upsert runs a prefilter select and then writes 500 rows, and the select carries the bill.
# "-" is 0, kept quiet so the ordinary single-statement case does not compete with the ranking.
def queries_multi_share(stat)
  calls = stat["calls"].to_i
  multi = stat["multi_statement_calls"].to_i
  return "-" if multi.zero? || calls.zero?

  "#{(multi * 100.0 / calls).round}%"
end

# Offer to hand the selected queries to a Claude session, via an issue.
#
# The ranking answers "what is expensive"; the next question is always "why, and
# can it be cheaper", and that is an investigation with a real code change behind
# it. Routing it through `issues` rather than spawning Claude directly is what
# makes it trackable: the issue is the record that the question was asked, it
# closes with the PR that answered it, and `dev issues resume` reattaches to the
# session — none of which a bare `claude` invocation gives you.
#
# One issue for the whole selection, not one per query: queries picked off the
# same ranking usually share a cause (a missing index, one hot code path, one
# oversized result set), and a session that can see all of them together finds
# that faster than N sessions each holding one.
#
# Skipped entirely when stdin is not a tty — piping this command must print the
# table and exit, never block on a prompt nobody can answer.
def queries_offer_investigation(stats, days:, sort:, use_localhost:)
  return unless $stdin.tty?

  answer = Ask.for_string(
    "Investigate any of these? Enter numbers (e.g. 1,3), `all`, or `none` [none]:",
    default: "none",
  )
  selected = Ask.parse_selection(answer, stats)
  if selected.nil?
    puts "Invalid selection — nothing filed. Re-run to pick again."
    return
  end
  return if selected.empty?

  require_playbook_session!(use_localhost)
  form = {
    category: QUERIES_ISSUE_CATEGORY,
    title: queries_issue_title(selected),
    body: queries_issue_body(selected, days: days, sort: sort),
  }
  issue_file_and_start(
    endpoint: issue_endpoint(use_localhost), form: form, category: QUERIES_ISSUE_CATEGORY, status: "claimed"
  )
end

# Query cost is an improvement, not a bug: nothing is broken, it costs more than
# it should. `improvement` is also one of the manual categories, so these issues
# land in the same queue `dev issues claim` already works.
QUERIES_ISSUE_CATEGORY = "improvement".freeze

# A title that says which query without the session having to open the issue.
# The call site is the identifying half when there is one; the statement's head
# is the fallback for a query that never got hot enough to be attributed.
def queries_issue_title(selected)
  return "Expensive queries: #{selected.length} from the query-stats ranking" if selected.length > 1

  s = selected.first
  site = s["call_site"].to_s
  subject = site.empty? ? slow_routes_truncate(s["sql"].to_s.gsub(/\s+/, " ").strip, 60) : queries_call_site_short(site)
  "Expensive query: #{subject}"
end

# The class and method out of a call site, dropping the package and the
# file:line — "BaseMemberEngagementScoresDao.findAll" out of
# "generated.db.playbook.BaseMemberEngagementScoresDao.findAll(MemberEngagementScoresDao.scala:242)".
def queries_call_site_short(site)
  head = site.to_s.sub(/\(.*\z/, "")
  head.split(".").last(2).join(".")
end

# The issue body handed to the investigating session.
#
# The durable half — how the numbers are produced, where the code is, and how to
# read them — is baked in here rather than re-derived by every session that picks
# one of these up (rules/llm.ticket.prompts.mdc). The measurement has three
# behaviours that make a naive reading wrong, and all three are stated: the
# duration is charged to the FIRST statement of its block, the SQL is normalized,
# and rows are summed across nodes and 6-hour windows. A session that does not
# know the first one will chase an `insert` that is really a whole transaction --
# and one did (ISS-110), against a select that turned out to cost 20ms in front of
# a 500-row batch upsert, which is why the multi-statement share is now stated per
# query rather than left as a caveat to remember.
#
# The per-instance data (the selected queries and their numbers) goes last.
def queries_issue_body(selected, days:, sort:)
  <<~BODY
    #{selected.length} #{selected.length == 1 ? 'query' : 'queries'} selected from `dev queries top` (ranked by #{sort}, last #{days} day(s)).
    Work out why #{selected.length == 1 ? 'it costs' : 'they cost'} what #{selected.length == 1 ? 'it does' : 'they do'} and make #{selected.length == 1 ? 'it' : 'them'} cheaper — or establish that the
    cost is justified and say why. Either outcome closes this issue; a query that is
    correctly expensive is a real finding, not a failure.

    ## How these numbers are produced

    Every `withConnection` / `withTransaction` block on the platform is wrapped by a
    timing decorator. It measures the block, then charges that duration to the SQL of
    the statement prepared inside it, keyed on the statement rather than the caller —
    which is what catches the fast-but-frequent shape a duration threshold never sees
    (63ms x 26,758 calls). Counters accumulate in memory per node; an actor drains them
    every 6 hours into `query_stats.query_samples`, one row per query per node per
    window. `dev queries top` reads those rows back through `GET /dev/query/stats`,
    grouped by statement and summed across every node and window in the period.

    The call site is resolved by walking the stack ONCE, the first time a query crosses
    100 calls on a node — far too expensive per call, free amortized over a hot query.

    ## Where the code lives

    - `~/code/platform/generated/app/util/QueryStats.scala` — the counters, the hot threshold, the 5,000-query tracking cap
    - `~/code/platform/generated/app/util/PlatformDatabase.scala` — the timing decorator that records each block
    - `~/code/platform/generated/app/util/TimingConnection.scala` — which statement in a block the duration is charged to
    - `~/code/platform/generated/app/util/QuerySqlNormalizer.scala` — how bind lists are collapsed
    - `~/code/platform/generated/app/util/QueryCallSite.scala` — the stack walk, and the frames it treats as infrastructure
    - `~/code/platform/core/app/core/actors/QueryStatsActor.scala` — the 6-hour flush and what it persists
    - `~/code/platform/core/app/core/db/InternalQueryStatsDao.scala` — the aggregation behind the ranking
    - `~/code/platform/dao/spec/db-query-stats.json` — the DAO spec for the samples table

    ## Decoding what you are looking at

    - **The duration is charged to the FIRST statement prepared in its block, and covers
      the WHOLE block.** A `withTransaction` that inserts, then updates, then selects
      charges all three to the insert. **`multi-statement` below tells you how often that
      happened for this statement — READ IT FIRST.** At a high share, the cost shown is a
      block's cost and this statement merely ran first, so optimizing the statement is
      optimizing the wrong thing: find the block at the call site and look at what else
      runs in it. A generated batch upsert is the canonical case — it runs a prefilter
      select and then writes up to 500 rows, and the select carries the whole bill.
    - **The SQL is normalized**: runs of bind placeholders are collapsed to a single `?`,
      flat (`in (?)`) and row-wise (`in ((?))`) alike, so the list may have been two
      elements or two thousand. The width is a prime suspect and is NOT visible here —
      find it at the call site.
    - **`(never got hot)` means no call site, not no caller**: the query never reached
      100 calls in a window on any single node, so the stack walk never ran. Find the
      caller by grepping the statement's head (a distinctive column list or table name)
      under `~/code/platform`.
    - **`calls`, `total_ms` and `multi-statement` are sums across nodes and windows.**
      Per-node cost is roughly this divided by the number of pods serving; `max_ms` is a
      true single-call worst case, not an average of maxima.
    - **The call site is the application caller, not the DAO**: generated `generated.db.`
      frames are skipped, because the statement already names the table and the shape. Two
      different callers can issue byte-identical SQL and so share one entry — a batch
      upsert's prefilter select and a plain `findAll` do — and only one of them gets its
      stack walked, so the site names a caller of this statement, not necessarily the
      only one. If the site and the statement seem to disagree, look for the other caller.

    ## Suggested investigation

    1. Read the call site and the code around it. Establish the shape first: is this one
       query per request, a loop issuing one per row, or a batch job? An N+1 answers
       itself and needs no plan. If `multi-statement` is high, establish what ELSE runs in
       the block before you time this statement at all — a select that reads as 107ms mean
       can be a 20ms select in front of a 500-row write.
    2. Get an execution plan. Use the session Postgres, never production:
       `export CLAUDE_SESSION_ID=<feature>` then
       `eval "$(~/code/devops/bin/claude-db start --app platform | grep '^CONF_DB_DEV_URL=' | sed 's/^/export /')"`,
       then `EXPLAIN (ANALYZE, BUFFERS)` the statement. A sequential scan on a large
       table, or an estimate far from the actual row count, is the usual answer.
    3. Check the indexes that exist, in the table's DAO spec under
       `~/code/platform/dao/spec/`, in its model's `psql.indexes` block. **Never
       hand-write DDL** — an index is added to the DAO spec and regenerated with
       `api --group dao` (see `~/code/claude/rules/database.general.mdc`). A hand-rolled
       `CREATE INDEX` skips the generated schema and is lost on the next regen.
    4. Consider the caller, not only the query: fetching columns nobody reads, paging
       through rows that could be filtered in SQL, or re-running per row what could run
       once are all cheaper to fix than the statement itself.
    5. Confirm the win. Re-run `dev queries top --days 1` after the fix is deployed and
       compare `total_ms` — the ranking is the same instrument that found it. Note that
       a 6-hour flush window means the effect is not visible immediately.

    ## The #{selected.length == 1 ? 'query' : 'queries'}

    #{selected.each_with_index.map { |s, i| queries_issue_body_entry(s, i + 1) }.join("\n\n")}
  BODY
end

# One selected query as it appears at the bottom of the issue body. The statement
# is fenced and NOT truncated — the display cap in the terminal exists so a wide
# select does not bury the ranking, but the session needs the whole thing.
def queries_issue_body_entry(s, position)
  <<~ENTRY.strip
    ### #{position}. #{s['call_site'].to_s.empty? ? '(never got hot — no call site resolved)' : "`#{s['call_site']}`"}

    - total: #{s['total_ms']} ms across #{s['calls']} calls
    - mean: #{s['mean_ms']} ms, max: #{s['max_ms']} ms
    - multi-statement: #{queries_issue_body_multi(s)}

    ```sql
    #{s['sql'].to_s.gsub(/\s+/, ' ').strip}
    ```
  ENTRY
end

# Spelled out rather than shown as the terminal's bare percentage: the issue is read by a session
# with no other context, and the number is worthless without the sentence that says what to do with
# it. The percentage alone invited exactly the reading it exists to prevent.
def queries_issue_body_multi(s)
  calls = s["calls"].to_i
  multi = s["multi_statement_calls"].to_i
  return "0 of #{calls} calls — the duration below is this statement's alone" if multi.zero?

  share = calls.zero? ? 0 : (multi * 100.0 / calls).round
  "#{multi} of #{calls} calls (#{share}%) ran more than one statement in their block, " \
    "so those durations cover sibling statements too — check what else runs in that block " \
    "before treating this cost as this statement's"
end

# How much of the statement is worth reading. One line of head was enough to tell two
# queries apart but not enough to see WHICH columns, joins, or where-clause the cost is
# in -- which is the question the ranking exists to answer. Bounded rather than unbounded
# because a few statements run to thousands of characters and would bury the ranking.
QUERIES_SQL_CHARS = 440

QUERIES_SQL_INDENT = "              ".freeze

# The statement, whitespace-collapsed, capped at QUERIES_SQL_CHARS and wrapped to the
# terminal so the extra length reads as text instead of one line the terminal folds
# mid-token. Wrapping is on word boundaries, falling back to a hard split for a single
# token longer than the available width.
def queries_sql_lines(sql, indent:)
  text = slow_routes_truncate(sql.gsub(/\s+/, " ").strip, QUERIES_SQL_CHARS)
  width = [terminal_width - indent.length, 40].max
  lines = []
  current = +""
  text.split(" ").each do |word|
    # A token wider than the line can never fit; emit it in hard chunks rather than
    # looping forever trying to place it.
    word.scan(/.{1,#{width}}/).each do |chunk|
      if current.empty?
        current = +chunk
      elsif current.length + 1 + chunk.length <= width
        current << " " << chunk
      else
        lines << current
        current = +chunk
      end
    end
  end
  lines << current unless current.empty?
  lines.map { |line| "#{indent}#{line}" }
end

# Columns available for output. Falls back to a conventional 80 when stdout is not a tty
# (piped, redirected, CI), where there is no width to ask for.
def terminal_width
  IO.console&.winsize&.last || 80
rescue StandardError
  80
end

# ---------- claude-usage ----------
#
# Same shape as `dev queries top`: rank a cost dimension, offer to file the
# selection as an investigation. Here the dimension is Claude API token usage/
# cost per (feature, model), from claude.usage_daily_rollups (computed nightly
# by core.processor.ComputeClaudeUsageRollupProcessor from claude.requests /
# claude.responses). `feature` is the label callers set on AiRequest -- see
# com.bryzek.ai.claude.ClaudeRequestMetadata in lib-ai -- and is blank for any
# caller that hasn't been labeled yet.

def cmd_claude_usage_top(args)
  limit = 25
  days = 7
  sort = "cost_usd"
  use_localhost = false
  i = 0
  while i < args.length
    case args[i]
    when "--limit"
      limit = Integer(args[i + 1] || usage_exit("--limit requires a value", example: usage_for("claude-usage top")))
      i += 1
    when "--days"
      days = Integer(args[i + 1] || usage_exit("--days requires a value", example: usage_for("claude-usage top")))
      i += 1
    when "--sort"
      sort = args[i + 1] || usage_exit("--sort requires a value", example: usage_for("claude-usage top"))
      unless %w[cost_usd input_tokens output_tokens requests].include?(sort)
        usage_exit("Unknown --sort value: #{sort}", example: usage_for("claude-usage top"))
      end
      i += 1
    when "--localhost", "--local" then use_localhost = true
    else usage_exit("Unknown flag: #{args[i]}", example: usage_for("claude-usage top"))
    end
    i += 1
  end

  endpoint = platform_endpoint(use_localhost)
  handle_errors do
    stats = ApiClient.request(
      endpoint, :get,
      "/dev/claude/usage?days=#{days}&sort=#{sort}&limit=#{limit}&offset=0"
    )

    if stats.nil? || stats.empty?
      puts "No Claude usage in the last #{days} day(s)."
      next
    end

    puts ""
    puts Util.underline("Top #{stats.length} Claude usage by #{sort} (last #{days} day(s))")
    puts ""
    printf(
      "%4s  %-30s  %-18s  %10s  %12s  %12s  %12s  %12s\n",
      "#", "FEATURE", "MODEL", "REQUESTS", "INPUT TOK", "OUTPUT TOK", "CACHE RD", "COST USD"
    )
    stats.each_with_index do |s, idx|
      printf(
        "%4d  %-30s  %-18s  %10d  %12d  %12d  %12d  %12.2f\n",
        idx + 1,
        s["feature"] || "(unlabeled)",
        s["model"],
        s["requests"],
        s["input_tokens"],
        s["output_tokens"],
        s["cache_read_input_tokens"],
        s["cost_usd"].to_f,
      )
    end
    puts ""

    claude_usage_offer_investigation(stats, days: days, sort: sort, use_localhost: use_localhost)
  end
end

# Offer to hand the selected feature/model rows to a Claude session, via an
# issue -- same rationale as queries_offer_investigation: the ranking answers
# "what costs the most", the investigation ("why, and can it be cheaper") is a
# real code change, and routing through `issues` makes it trackable.
def claude_usage_offer_investigation(stats, days:, sort:, use_localhost:)
  return unless $stdin.tty?

  answer = Ask.for_string(
    "Investigate any of these? Enter numbers (e.g. 1,3), `all`, or `none` [none]:",
    default: "none",
  )
  selected = Ask.parse_selection(answer, stats)
  if selected.nil?
    puts "Invalid selection — nothing filed. Re-run to pick again."
    return
  end
  return if selected.empty?

  require_playbook_session!(use_localhost)
  form = {
    category: CLAUDE_USAGE_ISSUE_CATEGORY,
    title: claude_usage_issue_title(selected),
    body: claude_usage_issue_body(selected, days: days, sort: sort),
  }
  issue_file_and_start(
    endpoint: issue_endpoint(use_localhost), form: form, category: CLAUDE_USAGE_ISSUE_CATEGORY, status: "claimed"
  )
end

# Claude spend is an improvement, not a bug: nothing is broken, it costs more
# than it should. `improvement` is one of the manual categories, so these
# issues land in the same queue `dev issues claim` already works.
CLAUDE_USAGE_ISSUE_CATEGORY = "improvement".freeze

def claude_usage_issue_title(selected)
  return "Expensive Claude usage: #{selected.length} features from the usage ranking" if selected.length > 1

  s = selected.first
  "Expensive Claude usage: #{s['feature'] || '(unlabeled)'} / #{s['model']}"
end

# The issue body handed to the investigating session. Same shape as
# queries_issue_body: the durable half (how the numbers are produced, where the
# code lives, how to read them) is baked in so a session does not have to
# re-derive it; the per-instance data (the selected rows) goes last.
def claude_usage_issue_body(selected, days:, sort:)
  <<~BODY
    #{selected.length} #{selected.length == 1 ? 'row' : 'rows'} selected from `dev claude-usage top` (ranked by #{sort}, last #{days} day(s)).
    Work out why #{selected.length == 1 ? 'it costs' : 'they cost'} what #{selected.length == 1 ? 'it does' : 'they do'} and make #{selected.length == 1 ? 'it' : 'them'} cheaper (prompt caching, a
    smaller/cheaper model, fewer tool-loop turns, trimming the prompt) -- or establish
    that the cost is justified and say why. Either outcome closes this issue.

    ## How these numbers are produced

    Every Claude API call made through `com.bryzek.ai.claude.ClaudeClient` (lib-ai) is
    journaled to `claude.requests` / `claude.responses` by whichever `ClaudeStore` the
    calling app wired up (e.g. `playbook.ai.PlaybookClaudeStore`, `core.ai.DbClaudeStore`).
    The caller labels the call with a `feature` string via `AiRequest`/`ClaudeRequestMetadata`
    -- this is the low-cardinality dimension the ranking groups by; unlabeled callers show
    up as `(unlabeled)`. Nightly, `core.processor.ComputeClaudeUsageRollupProcessor`
    aggregates the prior UTC day's requests/responses by (feature, model) into
    `claude.usage_daily_rollups`. `dev claude-usage top` reads those rollups back through
    `GET /dev/claude/usage`, summed across every day in the requested period.

    Dollar cost is computed from token counts via the per-model rates in
    `core.ai.ClaudePricing` -- a hardcoded price list, not billing data, so it can drift
    from Anthropic's actual invoice if pricing changed since that file was last updated.

    ## Where the code lives

    - `~/code/lib-ai/app/scala/com/bryzek/ai/claude/ClaudeClient.scala` -- the shared client, `AiRequest`, `ClaudeRequestMetadata.feature`
    - `~/code/platform/playbook/app/playbook/ai/PlaybookClaudeStore.scala` -- playbook's persisting store (full content)
    - `~/code/platform/core/app/core/ai/DbClaudeStore.scala` -- the shared store for every other app (`persistContent` toggles whether raw prompt/response text is kept)
    - `~/code/platform/core/app/core/ai/ClaudePricing.scala` -- the per-model $/M-token rates behind `cost_usd`
    - `~/code/platform/core/app/core/processor/ComputeClaudeUsageRollupProcessor.scala` -- the nightly aggregation
    - `~/code/platform/core/app/core/db/InternalClaudeUsageDao.scala` -- the aggregation behind this ranking
    - `~/code/platform/dao/spec/db-claude.json` -- the DAO spec for `claude.requests` / `claude.responses` / `claude.usage_daily_rollups`

    ## Decoding what you are looking at

    - **`(unlabeled)` means the calling code hasn't set `feature` on its `AiRequest`**,
      not that the calls don't matter -- grep for `chatCompletion[`, `chatText(`, `chatComments(`,
      or `runToolLoop[` calls with no `feature =` argument to find them.
    - **`cost_usd` is a list-price estimate, not a bill.** It does not account for
      Anthropic account-level discounts, and prompt-cache write/read multipliers are
      approximated (5-minute-TTL write cost; a 1h-TTL cache write is under-costed).
    - **Rows are summed across every day in the period.** A feature with one very
      expensive day and otherwise-quiet usage looks the same as steady moderate usage --
      if that distinction matters, re-run with `--days 1` and compare across days.
    - **Cache read/write tokens are tracked but only cache-read is shown in the table**
      (`s['cache_creation_input_tokens']` is in the raw JSON if you need it) -- a feature
      with high input tokens but low cache-read is a prompt-caching candidate that isn't
      using it yet (see `shared/prompt-caching.md` in the claude-api skill, or
      `~/code/claude/plans/` for any existing caching work on this feature).

    ## Suggested investigation

    1. Read the feature's call site(s) (the `feature =` string usually maps 1:1 to a
       processor or service class -- grep for the literal string). Establish whether the
       cost is per-request (agentic tool loop, large system prompt) or volume (many small
       calls) before proposing a fix; the two have different remedies.
    2. Check whether prompt caching (`AiRequest(cacheSystem = true, ...)` or
       `cacheLastMessage = true`) is already enabled and actually hitting -- the journaled
       `claude.responses` rows have `usage_cache_read_input_tokens`; a persistent zero
       there with caching enabled means something is invalidating the prefix between
       calls (see `shared/prompt-caching.md`'s silent-invalidator checklist).
    3. Check the model tier (`claude.responses.model`) against the task's actual
       difficulty -- Opus-tier reasoning work that could run on Sonnet or Haiku is a
       common, low-risk win.
    4. For an agentic tool loop, check `maxCalls`/`maxTokens`/`effort` against what the
       task needs -- a generous default copied from another pipeline is a common source
       of avoidable spend.
    5. Confirm the win. Re-run `dev claude-usage top --days 1` after the fix is deployed
       and compare `cost_usd` for this feature -- the ranking is the same instrument that
       found it. The rollup is nightly, so same-day changes are not visible yet.

    ## The #{selected.length == 1 ? 'row' : 'rows'}

    #{selected.each_with_index.map { |s, i| claude_usage_issue_body_entry(s, i + 1) }.join("\n\n")}
  BODY
end

# One selected feature/model row as it appears at the bottom of the issue body.
def claude_usage_issue_body_entry(s, position)
  <<~ENTRY.strip
    ### #{position}. #{s['feature'] || '(unlabeled)'} / #{s['model']}

    - requests: #{s['requests']}
    - input tokens: #{s['input_tokens']}, output tokens: #{s['output_tokens']}
    - cache creation tokens: #{s['cache_creation_input_tokens']}, cache read tokens: #{s['cache_read_input_tokens']}
    - cost: $#{format('%.2f', s['cost_usd'].to_f)}
  ENTRY
end

# ---------- slow-routes ----------

def slow_routes_truncate(str, width)
  str.length > width ? str[0, width - 3] + "..." : str
end

def cmd_slow_routes(args)
  days = 7
  sort = "-p95"
  limit = 10
  app = nil
  use_localhost = false
  i = 0
  while i < args.length
    case args[i]
    when "--app"
      app = args[i + 1] || usage_exit("--app requires a value", example: usage_for("slow-routes"))
      i += 2
    when "--days"
      days = Integer(args[i + 1] || usage_exit("--days requires a value", example: usage_for("slow-routes")))
      i += 2
    when "--sort"
      sort = args[i + 1] || usage_exit("--sort requires a value", example: usage_for("slow-routes"))
      i += 2
    when "--limit"
      limit = Integer(args[i + 1] || usage_exit("--limit requires a value", example: usage_for("slow-routes")))
      i += 2
    when "--localhost"
      use_localhost = true
      i += 1
    when "-h", "--help"
      usage_exit
    else
      usage_exit("Unknown flag: #{args[i]}", example: usage_for("slow-routes"))
    end
  end

  # The playbook admin API lives on the platform host but authenticates with the playbook
  # tenant session, so use tenant_endpoint (playbook is deliberately not in ENDPOINTS).
  endpoint = ApiClient.tenant_endpoint("playbook", use_localhost: use_localhost)

  since = (Time.now - days * 86_400).utc.iso8601
  params = { "since" => since, "sort" => sort, "limit" => limit.to_s }
  params["app"] = app if app
  query = params.map { |k, v| "#{k}=#{URI.encode_www_form_component(v)}" }.join("&")

  rows = begin
    ApiClient.request(endpoint, :get, "/admin/user/tracking/page/views/latency?#{query}")
  rescue SessionExpired
    Util.exit_with_error("session expired - run 'dev auth login'")
  rescue ApiError => e
    Util.exit_with_error(e.message)
  end

  puts ""
  puts Util.underline("Slowest routes - last #{days}d#{app ? " (#{app})" : ''}, sort #{sort}")
  puts ""
  if rows.nil? || rows.empty?
    puts "No page-view timing data in the window."
    return
  end

  printf("%-7s %-40s %8s %7s %7s %7s %7s %7s\n", "app", "route", "views", "p50", "p75", "p95", "p99", "ttfb")
  rows.each do |r|
    printf(
      "%-7s %-40s %8d %7d %7d %7d %7d %7d\n",
      r["app"], slow_routes_truncate(r["route"].to_s, 40), r["view_count"],
      r["p50_load_ms"], r["p75_load_ms"], r["p95_load_ms"], r["p99_load_ms"], r["p75_ttfb_ms"]
    )
  end

  top = rows.first
  server_dominant = top["p75_ttfb_ms"].to_f >= 0.5 * [top["p75_load_ms"].to_f, 1.0].max
  app_repo = top["app"] == "admin" ? "playbook-admin" : "playbook-app"
  puts ""
  puts Util.underline("Claude handoff - paste to investigate the worst route")
  puts <<~PROMPT

    Investigate why the #{top['app']} route `#{top['route']}` is slow for end users. Over the last
    #{days} days it had #{top['view_count']} views with load p50=#{top['p50_load_ms']}ms
    p75=#{top['p75_load_ms']}ms p95=#{top['p95_load_ms']}ms p99=#{top['p99_load_ms']}ms, and
    time-to-first-byte p75=#{top['p75_ttfb_ms']}ms.

    Attribution: p75 TTFB is #{server_dominant ? 'a large' : 'a small'} share of p75 load, so the cost is
    likely #{server_dominant ? 'server-side (backend endpoint / SSR load function)' : 'client-side (hydration, bundle, render)'}.

    Use the systematic-debugging skill: instrument this route's load path, drive an authenticated load,
    measure per-call timing, find the dominant cost, fix the one thing, and verify p95 drops. The app is
    #{app_repo}; its backend is the platform playbook subproject.
  PROMPT
end

# ---------- changelog ----------

# Apps whose releases feed the changelog. Each tags independently with its own
# semver sequence; the app name is also its GitHub repo slug (mbryzek/<app>) and
# its local sibling checkout (~/code/<app>) we read git history from. platform is
# intentionally excluded: its monorepo tag spans HOA/acumen/playbook.
CHANGELOG_APPS = %w[playbook-admin playbook-app playbook-www].freeze

# Judgment + summarization quality matters here, so use a stronger model than the
# mechanical codegen sync (haiku).
CHANGELOG_CLAUDE_MODEL = "sonnet".freeze

# The build skill ships with this CLI rather than with the data it produces: it used to
# live in the `changelog` data repo, which is being archived, and a session run from a
# scratch dir can only reach it by absolute path anyway.
CHANGELOG_SKILL_PATH = File.expand_path("../.claude/skills/changelog-build/SKILL.md", __dir__).freeze

# Versions per Claude session. Each version is a small, independent commit list, so
# batching them amortizes the ~15-30s session startup (process spawn, skill read,
# tool setup) that used to be paid once per version — the dominant cost on a
# backfill. Kept bounded so one session's context stays small, a bad commit set can
# only poison its own batch, and a killed session loses at most this many versions
# (already-written notes files are cached, so a re-run resumes). See also
# CHANGELOG_BUILD_BATCH_COMMITS, the other half of the bound.
CHANGELOG_BUILD_BATCH_SIZE = 10

# Version count alone is a poor proxy for batch size: a typical release carries ~2
# commits, but the first tag of an app carries its whole history (500+). So a batch
# also closes once it has this many commits — a huge version travels alone rather
# than dragging nine others into a context that cannot hold them.
CHANGELOG_BUILD_BATCH_COMMITS = 100

# Group newest-first pending versions into sessions, bounded by both version count
# and cumulative commits. A single version over the commit bound still gets its own
# batch (never dropped).
def changelog_batches(pending, batch_size)
  pending.each_with_object([]) do |p, batches|
    current = batches.last
    if current.nil? || current.length >= batch_size ||
       current.sum { |q| q[:commit_count].to_i } + p[:commit_count].to_i > CHANGELOG_BUILD_BATCH_COMMITS
      batches << [p]
    else
      current << p
    end
  end
end

# A batch gets proportionally longer to finish, but never less than a single
# version's old budget, and never more than an hour.
def changelog_claude_timeout_secs(version_count)
  [[20 * 60, 5 * 60 * version_count].max, 60 * 60].min
end

def changelog_app_checkout(app)
  File.expand_path("~/code/#{changelog_app_repo(app)}")
end

# The GitHub repo backing a changelog app. They match today, but a deployable can be
# rebranded ahead of its repo, and the page links PRs off the repo.
# Goes through Config (which rebuilds dist/ from the env pkl sources once per process)
# rather than reading dist/ directly: dist/ is an untracked build artifact, and a stale
# one silently resolves a renamed app back to its own name — which reads as "no
# checkout" and skips the app. Not Work::Registry, whose tenant lookups hit the network
# for a value this path never needs. An unconfigured app keeps its own name.
def changelog_app_repo(app)
  @changelog_app_repos ||= {}
  @changelog_app_repos[app] ||= begin
    Config.all.find { |a| a.name == app }&.repo_name || app
  rescue StandardError
    app
  end
end

# Array-form git so paths/refs never go through the shell.
def changelog_git_out(*cmd)
  IO.popen(["git", *cmd], err: File::NULL, &:read)
end

# Repeatable --app (defaults to all tracked apps), plus --localhost, --limit and
# --batch-size. Rejects an unknown app loudly rather than silently producing nothing.
# Returns { apps:, use_localhost:, limit:, batch_size: } (limit nil = no cap,
# batch_size nil = CHANGELOG_BUILD_BATCH_SIZE).
def changelog_parse_flags(args)
  apps = []
  use_localhost = false
  limit = nil
  batch_size = nil
  i = 0
  while i < args.length
    a = args[i]
    case a
    when "--app"
      v = args[i + 1]
      usage_exit("--app requires a value", example: usage_for("changelog capture")) if v.nil?
      unknown("--app", v, CHANGELOG_APPS) unless CHANGELOG_APPS.include?(v)
      apps << v
      i += 2
    when "--limit"
      v = args[i + 1]
      usage_exit("--limit requires a positive integer", example: usage_for("changelog build")) if v.nil? || v !~ /\A[1-9]\d*\z/
      limit = v.to_i
      i += 2
    when "--batch-size"
      v = args[i + 1]
      usage_exit("--batch-size requires a positive integer", example: usage_for("changelog build")) if v.nil? || v !~ /\A[1-9]\d*\z/
      batch_size = v.to_i
      i += 2
    when "--localhost"
      use_localhost = true
      i += 1
    when "-h", "--help"
      usage_exit
    else
      usage_exit("unexpected argument: #{a}", example: usage_for("changelog build"))
    end
  end
  apps = CHANGELOG_APPS.dup if apps.empty?
  { apps: apps.uniq, use_localhost: use_localhost, limit: limit, batch_size: batch_size }
end

# Commits in `range`, oldest-first, no merges. Extracts the squash-merge PR number
# from the trailing "(#NN)" of the subject when present.
# --- the changelog store ------------------------------------------------------
#
# The changelog lives in platform and is served from the API. It used to live in a
# git repo whose contents were baked into playbook-admin as a committed data.json;
# that snapshot was regenerated AFTER the release that would have carried it, so a
# release could never contain its own notes and the page sat a deploy behind.

CHANGELOG_PATH = "/dev/changelog".freeze

# The server accepts at most this many records per call, and enforces it. Chunk to
# match rather than discovering the limit as a 422.
CHANGELOG_MAX_BATCH = 100

# Per-app server state, keyed by app name: what it already holds, so we send only the
# difference.
def changelog_status(endpoint)
  (ApiClient.request(endpoint, :get, "#{CHANGELOG_PATH}/status") || [])
    .map { |s| [s["application"], s] }.to_h
end

# Tags in VERSION order, not creation order or lexical order. `--sort=v:refname` is
# git's own version-aware sort: it yields 0.1.8, 0.1.9, 0.1.75, 0.1.76, where a plain
# sort yields 0.1.75, 0.1.76, 0.1.8, 0.1.9 and would silently skip the two newest.
# This is why nothing in this pipeline parses a version.
def changelog_tags(checkout)
  changelog_git_out("-C", checkout, "tag", "--list", "--sort=v:refname")
    .split("\n").map(&:strip).reject(&:empty?)
end

# The releases in this checkout the server does not have yet: everything after
# max_version in the ordered tag list. An unknown max_version (a deleted tag) sends
# everything and lets the upsert dedupe -- resending is a no-op, skipping is not.
def changelog_new_releases(app, checkout, max_version)
  tags = changelog_tags(checkout)
  cursor = max_version ? tags.index(max_version) : nil
  pending = cursor ? tags[(cursor + 1)..] || [] : tags
  pending.map do |tag|
    i = tags.index(tag)
    prev = i.positive? ? tags[i - 1] : nil
    range = prev ? "#{prev}..#{tag}" : tag
    {
      "application" => app,
      # Recorded alongside the app because they can differ: /admin/changelog links PRs
      # off the repo, not the app name.
      "repo" => changelog_app_repo(app),
      "version" => tag,
      "previous_version" => prev,
      "released_at" => changelog_git_out("-C", checkout, "log", "-1", "--format=%cI", tag).strip,
      "commits" => changelog_commits(checkout, range),
    }.compact
  end
end

# POST in chunks, returning the number sent. Each call is all-or-nothing server side,
# so a failure leaves earlier chunks committed and the next run resumes from the
# server's own cursor.
def changelog_post_batches(endpoint, path, key, records)
  records.each_slice(CHANGELOG_MAX_BATCH) do |chunk|
    ApiClient.request(endpoint, :post, "#{CHANGELOG_PATH}/#{path}", body: { key => chunk })
  end
  records.length
end

def changelog_commits(checkout, range)
  raw = changelog_git_out("-C", checkout, "log", "--no-merges", "--reverse",
                          "--format=%H%x1f%s%x1f%b%x1e", range)
  raw.split("\x1e").map(&:strip).reject(&:empty?).map do |rec|
    sha, subject, body = rec.split("\x1f", 3)
    subject = (subject || "").strip
    pr = subject[/\(#(\d+)\)\s*\z/, 1]
    {
      "sha" => (sha || "").strip,
      "subject" => subject,
      # Omitted, never "": the API models body as optional, so an empty string would
      # store a value every reader then has to treat as absent.
      "body" => ((body || "").strip.empty? ? nil : body.strip),
      "pr_number" => (pr ? pr.to_i : nil),
    }.compact
  end
end

# One line per app describing what capture actually looked at. Without it the
# common "nothing new" outcome is indistinguishable from "scanned nothing at all":
# an app whose checkout is missing, or whose repo was renamed out from under the
# app name, silently contributes zero tags.
def changelog_capture_scan_line(scan)
  label = scan[:repo] == scan[:app] ? scan[:app] : "#{scan[:app]} (#{scan[:repo]})"
  return "  #{label}: #{scan[:skipped]}" if scan[:skipped]

  line = "  #{label}: #{scan[:tags]} tag(s), #{scan[:new]} new, latest #{scan[:latest] || '(none)'}"
  scan[:gap] ? "#{line} -- SERVER #{scan[:gap].upcase}" : line
end

def cmd_changelog_capture(args)
  flags = changelog_parse_flags(args)
  apps = flags[:apps]
  endpoint = platform_endpoint(flags[:use_localhost])

  handle_errors do
    status = changelog_status(endpoint)
    sent = 0
    scans = []
    apps.each do |app|
      checkout = changelog_app_checkout(app)
      scan = { app: app, repo: changelog_app_repo(app), tags: 0, new: 0, latest: nil }
      scans << scan
      unless Dir.exist?(File.join(checkout, ".git"))
        scan[:skipped] = "skipped, no checkout at #{checkout}"
        warn "changelog: skipping #{app} (no checkout at #{checkout})"
        next
      end
      tags = changelog_tags(checkout)
      scan[:tags] = tags.length
      scan[:latest] = tags.last
      releases = changelog_new_releases(app, checkout, status.dig(app, "max_version"))
      scan[:new] = releases.length
      sent += changelog_post_batches(endpoint, "releases", :releases, releases)
    end

    # Re-read after sending, or every count would be short by exactly what this run just
    # recorded and a clean capture would report a gap.
    status = changelog_status(endpoint) if sent.positive?
    scans.each { |s| s[:gap] = changelog_capture_gap(s, status.dig(s[:app], "release_count")) }

    puts "changelog capture: sent #{sent} release(s) from #{scans.length} app(s)"
    scans.each { |s| puts changelog_capture_scan_line(s) }
    scans.select { |s| s[:gap] }.each do |s|
      warn "changelog: #{s[:app]} #{s[:gap]} -- re-capture with the missing tags present locally"
    end
  end
end

# The completeness check `max_version` cannot make.
#
# capture only ever looks PAST the cursor, so "0 new" means "the newest tag is recorded",
# NOT "every tag is recorded" -- a release missing below the watermark is invisible to it
# forever. Comparing counts is the only thing that tells those apart.
#
# A nil count is "the server did not say", not zero: a platform that predates release_count
# would otherwise report every tag as missing. Silence beats a false alarm.
def changelog_capture_gap(scan, recorded)
  return nil if scan[:skipped] || recorded.nil? || scan[:tags].zero?
  diff = scan[:tags] - recorded.to_i
  return nil if diff.zero?
  diff.positive? ? "is missing #{diff} release(s)" : "has #{-diff} release(s) not in git"
end

# Versions the server has recorded but has no notes for, newest first so a --limit
# builds the most recent releases. The list is the server's answer, not a filesystem
# scan: "still needs notes" is notes_built_at being null, which is deliberately not the
# same as having no entries -- a release whose commits were all noise gets zero entries
# and is finished, not pending.
#
# Commits come from git rather than the API: they are the model's input, never rendered,
# so the read path does not serve them.
def changelog_pending(endpoint, apps, workdir)
  status = changelog_status(endpoint)
  apps.flat_map do |app|
    versions = status.dig(app, "versions_missing_notes") || []
    next [] if versions.empty?
    checkout = changelog_app_checkout(app)
    unless Dir.exist?(File.join(checkout, ".git"))
      warn "changelog: #{versions.length} version(s) of #{app} need notes but there is no checkout at #{checkout}"
      next []
    end
    tags = changelog_tags(checkout)
    versions.filter_map do |version|
      i = tags.index(version)
      if i.nil?
        warn "changelog: #{app} #{version} is recorded but has no local tag; skipping"
        next nil
      end
      prev = i.positive? ? tags[i - 1] : nil
      range = prev ? "#{prev}..#{version}" : version
      commits = changelog_commits(checkout, range)
      {
        app: app,
        version: version,
        notes_file: File.join(workdir, "#{app}-#{version}.notes.json"),
        released_at: changelog_git_out("-C", checkout, "log", "-1", "--format=%cI", version).strip,
        commits: commits,
        commit_count: commits.length,
      }
    end
  end.sort_by { |p| p[:released_at] }.reverse
end

def changelog_issue_map(use_localhost)
  if ApiClient.session_id_for("playbook", use_localhost: use_localhost).nil?
    warn "changelog: no playbook session; skipping ISS enrichment (run `dev auth login --app playbook` to enable)"
    return {}
  end
  map = {}
  begin
    issues = ApiClient.request(issue_endpoint(use_localhost), :get,
                               issues_list_path(statuses: %w[fixed deployed verified])) || []
    issues.each do |issue|
      number = issue["number"]
      (issue["fixes"] || []).each do |fix|
        m = fix["url"].to_s.match(%r{github\.com/mbryzek/([^/]+)/pull/(\d+)})
        map["#{m[1]}##{m[2].to_i}"] = number if m
      end
    end
  rescue StandardError => e
    warn "changelog: issue enrichment unavailable (#{e}); continuing without ISS links"
  end
  map
end

# Headless Claude session that writes the notes files. Unlike spawn_claude (which
# expects a PR URL), this only asks Claude to write files we validate afterwards.
#
# The session runs in a scratch dir, so the skill is named by ABSOLUTE path: a relative
# `.claude/skills/...` resolves against the cwd, and when that stopped being a repo
# checkout the model fell back to searching the filesystem (`find / -maxdepth 8`) for
# the skill on every batch -- minutes of disk scan per batch before any work started.
def changelog_run_claude(workdir, input_path, version_count)
  timeout_secs = changelog_claude_timeout_secs(version_count)
  prompt = <<~PROMPT
    Follow the process in #{CHANGELOG_SKILL_PATH} exactly.
    Input file: #{input_path}
    It lists #{version_count} version(s). For each version under "versions", decide which
    commits are worth telling a human about, write concise plain-language release notes,
    and write the result as JSON to that version's "notes_file" path. Write each file as
    soon as you finish that version rather than batching the writes at the end. Every
    version must get a file, even if its "entries" is empty. Do not modify any other
    files; do not commit or push.
  PROMPT
  stdin, out_err, wait_thr = Open3.popen2e("claude", "--print", "--dangerously-skip-permissions",
                                           "--model", CHANGELOG_CLAUDE_MODEL, prompt,
                                           chdir: workdir, pgroup: true)
  stdin.close
  pid = wait_thr.pid
  output =
    begin
      Timeout.timeout(timeout_secs) { out_err.read }
    rescue Timeout::Error
      begin Process.kill("TERM", -pid) rescue Errno::ESRCH end
      begin Process.kill("KILL", -pid) rescue Errno::ESRCH end
      return "claude timed out after #{timeout_secs}s"
    ensure
      out_err.close unless out_err.closed?
    end
  wait_thr.value
  Util.to_utf8(output)
end

# One batch's input payload for the Claude session, with ISS numbers resolved.
def changelog_build_input(batch, iss_map)
  { "versions" => batch.map { |p| changelog_version_input(p, iss_map) } }
end

def changelog_version_input(p, iss_map)
  commits = p[:commits].map do |c|
    pr = c["pr_number"]
    {
      "sha" => c["sha"],
      "subject" => c["subject"],
      "body" => c["body"],
      "pr_number" => pr,
      # The map is keyed by REPO slug (it is parsed out of PR urls), which is not
      # the app name once an app is rebranded ahead of its repo.
      "issue_number" => pr ? iss_map["#{changelog_app_repo(p[:app])}##{pr}"] : nil,
    }
  end
  {
    "application" => p[:app],
    "version" => p[:version],
    "released_at" => p[:released_at],
    "notes_file" => p[:notes_file],
    "commits" => commits,
  }
end

# One aligned line per version in a build, so the batch header and the summary read
# as a table rather than ragged text.
def changelog_build_lines(pending)
  labels = pending.map { |p| "#{p[:app]}/#{p[:version]}" }
  width = labels.map(&:length).max.to_i
  pending.zip(labels).map { |p, label| "  #{label.ljust(width)}  #{yield(p)}" }
end

def cmd_changelog_build(args)
  flags = changelog_parse_flags(args)
  endpoint = platform_endpoint(flags[:use_localhost])

  handle_errors do
    # The model writes each version's notes to a file, so it needs somewhere to write.
    # A scratch dir rather than a repo: notes are persisted by POSTing them, and a
    # half-written batch should leave nothing behind.
    Dir.mktmpdir("changelog-build") do |workdir|
      pending = changelog_pending(endpoint, flags[:apps], workdir)
      total_pending = pending.length
      pending = pending.first(flags[:limit]) if flags[:limit]
      if pending.empty?
        puts "changelog build: nothing to build"
        next
      end
      if flags[:limit] && total_pending > pending.length
        puts "changelog build: #{total_pending} versions pending; building the #{pending.length} most recent (--limit)."
      end

      iss_map = changelog_issue_map(flags[:use_localhost])

      # One bounded Claude session per BATCH of versions: session startup dominated the
      # old one-session-per-version loop, and each version's commit list is small enough
      # that several fit comfortably in one context. Still bounded, so a bad commit set
      # can only poison its own batch, and a large backfill stays resumable -- notes are
      # POSTed per batch, so a re-run picks up whatever the server still lists as
      # missing.
      built = []
      failed = []
      batches = changelog_batches(pending, flags[:batch_size] || CHANGELOG_BUILD_BATCH_SIZE)
      batches.each_with_index do |batch, idx|
        puts "changelog build [batch #{idx + 1}/#{batches.length}]: #{batch.length} version(s) " \
             "via Claude (#{CHANGELOG_CLAUDE_MODEL})"
        puts changelog_build_lines(batch) { |p| "#{p[:commit_count]} commit(s)" }
        input_path = File.join(workdir, "_build_input.json")
        File.write(input_path, "#{JSON.pretty_generate(changelog_build_input(batch, iss_map))}\n")
        output = changelog_run_claude(workdir, input_path, batch.length)
        File.delete(input_path) if File.exist?(input_path)

        notes = []
        batch.each do |p|
          parsed = (JSON.parse(File.read(p[:notes_file])) if File.exist?(p[:notes_file])) rescue nil
          if parsed
            notes << {
              "application" => p[:app],
              "version" => p[:version],
              # Every version must get a record even with no entries: that is what marks
              # it evaluated, and without it the release comes back as pending forever.
              "entries" => (parsed["entries"] || []).map { |e|
                { "summary" => e["summary"], "category" => e["category"],
                  "pr_number" => e["pr_number"], "issue_number" => e["issue_number"] }.compact
              },
            }
            built << p.merge(entry_count: (parsed["entries"] || []).length)
          else
            failed << p
            warn "  #{p[:app]}/#{p[:version]}: failed: #{output.to_s.lines.last}"
          end
        end
        changelog_post_batches(endpoint, "notes", :notes, notes) unless notes.empty?
      end

      unless built.empty?
        published, empty = built.partition { |p| p[:entry_count].positive? }
        puts "changelog build: recorded notes for #{built.length} version(s): " \
             "#{published.length} with release notes, #{empty.length} with no user-facing changes"
        puts changelog_build_lines(built) { |p|
          p[:entry_count].positive? ? "#{p[:entry_count]} note(s)" : "no user-facing changes"
        }
      end
      unless failed.empty?
        Util.exit_with_error("changelog build: #{failed.length} version(s) failed (re-run to retry):\n" \
                             "#{failed.map { |p| "  #{p[:app]}/#{p[:version]}" }.join("\n")}")
      end
    end
  end
end

# What the server holds, per app: how far capture has gotten and what build still owes.
def cmd_changelog_status(args)
  flags = changelog_parse_flags(args)
  endpoint = platform_endpoint(flags[:use_localhost])
  handle_errors do
    status = changelog_status(endpoint)
    if status.empty?
      puts "changelog: nothing recorded"
      return
    end
    status.keys.sort.each do |app|
      s = status[app]
      missing = s["versions_missing_notes"] || []
      puts "  #{app}: latest #{s['max_version'] || '(none)'}, #{missing.length} awaiting notes"
      puts "    #{missing.first(10).join(', ')}#{missing.length > 10 ? ', ...' : ''}" unless missing.empty?
    end
  end
end

# The full pipeline, and what bare `dev changelog` runs (including the post-release
# hook in bin/release).
#
# capture first: build's work list is the server's own versions_missing_notes, so a
# release has to be recorded before there is anything to write notes for.
def cmd_changelog_all(args)
  cmd_changelog_capture(args.dup)
  cmd_changelog_build(args.dup)
end

# ---------- autonomy ----------
#
# The autonomy ledger lives on the platform host, so these commands never take
# --app: there is exactly one ledger.
#
# `decide` is the important one, and its EXIT CODE is the interface. It exits 0
# only when the ledger auto-approved the decision, so a shell script can simply
# do `dev autonomy decide ... && do_the_thing`. Every other answer -- pending,
# blocked, suppressed, a validation failure, or an unreachable ledger -- is
# non-zero, which means the default behaviour on anything going wrong is to do
# nothing. That is the whole safety property, expressed in one number.

AUTONOMY_REVERSIBILITIES = %w[trivial reversible costly irreversible].freeze
AUTONOMY_TRIGGERS = %w[scheduled manual event].freeze
AUTONOMY_RUN_STATUSES = %w[completed failed gave_up].freeze

def autonomy_endpoint(use_localhost)
  ApiClient.endpoints(use_localhost: use_localhost, app_filter: "platform").first
end

# `--assert key=value` collected into the JSON object the envelope is evaluated
# against. `true`/`false` become booleans and digits become numbers, because
# `ci_green` and `diff_lines` are only meaningful to the ledger as a boolean and
# a number -- a string "true" is not an assertion that CI is green.
def autonomy_parse_assertion(raw, problems)
  key, _, value = raw.partition("=")
  if key.empty? || value.empty?
    problems << "--assert expects key=value, got '#{raw}'"
    return nil
  end
  parsed =
    case value
    when "true"  then true
    when "false" then false
    when /\A-?\d+\z/ then value.to_i
    else value
    end
  [key, parsed]
end

def autonomy_default_idempotency_key(workflow, action, subject_type, subject_id)
  require "digest"
  Digest::SHA256.hexdigest([workflow, action, subject_type, subject_id].join("|"))[0, 32]
end

def autonomy_print_decision(decision)
  puts "#{decision['disposition']}: #{decision['action']} #{decision['subject']['label']}"
  reason = decision["disposition_reason"]
  puts "  #{reason}" if reason && !reason.empty?
  puts "  id: #{decision['id']}"
end

def cmd_autonomy_decide(args)
  rest, _app_filter, use_localhost = parse_common_flags(args)
  opts = {}
  assertions = {}
  problems = []
  i = 0
  while i < rest.length
    a = rest[i]
    case a
    when "--workflow", "--action", "--subject-type", "--subject-id", "--subject-label",
         "--subject-url", "--rationale", "--reversibility", "--run-id", "--idempotency-key",
         "--register-name", "--register-description"
      value = rest[i + 1]
      usage_exit("#{a} requires a value", example: usage_for("autonomy decide")) if value.nil?
      opts[a.delete_prefix("--").tr("-", "_").to_sym] = value
      i += 2
    when "--assert"
      value = rest[i + 1]
      usage_exit("--assert requires key=value", example: usage_for("autonomy decide")) if value.nil?
      pair = autonomy_parse_assertion(value, problems)
      assertions[pair[0]] = pair[1] if pair
      i += 2
    else
      problems << "Unknown argument '#{a}'"
      i += 1
    end
  end

  %i[workflow action subject_type subject_id subject_label rationale reversibility].each do |k|
    problems << "--#{k.to_s.tr('_', '-')} is required" if opts[k].nil? || opts[k].to_s.empty?
  end
  if opts[:reversibility] && !AUTONOMY_REVERSIBILITIES.include?(opts[:reversibility])
    problems << "--reversibility must be one of #{AUTONOMY_REVERSIBILITIES.join(', ')}"
  end
  report_arg_problems("decide", problems, usage_for("autonomy decide"))

  body = {
    workflow_key: opts[:workflow],
    idempotency_key: opts[:idempotency_key] ||
      autonomy_default_idempotency_key(opts[:workflow], opts[:action], opts[:subject_type], opts[:subject_id]),
    action: opts[:action],
    subject: {
      type: opts[:subject_type],
      id: opts[:subject_id],
      label: opts[:subject_label],
    },
    rationale: opts[:rationale],
    reversibility: opts[:reversibility],
    assertions: assertions,
  }
  body[:run_id] = opts[:run_id] if opts[:run_id]
  body[:subject][:url] = opts[:subject_url] if opts[:subject_url]
  if opts[:register_name]
    body[:workflow_defaults] = {
      name: opts[:register_name],
      description: opts[:register_description] || "",
    }
  end

  decision =
    begin
      ApiClient.request(autonomy_endpoint(use_localhost), :post, "/autonomy/decisions", body: body)
    rescue StandardError => e
      # Fail CLOSED. An unreachable or erroring ledger must never read as permission.
      warn "autonomy: #{e.message}"
      warn "autonomy: treating an unanswered request as 'do nothing'"
      exit 1
    end

  autonomy_print_decision(decision)
  exit(decision["disposition"] == "auto_approved" ? 0 : 1)
end

def cmd_autonomy_outcome(args)
  rest, _app_filter, use_localhost = parse_common_flags(args)
  applied = nil
  error = nil
  undo_command = nil
  leftover = []
  i = 0
  while i < rest.length
    a = rest[i]
    case a
    when "--applied"
      applied = true
      i += 1
    when "--failed"
      applied = false
      error = rest[i + 1]
      usage_exit("--failed requires an error message", example: usage_for("autonomy outcome")) if error.nil?
      i += 2
    when "--undo-command"
      undo_command = rest[i + 1]
      usage_exit("--undo-command requires a value", example: usage_for("autonomy outcome")) if undo_command.nil?
      i += 2
    else
      leftover << a
      i += 1
    end
  end

  problems = []
  problems << "A decision id is required" if leftover.empty?
  problems << "Pass exactly one of --applied or --failed" if applied.nil?
  report_arg_problems("outcome", problems, usage_for("autonomy outcome"))

  body = { applied: applied }
  body[:error] = error if error
  body[:undo] = { kind: "command", command: undo_command } if undo_command

  handle_errors do
    decision = ApiClient.request(autonomy_endpoint(use_localhost), :post,
                                 "/autonomy/decisions/#{URI.encode_www_form_component(leftover.first)}/outcome",
                                 body: body)
    puts "#{decision['status']}: #{decision['action']} #{decision['subject']['label']}"
    if decision["status"] == "contradicted"
      warn "autonomy: the ledger never approved this decision. Acting on it was a contract violation."
      exit 1
    end
  end
end

def cmd_autonomy_workflows(args)
  rest, _app_filter, use_localhost = parse_common_flags(args)
  endpoint = autonomy_endpoint(use_localhost)

  handle_errors do
    if rest.empty?
      rows = ApiClient.request(endpoint, :get, "/autonomy/workflows?limit=100")
      if rows.empty?
        puts "No workflows registered yet."
      else
        rows.each do |w|
          stats = w["stats"]
          puts format("%-28s %-12s decisions today %-4s blocked %-4s pending %s",
                      w["key"], w["mode"], stats["decisions_today"], stats["blocked_today"], stats["pending"])
        end
      end
    else
      w = ApiClient.request(endpoint, :get, "/autonomy/workflows/#{URI.encode_www_form_component(rest.first)}")
      puts "#{w['key']} (#{w['mode']})"
      puts "  #{w['description']}"
      env = w["envelope"]
      puts "  repos:      #{env['allowed_repos'].empty? ? 'unrestricted' : env['allowed_repos'].join(', ')}"
      puts "  max diff:   #{env['max_diff_lines'] || 'unrestricted'}"
      puts "  asserts:    #{env['required_assertions'].empty? ? 'none' : env['required_assertions'].join(', ')}"
      budget = w["budget"]
      puts "  budget:     #{budget['max_decisions_per_day'] || '-'} decisions/day, #{budget['max_auto_approved_per_day'] || '-'} auto-approved/day"
    end
  end
end

def cmd_autonomy_decisions(args)
  rest, _app_filter, use_localhost = parse_common_flags(args)
  params = []
  limit = "25"
  i = 0
  while i < rest.length
    a = rest[i]
    case a
    when "--workflow", "--status", "--disposition"
      value = rest[i + 1]
      usage_exit("#{a} requires a value", example: usage_for("autonomy decisions")) if value.nil?
      key = a == "--workflow" ? "workflow_key" : a.delete_prefix("--")
      params << "#{key}=#{URI.encode_www_form_component(value)}"
      i += 2
    when "--limit"
      limit = rest[i + 1]
      usage_exit("--limit requires a value", example: usage_for("autonomy decisions")) if limit.nil?
      i += 2
    else
      usage_exit("Unknown argument '#{a}'", example: usage_for("autonomy decisions"))
    end
  end
  params << "limit=#{limit}"

  handle_errors do
    rows = ApiClient.request(autonomy_endpoint(use_localhost), :get, "/autonomy/decisions?#{params.join('&')}")
    if rows.empty?
      puts "No decisions match."
    else
      rows.each do |d|
        puts format("%-14s %-12s %-24s %s",
                    d["disposition"], d["status"], d["workflow"]["key"], d["subject"]["label"])
      end
    end
  end
end

def cmd_autonomy_run(args)
  sub = args.shift
  rest, _app_filter, use_localhost = parse_common_flags(args)
  endpoint = autonomy_endpoint(use_localhost)

  case sub
  when "start"
    opts = {}
    i = 0
    while i < rest.length
      a = rest[i]
      case a
      when "--workflow", "--trigger", "--reference"
        value = rest[i + 1]
        usage_exit("#{a} requires a value", example: usage_for("autonomy run")) if value.nil?
        opts[a.delete_prefix("--").to_sym] = value
        i += 2
      else
        usage_exit("Unknown argument '#{a}'", example: usage_for("autonomy run"))
      end
    end
    problems = []
    problems << "--workflow is required" if opts[:workflow].nil?
    trigger = opts[:trigger] || "scheduled"
    problems << "--trigger must be one of #{AUTONOMY_TRIGGERS.join(', ')}" unless AUTONOMY_TRIGGERS.include?(trigger)
    report_arg_problems("run start", problems, usage_for("autonomy run"))

    body = { workflow_key: opts[:workflow], trigger_source: trigger }
    body[:external_reference] = opts[:reference] if opts[:reference]
    handle_errors do
      run = ApiClient.request(endpoint, :post, "/autonomy/runs", body: body)
      puts run["id"]
    end
  when "finish"
    id = rest.shift
    opts = {}
    i = 0
    while i < rest.length
      a = rest[i]
      case a
      when "--status", "--summary", "--error"
        value = rest[i + 1]
        usage_exit("#{a} requires a value", example: usage_for("autonomy run")) if value.nil?
        opts[a.delete_prefix("--").to_sym] = value
        i += 2
      else
        usage_exit("Unknown argument '#{a}'", example: usage_for("autonomy run"))
      end
    end
    problems = []
    problems << "A run id is required" if id.nil?
    problems << "--status must be one of #{AUTONOMY_RUN_STATUSES.join(', ')}" unless AUTONOMY_RUN_STATUSES.include?(opts[:status].to_s)
    report_arg_problems("run finish", problems, usage_for("autonomy run"))

    body = { status: opts[:status] }
    body[:summary] = opts[:summary] if opts[:summary]
    body[:error] = opts[:error] if opts[:error]
    handle_errors do
      run = ApiClient.request(endpoint, :put, "/autonomy/runs/#{URI.encode_www_form_component(id)}", body: body)
      puts "#{run['id']}: #{run['status']}"
    end
  else
    usage_exit("autonomy run takes 'start' or 'finish'", example: usage_for("autonomy run"))
  end
end

def cmd_autonomy_reverts(args)
  rest, _app_filter, use_localhost = parse_common_flags(args)
  reject_unknown_args("autonomy reverts", rest)

  handle_errors do
    rows = ApiClient.request(autonomy_endpoint(use_localhost), :get,
                             "/autonomy/decisions?status=revert_requested&limit=100")
    commands = rows.select { |d| d["undo"] && d["undo"]["kind"] == "command" }
    if commands.empty?
      puts "No reverts are waiting on an executor."
    else
      commands.each do |d|
        puts "#{d['id']}  #{d['subject']['label']}"
        puts "  #{d['undo']['command']}"
        puts "  then: dev autonomy reverted #{d['id']}"
      end
    end
  end
end

def cmd_autonomy_reverted(args)
  rest, _app_filter, use_localhost = parse_common_flags(args)
  succeeded = true
  note = nil
  leftover = []
  i = 0
  while i < rest.length
    a = rest[i]
    case a
    when "--failed"
      succeeded = false
      i += 1
    when "--note"
      note = rest[i + 1]
      usage_exit("--note requires a value", example: usage_for("autonomy reverted")) if note.nil?
      i += 2
    else
      leftover << a
      i += 1
    end
  end
  report_arg_problems("reverted", leftover.empty? ? ["A decision id is required"] : [], usage_for("autonomy reverted"))

  body = { succeeded: succeeded }
  body[:note] = note if note
  handle_errors do
    decision = ApiClient.request(autonomy_endpoint(use_localhost), :post,
                                 "/autonomy/decisions/#{URI.encode_www_form_component(leftover.first)}/revert/completion",
                                 body: body)
    puts "#{decision['id']}: #{decision['status']}"
  end
end

# ---------- agent ----------
#
# The autonomous dispatcher's surface (design §4.7). Everything that browses
# WORK is already `dev issues` and playbook-admin's issue pages — there is no
# separate queue here, which is most of the point. These commands are about the
# MACHINES: what they are doing right now, what they are scheduled to do, and the
# two levers (pause, release) that stop them.
#
# All of the deciding lives in lib/agent/*; these functions parse args, call it,
# and format. That split is what makes the tick testable.

# The runner identity this machine registered, or a clear message about what is
# missing. Every command except `tick` and `gc` needs it — `tick` because it is
# the thing that creates it, `gc` because it only touches local files.
def agent_identity!(use_localhost)
  identity = Agent::Host.cached_identity
  return identity if identity
  Util.exit_with_error(
    "This machine has not registered as a runner yet (no #{Agent::Paths.identity_file}). " \
    "Run `dev agent tick#{use_localhost ? ' --localhost' : ''}` once — the first tick self-registers."
  )
end

def agent_flag_only(command, args, flag)
  rest, app_filter, use_localhost = parse_common_flags(args)
  reject_unknown_args(command, [app_filter].compact) if app_filter
  value = false
  leftover = []
  rest.each { |a| a == flag ? value = true : leftover << a }
  reject_unknown_args(command, leftover)
  [value, use_localhost]
end

def agent_issue_number!(command, rest)
  number = rest.shift
  problems = []
  problems << "missing issue number (positional argument, e.g. 120)" if number.nil? || number.empty?
  problems << "unexpected argument(s): #{rest.join(', ')}" unless rest.empty?
  report_arg_problems(command, problems, usage_for(command))
  number
end

def cmd_agent_tick(args)
  dry_run, use_localhost = agent_flag_only("agent tick", args, "--dry-run")
  handle_errors do
    Agent::Tick.new(use_localhost: use_localhost,
                    claude_argv: headless_claude_argv,
                    dry_run: dry_run,
                    verbose: $stdout.tty? || dry_run).run
  end
end

def cmd_agent_status(args)
  rest, app_filter, use_localhost = parse_common_flags(args)
  reject_unknown_args("agent status", rest + [app_filter].compact)
  identity = agent_identity!(use_localhost)

  handle_errors do
    runners = Agent::Api.runners(token: identity.token, use_localhost: use_localhost)
    me = runners.find { |r| r["id"] == identity.runner_id }
    puts "Runner #{identity.runner_id}#{me ? " (#{me['hostname']})" : ''}"
    puts "  concurrency: #{me ? me['max_concurrency'] : '?'}   paused: #{me ? !!me['paused'] : '?'}"
    puts "  last heartbeat: #{me && me['last_heartbeat_at']}"
    puts "  notifications: #{agent_notify_channel_line}"

    jobs = Agent::Jobs.all
    if jobs.empty?
      puts "\nNo live claims."
    else
      puts "\nLive claims:"
      jobs.each { |job| puts agent_job_line(job) }
    end

    last_tick = Agent::Paths.tick_log(Time.now)
    tail = File.file?(last_tick) ? File.readlines(last_tick).last&.strip : nil
    puts "\nLast tick: #{tail || '(nothing logged today)'}"
  end
end

# Whether this machine can push at all, on the status line rather than only in a
# tick log nobody opens until something has already gone wrong (ISS-535). The
# absent case names what is lost and what is not, because the honest answer is
# "attention, not information" — every push has a durable backstop
# (Agent::Notify::BACKSTOPS) and runner-offline is delivered by the platform.
def agent_notify_channel_line
  return "suppressed (DEV_AGENT_NO_NOTIFY is set)" unless Agent::Notify.enabled?

  path = Agent::Notify.channel_path
  return path if path

  "no `#{Agent::Notify::BINARY}` on this PATH — pushes are no-ops. Nothing is lost: every push has a " \
    "durable backstop (Agent::Notify::BACKSTOPS) and the runner-offline alert is emailed by the platform."
end

def agent_job_line(job)
  number = job["issue"]
  alive = Agent::Jobs.alive?(job["pid"])
  elapsed = ((Time.now - Time.parse(job["started_at"])) / 60).round
  log = Agent::Paths.claude_log(number)
  last = File.file?(log) ? File.readlines(log).last&.strip : nil
  "  ISS-#{number}  #{alive ? 'running' : 'FINISHED (unreaped)'}  #{elapsed}m  branch #{job['branch']}\n" \
    "      #{last ? last[0, 140] : '(no output yet)'}"
end

def cmd_agent_logs(args)
  rest, app_filter, _use_localhost = parse_common_flags(args)
  reject_unknown_args("agent logs", [app_filter].compact) if app_filter
  follow = rest.include?("--follow")
  number = agent_issue_number!("agent logs", rest - ["--follow"])

  log = Agent::Paths.claude_log(number)
  Util.exit_with_error("No session log for ISS-#{number} (#{log})") unless File.file?(log)
  exec(*(follow ? ["tail", "-f", log] : ["tail", "-n", "200", log]))
end

def cmd_agent_pause(args) = agent_set_paused(args, "agent pause", true)
def cmd_agent_resume(args) = agent_set_paused(args, "agent resume", false)

# The kill switch drains rather than kills: a paused runner finishes what it is
# working and claims nothing new. Killing live sessions on pause would throw away
# hours of work to stop the next 30 seconds of it; `dev agent release <issue>` is
# the per-job hammer.
def agent_set_paused(args, command, paused)
  rest, app_filter, use_localhost = parse_common_flags(args)
  reject_unknown_args(command, rest + [app_filter].compact)
  identity = agent_identity!(use_localhost)
  handle_errors do
    runner = Agent::Api.update_runner(identity.runner_id, { paused: paused },
                                      token: identity.token, use_localhost: use_localhost)
    puts "Runner #{identity.runner_id} #{paused ? 'paused — it will finish its live claims and take nothing new' : 'resumed'}."
    puts "  live claims: #{Agent::Jobs.all.count { |j| Agent::Jobs.alive?(j['pid']) }} / #{runner['max_concurrency']}"
  end
end

def cmd_agent_runners(args)
  rest, app_filter, use_localhost = parse_common_flags(args)
  reject_unknown_args("agent runners", rest + [app_filter].compact)
  identity = agent_identity!(use_localhost)
  handle_errors do
    runners = Agent::Api.runners(token: identity.token, use_localhost: use_localhost)
    if runners.empty?
      puts "No runners registered."
      return
    end
    runners.each do |r|
      mine = r["id"] == identity.runner_id ? " (this machine)" : ""
      gb = r["memory_bytes"] ? (r["memory_bytes"] / (1024.0**3)).round : "?"
      puts "#{r['hostname']}#{mine}"
      puts "  #{r['model']} #{r['cpu_brand']} #{r['cpu_cores']} cores #{gb}G   concurrency #{r['max_concurrency']}"
      # `is_stale` is the server's own answer, the same predicate behind the
      # agent_runner_heartbeat_stale invariant. Never recompute it from the
      # timestamp here — two thresholds that disagree is worse than one.
      flags = [r["is_stale"] ? "OFFLINE" : nil, r["paused"] ? "PAUSED" : nil, r["retired_at"] ? "RETIRED" : nil].compact
      puts "  last seen #{r['last_heartbeat_at']}#{flags.empty? ? '' : "   #{flags.join('  ')}"}"
    end
  end
end

def cmd_agent_producers(args)
  rest, app_filter, use_localhost = parse_common_flags(args)
  reject_unknown_args("agent producers", rest + [app_filter].compact)
  identity = agent_identity!(use_localhost)
  handle_errors do
    # Straight off the platform, and deliberately doing no arithmetic of its own.
    # This command used to parse `agent/producers.yml` out of THIS checkout and
    # compute due-ness locally, which made it a second implementation of the
    # schedule grammar and a second opinion about the registry -- so two machines
    # on different devops shas printed two different answers and neither was
    # wrong. There is one registry now and one `next_due_at`, both server-side
    # (ISS-526); this just prints them.
    producers = Agent::Api.producers(token: identity.token, use_localhost: use_localhost)
    runs = Agent::Api.producer_runs(token: identity.token, use_localhost: use_localhost)
    latest = runs.group_by { |r| r["producer_key"] }
    now = Time.now
    if producers.empty?
      puts "No producers in the registry. Add one at /admin/agents."
      next
    end
    puts "Registry: #{producers.length} producer(s), managed at /admin/agents"
    producers.each do |producer|
      last = (latest[producer["key"]] || []).max_by { |r| r["started_at"].to_s }
      due = Time.parse(producer["next_due_at"]) rescue nil
      action = producer.dig("action", "file_when")
      check = producer.dig("action", "check")
      puts "#{producer['key']}"
      puts "  #{producer['schedule']} (#{producer['timezone']})   file_when: #{action}#{check ? "   check: #{check}" : ''}"
      puts "  last run: #{last ? "#{last['started_at']} → #{last['result']}" : 'never'}"
      puts "  next due: #{due.nil? ? producer['next_due_at'] : (due <= now ? 'now' : due)}"
    end
  end
end

def cmd_agent_runs(args)
  rest, app_filter, use_localhost = parse_common_flags(args)
  issue_number = nil
  limit = 25
  leftover = []
  i = 0
  while i < rest.length
    case rest[i]
    when "--issue"
      issue_number = rest[i + 1]
      usage_exit("--issue requires a value", example: usage_for("agent runs")) if issue_number.nil?
      i += 2
    when "--limit"
      limit = rest[i + 1].to_i
      usage_exit("--limit requires a positive integer", example: usage_for("agent runs")) if limit <= 0
      i += 2
    else
      leftover << rest[i]
      i += 1
    end
  end
  key = leftover.shift
  problems = []
  problems << "unexpected argument(s): #{leftover.join(', ')}" unless leftover.empty?
  problems << "--app is not a valid option here" if app_filter
  report_arg_problems("agent runs", problems, usage_for("agent runs"))
  identity = agent_identity!(use_localhost)

  handle_errors do
    if issue_number
      # Every attempt, active and closed: the lease table IS the attempt history.
      leases = Agent::Api.issue_lease_history(issue_number, token: identity.token, use_localhost: use_localhost)
      puts "ISS-#{issue_number}: #{leases.length} lease attempt(s)"
      leases.each do |l|
        puts "  #{l['created']}  runner #{l['runner_id']}  branch #{l['branch'] || '-'}  " \
             "#{l['released_at'] ? "released #{l['released_at']} (#{l['outcome']})" : "active until #{l['leased_until']}"}"
      end
      puts ""
    end
    runs = Agent::Api.producer_runs(token: identity.token, use_localhost: use_localhost,
                                    producer_key: key, limit: limit)
    puts "#{runs.length} producer run(s)#{key ? " for #{key}" : ''}"
    runs.each do |r|
      puts "  #{r['started_at']}  #{r['producer_key']}  #{r['result']}#{r['issue_number'] ? "  ISS-#{r['issue_number']}" : ''}"
    end
  end
end

# Sugar for one transition, and deliberately nothing more: review feedback and a
# pre-merge rebase are both "more work on this issue", and the queue already
# models that. Mike can do the same thing from playbook-admin or `dev issues
# status` — this exists so the common case is one command with a comment that
# already says the right thing.
REFRESH_COMMENT = "Re-opened for the fleet: rebase onto the latest `origin/main`, rerun codegen, " \
                  "and address any review feedback above. Resume the existing branch and PR — do not open a new one.".freeze

def cmd_agent_refresh(args)
  rest, app_filter, use_localhost = parse_common_flags(args)
  comment = nil
  leftover = []
  i = 0
  while i < rest.length
    if rest[i] == "--comment"
      comment = rest[i + 1]
      usage_exit("--comment requires a value", example: usage_for("agent refresh")) if comment.nil?
      i += 2
    else
      leftover << rest[i]
      i += 1
    end
  end
  usage_exit("agent refresh: unknown argument: --app", example: usage_for("agent refresh")) if app_filter
  number = agent_issue_number!("agent refresh", leftover)

  handle_errors do
    issue = Agent::Api.set_status(number, "open", comment: comment || REFRESH_COMMENT, use_localhost: use_localhost)
    puts "ISS-#{issue['number']}: re-opened. The next claim resumes its recorded branch and updates the PR in place."
  end
end

def cmd_agent_release(args)
  rest, app_filter, use_localhost = parse_common_flags(args)
  usage_exit("agent release: unknown argument: --app", example: usage_for("agent release")) if app_filter
  number = agent_issue_number!("agent release", rest)
  identity = agent_identity!(use_localhost)

  handle_errors do
    job = Agent::Jobs.find(number)
    if job && Agent::Jobs.alive?(job["pid"])
      Agent::Jobs.kill(job["pid"])
      puts "Killed pid #{job['pid']} (ISS-#{number})."
    end
    leases = Agent::Api.leases(token: identity.token, use_localhost: use_localhost,
                               issue_number: number, is_active: true)
    if leases.empty?
      puts "No active lease for ISS-#{number}."
    else
      leases.each do |lease|
        Agent::Api.release_lease(lease.fetch("id"), token: identity.token, use_localhost: use_localhost)
        puts "Released lease #{lease['id']} — ISS-#{number} is back in the queue."
      end
    end
    Agent::Jobs.delete(number) if job
  end
end

def cmd_agent_gc(args)
  dry_run, _use_localhost = agent_flag_only("agent gc", args, "--dry-run")
  entries = Agent::Gc.plan
  if entries.empty?
    puts "Nothing to collect."
    return
  end
  entries.each { |path, reason| puts "#{dry_run ? 'would remove' : 'removing'} #{path} — #{reason}" }
  return if dry_run
  puts "Removed #{Agent::Gc.apply(entries)} path(s)."
end

# The operator handle on runner-local housekeeping (ISS-520). Its real job is
# ANSWERING, not running: "did this machine prune, and does it have headroom" is
# the question, and before this it could only be answered by ssh-ing in and
# reading `df` by hand — which is precisely why N-1 machines starving went
# unnoticed. The tick runs the same code on its own; this is how a human sees it.
def cmd_agent_maintenance(args)
  rest, app_filter, _use_localhost = parse_common_flags(args)
  reject_unknown_args("agent maintenance", [app_filter].compact) if app_filter
  dry_run = false
  force = false
  leftover = []
  rest.each do |arg|
    case arg
    when "--dry-run" then dry_run = true
    when "--force"   then force = true
    else                  leftover << arg
    end
  end
  reject_unknown_args("agent maintenance", leftover)

  free, total = Agent::Maintenance.disk
  last = Agent::Maintenance.last_run_at
  puts "Disk: #{free ? "#{docker_format_size(free)} free of #{docker_format_size(total)}" : 'unknown (df failed)'}" \
       " (pressure floor #{docker_format_size(Agent::Maintenance::PRESSURE_FLOOR_BYTES)})"
  puts "Last run: #{last ? last.localtime.strftime('%Y-%m-%d %H:%M %Z') : 'never'}"

  trigger = Agent::Maintenance.due(now: Time.now, free_bytes: free)
  if trigger.nil? && !force
    puts "Not due (cadence #{Agent::Maintenance::CADENCE_SECONDS / 3600}h). Pass --force to run anyway."
    return
  end
  trigger ||= :forced

  if dry_run
    puts "Would run (#{trigger}):"
    Agent::Maintenance.plan(trigger).each { |line| puts "  #{line}" }
    return
  end

  puts "Running (#{trigger})..."
  result = Agent::Maintenance.run(trigger: trigger)
  result.outcomes.each { |o| puts "  #{o.ok ? 'ok  ' : 'FAIL'} #{o.source} — #{o.message}" }
  reclaimed = result.reclaimed_bytes
  puts "Reclaimed: #{reclaimed ? docker_format_size(reclaimed) : 'unknown'} (observed change in free space)"
  exit 1 unless result.outcomes.all?(&:ok)
end

# The executable form of the HOST PREREQUISITES comment in
# launchd/com.bryzek.dev-agent.plist (ISS-531).
#
# That comment was accurate and never once compared to a machine, which is how
# this fleet ran for its whole history with `depsguard` absent and its weekly
# supply-chain scan therefore never executing — silently, because a check that
# cannot run records `check_failed` and a `check_failed` is deliberately
# indistinguishable from a clean run. Provisioning gets a command it can fail on.
#
# The exit code is the contract: 0 every required tool resolves, 1 something
# does not. Optional tools are reported and never affect it.
def cmd_agent_doctor(args)
  reject_unknown_args("agent doctor", args)

  result = Agent::Toolchain.check
  puts "PATH (as `/bin/zsh -lc` gives it to the tick):"
  result.path.split(File::PATH_SEPARATOR).reject(&:empty?).uniq.each { |dir| puts "  #{dir}" }
  puts

  width = result.found.map { |f| f.tool.name.length }.max
  result.found.each do |f|
    status = if f.present? then "ok  "
             elsif f.tool.optional? then "--  "
             else "MISS"
             end
    detail = f.present? ? (f.version || f.path) : "not on the agent's PATH"
    puts "  #{status} #{f.tool.name.ljust(width)}  #{detail}"
  end

  missing = result.missing_required
  optional = result.missing_optional
  unless optional.empty?
    puts
    optional.each { |t| puts "Optional, absent: #{t.name} — #{t.required_by} (`#{t.install}`)" }
  end

  agent_doctor_credentials

  if missing.empty?
    puts
    puts "All #{result.found.count { |f| f.tool.required? }} required tool(s) present."
    return
  end

  puts
  missing.each do |tool|
    puts "MISSING #{tool.name} — #{tool.required_by}"
    puts "  install: #{tool.install}"
    puts "  blocks producer(s): #{tool.producers.join(', ')}" unless tool.producers.empty?
  end
  blocked = result.blocked_producers
  unless blocked.empty?
    puts
    puts "Producer(s) that cannot run on this machine: #{blocked.join(', ')}"
    puts "They record `check_failed`, file nothing, and look exactly like a quiet week."
  end
  exit 1
end

# The external-API credentials half of the doctor (ISS-570).
#
# NEVER affects the exit code, and that is the whole design: a runner with no
# Anthropic key is perfectly able to claim the overwhelming majority of the
# queue, and failing provisioning over it would make a narrow capability into a
# blocker. What an absent credential must not do is stay invisible until a
# session is halfway through an issue whose entire subject is that API — so the
# real enforcement is the same fact rendered into every session's prompt at
# claim time (Agent::Prompt#credentials_section). This is the operator's view of
# it.
#
# Prints presence, never values: `Agent::Credentials.check` cannot carry a
# secret, so this cannot print one.
def agent_doctor_credentials
  found = Agent::Credentials.check
  return if found.empty?

  puts
  puts "Live external-API credentials (read from the env repo WITHOUT unlocking it):"
  width = found.map { |f| f.name.length }.max
  found.each { |f| puts "  #{f.present? ? 'ok  ' : '--  '} #{f.name.ljust(width)}  #{f.explanation}" }

  absent = found.reject(&:present?)
  return if absent.empty?

  puts
  absent.each do |f|
    puts "ABSENT #{f.name} — needed by #{f.credential.required_by}"
    puts "  provide it: #{f.credential.how_to_provide}"
  end
  puts "Sessions on this machine are TOLD this up front and will report such work as unverified " \
       "rather than guessing (ISS-570). Nothing else is blocked."
end

# ---------- dispatch ----------

if __FILE__ == $PROGRAM_NAME
  argv = ARGV.dup
  # Global flag, stripped before dispatch so no subcommand parser has to know it.
  Config.skip_regenerate! if argv.delete(Config::SKIP_REGENERATE_FLAG)
  usage_exit if argv.empty?
  usage_exit if %w[-h --help help].include?(argv.first)

  command = argv.shift
  case command
when "auth"
  sub = resolve_subcommand(argv, default: "status")
  case sub
  when "status" then cmd_auth_status(argv)
  when "login"  then cmd_auth_login(argv)
  when "logout" then cmd_auth_logout(argv)
  when "ai"
    ai_sub = resolve_subcommand(argv, default: "status")
    case ai_sub
    when "status"    then cmd_auth_ai_status(argv)
    when "provision" then cmd_auth_ai_provision(argv)
    when "set"       then cmd_auth_ai_set(argv)
    when "clear"     then cmd_auth_ai_clear(argv)
    when "revoke"    then cmd_auth_ai_revoke(argv)
    else                  unknown("auth ai subcommand", ai_sub, SUBCOMMANDS["auth ai"])
    end
  else               unknown("auth subcommand", sub, SUBCOMMANDS["auth"])
  end
when "invariants"
  sub = resolve_subcommand(argv, default: "check")
  case sub
  when "check"    then cmd_invariants_check(argv)
  when "snoozes"  then cmd_invariants_snoozes(argv)
  when "snooze"   then cmd_invariants_snooze(argv)
  when "unsnooze" then cmd_invariants_unsnooze(argv)
  else                 unknown("invariants subcommand", sub, SUBCOMMANDS["invariants"])
  end
when "slow-routes"
  cmd_slow_routes(argv)
when "deploy"
  sub = resolve_subcommand(argv, default: "status")
  case sub
  when "status" then cmd_deploy_status(argv)
  when "all"    then cmd_deploy_all(argv)
  else               unknown("deploy subcommand", sub, SUBCOMMANDS["deploy"])
  end
when "config"
  sub = argv.shift
  case sub
  when "check"   then cmd_config_check(argv)
  when "rollout" then cmd_config_rollout(argv)
  when nil       then require_subcommand("config")
  else                unknown("config subcommand", sub, SUBCOMMANDS["config"])
  end
when "tasks"
  sub = argv.shift
  case sub
  when "requeue" then cmd_tasks_requeue(argv)
  when "delete"  then cmd_tasks_delete(argv)
  when nil       then require_subcommand("tasks")
  else                unknown("tasks subcommand", sub, SUBCOMMANDS["tasks"])
