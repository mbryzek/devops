#!/usr/bin/env ruby

# Unified database migration deployment tool
# Usage: release-db --app platform-postgresql [--env production]
#
# This script automates the full deployment:
#   1. Prompts to create a new tag if needed
#   2. Resolves every deployable built from the schema repo — platform-postgresql
#      applies to BOTH platform (personal DO account) and playbook-api (playbook
#      DO account) — so one release keeps every copy of the schema in sync
#   3. For each target: copies the tarball to that account's bastion, SSHs in,
#      extracts, and runs sem-apply against that target's database
#
# A target whose account has no bastion, or whose app has no env files /
# CONF_DB_PROD_URL yet, is skipped with a loud warning (the playbook side stays
# in this state until WS2/WS3 of the account split provision it).
#
# Output: concise by default, exactly like release-scala / release-sveltekit —
# one "label... done (12s)" line per stage, with every command's full output in
# the log. That stream is also what `dev deploy` parses to narrate this release
# live; before it, a database release was a name and an elapsed clock for its
# whole duration (the longest single item in a deploy, and the only one that
# showed nothing). --verbose restores the traditional full streaming output.
#
# Prompts (Tag.ask, the tarball overwrite, the apply gate) stay OUTSIDE every
# Util.step: a stage owns its line of stdout for the length of its block, and a
# prompt printed into the middle of it mangles both the prompt and the stage the
# parent is reading.

load File.join(File.dirname(__FILE__), '../lib/common.rb')
require 'securerandom'

# When RELEASE_DB_AUTO_CONFIRM=1 (or true/yes), both the tarball-overwrite
# prompt and the "Ready to apply migrations" gate are answered "yes". Lets
# `dev pending release` drive release-db from a worker without a TTY. Any
# new interactive prompt added to release-db must respect this same flag.
AUTO_CONFIRM_ENV = "RELEASE_DB_AUTO_CONFIRM"
def auto_confirm?
  %w[1 true yes].include?(ENV[AUTO_CONFIRM_ENV].to_s.downcase)
end

# Stop a hand-run release from dropping something the deployed code still uses.
#
# `dev deploy all` already gets this right — a contracting schema release is
# scheduled after the apps it migrates (Phase 3), so by the time release-db runs
# under RELEASE_DB_AUTO_CONFIRM the code has shipped and there is nothing left to
# ask. This is the backstop for the other path: release-db invoked directly, out
# of order, which is how production got 11 `column re.business_line_id does not
# exist` on 2026-08-03 and 37 `relation "playbook.membership_categories" does not
# exist` on 2026-08-04 (ISS-317).
#
def confirm_contracting_release!(repo_dir, tag)
  previous = SchemaScripts.previous_tag(repo_dir, tag)
  return if previous.nil?

  contracting = SchemaScripts.contracting(repo_dir, previous, tag)
  return if contracting.empty?

  puts ""
  puts SchemaScripts.contracting_warning(tag, contracting)

  if auto_confirm?
    # The caller (dev deploy all) has already put this release behind its apps.
    puts "#{AUTO_CONFIRM_ENV}=1: proceeding — the caller is responsible for the ordering"
    return
  end

  return if Ask.for_boolean("Have the apps that stopped using these objects already been deployed?")

  Util.exit_with_error("Aborted: deploy the app first, then re-run release-db (or use `dev deploy all`)")
end

args = Args.parse(ARGV, ["app"])

# Determine the postgresql repo directory
# Supports: --app platform-postgresql OR --app platform (infers -postgresql)
db_name = args.app
if !db_name.end_with?("-postgresql")
    db_name = "#{db_name}-postgresql"
end

repo_dir = File.expand_path("~/code/#{db_name}")
if !File.directory?(repo_dir)
    Util.exit_with_error("Repository directory not found: #{repo_dir}")
end

base_app = db_name.sub(/-postgresql$/, '')

# The log name carries no version, unlike release-scala's: a database release
# does not know its tag until Tag.ask, several lines below.
Util.quiet!("/tmp/devops-release/#{db_name}.log") unless args.verbose

# Every deployable built from this repo with a database config gets the
# migrations. Applying to a subset silently strands the other databases on an
# old schema, so target selection is config-driven, never a flag.
targets = Config.all.select { |a| a.scala && a.built_from?(base_app) }
if targets.empty?
    Util.exit_with_error("No app with a scala config is built from ~/code/#{base_app} — nothing to apply #{db_name} to")
end
# Primary (the app named after the repo) first, then the rest by name.
targets = targets.sort_by { |a| [a.name == base_app ? 0 : 1, a.name] }

puts ""
puts Util.underline("Database Migration Deployment")
puts "  DB:     #{db_name}"
puts "  Env:    #{args.env}"
targets.each do |t|
    db = t.scala.send(args.env).database
    puts "  Target: #{t.name} (account #{t.digital_ocean_account}) -> #{db.name}@#{db.host}:#{db.port}"
end
puts "  Full log: #{Util.log_file}" if Util.quiet?
puts ""

tarball = nil
released_tag = nil

Dir.chdir(repo_dir) do
    # Step 1: Ask user about creating a new tag
    current_tag = Tag.ask

    if current_tag.empty?
        Util.exit_with_error("No tag found. Please create a tag first.")
    end
    released_tag = current_tag

    confirm_contracting_release!(repo_dir, current_tag)

    tarball = File.join(repo_dir, "dist", "#{db_name}-#{current_tag}.tar.gz")

    if File.exist?(tarball)
      if auto_confirm?
        puts "#{AUTO_CONFIRM_ENV}=1: overwriting existing tarball #{tarball}"
        File.delete(tarball)
      elsif Ask.for_boolean("Tarball already exists. Do you want to overwrite it?")
        File.delete(tarball)
      end
    end

    # Create distribution if tarball doesn't exist
    if !File.exist?(tarball)
        Util.step("Creating distribution #{current_tag}") do
            Util.run("/Users/mbryzek/code/schema-evolution-manager/bin/sem-dist --tag #{current_tag}")
            if !File.exist?(tarball)
                Util.exit_with_error("sem-dist failed to create tarball at expected location: #{tarball}")
            end
        end
    end
end

tarball_name = File.basename(tarball)
dir_name = tarball_name.sub('.tar.gz', '')

applied = []
skipped = []

targets.each do |target|
    account = DigitalOceanAccounts.for_label(target.digital_ocean_account)
    db = target.scala.send(args.env).database

    node_ip = account['bastion'].to_s.strip
    if node_ip.empty?
        Util.warning("Skipping #{target.name}: DO account '#{target.digital_ocean_account}' has no bastion configured in digital-ocean-accounts.pkl")
        skipped << target.name
        next
    end

    if !EnvironmentVariables.configured?(target.name, args.env)
        Util.warning("Skipping #{target.name}: no env files under env/apps/#{target.name}/env")
        skipped << target.name
        next
    end

    password = EnvironmentVariables.db_password(target.name, args.env)
    if password.nil?
        Util.warning("Skipping #{target.name}: CONF_DB_PROD_URL not found in environment variables")
        skipped << target.name
        next
    end

    Util.detail("")
    Util.detail(Util.underline("#{target.name}: #{db.name}@#{db.host}:#{db.port} via #{node_ip}"))

    # Name the target in the stage labels only when there is more than one to
    # tell apart — most schema repos apply to a single database, where a bare
    # "Applying migrations" reads better. Same rule as release-sveltekit.
    scope = targets.length > 1 ? " (#{target.name})" : ""

    pgpass_remote = "/tmp/.pgpass-#{SecureRandom.hex(8)}"

    Util.step("Uploading #{tarball_name}#{scope}") do
      # Copy tarball to this account's bastion
      Util.detail("Copying #{tarball} to #{node_ip}")
      Util.run("scp #{tarball} root@#{node_ip}:~/")

      # Create pgpass file locally and copy to node
      # Format: hostname:port:database:username:password
      local_pgpass = "/tmp/.pgpass-local-#{$$}"
      begin
        File.write(local_pgpass, "#{db.host}:#{db.port}:#{db.name}:#{db.user}:#{password}")
        File.chmod(0600, local_pgpass)

        Util.detail("Copying credentials to #{node_ip}")
        Util.run("scp #{local_pgpass} root@#{node_ip}:#{pgpass_remote}", :quiet => true)
      ensure
        # A failed scp used to leave the production DB password sitting in /tmp:
        # Util.run aborts the process, and the delete was the next line.
        File.delete(local_pgpass) if File.exist?(local_pgpass)
      end
    end

    begin
      proceed = auto_confirm?
      if proceed
        Util.detail("#{AUTO_CONFIRM_ENV}=1: proceeding with apply on #{node_ip} for #{target.name}")
      else
        puts ""
        puts "Ready to apply migrations on #{node_ip} for #{target.name}"
      end
      if proceed || Ask.for_boolean("Continue?")
        remote_cmd = [
            "cd ~",
            "tar --warning=no-unknown-keyword -xzf #{tarball_name}",
            "cd #{dir_name}",
            "chmod 600 #{pgpass_remote}",
            "PGPASSFILE=#{pgpass_remote} sem-apply --set sslmode=require --host #{db.host} --port #{db.port} --user #{db.user} --name #{db.name}",
            "rm -f #{pgpass_remote}"
        ].join(" && ")

        Util.step("Applying migrations#{scope}") do
          Util.run("ssh root@#{node_ip} '#{remote_cmd}'")
        end

        applied << target.name
      else
        skipped << target.name
      end
    ensure
      # Not a stage of its own: it runs on the failure path too, where the stage
      # that just failed is the diagnostic and a trailing "Deleting credentials
      # file... done" only buries it.
      Util.detail("Deleting credentials file")
      Util.run("ssh root@#{node_ip} 'rm -f #{pgpass_remote}'")
    end
end

puts ""
if !applied.empty?
  puts "Migration deployment complete: #{applied.join(", ")}"
end
if !skipped.empty?
  Util.warning("Migrations NOT applied to: #{skipped.join(", ")} — those databases are behind until a later release applies them")
end
puts ""

if applied.include?(base_app)
  # Build and push a fresh session-DB Docker image for the just-released schema,
  # then purge old registry images.  Best-effort only: the schema is already
  # deployed at this point, so any failure in the image build or purge must NOT
  # abort release-db or report a non-zero exit.  We rescue StandardError AND
  # SystemExit because DbImages.purge_old calls Util.exit_with_error (which
  # calls exit 1, raising SystemExit) on certain internal failures; plain
  # `rescue => e` only catches StandardError and would let that SystemExit
  # propagate, killing release-db after a successful migration.
  #
  # Every app with a schema repo gets this — the gate is "does this app have a
  # baseline to build on top of", not a hardcoded repo name, so a new Scala
  # project picks it up by cutting a baseline.
  app = DbApp.load(base_app, :repo_dir => repo_dir)
  if File.exist?(app.path(DbApp::BASELINE_TAG_FILE))
    # The dev-template image lives in the primary target's account registry.
    primary = targets.find { |t| t.name == base_app }
    ENV['DIGITALOCEAN_CONTEXT'] = DigitalOceanAccounts.for_label(primary.digital_ocean_account)['doctl_context']
    tag = nil
    build_log = nil
    build_failed = false
    build_cmd = File.join(File.dirname(__FILE__), "db-image")
    begin
      tag = Dir.chdir(repo_dir) { `sem-info tag latest`.strip }
      raise "sem-info tag latest returned empty string in #{repo_dir}" if tag.empty?
      # The image build replays the delta schema through psql and runs a
      # multi-arch docker buildx — thousands of lines of dev-only output that
      # otherwise bury the production migration result above.  Capture stdout
      # AND stderr to a log file so the release console stays readable; the log
      # is surfaced (tail + path) only when the build itself fails.
      build_log = "/tmp/#{app.database}-image-build-#{tag}.log"
      Util.detail("Building and pushing #{app.database} Docker image for schema tag #{tag}...")
      Util.detail("  (dev-only build output -> #{build_log}; shown here only on failure)")
      Util.step("Building #{app.database} image #{tag}") do
        Util.registry_login
        cmd = "#{Shellwords.shellescape(build_cmd)} build " \
              "--app #{Shellwords.shellescape(base_app)} " \
              "--tag #{Shellwords.shellescape(tag)} " \
              "--repo-dir #{Shellwords.shellescape(repo_dir)} --push " \
              "> #{Shellwords.shellescape(build_log)} 2>&1"
        unless system(cmd)
          build_failed = true
          raise "db-image build exited non-zero for tag #{tag} (see #{build_log})"
        end
      end
      Util.step("Purging old #{app.database} images") { DbImages.purge_old(app) }
    rescue StandardError, SystemExit => e
      manual_cmd = "db-image build --app #{base_app} --tag #{tag || '<tag>'} --push"
      # Only dump the build log when the *build* is what failed. A purge failure
      # means the build succeeded, so its log is irrelevant (and would look like
      # a clean success); e.message still carries the real cause below.
      details = ["  To build manually: #{manual_cmd}", "  Or run:            bin/verify-db-images --app #{base_app}"]
      if build_failed && build_log && File.exist?(build_log)
        puts ""
        puts "---- last 40 lines of #{build_log} ----"
        puts File.readlines(build_log).last(40).join
        puts "---- end of build log ----"
        details.unshift("  Full build log:    #{build_log}")
      end
      Util.warning(
        (["#{app.database} image build/purge failed (schema deploy succeeded): #{e.message}"] + details).join("\n")
      )
    end
  end
end

# `dev deploy` reads this line to learn the version actually released — it knows
# the tag that existed BEFORE the release, which is the wrong one whenever the
# release minted a new one. Same contract as release-scala / release-sveltekit.
#
# Only when at least one database actually took the migrations: a run whose
# every target was skipped shipped this tag nowhere, and must not report itself
# as deployed.
unless applied.empty?
  puts "Full log: #{Util.log_file}" if Util.quiet?
  puts ""
  puts "Release complete: #{db_name} #{released_tag}"
  puts ""
end
